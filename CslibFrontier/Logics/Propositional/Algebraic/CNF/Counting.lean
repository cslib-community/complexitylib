/-!
# Clause-indicator polynomials and Boolean-cube model counting

This module connects algebraic propositional proof systems with the Boolean-cube quotient
`Cslib.BitString.boolIdeal` and exact model counting (`Cslib.Logic.PL.CNF.modelCount`,
`Cslib.Logic.PL.CNF.modelCountOn`):

* **Ideal bridge:** `Cslib.Logic.PL.Algebraic.span_boolAxioms_eq_boolIdeal` and
  `Cslib.Logic.PL.Algebraic.span_booleanAxioms_eq_boolIdeal` identify the ideal generated by the
  Boolean axioms with `boolIdeal σ R`. Over a field `K`,
  `Cslib.Logic.PL.Algebraic.one_mem_sup_boolIdeal_iff` shows that
  `1 ∈ Ideal.span {p | p ∈ F} ⊔ boolIdeal σ K` holds if and only if `F` has no Boolean solution.
* **Clause-indicator polynomial:** `Cslib.Logic.PL.Clause.satPoly R c := 1 - c.toBoolPoly R`
  evaluates on `{0, 1} ^ V` to `1` when `c` is satisfied and `0` when `c` is falsified, and
  `Cslib.Logic.PL.CNF.satIndicatorPoly R φ := (φ.map (Clause.satPoly R)).prod` evaluates to the
  `0`/`1` indicator of satisfaction of `φ`.
* **Model counting:** over **any** commutative ring `R`, summing `φ.satIndicatorPoly R` over the
  Boolean cube of `declared` variables equals `(φ.modelCountOn declared : R)`
  (`Cslib.Logic.PL.CNF.sum_eval_satIndicatorPoly_declared`); summing over `φ.vars.toFinset`,
  over `Finset.range (2 ^ φ.numVars)` via `bitsAssignment`, or over a finite ambient type `V`
  recovers `(φ.modelCount : R)` (up to `2 ^ (card V - φ.numVars)` for unused ambient variables).
* **Quotient characterization:** modulo `boolIdeal V R`, `φ.satIndicatorPoly R` is represented by
  the multilinear extension of the satisfaction indicator, annihilates every clause polynomial
  `c.toBoolPoly R`, and lies in `boolIdeal V R` if and only if `φ` is unsatisfiable.

## Main definitions

* `Cslib.Logic.PL.Clause.satPoly`: the `0`/`1` satisfaction indicator polynomial
  `1 - c.toBoolPoly R` of a clause.
* `Cslib.Logic.PL.CNF.satIndicatorPoly`: the product `(φ.map (Clause.satPoly R)).prod` indicating
  satisfying assignments of `φ`.

## Main results

* `Cslib.Logic.PL.Algebraic.span_booleanAxioms_eq_boolIdeal`,
  `Cslib.Logic.PL.Algebraic.span_boolAxioms_eq_boolIdeal`,
  `Cslib.Logic.PL.Algebraic.one_mem_sup_boolIdeal_iff`,
  `Cslib.Logic.PL.CNF.one_mem_span_toBoolPolys_sup_boolIdeal_iff`.
* `Cslib.Logic.PL.Clause.eval_satPoly`, `Cslib.Logic.PL.CNF.eval_satIndicatorPoly`,
  `Cslib.Logic.PL.CNF.totalDegree_satIndicatorPoly_le`,
  `Cslib.Logic.PL.CNF.totalDegree_satIndicatorPoly_le_mul`.
* `Cslib.Logic.PL.CNF.sum_eval_satIndicatorPoly_declared`,
  `Cslib.Logic.PL.CNF.sum_eval_satIndicatorPoly_vars`,
  `Cslib.Logic.PL.CNF.sum_eval_satIndicatorPoly`,
  `Cslib.Logic.PL.CNF.sum_range_eval_satIndicatorPoly_distinctVars`.
* `Cslib.Logic.PL.CNF.satIndicatorPoly_sub_multilinearExtension_mem_boolIdeal`,
  `Cslib.Logic.PL.CNF.boolQuotientAlgEquiv_satIndicatorPoly`,
  `Cslib.Logic.PL.CNF.satisfiable_iff_satIndicatorPoly_notMem_boolIdeal`.
-/

public section

namespace Cslib.Logic.PL

open MvPolynomial Finset Cslib.BitString

section IdealBridge

namespace Algebraic

/-- The ideal generated by `SOS.Psatz.booleanAxioms σ R` is `boolIdeal σ R`. -/
theorem span_booleanAxioms_eq_boolIdeal (σ R : Type*) [CommRing R] :
    Ideal.span (SOS.Psatz.booleanAxioms σ R) = boolIdeal σ R := by
  refine congrArg Ideal.span <| Set.ext fun p => ?_
  rw [SOS.Psatz.mem_booleanAxioms, Set.mem_range]

/-- The ideal generated by the list `boolAxioms σ R` is `boolIdeal σ R`. -/
theorem span_boolAxioms_eq_boolIdeal (σ R : Type*) [CommRing R] [Fintype σ] :
    Ideal.span {p | p ∈ boolAxioms σ R} = boolIdeal σ R := by
  rw [setOf_mem_boolAxioms, span_booleanAxioms_eq_boolIdeal]

/-- Soundness for Boolean-ideal membership: over any nontrivial commutative ring, if `1` lies in
`Ideal.span {p | p ∈ F} ⊔ boolIdeal σ R`, then `F` has no Boolean solution. -/
theorem not_isBoolSolution_of_one_mem_sup_boolIdeal {σ R : Type*} [CommRing R] [Nontrivial R]
    {F : List (MvPolynomial σ R)}
    (h1 : (1 : MvPolynomial σ R) ∈ Ideal.span {p | p ∈ F} ⊔ boolIdeal σ R) (x : σ → Bool) :
    ¬ IsBoolSolution F x := by
  intro hx
  rw [Submodule.mem_sup] at h1
  obtain ⟨f, hf, g, hg, hfg⟩ := h1
  have hkerF : Ideal.span {p | p ∈ F} ≤ RingHom.ker (eval (bitPoint (R := R) x)) := by
    refine Ideal.span_le.mpr ?_
    intro p hp
    exact RingHom.mem_ker.2 (hx p hp)
  have hf0 : eval (bitPoint (R := R) x) f = 0 := RingHom.mem_ker.1 (hkerF hf)
  have hg0 : eval (bitPoint (R := R) x) g = 0 := mem_boolIdeal_iff_forall_eval_bitPoint.1 hg x
  have h01 := congrArg (eval (bitPoint (R := R) x)) hfg
  rw [map_add, hf0, hg0, add_zero, map_one] at h01
  exact zero_ne_one h01

/-- A Nullstellensatz refutation of `F ++ boolAxioms σ R` witnesses
`1 ∈ Ideal.span {p | p ∈ F} ⊔ boolIdeal σ R`. -/
theorem one_mem_sup_boolIdeal_of_ns {σ R : Type*} [CommRing R] [Fintype σ]
    {F : List (MvPolynomial σ R)}
    {P : Fin (F ++ boolAxioms σ R).length → MvPolynomial σ R}
    (hP : NS.IsProof (F ++ boolAxioms σ R) P 1) :
    (1 : MvPolynomial σ R) ∈ Ideal.span {p | p ∈ F} ⊔ boolIdeal σ R := by
  have hspan : Ideal.span {p | p ∈ F ++ boolAxioms σ R} =
      Ideal.span {p | p ∈ F} ⊔ boolIdeal σ R := by
    have hset : {p | p ∈ F ++ boolAxioms σ R} = {p | p ∈ F} ∪ {p | p ∈ boolAxioms σ R} := by
      ext p
      simp only [Set.mem_ofPred_eq, List.mem_append, Set.mem_union]
    rw [hset, Ideal.span_union, span_boolAxioms_eq_boolIdeal]
  rw [← hspan]
  have hsum : (∑ i : Fin (F ++ boolAxioms σ R).length,
      (F ++ boolAxioms σ R).get i * P i) = 1 := hP
  rw [← hsum]
  refine Submodule.sum_mem _ fun i _ => ?_
  exact Ideal.mul_mem_right _ _ (Ideal.subset_span (List.get_mem _ i))

/-- Over a field `K` and finite variable type `σ`, `1` lies in
`Ideal.span {p | p ∈ F} ⊔ boolIdeal σ K` if and only if `F` has no Boolean solution. -/
theorem one_mem_sup_boolIdeal_iff {σ K : Type*} [Field K] [Finite σ]
    {F : List (MvPolynomial σ K)} :
    (1 : MvPolynomial σ K) ∈ Ideal.span {p | p ∈ F} ⊔ boolIdeal σ K ↔ ∀ x, ¬ IsBoolSolution F x :=
  ⟨not_isBoolSolution_of_one_mem_sup_boolIdeal, fun h => by
    have : Fintype σ := Fintype.ofFinite σ
    obtain ⟨_, P, hP, _⟩ := (NS.exists_refutableInDegree_iff (σ := σ) (K := K)).2 h
    exact one_mem_sup_boolIdeal_of_ns hP⟩

/-- Over a field `K` and finite variable type `σ`, `Ideal.span {p | p ∈ F} ⊔ boolIdeal σ K = ⊤`
if and only if `F` has no Boolean solution. -/
theorem sup_boolIdeal_eq_top_iff {σ K : Type*} [Field K] [Finite σ]
    {F : List (MvPolynomial σ K)} :
    Ideal.span {p | p ∈ F} ⊔ boolIdeal σ K = ⊤ ↔ ∀ x, ¬ IsBoolSolution F x := by
  rw [Ideal.eq_top_iff_one, one_mem_sup_boolIdeal_iff]

end Algebraic

/-- Over a field `K` and finite variable type `V`, a CNF formula `φ` is unsatisfiable if and only
if `1 ∈ Ideal.span {p | p ∈ φ.toBoolPolys K} ⊔ boolIdeal V K`. -/
theorem CNF.one_mem_span_toBoolPolys_sup_boolIdeal_iff {V K : Type*} [Field K] [Finite V]
    {φ : CNF V} :
    (1 : MvPolynomial V K) ∈ Ideal.span {p | p ∈ φ.toBoolPolys K} ⊔ boolIdeal V K ↔
      ¬ φ.Satisfiable := by
  rw [Algebraic.one_mem_sup_boolIdeal_iff]
  simp only [CNF.isBoolSolution_toBoolPolys_iff, CNF.Satisfiable, not_exists]

end IdealBridge

section Indicators

variable {V : Type*}

/-- The satisfaction indicator polynomial `1 - c.toBoolPoly R` of a clause `c`: it evaluates on
`{0, 1} ^ V` to `1` when `c` is satisfied and `0` when `c` is falsified. -/
@[expose] noncomputable def Clause.satPoly (R : Type*) [CommRing R] (c : Clause V) :
    MvPolynomial V R :=
  1 - c.toBoolPoly R

/-- The satisfaction indicator polynomial of a CNF formula `φ`: the product of `c.satPoly R` over
all clauses `c ∈ φ`. -/
@[expose] noncomputable def CNF.satIndicatorPoly (R : Type*) [CommRing R] (φ : CNF V) :
    MvPolynomial V R :=
  (φ.map (Clause.satPoly R)).prod

variable {R : Type*} [CommRing R]

/-- The empty clause has satisfaction indicator `0`. -/
@[simp] theorem Clause.satPoly_nil : Clause.satPoly R ([] : Clause V) = 0 := by
  simp [Clause.satPoly]

/-- On `{0, 1} ^ V`, `Clause.satPoly R c` evaluates to `1` when `c` is satisfied and `0` when `c`
is falsified. -/
theorem Clause.eval_satPoly (x : V → Bool) (c : Clause V) :
    MvPolynomial.eval (bitPoint (R := R) x) (c.satPoly R) = if c.eval x then 1 else 0 := by
  rw [Clause.satPoly, map_sub, map_one, Clause.eval_toBoolPoly]
  cases c.eval x <;> simp

/-- A clause satisfaction polynomial has total degree at most `c.length`. -/
theorem Clause.totalDegree_satPoly_le (c : Clause V) : (c.satPoly R).totalDegree ≤ c.length := by
  rw [Clause.satPoly]
  refine (totalDegree_sub _ _).trans (max_le ?_ (Clause.totalDegree_toBoolPoly_le c))
  rw [totalDegree_one]
  exact Nat.zero_le _

/-- The empty CNF formula has satisfaction indicator `1`. -/
@[simp] theorem CNF.satIndicatorPoly_nil : CNF.satIndicatorPoly R ([] : CNF V) = 1 := rfl

/-- Adding a clause multiplies the satisfaction indicator by `c.satPoly R`. -/
@[simp] theorem CNF.satIndicatorPoly_cons (c : Clause V) (φ : CNF V) :
    CNF.satIndicatorPoly R (c :: φ) = c.satPoly R * φ.satIndicatorPoly R := rfl

/-- On `{0, 1} ^ V`, `CNF.satIndicatorPoly R φ` evaluates to `1` when `φ` is satisfied and `0`
otherwise. -/
theorem CNF.eval_satIndicatorPoly (x : V → Bool) (φ : CNF V) :
    MvPolynomial.eval (bitPoint (R := R) x) (φ.satIndicatorPoly R) = if φ.eval x then 1 else 0 := by
  induction φ with
  | nil => simp [CNF.satIndicatorPoly, CNF.eval_nil]
  | cons c φ ih =>
    rw [CNF.satIndicatorPoly_cons, map_mul, Clause.eval_satPoly, ih, CNF.eval_cons]
    cases c.eval x <;> cases CNF.eval x φ <;> simp

/-- The satisfaction indicator of `φ` has total degree at most the sum of its clause lengths. -/
theorem CNF.totalDegree_satIndicatorPoly_le (φ : CNF V) :
    (φ.satIndicatorPoly R).totalDegree ≤ (φ.map List.length).sum := by
  induction φ with
  | nil => simp [CNF.satIndicatorPoly]
  | cons c φ ih =>
    rw [CNF.satIndicatorPoly_cons, List.map_cons, List.sum_cons]
    exact (totalDegree_mul _ _).trans (add_le_add (Clause.totalDegree_satPoly_le c) ih)

/-- If every clause of `φ` has width at most `w`, then `φ.satIndicatorPoly R` has total degree at
most `φ.length * w`. -/
theorem CNF.totalDegree_satIndicatorPoly_le_mul {φ : CNF V} {w : ℕ}
    (hw : ∀ c ∈ φ, c.length ≤ w) :
    (φ.satIndicatorPoly R).totalDegree ≤ φ.length * w := by
  refine (CNF.totalDegree_satIndicatorPoly_le φ).trans ?_
  calc (φ.map List.length).sum
      ≤ (φ.map fun _ => w).sum := List.sum_le_sum fun c hc => hw c hc
    _ = φ.length * w := by simp

end Indicators

section ModelCounting

variable {V R : Type*} [CommRing R]

/-- **Boolean-cube sum counts models on any declared set**: over **any** commutative ring `R`,
summing `φ.satIndicatorPoly R` over Boolean assignments to `declared` gives
`(φ.modelCountOn declared : R)`. -/
theorem CNF.sum_eval_satIndicatorPoly_declared [DecidableEq V] (φ : CNF V)
    (declared : Finset V) :
    (∑ σ : declared → Bool,
      MvPolynomial.eval
        (bitPoint (R := R) fun v => if h : v ∈ declared then σ ⟨v, h⟩ else false)
        (φ.satIndicatorPoly R)) = (φ.modelCountOn declared : R) := by
  have hrew :
      (∑ σ : declared → Bool,
        MvPolynomial.eval
          (bitPoint (R := R) fun v => if h : v ∈ declared then σ ⟨v, h⟩ else false)
          (φ.satIndicatorPoly R)) =
      ∑ σ : declared → Bool,
        if φ.eval (fun v => if h : v ∈ declared then σ ⟨v, h⟩ else false) = true
        then (1 : R) else 0 := by
    refine Finset.sum_congr rfl fun σ _ => ?_
    rw [CNF.eval_satIndicatorPoly]
  rw [hrew, Finset.sum_boole, CNF.modelCountOn]

/-- **Boolean-cube sum counts models**: over **any** commutative ring `R`, summing
`φ.satIndicatorPoly R` over assignments to `φ.vars.toFinset` gives `(φ.modelCount : R)`. -/
theorem CNF.sum_eval_satIndicatorPoly_vars [DecidableEq V] (φ : CNF V) :
    (∑ τ : φ.vars.toFinset → Bool,
      MvPolynomial.eval (bitPoint (R := R) (φ.extendAssignment τ)) (φ.satIndicatorPoly R)) =
      (φ.modelCount : R) := by
  have h := φ.sum_eval_satIndicatorPoly_declared (R := R) φ.vars.toFinset
  rw [CNF.modelCountOn_vars] at h
  exact h

/-- Over a finite variable type `V`, summing `φ.satIndicatorPoly R` over `V → Bool` counts models
on `Finset.univ`. -/
theorem CNF.sum_eval_satIndicatorPoly_eq_modelCountOn [Fintype V] [DecidableEq V] (φ : CNF V) :
    (∑ x : V → Bool, MvPolynomial.eval (bitPoint (R := R) x) (φ.satIndicatorPoly R)) =
      (φ.modelCountOn Finset.univ : R) := by
  have hrew :
      (∑ x : V → Bool, MvPolynomial.eval (bitPoint (R := R) x) (φ.satIndicatorPoly R)) =
        ∑ x : V → Bool, if φ.eval x = true then (1 : R) else 0 := by
    refine Finset.sum_congr rfl fun x _ => ?_
    rw [CNF.eval_satIndicatorPoly]
  rw [hrew, Finset.sum_boole, CNF.modelCountOn]
  congr 1
  refine Finset.card_bij (fun x _ (v : (Finset.univ : Finset V)) => x v.1)
    (fun x hx => ?_) (fun x y _ _ hxy => ?_) (fun σ hσ => ?_)
  · simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_univ, ↓reduceDIte] at hx ⊢
    exact hx
  · funext v
    exact congrFun hxy ⟨v, Finset.mem_univ v⟩
  · refine ⟨fun v => σ ⟨v, Finset.mem_univ v⟩, ?_, funext fun v => rfl⟩
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_univ, ↓reduceDIte] at hσ ⊢
    exact hσ

/-- Over a finite variable type `V`, summing `φ.satIndicatorPoly R` over `V → Bool` gives
`2 ^ (Fintype.card V - φ.numVars) * (φ.modelCount : R)`. -/
theorem CNF.sum_eval_satIndicatorPoly [Fintype V] [DecidableEq V] (φ : CNF V) :
    (∑ x : V → Bool, MvPolynomial.eval (bitPoint (R := R) x) (φ.satIndicatorPoly R)) =
      (2 : R) ^ (Fintype.card V - φ.numVars) * (φ.modelCount : R) := by
  rw [CNF.sum_eval_satIndicatorPoly_eq_modelCountOn,
    CNF.modelCountOn_eq_mul_modelCount φ Finset.univ (Finset.subset_univ _), Finset.card_univ]
  push_cast
  rfl

/-- Summing `φ.satIndicatorPoly R` over the `2 ^ φ.numVars` numbered assignments
`bitsAssignment φ.distinctVars i` (`i < 2 ^ φ.numVars`) recovers `(φ.modelCount : R)` over **any**
commutative ring `R` and any variable type `V`. -/
theorem CNF.sum_range_eval_satIndicatorPoly_distinctVars [DecidableEq V] (φ : CNF V) :
    (∑ i ∈ Finset.range (2 ^ φ.numVars),
      MvPolynomial.eval (bitPoint (R := R) (bitsAssignment φ.distinctVars i))
        (φ.satIndicatorPoly R)) =
      (φ.modelCount : R) := by
  have hrew :
      (∑ i ∈ Finset.range (2 ^ φ.numVars),
        MvPolynomial.eval (bitPoint (R := R) (bitsAssignment φ.distinctVars i))
          (φ.satIndicatorPoly R)) =
      ∑ i ∈ Finset.range (2 ^ φ.numVars),
        if φ.eval (bitsAssignment φ.distinctVars i) = true then (1 : R) else 0 := by
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [CNF.eval_satIndicatorPoly]
  rw [hrew, Finset.sum_boole, CNF.modelCount]
  congr 1
  refine Finset.card_bij (fun i _ v => bitsAssignment φ.distinctVars i v.1)
    (fun i hi => ?_) (fun i₁ hi₁ i₂ hi₂ h => ?_) (fun τ hτ => ?_)
  · rw [Finset.mem_filter] at hi ⊢
    refine ⟨Finset.mem_univ _, ?_⟩
    exact (CNF.eval_congr fun v hv => CNF.extendAssignment_of_mem _ hv).trans hi.2
  · rw [Finset.mem_filter, Finset.mem_range] at hi₁ hi₂
    apply Nat.eq_of_testBit_eq
    intro k
    by_cases hk : k < φ.distinctVars.length
    · have hkmem : φ.distinctVars[k]'hk ∈ φ.vars.toFinset :=
        List.mem_toFinset.2 (CNF.mem_distinctVars.1 (List.getElem_mem hk))
      have hvk := congrFun h ⟨φ.distinctVars[k]'hk, hkmem⟩
      simpa only [bitsAssignment, (CNF.nodup_distinctVars φ).idxOf_getElem k hk] using hvk
    · have hklen : φ.distinctVars.length ≤ k := Nat.le_of_not_lt hk
      rw [CNF.length_distinctVars] at hklen
      have h1 : i₁.testBit k = false :=
        Nat.testBit_lt_two_pow (hi₁.1.trans_le (Nat.pow_le_pow_right (by omega) hklen))
      have h2 : i₂.testBit k = false :=
        Nat.testBit_lt_two_pow (hi₂.1.trans_le (Nat.pow_le_pow_right (by omega) hklen))
      rw [h1, h2]
  · rw [Finset.mem_filter] at hτ
    obtain ⟨i, hi, hiτ⟩ :=
      exists_lt_two_pow_bitsAssignment_eq (vs := φ.distinctVars) (φ.extendAssignment τ)
    refine ⟨i, Finset.mem_filter.2 ⟨Finset.mem_range.2 ?_, ?_⟩, funext fun v => ?_⟩
    · rwa [← CNF.length_distinctVars]
    · exact (CNF.eval_congr fun v hv => hiτ v (CNF.mem_distinctVars.2 hv)).trans hτ.2
    · have hv : v.1 ∈ φ.vars := List.mem_toFinset.1 v.2
      exact (hiτ v.1 (CNF.mem_distinctVars.2 hv)).trans (CNF.extendAssignment_of_mem τ hv)

end ModelCounting

section QuotientAndCharacterization

variable {V R : Type*} [CommRing R]

/-- Modulo `boolIdeal V R`, `φ.satIndicatorPoly R` is represented by the multilinear extension of
the `0`/`1` satisfaction indicator on `{0, 1} ^ V`. -/
theorem CNF.satIndicatorPoly_sub_multilinearExtension_mem_boolIdeal [Fintype V] [DecidableEq V]
    (φ : CNF V) :
    φ.satIndicatorPoly R -
      multilinearExtension (fun x : V → Bool => if φ.eval x then (1 : R) else 0) ∈
        boolIdeal V R := by
  rw [mem_boolIdeal_iff_forall_eval_bitPoint]
  intro x
  rw [map_sub, CNF.eval_satIndicatorPoly, eval_multilinearExtension, sub_self]

/-- Under `boolQuotientAlgEquiv`, the coset of `φ.satIndicatorPoly R` is the `0`/`1` satisfaction
indicator function on `{0, 1} ^ V`. -/
theorem CNF.boolQuotientAlgEquiv_satIndicatorPoly [Finite V] (φ : CNF V) (x : V → Bool) :
    boolQuotientAlgEquiv V R (Ideal.Quotient.mk (boolIdeal V R) (φ.satIndicatorPoly R)) x =
      if φ.eval x then 1 else 0 := by
  rw [boolQuotientAlgEquiv_mk, CNF.eval_satIndicatorPoly]

/-- The unique multilinear representative of `φ.satIndicatorPoly R` has the same cube sum. -/
theorem CNF.sum_eval_multilinearExtension_satIndicator [Fintype V] [DecidableEq V] (φ : CNF V) :
    (∑ x : V → Bool, MvPolynomial.eval (bitPoint (R := R) x)
      (multilinearExtension (fun y : V → Bool => if φ.eval y then (1 : R) else 0))) =
      (2 : R) ^ (Fintype.card V - φ.numVars) * (φ.modelCount : R) := by
  have heq :
      (∑ x : V → Bool, MvPolynomial.eval (bitPoint (R := R) x)
        (multilinearExtension (fun y : V → Bool => if φ.eval y then (1 : R) else 0))) =
      ∑ x : V → Bool, MvPolynomial.eval (bitPoint (R := R) x) (φ.satIndicatorPoly R) := by
    refine Finset.sum_congr rfl fun x _ => ?_
    rw [eval_multilinearExtension, CNF.eval_satIndicatorPoly]
  rw [heq, CNF.sum_eval_satIndicatorPoly]

/-- Every clause polynomial `c.toBoolPoly R` for `c ∈ φ` annihilates `φ.satIndicatorPoly R`
modulo `boolIdeal V R`. -/
theorem CNF.toBoolPoly_mul_satIndicatorPoly_mem_boolIdeal {φ : CNF V} {c : Clause V}
    (hc : c ∈ φ) :
    c.toBoolPoly R * φ.satIndicatorPoly R ∈ boolIdeal V R := by
  rw [mem_boolIdeal_iff_forall_eval_bitPoint]
  intro x
  rw [map_mul, Clause.eval_toBoolPoly, CNF.eval_satIndicatorPoly]
  by_cases hcx : c.eval x = true
  · simp [hcx]
  · have hpx : φ.eval x ≠ true := fun hpx => hcx ((CNF.eval_eq_true_iff x φ).1 hpx c hc)
    simp [hcx, hpx]

/-- Over any nontrivial commutative ring `R`, `φ.satIndicatorPoly R` lies in `boolIdeal V R` if
and only if `φ` is unsatisfiable. -/
theorem CNF.satIndicatorPoly_mem_boolIdeal_iff [Nontrivial R] (φ : CNF V) :
    φ.satIndicatorPoly R ∈ boolIdeal V R ↔ ¬ φ.Satisfiable := by
  rw [mem_boolIdeal_iff_forall_eval_bitPoint]
  simp only [CNF.eval_satIndicatorPoly, CNF.Satisfiable, not_exists]
  refine forall_congr' fun x => ?_
  cases φ.eval x <;> simp

/-- Over any nontrivial commutative ring `R`, `φ` is satisfiable if and only if
`φ.satIndicatorPoly R ∉ boolIdeal V R`. -/
theorem CNF.satisfiable_iff_satIndicatorPoly_notMem_boolIdeal [Nontrivial R] (φ : CNF V) :
    φ.Satisfiable ↔ φ.satIndicatorPoly R ∉ boolIdeal V R := by
  rw [CNF.satIndicatorPoly_mem_boolIdeal_iff, not_not]

/-- Modulo `boolIdeal V R`, `φ` is satisfiable if and only if the coset of `φ.satIndicatorPoly R`
is nonzero. -/
theorem CNF.satisfiable_iff_mk_satIndicatorPoly_ne_zero [Nontrivial R] (φ : CNF V) :
    φ.Satisfiable ↔ Ideal.Quotient.mk (boolIdeal V R) (φ.satIndicatorPoly R) ≠ 0 := by
  rw [ne_eq, Ideal.Quotient.eq_zero_iff_mem, CNF.satIndicatorPoly_mem_boolIdeal_iff, not_not]

end QuotientAndCharacterization

end Cslib.Logic.PL
