public import CslibFrontier.Logics.BooleanClone.Basic

/-!
# Generated Boolean clones and functional completeness

`BooleanClone.generated G` contains exactly the operations obtained from positive-arity
members of `G` and coordinate projections by finitely many superpositions. Members of `G 0`
are ignored: constant functions here have positive arity, rather than being nullary gates.

## Main definitions

* `Cslib.Logic.BooleanClone.Generated`: finite superposition derivations.
* `Cslib.Logic.BooleanClone.generated`: the clone generated by a family of operations.
* `Cslib.Logic.BooleanClone.IsComplete`: containing every positive-arity Boolean operation.
* `Cslib.Logic.BooleanClone.FunctionallyComplete`: generation of all positive-arity operations.

## Main results

* `Cslib.Logic.BooleanClone.generated_le_iff`: the universal property of the generated clone.
-/

public section

namespace Cslib.Logic.BooleanClone

/-- A finite derivation from positive-arity generators, projections and superposition. -/
inductive Generated (G : (n : ℕ) → Set ((Fin n → Bool) → Bool)) :
    {n : ℕ} → ((Fin n → Bool) → Bool) → Prop
  | of_mem {n} {f : (Fin n → Bool) → Bool} : 0 < n → f ∈ G n → Generated G f
  | projection {n} (i : Fin n) : Generated G (fun a => a i)
  | comp {m n} (hm : 0 < m) (hn : 0 < n)
      {f : (Fin m → Bool) → Bool} {g : Fin m → (Fin n → Bool) → Bool} :
      Generated G f → (∀ i, Generated G (g i)) → Generated G (fun a => f (fun i => g i a))

/-- Derivations only construct positive-arity operations. -/
theorem Generated.arity_pos {G : (n : ℕ) → Set ((Fin n → Bool) → Bool)}
    {n : ℕ} {f : (Fin n → Bool) → Bool} (h : Generated G f) : 0 < n := by
  cases h with
  | of_mem hn _ => exact hn
  | projection i => exact lt_of_le_of_lt (Nat.zero_le _) i.isLt
  | comp _ hn _ _ => exact hn

/-- The clone of operations with a finite superposition derivation from `G`. -/
@[expose] def generated (G : (n : ℕ) → Set ((Fin n → Bool) → Bool)) : BooleanClone where
  operations _ := {f | Generated G f}
  nullary := by ext f; exact ⟨fun h => (Nat.lt_irrefl 0 h.arity_pos).elim, False.elim⟩
  projection := Generated.projection
  comp := Generated.comp

/-- A clone contains the generated clone exactly when it contains every positive-arity
original generator. No condition on `G 0` is imposed. -/
theorem generated_le_iff (G : (n : ℕ) → Set ((Fin n → Bool) → Bool)) (C : BooleanClone) :
    (∀ n, (generated G).operations n ⊆ C.operations n) ↔
      ∀ n, 0 < n → G n ⊆ C.operations n := by
  constructor
  · intro h n hn f hf
    exact h n (Generated.of_mem hn hf)
  · intro h n f hf
    induction hf with
    | of_mem hn hf => exact h _ hn hf
    | projection i => exact C.projection i
    | comp hm hn _ _ ihf ihg => exact C.comp hm hn ihf ihg

/-- A clone is complete when it contains every Boolean operation of every positive arity. -/
@[expose] def IsComplete (C : BooleanClone) : Prop :=
  ∀ n, 0 < n → ∀ f : (Fin n → Bool) → Bool, f ∈ C.operations n

/-- Functional completeness for positive arities, allowing unary constant functions.
This does not require synthesizing nullary gates. -/
@[expose] def FunctionallyComplete (G : (n : ℕ) → Set ((Fin n → Bool) → Bool)) : Prop :=
  (generated G).IsComplete

end Cslib.Logic.BooleanClone
