/-!
# Certified-risk transfer to the native greedy batch

[Wang2027], Theorem 4, PDF pp. 9–11. The conditional kernels are constructed
from actual jointly sampled call trajectories; no representation identity is a
premise. Canceled or malformed proposals become empty families for fixed-order
processing, preserving the original retention result. Oracle metadata and bills
are retained by the earlier native joint law.

## Main results

* `report_retained`: actual packet processing agrees with original-family retention.
* `native_risk`: source conditional risk bounds for the same native tape output.
-/

public section
noncomputable section
namespace Cslib.Probability.StochasticOracle.PartialCover.NativeExecution
open Turing NativeOpenExecution ConcurrentBatch NativeRetention
open scoped NNReal ENNReal

/-- The same original WSC instance, restricted to its finitely many candidate labels. -/
@[expose] def sourceInstance (x : Input) (hx : Valid x.system) :
    Instance ℕ (Fin x.system.rows.length) :=
  (instanceOf x.system hx).reindex Fin.valEmbedding

/-- Exact retention of a canonical report, including the original local tests. -/
theorem report_retained (system : NativeRetention.Input) (hx : Valid system)
    (n : ℕ) (report : Report n) :
    outputFamily (Packets.assemble ⟨system, n, [encodeReport report]⟩) =
      ((instanceOf system hx).reindex Fin.valEmbedding).retain system.rho ∅
        (proposals system.rows.length report) := by
  set_option backward.isDefEq.respectTransparency false in
    let data := Packets.assemble (⟨system, n, [encodeReport report]⟩ : Packets.Work)
    have hv : Valid data := ⟨hx.weight_nonneg, hx.dual_nonneg, hx.feasible⟩
    dsimp only [Packets.assemble]
    apply Finset.image_injective (f := fun i : Fin system.rows.length => i.val) Fin.val_injective
    rw [outputFamily_image, retain_eq data hv, Instance.reindex_retain (instanceOf system hx) Fin.valEmbedding system.rho ∅
      (proposals system.rows.length report)]
    simp only [Finset.image_empty]
    have hprops : data.proposals = (proposals system.rows.length report).map sourceIndices := by
      simp [data, Packets.assemble, Packets.families_report]
    rw [hprops, List.map_map]
    have he : (fun C : Finset (Fin system.rows.length) =>
        (normalize data (sourceIndices C)).toFinset) = fun C => C.image Fin.val := by
      funext C
      exact BatchReceipts.normalize_sourceIndices data C
    rw [he]
    rfl

/-- Every call position has a decoded family, with empty family for cancellation
or malformed masks. No raw reply or correlated hidden state is replaced. -/
@[expose] def family {n m : ℕ} (report : Report n) (i : Fin n) : Finset (Fin m) :=
  ((report i).bind fun call => call.1.bind (decodeFamily m)).getD ∅

/-- Including the absent/invalid-call entries as empty families preserves retention. -/
theorem retain_families {E : Type} [DecidableEq E] {n m : ℕ}
    (I : Instance E (Fin m)) (ρ : ℝ) (report : Report n) :
    I.retain ρ ∅ (List.ofFn (family (m := m) report)) =
      I.retain ρ ∅ (proposals m report) := by
  rw [proposals, ← Instance.retain_options]
  congr 1
  rw [List.map_ofFn]
  rfl

/-- Joint trajectory/private-state outcomes of the actual batch sampler. -/
abbrev Draw (x : Input) (P : Type) :=
  (Fin (GreedyNative.labels x.planner).length → CallTrace) × P

/-- Actual concurrent receipt generated by a single original joint sample. -/
@[expose] def receipt {P : Type} (x : Input)
    (limits : Limits (GreedyNative.labels x.planner).length)
    (hs : RuntimeControl.stopped (initial x) = false) (draw : Draw x P) :=
  observe limits limits.deadline (batch x (live_nonempty x hs)) draw.1

/-- The indexed decoded response used in the source processing order. -/
@[expose] def response {P : Type} (x : Input)
    (limits : Limits (GreedyNative.labels x.planner).length)
    (hs : RuntimeControl.stopped (initial x) = false) (k : ℕ) (draw : Draw x P) :
    Finset (Fin x.system.rows.length) :=
  if h : k < (GreedyNative.labels x.planner).length then
    family (receipt x limits hs draw).report ⟨k, h⟩
  else ∅

/-- Exact original eligibility sets, transported to the WSC ground's natural labels. -/
@[expose] def eligible (x : Input) : List (Finset ℕ) :=
  (GreedyNative.labels x.planner).map fun j =>
    (GreedyNative.oracleAt x.planner.val j).eligible.image Fin.val

/-- Source certification checks the actual decoded tape family and the actual deadline. -/
@[expose] def certified (x : Input) (hx : Valid x.system) (D : ℝ≥0)
    {P : Type} (outcome : Option (NativeReplyContext.Observation P)) : Bool :=
  outcome.any fun final => (decodeFamily x.system.rows.length final.output).any fun C =>
    decide ((instanceOf x.system hx).covered (C.image Fin.val) = (instanceOf x.system hx).ground ∧
      (instanceOf x.system hx).cost (C.image Fin.val) ≤ (x.system.rho : ℝ) *
        ∑ e ∈ (instanceOf x.system hx).ground, (instanceOf x.system hx).dual e ∧
      elapsed final.memory.events ≤ D)

/-- On every actual trajectory, complete source retention gives the native
computed completion flag; no successful-output premise is supplied by the caller. -/
theorem retained_complete {P : Type} (x : Input) (hx : Valid x.system)
    (limits : Limits (GreedyNative.labels x.planner).length)
    (hs : RuntimeControl.stopped (initial x) = false) (draw : Draw x P)
    (hc : (sourceInstance x hx).covered
      (Disintegration.retained (sourceInstance x hx) x.system.rho
        (Disintegration.history (response x limits hs)
          (GreedyNative.labels x.planner).length draw)) = (sourceInstance x hx).ground) :
    complete (responseInput x (replyOf (receipt x limits hs draw)).word) = true := by
  have hfamily : Disintegration.retained (sourceInstance x hx) x.system.rho
      (Disintegration.history (response x limits hs)
        (GreedyNative.labels x.planner).length draw) =
      (sourceInstance x hx).retain x.system.rho ∅
        (proposals x.system.rows.length (receipt x limits hs draw).report) := by
    rw [Disintegration.retained, Disintegration.history_reverse]
    have he : (fun i : Fin (GreedyNative.labels x.planner).length =>
        response x limits hs i.val draw) = family (receipt x limits hs draw).report := by
      funext i
      simp [response, i.isLt]
    rw [he, retain_families]
  rw [hfamily, sourceInstance, Instance.reindex_covered] at hc
  have hr := report_retained x.system hx _ (receipt x limits hs draw).report
  have hv : Valid (responseInput x (replyOf (receipt x limits hs draw)).word) :=
    ⟨hx.weight_nonneg, hx.dual_nonneg, hx.feasible⟩
  apply (complete_eq _ hv).mpr
  rw [← outputFamily_image]
  change (instanceOf x.system hx).covered _ = _
  rw [show outputFamily (responseInput x (replyOf (receipt x limits hs draw)).word) =
      ((instanceOf x.system hx).reindex Fin.valEmbedding).retain x.system.rho ∅
        (proposals x.system.rows.length (receipt x limits hs draw).report) from hr]
  exact hc

/-- Actual source conditional envelopes imply the original certified-risk bound
for the named native program, its tape output and oracle deadline. -/
theorem native_risk {P : Type} (x : Input) (hx : Valid x.system)
    (limits : Limits (GreedyNative.labels x.planner).length)
    (sample : Sampler (GreedyNative.labels x.planner).length P) (seed : P)
    (hs : RuntimeControl.stopped (initial x) = false)
    (hd : 0 < limits.deadline) (ht : 0 < limits.turns) {p : ℝ}
    (hp : 0 ≤ p) (hpone : p ≤ 1)
    (had : (sourceInstance x hx).Admissible x.system.rho p
      (Disintegration.kernel (sample (ConcurrentBatch.initial seed) (batch x (live_nonempty x hs)))
        (response x limits hs)) [] ∅ (eligible x)) :
    max 0 (1 - ∑ e ∈ (instanceOf x.system hx).ground,
      (1 - p) ^ Instance.chances e (eligible x)) ≤
      ((((NativeUnboundedExecution.terminal controller.program (environment limits sample)
        ⟨controller.program.initialConfig (encoding x), ⟨ConcurrentBatch.initial seed, []⟩⟩).map
          (Option.map (NativeReplyContext.observe controller.context))).map
            (certified x hx limits.deadline)) true).toReal := by
  have h := Disintegration.risk_bound (sourceInstance x hx) x.system.rho
    (sample (ConcurrentBatch.initial seed) (batch x (live_nonempty x hs)))
    (response x limits hs) (eligible x) hp hpone had
  have hm : (sample (ConcurrentBatch.initial seed) (batch x (live_nonempty x hs))).map
      (fun draw => decide ((sourceInstance x hx).covered
        (Disintegration.retained (sourceInstance x hx) x.system.rho
          (Disintegration.history (response x limits hs) (eligible x).length draw)) =
          (sourceInstance x hx).ground ∧
        (sourceInstance x hx).cost (Disintegration.retained (sourceInstance x hx) x.system.rho
          (Disintegration.history (response x limits hs) (eligible x).length draw)) ≤
            (x.system.rho : ℝ) * ∑ e ∈ (sourceInstance x hx).ground, (sourceInstance x hx).dual e)) true ≤
      (((NativeUnboundedExecution.terminal controller.program (environment limits sample)
        ⟨controller.program.initialConfig (encoding x), ⟨ConcurrentBatch.initial seed, []⟩⟩).map
          (Option.map (NativeReplyContext.observe controller.context))).map
            (certified x hx limits.deadline)) true := by
    rw [source_law x limits sample seed hs hd ht, PMF.map_comp]
    apply PMF.map_true_mono
    intro draw _ hgood
    have hc := (of_decide_eq_true hgood).1
    have hlen : (eligible x).length = (GreedyNative.labels x.planner).length := List.length_map _
    rw [hlen] at hc
    have hc' := retained_complete x hx limits hs draw hc
    have hr := completed_decodes x (replyOf (receipt x limits hs draw)) hc'
      (⟨ConcurrentBatch.initial seed, []⟩ : Memory Unit _) (commit (ConcurrentBatch.initial seed)
        (receipt x limits hs draw) draw.2)
    have hcert := completed_certificate x (replyOf (receipt x limits hs draw)).word hx hc'
    simp only [Function.comp_def, certified, Option.any_some]
    dsimp only [receipt, responseInput, Packets.assemble] at hr hcert
    rw [hr]
    simp only [Option.any_some, decide_eq_true_eq]
    refine ⟨hcert.1, hcert.2, ?_⟩
    simpa only [finished, Memory.record, elapsed, List.map_cons, List.map_nil, List.sum_cons,
      List.sum_nil, add_zero, replyOf] using
      observe_duration_le limits limits.deadline (batch x (live_nonempty x hs)) draw.1
  exact h.trans ((ENNReal.toReal_le_toReal (by exact PMF.apply_ne_top _ _)
    (by exact PMF.apply_ne_top _ _)).mpr hm)

end Cslib.Probability.StochasticOracle.PartialCover.NativeExecution
