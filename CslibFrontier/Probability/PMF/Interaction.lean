module
-- upstream: candidate

public import CslibFrontier.Probability.Conditioning
import CslibFrontier.Probability.PMF.Bind
import CslibFrontier.Probability.PMF.Map
import Mathlib.Tactic

/-!
# Private-state filtering across a query and response

A policy privately samples a query, then an independently initialized source
responds to that query. The complete query/reply observation separates the two
remaining private states: their posterior is the product of the policy posterior
at the query and the source posterior at the reply. In particular, the latter
does not depend on how the policy sampled that query.

The reply alphabet must include everything the policy observes, including resource
metadata. This is a one-interaction filtering step; a multi-turn or native
application must establish the product invariant at each reached prefix.

## Main definitions

* `queryResponse`: actual joint query/reply and remaining private-state law.

## Main results

* `queryResponse_disintegrate`: explicit independent conditional private states.
* `conditionalSnd_queryResponse`: posterior factorization at a supported observation.
* `conditionalSnd_queryResponse_source`: policy-independent remaining source law.
* `conditionalSnd_queryResponse_update`: product preservation after local random processing.
-/

public section
noncomputable section
namespace Cslib.Probability.PMF
variable {A B C S : Type*}

/-- Sample a query together with policy-private state, then the source's complete
reply together with source-private state. The source kernel sees only the query. -/
@[expose] def queryResponse (policy : PMF (A × C)) (source : A → PMF (B × S)) :
    PMF ((A × B) × (C × S)) :=
  policy.bind fun ac => (source ac.1).map fun bs => ((ac.1, bs.1), (ac.2, bs.2))

/-- The actual interaction law can be generated by the query/reply marginal,
followed by independent policy and source posteriors. -/
theorem queryResponse_disintegrate (policy : PMF (A × C)) (source : A → PMF (B × S)) :
    queryResponse policy source =
      ((policy.map Prod.fst).bind fun a => ((source a).map Prod.fst).map (a, ·)).bind
        (fun ab => ((conditionalSnd policy ab.1).bind fun c =>
          (conditionalSnd (source ab.1) ab.2).map (c, ·)).map (ab, ·)) := by
  conv_lhs => rw [queryResponse, ← bind_conditionalSnd policy]
  simp only [PMF.bind_bind, PMF.bind_map, Function.comp_def]
  apply PMF.bind_congr_on_support
  intro ac _
  have he := bind_conditionalSnd (source ac.1)
  conv_lhs => arg 2; ext c; rw [← he]
  simp only [PMF.map_bind, PMF.bind_map, PMF.map_comp, Function.comp_def]
  exact PMF.bind_comm _ _ _

/-- Complete observed query/reply marginal of the actual joint interaction. -/
theorem map_fst_queryResponse (policy : PMF (A × C)) (source : A → PMF (B × S)) :
    (queryResponse policy source).map Prod.fst =
      (policy.map Prod.fst).bind fun a => ((source a).map Prod.fst).map (a, ·) := by
  rw [queryResponse_disintegrate, map_fst_bind_pair]

/-- At a supported complete observation, the source posterior is independent of
policy-private query sampling. Both remaining private states are retained. -/
theorem conditionalSnd_queryResponse (policy : PMF (A × C)) (source : A → PMF (B × S))
    (a : A) (b : B)
    (h : (a, b) ∈ ((queryResponse policy source).map Prod.fst).support) :
    conditionalSnd (queryResponse policy source) (a, b) =
      (conditionalSnd policy a).bind fun c => (conditionalSnd (source a) b).map (c, ·) := by
  rw [map_fst_queryResponse] at h
  rw [queryResponse_disintegrate]
  exact conditionalSnd_bind_pair _ _ (a, b) h

/-- The remaining source state depends on the observed query/reply and source law,
not on the policy's private query sampler. -/
theorem conditionalSnd_queryResponse_source (policy : PMF (A × C))
    (source : A → PMF (B × S)) (a : A) (b : B)
    (h : (a, b) ∈ ((queryResponse policy source).map Prod.fst).support) :
    (conditionalSnd (queryResponse policy source) (a, b)).map Prod.snd =
      conditionalSnd (source a) b := by
  rw [conditionalSnd_queryResponse policy source a b h, PMF.map_bind]
  simp only [PMF.map_comp, Function.comp_def, PMF.bind_const]
  exact PMF.map_id _

/-- Local randomized processing of a complete reply preserves the conditional
product of policy-private and source-private states. This is the invariant needed
before another separated query/response step. -/
theorem conditionalSnd_queryResponse_update {D : Type*} (policy : PMF (A × C))
    (source : A → PMF (B × S)) (update : A → B → C → PMF D) (a : A) (b : B)
    (h : (a, b) ∈ ((queryResponse policy source).map Prod.fst).support) :
    conditionalSnd ((queryResponse policy source).bind
      fun ⟨⟨query, reply⟩, ⟨localState, sourceState⟩⟩ =>
        (update query reply localState).map fun next => ((query, reply), (next, sourceState)))
      (a, b) =
      ((conditionalSnd policy a).bind (update a b)).bind fun d =>
        (conditionalSnd (source a) b).map (d, ·) := by
  have he : (queryResponse policy source).bind
      (fun ⟨⟨query, reply⟩, ⟨localState, sourceState⟩⟩ =>
        (update query reply localState).map fun next => ((query, reply), (next, sourceState))) =
      ((policy.map Prod.fst).bind fun a => ((source a).map Prod.fst).map (a, ·)).bind
        (fun ab => (((conditionalSnd policy ab.1).bind (update ab.1 ab.2)).bind fun d =>
          (conditionalSnd (source ab.1) ab.2).map (d, ·)).map (ab, ·)) := by
    rw [queryResponse_disintegrate]
    simp only [PMF.bind_bind, PMF.bind_map, PMF.map_bind, PMF.map_comp, Function.comp_def]
    apply PMF.bind_congr_on_support
    intro ac _
    apply PMF.bind_congr_on_support
    intro bs _
    apply PMF.bind_congr_on_support
    intro c _
    exact PMF.bind_comm _ _ _
  rw [he]
  apply conditionalSnd_bind_pair
  rwa [map_fst_queryResponse] at h

end Cslib.Probability.PMF
