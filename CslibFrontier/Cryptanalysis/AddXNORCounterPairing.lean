/-!
# Executable pairing of reachable-state counter pulls

Emit both counter relocations, tagging their destination keys by `2*state+side`.
One radix sort puts the two counters for each state next to each other. The
small-state adjacent-payload writer then supplies the approved binary adder.
There is no semantic `List.zip` or table lookup in this execution route.

These are the pull/pair/add stages of [WangLvShenZhang2027], Lemma 8, PDF pp. 21–22.
Complete table initialization, numeric-key restoration, operand iteration/reuse and readback remain
necessary for the full reachable-state DP and faster all-count prepass.

## Main results

* `pairs_table`: actual pairing of both recursive pulls, in numeric state order.
* `layer_table`: both directions give the actual native counter update.
* `layer_computable`, `source_certificate`: uniform per-width and original-counter bit resources.
-/

public section
namespace Cslib.Cryptanalysis.AddXNOR.CounterPairing
open Turing.MultiTapeTM Cslib.GenericRAM

/-- Unary word width, binary operand and inverse-direction bit. -/
abbrev Parameters := (ℕ × ℕ) × Bool

/-- Frame the width before the binary operand, then frame that pair before the direction bit. -/
abbrev parameterEncoding : Parameters ↪ List Bool := encPair (encPair encUnary encNat) encBool

/-- Scalar header followed by the complete state/counter records. -/
abbrev Input := Parameters × List (ℕ × ℕ)

/-- Frame the scalar header before the ordinary framed binary state/counter list. -/
abbrev encoding : Input ↪ List Bool := encPair parameterEncoding encNatPairList

/-- A side bit in the destination key makes alignment independent of equal counter values. -/
def tag (side : Bool) (row : ℕ × ℕ) : ℕ × ℕ :=
  let (key, value) := row
  (2*key+side.toNat, value)

/-- One original step permutation, with its destination-side label generated by the program. -/
def record (parameters : Parameters) (side : Bool) (row : ℕ × ℕ) : ℕ × ℕ :=
  let ((width, operand), inverse) := parameters
  let (state, counter) := row
  tag side (CounterPull.image ((width, operand), (inverse, side)) state, counter)

/-- Both branches are emitted in one input scan; no growing table is a callback parameter. -/
def mapped (input : Input) : List (ℕ × ℕ) :=
  let (parameters, rows) := input
  rows.flatMap fun row => [record parameters false row, record parameters true row]

/-- One runtime-width radix sort aligns both counters of each complete-table state. -/
def sorted (input : Input) : List (ℕ × ℕ) :=
  let (((width, _), _), _) := input
  RadixSort.sort (width+1, mapped input)

/-- Actual small-state pairing, before the binary addition pass. -/
def pairs (input : Input) : List (ℕ × ℕ) := AdjacentPairs.run (sorted input)

/-- The installed pull/pair/add route. Its output retains every state, including zero counters. -/
def layer (input : Input) : List ℕ := BinaryPairSums.run (pairs input)

private def canonical {m : ℕ} (left right : BitVec m → ℕ) : List (ℕ × ℕ) :=
  (List.finRange (2^m)).flatMap fun i =>
    [(2*i.val, left (BitVec.ofFin i)), (2*i.val+1, right (BitVec.ofFin i))]

private theorem canonical_sorted {m : ℕ} (left right : BitVec m → ℕ) :
    (canonical left right).Pairwise (fun a b => a.1 ≤ b.1) := by
  apply List.pairwise_flatMap.mpr
  constructor
  · intro i _
    simp
  · have base : (List.finRange (2^m)).Pairwise (fun i j => i.val < j.val) := by
      rw [← List.ofFn_id]
      exact List.pairwise_ofFn.mpr (fun _ _ h => h)
    apply base.imp
    intro i j hij x hx y hy
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hx hy
    rcases hx with rfl | rfl <;> rcases hy with rfl | rfl <;> dsimp only <;> omega

private theorem canonical_key {m : ℕ} (left right : BitVec m → ℕ) (x y : ℕ × ℕ)
    (hx : x ∈ canonical left right) (hy : y ∈ canonical left right) (hk : x.1 = y.1) : x = y := by
  obtain ⟨i, _, hi⟩ := List.mem_flatMap.mp hx
  obtain ⟨j, _, hj⟩ := List.mem_flatMap.mp hy
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hi hj
  rcases hi with rfl | rfl <;> rcases hj with rfl | rfl <;>
    dsimp only at hk
  · have he : i = j := Fin.ext (by omega)
    subst j
    rfl
  · omega
  · omega
  · have he : i = j := Fin.ext (by omega)
    subst j
    rfl

private theorem sorted_table {m : ℕ} (table : WordTable ℕ m) (a : BitVec m) (inverse : Bool) :
    sorted (((m, a.toNat), inverse), CounterPull.graph table.read) =
      canonical (CounterPull.pulled table inverse false a).read
        (CounterPull.pulled table inverse true a).read := by
  let input : Input := (((m, a.toNat), inverse), CounterPull.graph table.read)
  have branch (side : Bool) :
      ((CounterPull.graph table.read).map (record input.1 side)).Perm
        ((CounterPull.graph (CounterPull.pulled table inverse side a).read).map (tag side)) := by
    have p := (RadixSort.prefix_invariants
      (CounterPull.mapped (((m, a.toNat), (inverse, side)), CounterPull.graph table.read)) m).2
    have h := (p.symm.trans (CounterPull.run_table table inverse side a)).map (tag side)
    simp only [CounterPull.mapped, List.map_map, Function.comp_def] at h
    convert h using 1
    apply congrArg (fun f => (CounterPull.graph table.read).map f)
    funext ⟨key, value⟩
    rfl
  have raw : (mapped input).Perm
      (canonical (CounterPull.pulled table inverse false a).read
        (CounterPull.pulled table inverse true a).read) := by
    have separate := (List.map_append_flatMap_perm (CounterPull.graph table.read)
      (record input.1 false) (fun row => [record input.1 true row])).symm
    have together := (branch false).append (branch true)
    have join := List.map_append_flatMap_perm (List.finRange (2^m))
      (fun i => tag false (i.val, (CounterPull.pulled table inverse false a).read (BitVec.ofFin i)))
      (fun i => [tag true (i.val, (CounterPull.pulled table inverse true a).read (BitVec.ofFin i))])
    have split : (mapped input).Perm
        ((CounterPull.graph table.read).map (record input.1 false) ++
          (CounterPull.graph table.read).map (record input.1 true)) := by
      simpa only [mapped, List.map_eq_flatMap] using separate
    exact split.trans (together.trans (by
      simpa only [CounterPull.graph, List.ofFn_eq_map, List.map_map,
        Function.comp_def, ← List.map_eq_flatMap, canonical, tag,
        Bool.toNat_false, Bool.toNat_true, Nat.add_zero]
        using join))
  have fits : ∀ row ∈ mapped input, row.1 < 2^(m+1) := by
    intro row hr
    obtain ⟨r, _, hr⟩ := List.mem_flatMap.mp hr
    have lo := CounterPull.image_lt ((m, a.toNat), (inverse, false)) r.1
    have hi := CounterPull.image_lt ((m, a.toNat), (inverse, true)) r.1
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
    rcases hr with rfl | rfl <;>
      simp only [record, tag, Bool.toNat_false, Bool.toNat_true, CounterPull.wordWidth,
        Nat.pow_succ] at * <;> dsimp only [input] at * <;> omega
  have hs := RadixSort.correct (m+1, mapped input) fits
  have perm := hs.1.trans raw
  exact perm.eq_of_pairwise
    (fun x y hx hy hxy hyx => canonical_key _ _ x y (perm.subset hx) hy
      (Nat.le_antisymm hxy hyx)) hs.2 (canonical_sorted _ _)

/-- Efficient machine pairing gives the two native preimage counters for every actual state. -/
theorem pairs_table {m : ℕ} (table : WordTable ℕ m) (a : BitVec m) (inverse : Bool) :
    pairs (((m, a.toNat), inverse), CounterPull.graph table.read) =
      List.ofFn (fun i : Fin (2^m) =>
        ((CounterPull.pulled table inverse false a).read (BitVec.ofFin i),
          (CounterPull.pulled table inverse true a).read (BitVec.ofFin i))) := by
  rw [pairs, sorted_table, canonical, AdjacentPairs.run_flatMap, List.ofFn_eq_map]

/-- The executed composition gives the next native counter table in either chain direction.
No correctness, witness, execution or resource conclusion is a premise. -/
theorem layer_table {m : ℕ} (table : WordTable ℕ m) (a : BitVec m) (inverse : Bool) :
    layer (((m, a.toNat), inverse), CounterPull.graph table.read) =
      (CounterPull.graph (if inverse then (WordTable.countBackAdvance (stateKey a) table).ret
        else (WordTable.countAdvance (stateKey a) table).ret).read).map Prod.snd := by
  rw [layer, pairs_table]
  simp only [BinaryPairSums.run, CounterPull.graph, List.map_ofFn]
  apply congrArg List.ofFn
  funext i
  dsimp only [Function.comp_def]
  rw [CounterPull.pulled_read, CounterPull.pulled_read]
  cases inverse <;> simp [CounterPull.wordImage, WordTable.countAdvance_read,
    WordTable.countBackAdvance_read]

/-- Header plus maximum original key/counter wire, independent of complete table volume. -/
def width (input : Input) : ℕ :=
  let (parameters, rows) := input
  (parameterEncoding parameters).length+streamRecordLength (encPair encNat encNat) rows+1

private theorem emit_polyTime : ComputableInPolyTime
    (fun q : Parameters × (ℕ × ℕ) => [record q.1 false q.2, record q.1 true q.2])
    (encPair parameterEncoding (encPair encNat encNat)) encNatPairList := by
  let input := encPair parameterEncoding (encPair encNat encNat)
  have branch (side : Bool) : ComputableInPolyTime
      (fun q : Parameters × (ℕ × ℕ) => record q.1 side q.2)
      input (encPair encNat encNat) := by
    have arg : ComputableInPolyTime
        (fun q : Parameters × (ℕ × ℕ) => (((q.1.1, (q.1.2, side))), q.2))
        input (encPair CounterPull.parameterEncoding (encPair encNat encNat)) := by fun_prop
    have rel := CounterPull.record_polyTime.comp arg
    have tagged : ComputableInPolyTime (tag side) (encPair encNat encNat)
        (encPair encNat encNat) := by unfold tag; fun_prop
    exact (tagged.comp rel).of_enc_eq (fun _ => rfl)
  have single : ComputableTidilyInPolyTime (fun r : ℕ × ℕ => [r])
      (encPair encNat encNat) encNatPairList := .of_linear (.of_frame (fun _ => by simp))
  have left := single.computableInPolyTime.comp (branch false)
  have right := single.computableInPolyTime.comp (branch true)
  exact ((ComputableTidilyInPolyTime.listAppend (encPair encNat encNat)).comp
    (left.tidy.prod right.tidy)).computableInPolyTime

private theorem mapped_computable : ∃ P : ℕ → ℕ, Cslib.PolynomiallyBounded P ∧ Monotone P ∧
    ComputableInO mapped encoding encNatPairList
      (fun input => (encoding input).length+(input.2.length+1)*P (width input))
      (fun input => (encoding input).length+(input.2.length+1)*P (width input)) := by
  obtain ⟨P, hp, mp, h⟩ := ComputableInO.flatMap_stream emit_polyTime
  exact ⟨P, hp, mp, h.of_enc_eq (fun _ => rfl)⟩

private theorem mapped_length (input : Input) : (mapped input).length = 2*input.2.length := by
  simp [mapped, List.length_flatMap, Nat.mul_comm]

private theorem sort_length (input : Input) :
    (RadixSort.sort (input.1.1.1+1, mapped input)).length = 2*input.2.length :=
  (RadixSort.prefix_invariants (mapped input) (input.1.1.1+1)).2.length_eq.trans
    (mapped_length input)

private theorem record_key_lt (m a : ℕ) (inverse side : Bool) (row : ℕ × ℕ) :
    (record ((m, a), inverse) side row).1 < 2^(m+1) := by
  obtain ⟨key, value⟩ := row
  have h := CounterPull.image_lt ((m, a), (inverse, side)) key
  cases side <;> simp only [record, tag, Bool.toNat_false, Bool.toNat_true,
    CounterPull.wordWidth, Nat.pow_succ] at * <;> omega

/-- The actual uniform pull/pair/add machine has a linear table-volume factor. All mapper,
sorter, small-state pairing and binary-adder temporaries and simultaneous buffers are charged. -/
theorem layer_computable : ∃ P : ℕ → ℕ, Cslib.PolynomiallyBounded P ∧ Monotone P ∧
    ComputableInO layer encoding (encList encNat)
      (fun input => (input.2.length+1)*P (width input))
      (fun input => (input.2.length+1)*P (width input)) := by
  obtain ⟨A, ha, ma, hmap⟩ := mapped_computable
  obtain ⟨R, hr, mr, hsort⟩ := RadixSort.computable
  obtain ⟨D, hd, md, hpair⟩ := AdjacentPairs.run_computable
  obtain ⟨U, hu, mu, hadd⟩ := BinaryPairSums.run_computable
  let P := fun B => 70*B+70+A B+(B+2)*(20*B+20+2*R (6*B+6))+
    2*D (6*B+6)+2*U (20*B+20)
  have hp : Cslib.PolynomiallyBounded P := by dsimp only [P]; fun_prop
  have mp : Monotone P := by
    intro a b hab
    have := ma hab
    have := mr (by omega : 6*a+6 ≤ 6*b+6)
    have := md (by omega : 6*a+6 ≤ 6*b+6)
    have := mu (by omega : 20*a+20 ≤ 20*b+20)
    have product := Nat.mul_le_mul (by omega : a+2 ≤ b+2)
      (by omega : 20*a+20+2*R (6*a+6) ≤ 20*b+20+2*R (6*b+6))
    dsimp only [P]
    omega
  let original : NativeCertificate (id : Input → Input) encoding encoding :=
    .linear (.of_eq (fun _ => rfl))
  have successor := ComputableInO.unarySucc'.comp_linear original.fst.fst.fst.computes
  have prepare := successor.prod hmap
  have sortMachine := hsort.comp prepare
  have pairMachine := hpair.comp sortMachine
  have actual := (hadd.comp pairMachine).of_enc_eq (g := layer) (encC := encList encNat)
    (fun _ => rfl)
  have estimates (input : Input) :
      let (((m, _), _), rows) := input
      let B := width input
      let I := (encoding input).length
      let J := (RadixPartition.inputEncoding (m+1, mapped input)).length
      let C := streamFilterWidth encUnary RadixPartition.recordEncoding (m+1, mapped input)
      let W := streamRecordLength (encPair encNat encNat) (sorted input)+1
      let V := BinaryPairSums.width (pairs input)
      let O := (encNatPairList (pairs input)).length
      I+(I+(rows.length+1)*A B)+(m+2)*(J+(2*rows.length+1)*R C)+
          (2*rows.length+1)*D W+(O+((pairs input).length+1)*U V) ≤ (rows.length+1)*P B ∧
      I+(I+(rows.length+1)*A B)+(J+R C)+
          (2*rows.length+1)*D W+(O+((pairs input).length+1)*U V) ≤ (rows.length+1)*P B := by
    rcases input with ⟨⟨⟨m, a⟩, inverse⟩, rows⟩
    let input : Input := (((m, a), inverse), rows)
    let B := width input
    let N := rows.length+1
    let J := (RadixPartition.inputEncoding (m+1, mapped input)).length
    let C := streamFilterWidth encUnary RadixPartition.recordEncoding (m+1, mapped input)
    let W := streamRecordLength (encPair encNat encNat) (sorted input)+1
    let V := BinaryPairSums.width (pairs input)
    let O := (encNatPairList (pairs input)).length
    have mB : m ≤ B := by
      dsimp only [B, width, input, parameterEncoding]
      simp only [length_encPair, encUnary_apply, encBool_apply,
        List.length_replicate, List.length_singleton]
      omega
    have old (r : ℕ × ℕ) (h : r ∈ rows) : (encPair encNat encNat r).length ≤ B := by
      have := le_listMax (f := fun r => (encPair encNat encNat r).length) h
      change (encPair encNat encNat r).length ≤
        streamRecordLength (encPair encNat encNat) rows at this
      dsimp only [B, width, input]
      omega
    have rowBound : ∀ r ∈ mapped input, (encPair encNat encNat r).length ≤ 4*B+4 := by
      intro r hr
      obtain ⟨row, hrow, hr⟩ := List.mem_flatMap.mp hr
      have payload := old row hrow
      simp only [length_encPair] at payload
      have bound (side : Bool) :
          (encPair encNat encNat (record input.1 side row)).length ≤ 4*B+4 := by
        have hk := length_encNat_le_of_lt_two_pow (record_key_lt m a inverse side row)
        rcases row with ⟨key, value⟩
        dsimp only at payload
        simp only [record, tag] at hk ⊢
        rw [length_encPair]
        change 2*(encNat (2*CounterPull.image ((m, a), (inverse, side)) key+side.toNat)).length+
          1+(encNat value).length ≤ _
        omega
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
      rcases hr with rfl | rfl
      · exact bound false
      · exact bound true
    have sortedLength : (sorted input).length = 2*rows.length := by
      exact (RadixSort.prefix_invariants (mapped input) (m+1)).2.length_eq.trans
        (mapped_length input)
    have sortedBound : ∀ r ∈ sorted input, (encPair encNat encNat r).length ≤ 4*B+4 := by
      intro r hr
      exact rowBound r ((RadixSort.prefix_invariants (mapped input) (m+1)).2.mem_iff.mp hr)
    have pairLength : (pairs input).length ≤ 2*rows.length :=
      (AdjacentPairs.length_le _).trans_eq sortedLength
    have pairBound := AdjacentPairs.record_bound (sorted input) (4*B+4) sortedBound
    have pairWidth : V ≤ 20*B+20 := by
      have max := listMax_le pairBound
      change streamRecordLength (encPair encNat encNat) (pairs input) ≤ 3*(4*B+4)+1 at max
      dsimp only [V, BinaryPairSums.width]
      omega
    have wBound : W ≤ 6*B+6 := by
      have := listMax_le sortedBound
      change streamRecordLength (encPair encNat encNat) (sorted input) ≤ 4*B+4 at this
      dsimp only [W]
      omega
    have cBound : C ≤ 6*B+6 := by
      have := listMax_le rowBound
      change streamRecordLength RadixPartition.recordEncoding (mapped input) ≤ 4*B+4 at this
      dsimp only [C, streamFilterWidth]
      simp only [encUnary_apply, List.length_replicate]
      omega
    have iBound : (encoding input).length ≤ N*(3*B+3) := by
      have hl := length_encList_le (encPair encNat encNat) rows old
      have hs : (parameterEncoding input.1).length ≤ B := by dsimp only [B, width]; omega
      change (encNatPairList rows).length ≤ rows.length*(2*B+1) at hl
      change (encPair parameterEncoding encNatPairList input).length ≤ _
      rw [length_encPair]
      dsimp only [N]
      change 2*(parameterEncoding input.1).length+1+(encNatPairList rows).length ≤ _
      nlinarith
    have jBound : J ≤ N*(20*B+20) := by
      have h := length_encList_le (encPair encNat encNat) (mapped input) rowBound
      change (encList RadixPartition.recordEncoding (mapped input)).length ≤
        (mapped input).length*(2*(4*B+4)+1) at h
      rw [mapped_length] at h
      dsimp only [J, RadixPartition.inputEncoding]
      rw [length_encPair]
      simp only [encUnary_apply, List.length_replicate]
      dsimp only [N, input] at *
      nlinarith only [h, mB]
    have oBound : O ≤ N*(60*B+60) := by
      have h := length_encList_le (encPair encNat encNat) (pairs input) pairBound
      change O ≤ (pairs input).length*(2*(3*(4*B+4)+1)+1) at h
      have scaled := Nat.mul_le_mul_right (2*(3*(4*B+4)+1)+1) pairLength
      dsimp only [N]
      nlinarith only [h, scaled]
    have sortTime : (m+2)*(J+(2*rows.length+1)*R C) ≤
        N*((B+2)*(20*B+20+2*R (6*B+6))) := by
      have r := Nat.mul_le_mul (by dsimp only [N]; omega : 2*rows.length+1 ≤ 2*N) (mr cBound)
      calc
        _ ≤ (B+2)*(N*(20*B+20)+(2*N)*R (6*B+6)) :=
          Nat.mul_le_mul (by omega) (Nat.add_le_add jBound r)
        _ = _ := by ring
    have pairTime := Nat.mul_le_mul
      (by dsimp only [N]; omega : 2*rows.length+1 ≤ 2*N) (md wBound)
    have addTime := Nat.mul_le_mul
      (by dsimp only [N]; omega : (pairs input).length+1 ≤ 2*N) (mu pairWidth)
    have setup := Nat.add_le_add
      (Nat.add_le_add iBound iBound) (le_refl (N*A B))
    have timeBound : (encoding input).length+((encoding input).length+N*A B)+
        (m+2)*(J+(2*rows.length+1)*R C)+(2*rows.length+1)*D W+
        (O+((pairs input).length+1)*U V) ≤ N*P B := by
      dsimp only [P]
      nlinarith only [setup, sortTime, pairTime, addTime, oBound,
        Nat.zero_le (N*B), Nat.zero_le N]
    have sortSpace : J+R C ≤ (m+2)*(J+(2*rows.length+1)*R C) := by
      nlinarith [Nat.zero_le (m*(J+(2*rows.length+1)*R C))]
    refine ⟨timeBound, ?_⟩
    exact (Nat.add_le_add_right (Nat.add_le_add_right
      (Nat.add_le_add_left sortSpace ((encoding input).length+((encoding input).length+N*A B)))
      ((2*rows.length+1)*D W)) (O+((pairs input).length+1)*U V)).trans timeBound
  refine ⟨P, hp, mp, actual.mono_le (fun input => ?_) (fun input => ?_)⟩
  · simpa only [NativeCertificate.fst_time, original, NativeCertificate.linear_time,
      id_eq, Function.comp_def, sorted, sort_length, mapped_length, pairs, Nat.add_assoc]
      using (estimates input).1
  · simpa only [NativeCertificate.fst_space, original, NativeCertificate.linear_space,
      id_eq, Function.comp_def, sorted, sort_length, mapped_length, pairs, Nat.add_assoc]
      using (estimates input).2

/-- The complete encoded pull/pair/add pass has source-derived bounds in both directions.
The exponential factor is the number of states; every counter's width follows from the
original operator count. Table initialization, indexing for reuse and the full DP loop remain
outside this single-pass certificate. -/
theorem source_certificate : ∃ P : ℕ → ℕ, Cslib.PolynomiallyBounded P ∧ Monotone P ∧
    ∃ c : NativeCertificate layer encoding (encList encNat),
      ∀ m q (as : Fin q → BitVec m) (s a : BitVec m) (inverse : Bool),
        c.time (((m, a.toNat), inverse), CounterPull.graph
          (WordTable.classCounters (List.ofFn as) s).read) ≤ 2^m*P (m+q+1) ∧
        c.space (((m, a.toNat), inverse), CounterPull.graph
          (WordTable.classCounters (List.ofFn as) s).read) ≤ 2^m*P (m+q+1) ∧
        c.time (((m, a.toNat), inverse), CounterPull.graph
          (WordTable.backwardCounters (List.ofFn as) s).read) ≤ 2^m*P (m+q+1) ∧
        c.space (((m, a.toNat), inverse), CounterPull.graph
          (WordTable.backwardCounters (List.ofFn as) s).read) ≤ 2^m*P (m+q+1) := by
  obtain ⟨P, hp, mp, hc⟩ := layer_computable
  let resource := fun input : Input => (input.2.length+1)*P (width input)
  let c : NativeCertificate layer encoding (encList encNat) := ⟨resource, resource, hc⟩
  let Q := fun B => 2*P (10*(B+1))
  have hQ : Cslib.PolynomiallyBounded Q := by dsimp only [Q]; fun_prop
  have mQ : Monotone Q := fun _ _ h => Nat.mul_le_mul_left 2 (mp (by omega))
  have cost {m q : ℕ} (f : BitVec m → ℕ) (bound : ∀ s, Nat.size (f s) ≤ q+1)
      (a : BitVec m) (inverse : Bool) :
      resource (((m, a.toNat), inverse), CounterPull.graph f) ≤ 2^m*Q (m+q+1) := by
    have larger : width (((m, a.toNat), inverse), CounterPull.graph f) ≤
        CounterPull.width (((m, a.toNat), (inverse, false)), CounterPull.graph f) := by
      dsimp only [width, parameterEncoding, CounterPull.width, CounterPull.parameterEncoding]
      simp only [length_encPair, encBool_apply, List.length_singleton]
      omega
    have hw := larger.trans (CounterPull.graph_width f bound a inverse false)
    have ht := Nat.mul_le_mul_left (2^m+1) (mp hw)
    dsimp only [resource, Q]
    rw [CounterPull.graph_length]
    have he : m+(q+1)+1 = (m+q+1)+1 := by omega
    rw [he] at ht
    nlinarith only [ht, Nat.two_pow_pos m]
  refine ⟨Q, hQ, mQ, c, fun m q as s a inverse => ?_⟩
  have hf := cost _ (WordTable.classCounters_size_le as s) a inverse
  have hb := cost _ (WordTable.backwardCounters_size_le as s) a inverse
  exact ⟨hf, hf, hb, hb⟩

end Cslib.Cryptanalysis.AddXNOR.CounterPairing
