/-!
# The Boolean-cube quotient of multivariate polynomials

Over any commutative ring `R`, the **Boolean ideal** `Cslib.BitString.boolIdeal ι R` is the ideal
of `MvPolynomial ι R` generated by `X i ^ 2 - X i` for `i : ι`. Evaluating a polynomial at the
`0`/`1` points `Cslib.BitString.bitPoint x` (`x : ι → Bool`) defines an `R`-algebra homomorphism
`Cslib.BitString.evalCubeHom ι R : MvPolynomial ι R →ₐ[R] ((ι → Bool) → R)` containing
`boolIdeal ι R` in its kernel.

Reducing powers `X i ^ 2 ↦ X i` modulo `boolIdeal ι R` puts every polynomial in the same coset as
a multilinear polynomial in `MvPolynomial.restrictDegree ι R 1`, and a multilinear polynomial
vanishing at every `0`/`1` point vanishes identically (even over an arbitrary commutative ring and
an arbitrary index type `ι`, by subset-size induction on its monomials). Consequently:

* `Cslib.BitString.ker_evalCubeHom`: `RingHom.ker (evalCubeHom ι R) = boolIdeal ι R`.
* `Cslib.BitString.boolIdeal_isRadical`: `boolIdeal ι R` is radical whenever `R` is reduced.
* `Cslib.BitString.existsUnique_mem_restrictDegree_sub_mem_boolIdeal`: every polynomial has a
  unique multilinear representative modulo `boolIdeal ι R`.
* When `ι` is finite:
  * `Cslib.BitString.boolQuotientAlgEquiv`:
    `(MvPolynomial ι R ⧸ boolIdeal ι R) ≃ₐ[R] ((ι → Bool) → R)`.
  * `Cslib.BitString.eq_multilinearExtension_of_mem_restrictDegree`: the unique multilinear
    representative is `Cslib.BitString.multilinearExtension (fun x => eval (bitPoint x) p)`.
  * Over a field `K`, the quotient has `K`-dimension `2 ^ Fintype.card ι`.

## Main definitions

* `Cslib.BitString.boolIdeal`: the ideal generated by `X i ^ 2 - X i`.
* `Cslib.BitString.evalCubeHom`: evaluation on `{0, 1} ^ ι` as an `R`-algebra homomorphism.
* `Cslib.BitString.boolQuotientAlgEquiv`: the `R`-algebra isomorphism
  `(MvPolynomial ι R ⧸ boolIdeal ι R) ≃ₐ[R] ((ι → Bool) → R)`.
* `Cslib.BitString.restrictDegreeOneLinearEquiv`,
  `Cslib.BitString.restrictDegreeOneQuotientEquiv`,
  `Cslib.BitString.restrictDegreeOneLinearEquiv_apply`,
  `Cslib.BitString.coe_restrictDegreeOneLinearEquiv_symm`,
  `Cslib.BitString.restrictDegreeOneQuotientEquiv_apply`,
  `Cslib.BitString.eval_coe_restrictDegreeOneQuotientEquiv_symm`,
  `Cslib.BitString.coe_restrictDegreeOneQuotientEquiv_symm_mk`:
  `R`-linear equivalences between multilinear polynomials, functions on the cube, and the Boolean
  quotient, with their evaluation and inverse lemmas.

## Main results

* `Cslib.BitString.exists_mem_restrictDegree_sub_mem_boolIdeal`,
  `Cslib.BitString.existsUnique_mem_restrictDegree_sub_mem_boolIdeal`: existence and uniqueness of
  multilinear representatives modulo `boolIdeal ι R`.
* `Cslib.BitString.eq_zero_of_mem_restrictDegree_of_forall_eval_bitPoint`,
  `Cslib.BitString.eq_of_mem_restrictDegree_of_forall_eval_bitPoint`: multilinear uniqueness over
  any commutative ring.
* `Cslib.BitString.ker_evalCubeHom`, `Cslib.BitString.mem_boolIdeal_iff_forall_eval_bitPoint`,
  `Cslib.BitString.mem_boolIdeal_iff_forall_eval_zero_one`,
  `Cslib.BitString.boolIdeal_isRadical`: vanishing-ideal characterization and radicality.
* `Cslib.BitString.finrank_boolQuotient`, `Cslib.BitString.finrank_restrictDegree_one`:
  `K`-dimension `2 ^ Fintype.card ι` over a field `K`.
-/

public section

namespace Cslib.BitString

open MvPolynomial Finset

section Basic

variable (ι R : Type*) [CommRing R]

/-- The ideal of `MvPolynomial ι R` generated by the Boolean relations `X i ^ 2 - X i`. -/
@[expose] noncomputable def boolIdeal : Ideal (MvPolynomial ι R) :=
  Ideal.span (Set.range fun i : ι => (X i ^ 2 - X i : MvPolynomial ι R))

/-- Each Boolean generator `X i ^ 2 - X i` belongs to `boolIdeal ι R`. -/
theorem X_sq_sub_X_mem_boolIdeal (i : ι) : (X i ^ 2 - X i : MvPolynomial ι R) ∈ boolIdeal ι R :=
  Ideal.subset_span ⟨i, rfl⟩

/-- Evaluation on the Boolean cube `{0, 1} ^ ι` as an `R`-algebra homomorphism. -/
@[expose] noncomputable def evalCubeHom : MvPolynomial ι R →ₐ[R] ((ι → Bool) → R) :=
  MvPolynomial.aeval fun i (x : ι → Bool) => bitVal R (x i)

variable {ι R}

/-- Pointwise evaluation of `evalCubeHom` agrees with `MvPolynomial.eval` at `bitPoint x`. -/
@[simp] theorem evalCubeHom_apply (p : MvPolynomial ι R) (x : ι → Bool) :
    evalCubeHom ι R p x = eval (bitPoint x) p := by
  induction p using MvPolynomial.induction_on with
  | C r =>
    simp only [evalCubeHom, algHom_C, Algebra.algebraMap_eq_smul_one, Pi.smul_apply,
      Pi.one_apply, smul_eq_mul, mul_one, eval_C]
  | add p q hp hq => simp only [map_add, Pi.add_apply, hp, hq]
  | mul_X p i hp =>
    rw [map_mul, Pi.mul_apply, hp, map_mul, eval_X, evalCubeHom, aeval_X, bitPoint]

/-- Every generator `X i ^ 2 - X i` vanishes on the Boolean cube. -/
theorem boolIdeal_le_ker_evalCubeHom : boolIdeal ι R ≤ RingHom.ker (evalCubeHom ι R) := by
  refine Ideal.span_le.mpr ?_
  rintro _ ⟨i, rfl⟩
  rw [SetLike.mem_coe, RingHom.mem_ker]
  funext x
  simp only [Pi.zero_apply, map_sub, map_pow, evalCubeHom_apply, eval_X, bitPoint,
    bitVal_pow _ two_ne_zero, sub_self]

/-- Reducing a multilinear polynomial multiplied by `X i` by capping the exponent of `i` at `1`. -/
private noncomputable def reduceVar (i : ι) (q : MvPolynomial ι R) :
    MvPolynomial ι R :=
  ∑ s ∈ q.support,
    if s i = 0 then MvPolynomial.monomial (s + Finsupp.single i 1) (q.coeff s)
    else MvPolynomial.monomial s (q.coeff s)

private theorem reduceVar_mem_restrictDegree (i : ι) {q : MvPolynomial ι R}
    (hq : q ∈ restrictDegree ι R 1) : reduceVar i q ∈ restrictDegree ι R 1 := by
  classical
  refine Submodule.sum_mem _ fun s hs => ?_
  have hsle : ∀ j, s j ≤ 1 := (mem_restrictDegree _ _ _).1 hq s hs
  split_ifs with hsi
  · rw [mem_restrictDegree]
    intro t ht j
    obtain rfl := Finset.mem_singleton.1 (support_monomial_subset ht)
    by_cases hj : j = i
    · subst hj
      simp only [Finsupp.add_apply, hsi, Finsupp.single_eq_same, zero_add, le_refl]
    · simp only [Finsupp.add_apply, Finsupp.single_eq_of_ne hj, add_zero]
      exact hsle j
  · rw [mem_restrictDegree]
    intro t ht j
    obtain rfl := Finset.mem_singleton.1 (support_monomial_subset ht)
    exact hsle j

private theorem mul_X_sub_reduceVar_mem_boolIdeal (i : ι)
    {q : MvPolynomial ι R} (hq : q ∈ restrictDegree ι R 1) :
    q * X i - reduceVar i q ∈ boolIdeal ι R := by
  classical
  have hsum : q * X i - reduceVar i q =
      ∑ s ∈ q.support,
        (MvPolynomial.monomial s (q.coeff s) * X i -
          if s i = 0 then MvPolynomial.monomial (s + Finsupp.single i 1) (q.coeff s)
          else MvPolynomial.monomial s (q.coeff s)) := by
    conv_lhs =>
      arg 1
      arg 1
      rw [q.as_sum]
    rw [Finset.sum_mul]
    simp only [reduceVar, Finset.sum_sub_distrib]
  rw [hsum]
  refine Submodule.sum_mem _ fun s hs => ?_
  have hsle : s i ≤ 1 := (mem_restrictDegree _ _ _).1 hq s hs i
  have hX : (X i : MvPolynomial ι R) = MvPolynomial.monomial (Finsupp.single i 1) 1 := rfl
  split_ifs with hsi
  · have hmul : MvPolynomial.monomial s (q.coeff s) * (X i : MvPolynomial ι R) =
        MvPolynomial.monomial (s + Finsupp.single i 1) (q.coeff s) := by
      rw [hX, MvPolynomial.monomial_mul_monomial, mul_one]
    rw [hmul, sub_self]
    exact Ideal.zero_mem _
  · have hsi1 : s i = 1 := by omega
    let s' : ι →₀ ℕ := s - Finsupp.single i 1
    have hs' : s' + Finsupp.single i 1 = s := by
      ext j
      by_cases hj : j = i
      · subst hj
        simp only [s', Finsupp.add_apply, Finsupp.tsub_apply, Finsupp.single_eq_same, hsi1]
      · simp only [s', Finsupp.add_apply, Finsupp.tsub_apply, Finsupp.single_eq_of_ne hj,
          tsub_zero, add_zero]
    have hmul : MvPolynomial.monomial s (q.coeff s) =
        MvPolynomial.monomial s' (q.coeff s) * X i := by
      rw [← hs', hX, MvPolynomial.monomial_mul_monomial, mul_one]
    have hdiff : MvPolynomial.monomial s (q.coeff s) * X i - MvPolynomial.monomial s (q.coeff s) =
        MvPolynomial.monomial s' (q.coeff s) * (X i ^ 2 - X i) := by
      rw [hmul]
      ring
    rw [hdiff]
    exact Ideal.mul_mem_left _ _ (X_sq_sub_X_mem_boolIdeal ι R i)

/-- Every multivariate polynomial is congruent modulo `boolIdeal ι R` to a multilinear polynomial
(of degree at most `1` in every variable). -/
theorem exists_mem_restrictDegree_sub_mem_boolIdeal (p : MvPolynomial ι R) :
    ∃ q ∈ restrictDegree ι R 1, p - q ∈ boolIdeal ι R := by
  classical
  induction p using MvPolynomial.induction_on with
  | C r =>
    refine ⟨C r, ?_, by rw [sub_self]; exact Ideal.zero_mem _⟩
    rw [mem_restrictDegree]
    intro s hs j
    have hs0 : s = 0 := by
      by_contra hne
      apply mem_support_iff.1 hs
      rw [coeff_C, ite_eq_right fun h => hne h.symm]
    subst hs0
    simp only [Finsupp.zero_apply, zero_le]
  | add p₁ p₂ hp₁ hp₂ =>
    obtain ⟨q₁, hq₁, hsub₁⟩ := hp₁
    obtain ⟨q₂, hq₂, hsub₂⟩ := hp₂
    refine ⟨q₁ + q₂, Submodule.add_mem _ hq₁ hq₂, ?_⟩
    rw [show p₁ + p₂ - (q₁ + q₂) = (p₁ - q₁) + (p₂ - q₂) by ring]
    exact Ideal.add_mem _ hsub₁ hsub₂
  | mul_X p i hp =>
    obtain ⟨q, hq, hsub⟩ := hp
    refine ⟨reduceVar i q, reduceVar_mem_restrictDegree i hq, ?_⟩
    rw [show p * X i - reduceVar i q = (p - q) * X i + (q * X i - reduceVar i q) by ring]
    exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hsub) (mul_X_sub_reduceVar_mem_boolIdeal i hq)

private noncomputable def indMon (S : Finset ι) : ι →₀ ℕ :=
  Finsupp.indicator S fun _ _ => 1

private theorem indMon_apply [DecidableEq ι] (S : Finset ι) (i : ι) :
    indMon S i = if i ∈ S then 1 else 0 := by
  classical
  simp only [indMon, Finsupp.indicator_apply]
  split_ifs <;> rfl

private theorem support_indMon (S : Finset ι) : (indMon S).support = S := by
  classical
  ext i
  rw [Finsupp.mem_support_iff, indMon_apply]
  by_cases hi : i ∈ S <;> simp [hi]

private theorem eq_indMon_of_le_one {s : ι →₀ ℕ} (hs : ∀ i, s i ≤ 1) :
    s = indMon s.support := by
  classical
  ext i
  rw [indMon_apply]
  have hi := hs i
  by_cases hmem : i ∈ s.support
  · have hne : s i ≠ 0 := Finsupp.mem_support_iff.1 hmem
    simp only [hmem, ↓reduceIte]
    omega
  · simp only [hmem, ↓reduceIte]
    exact Finsupp.notMem_support_iff.1 hmem

/-- Over **any** commutative ring, a multilinear polynomial that vanishes at every point of the
Boolean cube `{0, 1} ^ ι` is the zero polynomial. -/
theorem eq_zero_of_mem_restrictDegree_of_forall_eval_bitPoint {q : MvPolynomial ι R}
    (hq : q ∈ restrictDegree ι R 1) (heval : ∀ x : ι → Bool, eval (bitPoint x) q = 0) :
    q = 0 := by
  classical
  have hsle : ∀ s ∈ q.support, ∀ i, s i ≤ 1 := (mem_restrictDegree _ _ _).1 hq
  have hcoeff : ∀ n : ℕ, ∀ S : Finset ι, #S = n → q.coeff (indMon S) = 0 := by
    intro n
    induction n using Nat.strong_induction_on with
    | ind n ih =>
      intro S hS
      let xS : ι → Bool := fun i => decide (i ∈ S)
      have h0 := heval xS
      rw [q.as_sum, map_sum] at h0
      have hterm : ∀ s ∈ q.support,
          eval (bitPoint xS) (MvPolynomial.monomial s (q.coeff s)) =
            if s.support ⊆ S then q.coeff s else 0 := fun s hs => by
        rw [eval_monomial, Finsupp.prod]
        split_ifs with hsub
        · have hprod : (∏ i ∈ s.support, bitPoint (R := R) xS i ^ s i) = 1 :=
            Finset.prod_eq_one fun i hi => by
              simp [xS, bitPoint, bitVal, hsub hi]
          rw [hprod, mul_one]
        · obtain ⟨i, hi, hiS⟩ := Finset.not_subset.1 hsub
          have hsi : s i ≠ 0 := Finsupp.mem_support_iff.1 hi
          have hprod : (∏ j ∈ s.support, bitPoint (R := R) xS j ^ s j) = 0 :=
            Finset.prod_eq_zero hi (by simp [xS, bitPoint, bitVal, hiS, hsi])
          rw [hprod, mul_zero]
      have hsum :
          (∑ s ∈ q.support, eval (bitPoint xS) (MvPolynomial.monomial s (q.coeff s))) =
            q.coeff (indMon S) := by
        rw [Finset.sum_congr rfl hterm, Finset.sum_eq_single (indMon S)]
        · simp only [support_indMon, Subset.rfl, ↓reduceIte]
        · intro s hs hne
          split_ifs with hsub
          · have hssub : s.support ⊂ S := Finset.ssubset_iff_subset_ne.2 ⟨hsub, fun heq => by
              apply hne
              rw [eq_indMon_of_le_one (hsle s hs), heq]⟩
            have hlt : #s.support < n := hS ▸ Finset.card_lt_card hssub
            have hz := ih #s.support hlt s.support rfl
            rwa [← eq_indMon_of_le_one (hsle s hs)] at hz
          · rfl
        · intro hnot
          simp only [notMem_support_iff.1 hnot, support_indMon, Subset.rfl, ↓reduceIte]
      exact hsum.symm.trans h0
  rw [q.as_sum]
  refine Finset.sum_eq_zero fun s hs => ?_
  have hzero := hcoeff #s.support s.support rfl
  rw [← eq_indMon_of_le_one (hsle s hs)] at hzero
  rw [hzero, monomial_zero]

/-- Two multilinear polynomials agreeing at every point of `{0, 1} ^ ι` are equal. -/
theorem eq_of_mem_restrictDegree_of_forall_eval_bitPoint {p q : MvPolynomial ι R}
    (hp : p ∈ restrictDegree ι R 1) (hq : q ∈ restrictDegree ι R 1)
    (heval : ∀ x : ι → Bool, eval (bitPoint x) p = eval (bitPoint x) q) : p = q :=
  sub_eq_zero.1 <| eq_zero_of_mem_restrictDegree_of_forall_eval_bitPoint
    (Submodule.sub_mem _ hp hq) fun x => by
      rw [map_sub, heval x, sub_self]

/-- The kernel of evaluation on `{0, 1} ^ ι` is `boolIdeal ι R`. -/
theorem ker_evalCubeHom : RingHom.ker (evalCubeHom ι R) = boolIdeal ι R := by
  refine le_antisymm ?_ boolIdeal_le_ker_evalCubeHom
  intro p hp
  obtain ⟨q, hq, hsub⟩ := exists_mem_restrictDegree_sub_mem_boolIdeal p
  have hqker : q ∈ RingHom.ker (evalCubeHom ι R) := by
    have hpq : p - (p - q) = q := by ring
    rw [← hpq]
    exact Ideal.sub_mem _ hp (boolIdeal_le_ker_evalCubeHom hsub)
  have hq0 : q = 0 := eq_zero_of_mem_restrictDegree_of_forall_eval_bitPoint hq fun x => by
    have hx := congrFun (RingHom.mem_ker.1 hqker) x
    simpa only [evalCubeHom_apply, Pi.zero_apply] using hx
  rw [hq0, sub_zero] at hsub
  exact hsub

/-- A polynomial belongs to `boolIdeal ι R` if and only if it vanishes at every point of
`{0, 1} ^ ι`. -/
theorem mem_boolIdeal_iff_forall_eval_bitPoint {p : MvPolynomial ι R} :
    p ∈ boolIdeal ι R ↔ ∀ x : ι → Bool, eval (bitPoint x) p = 0 := by
  rw [← ker_evalCubeHom, RingHom.mem_ker, funext_iff]
  simp only [evalCubeHom_apply, Pi.zero_apply]

/-- Every polynomial has a unique multilinear representative modulo `boolIdeal ι R`. -/
theorem existsUnique_mem_restrictDegree_sub_mem_boolIdeal (p : MvPolynomial ι R) :
    ∃! q : MvPolynomial ι R, q ∈ restrictDegree ι R 1 ∧ p - q ∈ boolIdeal ι R := by
  obtain ⟨q, hq, hsub⟩ := exists_mem_restrictDegree_sub_mem_boolIdeal p
  refine ⟨q, ⟨hq, hsub⟩, ?_⟩
  rintro q' ⟨hq', hsub'⟩
  refine eq_of_mem_restrictDegree_of_forall_eval_bitPoint hq' hq fun x => ?_
  have h1 := mem_boolIdeal_iff_forall_eval_bitPoint.1 hsub x
  have h2 := mem_boolIdeal_iff_forall_eval_bitPoint.1 hsub' x
  rw [map_sub, sub_eq_zero] at h1 h2
  rw [← h1, h2]

/-- Over a reduced ring (in particular, over any field or integral domain), `boolIdeal ι R` is
radical. -/
theorem boolIdeal_isRadical [IsReduced R] : (boolIdeal ι R).IsRadical := by
  rintro p ⟨n, hn⟩
  rw [mem_boolIdeal_iff_forall_eval_bitPoint] at hn ⊢
  intro x
  have h := hn x
  rw [map_pow] at h
  exact IsNilpotent.eq_zero ⟨n, h⟩

/-- Membership in `boolIdeal ι R` is equivalent to vanishing on `{0, 1} ^ ι ⊆ ι → R`. -/
theorem mem_boolIdeal_iff_forall_eval_zero_one {p : MvPolynomial ι R} :
    p ∈ boolIdeal ι R ↔ ∀ z : ι → R, (∀ i, z i = 0 ∨ z i = 1) → eval z p = 0 := by
  classical
  rw [mem_boolIdeal_iff_forall_eval_bitPoint]
  constructor
  · intro h z hz
    have hzeq : z = bitPoint fun i => decide (z i = 1) := by
      funext i
      by_cases h1 : z i = 1
      · simp [bitPoint, bitVal, h1]
      · rcases hz i with h0 | h1'
        · simp [bitPoint, bitVal, h0]
        · exact False.elim (h1 h1')
    rw [hzeq]
    exact h _
  · intro h x
    exact h (bitPoint x) fun i => by cases hxi : x i <;> simp [bitPoint, bitVal, hxi]

variable (ι R)

private noncomputable def evalCubeQuotHom :
    (MvPolynomial ι R ⧸ boolIdeal ι R) →ₐ[R] ((ι → Bool) → R) where
  toRingHom := Ideal.Quotient.lift (boolIdeal ι R) (evalCubeHom ι R).toRingHom fun _ h =>
    RingHom.mem_ker.1 (boolIdeal_le_ker_evalCubeHom h)
  commutes' r := by
    change Ideal.Quotient.lift (boolIdeal ι R) (evalCubeHom ι R).toRingHom _
      (Ideal.Quotient.mk (boolIdeal ι R) (algebraMap R (MvPolynomial ι R) r)) =
      algebraMap R ((ι → Bool) → R) r
    rw [Ideal.Quotient.lift_mk]
    exact (evalCubeHom ι R).commutes r

variable {ι R}

private theorem evalCubeQuotHom_mk (p : MvPolynomial ι R) :
    evalCubeQuotHom ι R (Ideal.Quotient.mk (boolIdeal ι R) p) = evalCubeHom ι R p := by
  change Ideal.Quotient.lift (boolIdeal ι R) (evalCubeHom ι R).toRingHom _
    (Ideal.Quotient.mk (boolIdeal ι R) p) = evalCubeHom ι R p
  exact Ideal.Quotient.lift_mk _ _ _

end Basic

section Multilinear

variable {ι R : Type*} [CommRing R] [Fintype ι] [DecidableEq ι]

/-- Every polynomial is congruent modulo `boolIdeal ι R` to the multilinear extension of its
values on `{0, 1} ^ ι`. -/
theorem sub_multilinearExtension_mem_boolIdeal (p : MvPolynomial ι R) :
    p - multilinearExtension (fun x => eval (bitPoint x) p) ∈ boolIdeal ι R := by
  rw [mem_boolIdeal_iff_forall_eval_bitPoint]
  intro x
  rw [map_sub, eval_multilinearExtension, sub_self]

/-- A multilinear polynomial equals the multilinear extension of its values on `{0, 1} ^ ι`. -/
theorem eq_multilinearExtension_of_mem_restrictDegree {p : MvPolynomial ι R}
    (hp : p ∈ restrictDegree ι R 1) :
    p = multilinearExtension (fun x => eval (bitPoint x) p) :=
  eq_of_mem_restrictDegree_of_forall_eval_bitPoint hp (multilinearExtension_mem_restrictDegree _)
    fun x => (eval_multilinearExtension (fun y => eval (bitPoint y) p) x).symm

/-- A polynomial has degree at most `1` in each variable if and only if it is a multilinear
extension. -/
theorem mem_restrictDegree_one_iff_eq_multilinearExtension {p : MvPolynomial ι R} :
    p ∈ restrictDegree ι R 1 ↔ ∃ g : (ι → Bool) → R, p = multilinearExtension g :=
  ⟨fun hp => ⟨_, eq_multilinearExtension_of_mem_restrictDegree hp⟩,
    fun ⟨_, h⟩ => h ▸ multilinearExtension_mem_restrictDegree _⟩

end Multilinear

section Finite

variable (ι R : Type*) [CommRing R] [Finite ι]

/-- **The Boolean-cube quotient isomorphism**: over any commutative ring `R`,
`MvPolynomial ι R ⧸ boolIdeal ι R` is `R`-algebra isomorphic to the ring `(ι → Bool) → R` of
functions on the Boolean cube. -/
noncomputable def boolQuotientAlgEquiv :
    (MvPolynomial ι R ⧸ boolIdeal ι R) ≃ₐ[R] ((ι → Bool) → R) :=
  AlgEquiv.ofBijective (evalCubeQuotHom ι R)
    ⟨fun x y hxy => by
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective y
      apply Ideal.Quotient.eq.2
      rw [← ker_evalCubeHom, RingHom.mem_ker, map_sub, sub_eq_zero]
      rwa [evalCubeQuotHom_mk, evalCubeQuotHom_mk] at hxy,
    fun g => by
      classical
      have : Fintype ι := Fintype.ofFinite ι
      refine ⟨Ideal.Quotient.mk (boolIdeal ι R) (multilinearExtension g), ?_⟩
      funext x
      rw [evalCubeQuotHom_mk, evalCubeHom_apply, eval_multilinearExtension]⟩

variable {ι R}

/-- Applying `boolQuotientAlgEquiv` to a coset evaluates a representative on the cube. -/
@[simp] theorem boolQuotientAlgEquiv_mk (p : MvPolynomial ι R) (x : ι → Bool) :
    boolQuotientAlgEquiv ι R (Ideal.Quotient.mk (boolIdeal ι R) p) x = eval (bitPoint x) p := by
  change evalCubeQuotHom ι R (Ideal.Quotient.mk (boolIdeal ι R) p) x = eval (bitPoint x) p
  rw [evalCubeQuotHom_mk, evalCubeHom_apply]

/-- The inverse of `boolQuotientAlgEquiv` sends a function on the cube to the coset of its
multilinear extension. -/
@[simp] theorem boolQuotientAlgEquiv_symm_apply [Fintype ι] [DecidableEq ι] (g : (ι → Bool) → R) :
    (boolQuotientAlgEquiv ι R).symm g =
      Ideal.Quotient.mk (boolIdeal ι R) (multilinearExtension g) := by
  apply (boolQuotientAlgEquiv ι R).injective
  rw [AlgEquiv.apply_symm_apply]
  funext x
  rw [boolQuotientAlgEquiv_mk, eval_multilinearExtension]

variable (ι R)

private noncomputable def cubeExtension (g : (ι → Bool) → R) : MvPolynomial ι R :=
  @multilinearExtension ι R _ (Fintype.ofFinite ι) (Classical.decEq ι) g

private theorem cubeExtension_mem_restrictDegree (g : (ι → Bool) → R) :
    cubeExtension ι R g ∈ restrictDegree ι R 1 :=
  @multilinearExtension_mem_restrictDegree ι R _ (Fintype.ofFinite ι) (Classical.decEq ι) g

private theorem eval_cubeExtension (g : (ι → Bool) → R) (x : ι → Bool) :
    eval (bitPoint x) (cubeExtension ι R g) = g x :=
  @eval_multilinearExtension ι R _ (Fintype.ofFinite ι) (Classical.decEq ι) g x

/-- Over any commutative ring `R`, multilinear polynomials are `R`-linearly equivalent to
functions on the Boolean cube `{0, 1} ^ ι`. -/
noncomputable def restrictDegreeOneLinearEquiv : restrictDegree ι R 1 ≃ₗ[R] ((ι → Bool) → R) where
  toFun p x := eval (bitPoint x) p.1
  map_add' p q := by
    funext x
    simp only [Submodule.coe_add, map_add, Pi.add_apply]
  map_smul' r p := by
    funext x
    simp only [SetLike.val_smul, Algebra.smul_def, map_mul, algebraMap_eq, eval_C,
      Algebra.algebraMap_self, RingHom.id_apply, Pi.smul_apply]
  invFun g := ⟨cubeExtension ι R g, cubeExtension_mem_restrictDegree ι R g⟩
  left_inv p := by
    ext1
    exact eq_of_mem_restrictDegree_of_forall_eval_bitPoint
      (cubeExtension_mem_restrictDegree ι R _) p.2 (eval_cubeExtension ι R _)
  right_inv g := by
    funext x
    exact eval_cubeExtension ι R g x

/-- Multilinear polynomials are `R`-linearly equivalent to the Boolean quotient
`MvPolynomial ι R ⧸ boolIdeal ι R`. -/
noncomputable def restrictDegreeOneQuotientEquiv :
    restrictDegree ι R 1 ≃ₗ[R] (MvPolynomial ι R ⧸ boolIdeal ι R) :=
  (restrictDegreeOneLinearEquiv ι R).trans (boolQuotientAlgEquiv ι R).toLinearEquiv.symm

variable {ι R}

/-- Evaluating `restrictDegreeOneLinearEquiv` on a multilinear polynomial computes its values on
`{0, 1} ^ ι`. -/
@[simp] theorem restrictDegreeOneLinearEquiv_apply (p : restrictDegree ι R 1) (x : ι → Bool) :
    restrictDegreeOneLinearEquiv ι R p x = eval (bitPoint x) p.1 := by
  unfold restrictDegreeOneLinearEquiv
  rfl

/-- Applying the inverse of `restrictDegreeOneLinearEquiv` yields `multilinearExtension`. -/
@[simp] theorem coe_restrictDegreeOneLinearEquiv_symm [Fintype ι] [DecidableEq ι]
    (g : (ι → Bool) → R) :
    ((restrictDegreeOneLinearEquiv ι R).symm g : MvPolynomial ι R) = multilinearExtension g := by
  refine eq_of_mem_restrictDegree_of_forall_eval_bitPoint
    ((restrictDegreeOneLinearEquiv ι R).symm g).2 (multilinearExtension_mem_restrictDegree g)
    fun x => ?_
  rw [← restrictDegreeOneLinearEquiv_apply, LinearEquiv.apply_symm_apply,
    eval_multilinearExtension]

/-- Evaluating `restrictDegreeOneQuotientEquiv` on a multilinear polynomial sends it to its own
coset modulo `boolIdeal ι R`. -/
@[simp] theorem restrictDegreeOneQuotientEquiv_apply (p : restrictDegree ι R 1) :
    restrictDegreeOneQuotientEquiv ι R p = Ideal.Quotient.mk (boolIdeal ι R) p.1 := by
  apply (boolQuotientAlgEquiv ι R).injective
  funext x
  rw [restrictDegreeOneQuotientEquiv, LinearEquiv.trans_apply, boolQuotientAlgEquiv_mk]
  have hinv :
      boolQuotientAlgEquiv ι R
        ((boolQuotientAlgEquiv ι R).toLinearEquiv.symm
          (restrictDegreeOneLinearEquiv ι R p)) =
        restrictDegreeOneLinearEquiv ι R p :=
    (boolQuotientAlgEquiv ι R).apply_symm_apply _
  rw [hinv, restrictDegreeOneLinearEquiv_apply]

/-- Evaluating the inverse of `restrictDegreeOneQuotientEquiv` at any cube point matches
`boolQuotientAlgEquiv`. -/
@[simp] theorem eval_coe_restrictDegreeOneQuotientEquiv_symm
    (z : MvPolynomial ι R ⧸ boolIdeal ι R) (x : ι → Bool) :
    eval (bitPoint x) ((restrictDegreeOneQuotientEquiv ι R).symm z : MvPolynomial ι R) =
      boolQuotientAlgEquiv ι R z x := by
  rw [← restrictDegreeOneLinearEquiv_apply, restrictDegreeOneQuotientEquiv,
    LinearEquiv.symm_trans_apply, LinearEquiv.apply_symm_apply]
  rfl

/-- The inverse of `restrictDegreeOneQuotientEquiv` sends the coset of `p` to
`multilinearExtension (fun x => eval (bitPoint x) p)`. -/
@[simp] theorem coe_restrictDegreeOneQuotientEquiv_symm_mk [Fintype ι] [DecidableEq ι]
    (p : MvPolynomial ι R) :
    ((restrictDegreeOneQuotientEquiv ι R).symm (Ideal.Quotient.mk (boolIdeal ι R) p) :
      MvPolynomial ι R) = multilinearExtension (fun x => eval (bitPoint x) p) := by
  refine eq_of_mem_restrictDegree_of_forall_eval_bitPoint
    ((restrictDegreeOneQuotientEquiv ι R).symm (Ideal.Quotient.mk (boolIdeal ι R) p)).2
    (multilinearExtension_mem_restrictDegree _) fun x => ?_
  rw [eval_coe_restrictDegreeOneQuotientEquiv_symm, boolQuotientAlgEquiv_mk,
    eval_multilinearExtension]

end Finite

section Field

variable (ι K : Type*) [Field K] [Fintype ι]

/-- Over a field `K`, the Boolean quotient `MvPolynomial ι K ⧸ boolIdeal ι K` has `K`-dimension
`2 ^ Fintype.card ι`. -/
theorem finrank_boolQuotient :
    Module.finrank K (MvPolynomial ι K ⧸ boolIdeal ι K) = 2 ^ Fintype.card ι := by
  classical
  rw [(boolQuotientAlgEquiv ι K).toLinearEquiv.finrank_eq, Module.finrank_fintype_fun_eq_card,
    Fintype.card_fun, Fintype.card_bool]

/-- Over a field `K`, the space of multilinear polynomials `restrictDegree ι K 1` has `K`-dimension
`2 ^ Fintype.card ι`. -/
theorem finrank_restrictDegree_one :
    Module.finrank K (restrictDegree ι K 1) = 2 ^ Fintype.card ι := by
  classical
  rw [(restrictDegreeOneLinearEquiv ι K).finrank_eq, Module.finrank_fintype_fun_eq_card,
    Fintype.card_fun, Fintype.card_bool]

end Field

end Cslib.BitString
