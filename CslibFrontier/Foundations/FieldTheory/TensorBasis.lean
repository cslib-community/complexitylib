/-!
# Monomial bases of composita of coprime degrees

Let `E / K` be a finite field extension of degree `∏ᵢ mᵢ`, with the `mᵢ` pairwise coprime, and let
`αᵢ ∈ E` have minimal polynomials of degree `mᵢ`. Then the monomials `∏ᵢ αᵢ ^ Jᵢ`, `Jᵢ < mᵢ`, form
a `K`-basis of `E` (`Cslib.prodPowBasis`), the basis that the tensor product
`⨂ᵢ K[X] / (minpoly αᵢ)` would have.

The proof counts. The span of the monomials is closed under multiplication by each `αᵢ`, since
`αᵢ ^ mᵢ` is a combination of lower powers, so it contains the algebra generated by the `αᵢ`. That
algebra is a subfield whose degree is divisible by every `mᵢ`, hence by their product, so it is
`E`. There are `∏ᵢ mᵢ = [E : K]` monomials, so the spanning family is a basis.

Over `𝔽₂` this presents `𝔽_{2 ^ n}`, `n = p₁ ⋯ pₖ` a product of distinct primes, through
irreducible polynomials of the small degrees `pᵢ`, which can be found by exhaustive search.

## Main definitions

* `Cslib.prodPowBasis`: the monomial basis `J ↦ ∏ᵢ αᵢ ^ Jᵢ`.

## Main results

* `Cslib.top_le_span_prod_pow`: the monomials span `E`.
* `Cslib.prodPowBasis_apply`: the basis vectors are the monomials.
* `Cslib.prodPowBasis_mul_prodPowBasis`: the structure constants of the basis,
  from the remainders of the powers `αᵢ ^ e`, `e < 2 mᵢ`.
-/

@[expose] public section

namespace Cslib

open Function Module Polynomial

variable {K E : Type*} [Field K] [Field E] [Algebra K E] [FiniteDimensional K E]
  {ι : Type*} [Fintype ι]

/-- If the minimal polynomial of `α` has degree `m`, then `α ^ m` lies in the span of the `α ^ e`,
`e < m`. -/
theorem pow_natDegree_minpoly_mem_span (α : E) :
    α ^ (minpoly K α).natDegree ∈
      Submodule.span K (Set.range fun e : Fin (minpoly K α).natDegree => α ^ (e : ℕ)) := by
  have hint : IsIntegral K α := .of_finite K α
  have hmon := minpoly.monic hint
  set m := (minpoly K α).natDegree
  have h0 := minpoly.aeval K α
  rw [aeval_eq_sum_range, Finset.sum_range_succ, hmon.coeff_natDegree, one_smul,
    add_eq_zero_iff_neg_eq] at h0
  rw [← h0]
  refine Submodule.neg_mem _ (Submodule.sum_mem _ fun e he => Submodule.smul_mem _ _ ?_)
  exact Submodule.subset_span ⟨⟨e, Finset.mem_range.1 he⟩, rfl⟩

variable {m : ι → ℕ} {α : ι → E}

/-- The monomials `∏ᵢ αᵢ ^ Jᵢ`, `Jᵢ < mᵢ`, span `E` when `[E : K] = ∏ᵢ mᵢ` with the `mᵢ` pairwise
coprime and `mᵢ` the degree of the minimal polynomial of `αᵢ`. -/
theorem top_le_span_prod_pow (hm : Pairwise (Nat.Coprime on m)) (hE : finrank K E = ∏ i, m i)
    (hα : ∀ i, (minpoly K (α i)).natDegree = m i) :
    ⊤ ≤ Submodule.span K (Set.range fun J : (i : ι) → Fin (m i) => ∏ i, α i ^ (J i : ℕ)) := by
  classical
  set S := Submodule.span K (Set.range fun J : (i : ι) → Fin (m i) => ∏ i, α i ^ (J i : ℕ))
  -- the elements multiplying `S` into itself form a subalgebra
  let T : Subalgebra K E :=
    { carrier := {x | ∀ y ∈ S, x * y ∈ S}
      mul_mem' := fun {x x'} hx hx' y hy => by
        rw [mul_assoc]
        exact hx _ (hx' y hy)
      add_mem' := fun {x x'} hx hx' y hy => by
        rw [add_mul]
        exact S.add_mem (hx y hy) (hx' y hy)
      algebraMap_mem' := fun c y hy => by
        rw [← Algebra.smul_def]
        exact S.smul_mem c hy }
  -- each `αᵢ` lies in `T`
  have hαT : ∀ i, α i ∈ T := by
    intro i y hy
    induction hy using Submodule.span_induction with
    | zero => simp
    | add y y' _ _ hy hy' => rw [mul_add]; exact S.add_mem hy hy'
    | smul c y _ hy => rw [mul_smul_comm]; exact S.smul_mem c hy
    | mem y hy =>
      obtain ⟨J, rfl⟩ := hy
      change α i * ∏ j, α j ^ (J j : ℕ) ∈ S
      -- split off the factor `αᵢ ^ Jᵢ`
      set rest := ∏ j ∈ Finset.univ.erase i, α j ^ (J j : ℕ)
      have hsplit : ∀ J' : (j : ι) → Fin (m j), (∀ j ≠ i, J' j = J j) →
          ∏ j, α j ^ (J' j : ℕ) = α i ^ (J' i : ℕ) * rest := by
        intro J' hJ'
        rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ i)]
        congr 1
        exact Finset.prod_congr rfl fun j hj => by rw [hJ' j (Finset.ne_of_mem_erase hj)]
      rw [hsplit J fun _ _ => rfl, ← mul_assoc, ← pow_succ']
      -- every power `αᵢ ^ e`, `e ≤ mᵢ`, times `rest` lies in `S`
      have hmem : ∀ e : Fin (m i), α i ^ (e : ℕ) * rest ∈ S := fun e => by
        have h := hsplit (Function.update J i e) fun j hj => Function.update_of_ne hj _ _
        rw [Function.update_self] at h
        rw [← h]
        exact Submodule.subset_span ⟨_, rfl⟩
      have hspan : ∀ z ∈ Submodule.span K (Set.range fun e : Fin (m i) => α i ^ (e : ℕ)),
          z * rest ∈ S := by
        intro z hz
        induction hz using Submodule.span_induction with
        | zero => simp
        | add z z' _ _ hz hz' => rw [add_mul]; exact S.add_mem hz hz'
        | smul c z _ hz => rw [smul_mul_assoc]; exact S.smul_mem c hz
        | mem z hz =>
          obtain ⟨e, rfl⟩ := hz
          exact hmem e
      rcases Nat.lt_or_ge ((J i : ℕ) + 1) (m i) with hlt | hge
      · exact hmem ⟨_, hlt⟩
      · rw [show (J i : ℕ) + 1 = m i by have := (J i).2; omega]
        refine hspan _ ?_
        have := pow_natDegree_minpoly_mem_span (K := K) (α i)
        rwa [hα i] at this
  -- the algebra generated by the `αᵢ` is all of `E`
  have hint : ∀ x : E, IsAlgebraic K x := fun x => (IsIntegral.of_finite K x).isAlgebraic
  set A := IntermediateField.adjoin K (Set.range α)
  have hdvd : ∀ i, m i ∣ finrank K A := fun i => by
    rw [← hα i, ← IntermediateField.adjoin.finrank (IsIntegral.of_finite K (α i))]
    exact IntermediateField.finrank_dvd_of_le_right
      (IntermediateField.adjoin_simple_le_iff.2 (IntermediateField.subset_adjoin _ _ ⟨i, rfl⟩))
  have hprod : ∏ i, m i ∣ finrank K A := by
    have := Fintype.prod_dvd_of_coprime (R := ℤ) (s := fun i => (m i : ℤ)) (z := finrank K A)
      (fun i j hij => Nat.isCoprime_iff_coprime.2 (hm hij))
      fun i => Int.natCast_dvd_natCast.2 (hdvd i)
    exact_mod_cast this
  have hA : A = ⊤ := by
    have htop := IntermediateField.finrank_dvd_of_le_right (K := K) (le_top : A ≤ ⊤)
    rw [IntermediateField.finrank_top', hE] at htop
    refine IntermediateField.eq_of_le_of_finrank_eq le_top ?_
    rw [IntermediateField.finrank_top', hE]
    exact Nat.dvd_antisymm htop hprod
  have hadj : Algebra.adjoin K (Set.range α) = ⊤ := by
    rw [← IntermediateField.adjoin_toSubalgebra_of_isAlgebraic fun x _ => hint x]
    change A.toSubalgebra = ⊤
    rw [hA, IntermediateField.top_toSubalgebra]
  have hle : Algebra.adjoin K (Set.range α) ≤ T :=
    Algebra.adjoin_le fun _ ⟨i, hi⟩ => hi ▸ hαT i
  have hone : (1 : E) ∈ S := Submodule.subset_span ⟨fun i => ⟨0, by
    have := hα i
    have := minpoly.natDegree_pos (IsIntegral.of_finite K (α i))
    omega⟩, by simp⟩
  intro x _
  have hx : x ∈ T := hle (hadj ▸ Algebra.mem_top)
  simpa using hx 1 hone

variable [DecidableEq ι]

/-- **The monomial basis of a compositum of coprime degrees**: if `[E : K] = ∏ᵢ mᵢ` with the `mᵢ`
pairwise coprime and the minimal polynomial of `αᵢ` has degree `mᵢ`, then the monomials
`∏ᵢ αᵢ ^ Jᵢ`, `Jᵢ < mᵢ`, form a basis of `E` over `K`. -/
noncomputable def prodPowBasis (hm : Pairwise (Nat.Coprime on m)) (hE : finrank K E = ∏ i, m i)
    (hα : ∀ i, (minpoly K (α i)).natDegree = m i) : Basis ((i : ι) → Fin (m i)) K E :=
  basisOfTopLeSpanOfCardEqFinrank _ (top_le_span_prod_pow hm hE hα) (by
    rw [Fintype.card_pi, hE]
    simp)

/-- The basis vector of `prodPowBasis` at exponents `J` is the monomial `∏ᵢ αᵢ ^ Jᵢ`. -/
@[simp]
theorem prodPowBasis_apply (hm : Pairwise (Nat.Coprime on m)) (hE : finrank K E = ∏ i, m i)
    (hα : ∀ i, (minpoly K (α i)).natDegree = m i) (J : (i : ι) → Fin (m i)) :
    prodPowBasis hm hE hα J = ∏ i, α i ^ (J i : ℕ) := by
  simp [prodPowBasis]

/-- **Structure constants of the monomial basis.** If each power `αᵢ ^ e`, `e < 2 mᵢ`, is the
combination `∑_d c i e d • αᵢ ^ d` of the powers below `mᵢ`, then the product of the monomial
basis vectors of `J` and `K` is the combination of those of `M` with the coefficients
`∏ᵢ c i (Jᵢ + Kᵢ) Mᵢ`. The coefficients depend only on the `c i`, not on the `αᵢ`. -/
theorem prodPowBasis_mul_prodPowBasis (hm : Pairwise (Nat.Coprime on m))
    (hE : finrank K E = ∏ i, m i) (hα : ∀ i, (minpoly K (α i)).natDegree = m i)
    (c : (i : ι) → ℕ → Fin (m i) → K)
    (hc : ∀ i, ∀ e < 2 * m i, α i ^ e = ∑ d, c i e d • α i ^ (d : ℕ))
    (J J' : (i : ι) → Fin (m i)) :
    prodPowBasis hm hE hα J * prodPowBasis hm hE hα J' =
      ∑ M, (∏ i, c i (J i + J' i) (M i)) • prodPowBasis hm hE hα M := by
  simp only [prodPowBasis_apply]
  rw [← Finset.prod_mul_distrib]
  simp_rw [← pow_add]
  rw [Finset.prod_congr rfl fun i _ => hc i _ (by have := (J i).2; have := (J' i).2; omega),
    Finset.prod_univ_sum, Fintype.piFinset_univ]
  refine Finset.sum_congr rfl fun M _ => ?_
  simp_rw [Algebra.smul_def, Finset.prod_mul_distrib, map_prod]

end Cslib
