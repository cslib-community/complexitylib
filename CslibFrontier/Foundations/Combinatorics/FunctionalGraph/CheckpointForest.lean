module
-- upstream: candidate

public import CslibFrontier.Foundations.Combinatorics.FunctionalGraph.Checkpoints
public import CslibFrontier.Foundations.Combinatorics.FunctionalGraph.Cycle
public import Mathlib.Algebra.BigOperators.Group.Finset.Basic
import Mathlib.Algebra.BigOperators.Ring.Finset
import Mathlib.Algebra.Order.BigOperators.Group.Finset

/-!
# The forest generated by checkpoint-to-cycle paths

Cut outgoing edges at periodic states (`transientDepth f x = 0`). Closing a finite checkpoint set
`H` along the remaining transient paths yields a finite directed forest `checkpointHull f H` whose
roots are the cycle entry points reached from `H` (`forestRoots f H`) and whose leaves all lie in
`H` (`forestLeaves_subset`).

Adding the roots and the branching states (`forestBranches f H`, states with at least two
predecessors in `forestSources f H`) to `H` produces the refined mark set `forestMarks f H`.
Because every branch and every root is paid for by a distinct leaf in `H`
(`forestBranches_roots_le_leaves`), the refined set has at most `2 |H|` states
(`forestMarks_card`), and outside `forestMarks f H` every state in the hull has at most one
hull predecessor (`forestPredecessor_unique`).

## Main definitions

* `Cslib.FunctionalGraph.checkpointHull`: states reached from `H` up to their first periodic point.
* `Cslib.FunctionalGraph.forestSources`: transient states in `checkpointHull f H`.
* `Cslib.FunctionalGraph.forestChildren`: predecessors of a state in `forestSources f H`.
* `Cslib.FunctionalGraph.forestRoots`: periodic states in `checkpointHull f H`.
* `Cslib.FunctionalGraph.forestLeaves`: hull states with no predecessor in `forestSources f H`.
* `Cslib.FunctionalGraph.forestBranches`: hull states with at least two predecessors in
  `forestSources f H`.
* `Cslib.FunctionalGraph.forestMarks`: refined checkpoint set `H ∪ (forestRoots f H ∪
  forestBranches f H)`.

## Main results

* `Cslib.FunctionalGraph.forestLeaves_subset`: every leaf of the checkpoint hull belongs to `H`.
* `Cslib.FunctionalGraph.sum_forestChildren`: child counts across the hull sum to
  `|forestSources f H|`.
* `Cslib.FunctionalGraph.forestBranches_roots_le_leaves`: branches and roots are bounded by leaves.
* `Cslib.FunctionalGraph.forestMarks_card`: `(forestMarks f H).card ≤ 2 * H.card`.
* `Cslib.FunctionalGraph.forestPredecessor_unique`: unmarked states have at most one predecessor in
  `forestSources f H`.

## References

* Adapted from lean/Proofs/CheckpointForest.lean in
  [S. Schlesinger,
  *Square-root circuit bounds for iterated functions*][Schlesinger2026IteratedFunctions].
-/

@[expose] public section

namespace Cslib.FunctionalGraph

open scoped BigOperators

universe u
variable {α : Type u} [Finite α] (f : α → α)

open scoped Classical in
/-- Follow each checkpoint in `H` along its orbit up to its first periodic point. -/
noncomputable def checkpointHull (H : Finset α) : Finset α :=
  H.biUnion fun h => (Finset.range (transientDepth f h + 1)).image fun t => f^[t] h

/-- A state lies in the checkpoint hull exactly when it is `f^[t] h` for some `h ∈ H` and
`t ≤ transientDepth f h`. -/
@[simp] theorem mem_checkpointHull (H : Finset α) (x : α) :
    x ∈ checkpointHull f H ↔ ∃ h ∈ H, ∃ t ≤ transientDepth f h, f^[t] h = x := by
  classical
  simp only [checkpointHull, Finset.mem_biUnion, Finset.mem_image, Finset.mem_range,
    Nat.lt_succ_iff]

/-- Every checkpoint lies in the checkpoint hull. -/
theorem subset_checkpointHull (H : Finset α) : H ⊆ checkpointHull f H := by
  intro h hh
  exact (mem_checkpointHull f H h).mpr ⟨h, hh, 0, Nat.zero_le _, rfl⟩

/-- The checkpoint hull is monotone in the checkpoint set. -/
theorem checkpointHull_subset_of_subset {H₁ H₂ : Finset α} (h : H₁ ⊆ H₂) :
    checkpointHull f H₁ ⊆ checkpointHull f H₂ := by
  intro x hx
  obtain ⟨a, ha, t, ht, rfl⟩ := (mem_checkpointHull f H₁ x).mp hx
  exact (mem_checkpointHull f H₂ _).mpr ⟨a, h ha, t, ht, rfl⟩

/-- The checkpoint hull contains the orbit of each of its states up to that state's transient
depth. -/
theorem checkpointHull_iterate (H : Finset α) {x : α} (hx : x ∈ checkpointHull f H)
    {t : ℕ} (ht : t ≤ transientDepth f x) : f^[t] x ∈ checkpointHull f H := by
  obtain ⟨h, hh, d, hd, rfl⟩ := (mem_checkpointHull f H x).mp hx
  rw [transientDepth_iterate] at ht
  apply (mem_checkpointHull f H _).mpr
  exact ⟨h, hh, t + d, by lia, Function.iterate_add_apply _ _ _ _⟩

/-- The checkpoint hull contains the successor of each of its transient states. -/
theorem checkpointHull_step (H : Finset α) {x : α} (hx : x ∈ checkpointHull f H)
    (ht : 0 < transientDepth f x) : f x ∈ checkpointHull f H := by
  simpa only [Function.iterate_one, Function.id_def] using
    checkpointHull_iterate f H hx (t := 1) (by lia)

/-- Every hull vertex outside `H` has a transient predecessor in the hull. -/
private theorem checkpointHull_predecessor (H : Finset α) {x : α}
    (hx : x ∈ checkpointHull f H) (hH : x ∉ H) :
    ∃ y ∈ checkpointHull f H, 0 < transientDepth f y ∧ f y = x := by
  obtain ⟨h, hh, t, ht, he⟩ := (mem_checkpointHull f H x).mp hx
  have hpos : 0 < t := by
    by_contra h0
    have hz : t = 0 := by lia
    simp only [hz, Function.iterate_zero_apply] at he
    exact hH (he ▸ hh)
  refine ⟨f^[t - 1] h, checkpointHull_iterate f H (subset_checkpointHull f H hh)
    (by lia), ?_, ?_⟩
  · rw [transientDepth_iterate]
    lia
  · rw [← Function.iterate_succ_apply' f (t - 1) h, Nat.succ_eq_add_one,
      show t - 1 + 1 = t by lia]
    exact he

open scoped Classical in
/-- Sources of the forest edges after cutting outgoing edges at periodic vertices. -/
noncomputable def forestSources (H : Finset α) : Finset α :=
  (checkpointHull f H).filter fun x => 0 < transientDepth f x

open scoped Classical in
/-- Predecessors of `x` in `forestSources f H`. -/
noncomputable def forestChildren (H : Finset α) (x : α) : Finset α :=
  (forestSources f H).filter fun y => f y = x

open scoped Classical in
/-- Periodic vertices in `checkpointHull f H` (the roots of the cut forest). -/
noncomputable def forestRoots (H : Finset α) : Finset α :=
  checkpointHull f H \ forestSources f H

open scoped Classical in
/-- Vertices of `checkpointHull f H` with no predecessor in `forestSources f H`. -/
noncomputable def forestLeaves (H : Finset α) : Finset α :=
  (checkpointHull f H).filter fun x => (forestChildren f H x).card = 0

open scoped Classical in
/-- Vertices of `checkpointHull f H` with at least two predecessors in `forestSources f H`. -/
noncomputable def forestBranches (H : Finset α) : Finset α :=
  (checkpointHull f H).filter fun x => 2 ≤ (forestChildren f H x).card

open scoped Classical in
/-- The refined mark set consisting of `H`, the forest roots, and the branching vertices. -/
noncomputable def forestMarks (H : Finset α) : Finset α :=
  H ∪ (forestRoots f H ∪ forestBranches f H)

/-- The forest sources are exactly the hull states of positive transient depth. -/
@[simp] theorem mem_forestSources (H : Finset α) (x : α) :
    x ∈ forestSources f H ↔ x ∈ checkpointHull f H ∧ 0 < transientDepth f x := by
  classical
  exact Finset.mem_filter

/-- The children of `x` are exactly the hull states of positive transient depth that `f` maps
to `x`. -/
@[simp] theorem mem_forestChildren (H : Finset α) (x y : α) :
    y ∈ forestChildren f H x ↔ y ∈ checkpointHull f H ∧
      0 < transientDepth f y ∧ f y = x := by
  classical
  simp only [forestChildren, Finset.mem_filter, mem_forestSources, and_assoc]

/-- The forest roots are exactly the hull states of transient depth zero. -/
@[simp] theorem mem_forestRoots (H : Finset α) (x : α) :
    x ∈ forestRoots f H ↔ x ∈ checkpointHull f H ∧ transientDepth f x = 0 := by
  classical
  simp only [forestRoots, Finset.mem_sdiff, mem_forestSources]
  lia

/-- The forest leaves are exactly the hull states with no children. -/
@[simp] theorem mem_forestLeaves (H : Finset α) (x : α) :
    x ∈ forestLeaves f H ↔ x ∈ checkpointHull f H ∧ (forestChildren f H x).card = 0 := by
  classical
  exact Finset.mem_filter

/-- The forest branches are exactly the hull states with at least two children. -/
@[simp] theorem mem_forestBranches (H : Finset α) (x : α) :
    x ∈ forestBranches f H ↔ x ∈ checkpointHull f H ∧ 2 ≤ (forestChildren f H x).card := by
  classical
  exact Finset.mem_filter

/-- A state is marked exactly when it is a checkpoint, a forest root, or a forest branch. -/
@[simp] theorem mem_forestMarks (H : Finset α) (x : α) :
    x ∈ forestMarks f H ↔ x ∈ H ∨ x ∈ forestRoots f H ∨ x ∈ forestBranches f H := by
  classical
  simp only [forestMarks, Finset.mem_union]

/-- Every leaf of the checkpoint hull belongs to `H`. -/
theorem forestLeaves_subset (H : Finset α) : forestLeaves f H ⊆ H := by
  classical
  intro x hx
  obtain ⟨hx, hz⟩ := Finset.mem_filter.mp hx
  by_contra hH
  obtain ⟨y, hy, hd, he⟩ := checkpointHull_predecessor f H hx hH
  have hmem := (mem_forestChildren f H x y).mpr ⟨hy, hd, he⟩
  have := Finset.card_pos.mpr ⟨y, hmem⟩
  lia

/-- Count each nonroot's outgoing edge at its parent. -/
theorem sum_forestChildren (H : Finset α) :
    ∑ x ∈ checkpointHull f H, (forestChildren f H x).card = (forestSources f H).card := by
  classical
  symm
  apply Finset.card_eq_sum_card_fiberwise
  intro x hx
  obtain ⟨hx, ht⟩ := (mem_forestSources f H x).mp hx
  exact checkpointHull_step f H hx ht

/-- Branches and roots together are paid for by distinct leaves. -/
theorem forestBranches_roots_le_leaves (H : Finset α) :
    (forestBranches f H).card + (forestRoots f H).card ≤ (forestLeaves f H).card := by
  classical
  have hsum := Finset.sum_le_sum (s := checkpointHull f H)
    (f := fun x => 1 + if 2 ≤ (forestChildren f H x).card then 1 else 0)
    (g := fun x => (forestChildren f H x).card +
      if (forestChildren f H x).card = 0 then 1 else 0) (fun x _ => by split_ifs <;> lia)
  simp only [Finset.sum_add_distrib, Finset.sum_const, Nat.nsmul_eq_mul,
    Nat.mul_one, Nat.cast_id, Finset.sum_boole, sum_forestChildren] at hsum
  have hcard := Finset.card_sdiff_add_card_eq_card
    (show forestSources f H ⊆ checkpointHull f H from Finset.filter_subset _ _)
  change (forestRoots f H).card + (forestSources f H).card = (checkpointHull f H).card at hcard
  change (checkpointHull f H).card + (forestBranches f H).card ≤
    (forestSources f H).card + (forestLeaves f H).card at hsum
  lia

/-- Every checkpoint is marked. -/
theorem subset_forestMarks (H : Finset α) : H ⊆ forestMarks f H := by
  classical
  exact Finset.subset_union_left

/-- Every forest root is marked. -/
theorem forestRoots_subset_marks (H : Finset α) : forestRoots f H ⊆ forestMarks f H := by
  classical
  exact Finset.subset_union_left.trans Finset.subset_union_right

/-- Every forest branch is marked. -/
theorem forestBranches_subset_marks (H : Finset α) : forestBranches f H ⊆ forestMarks f H := by
  classical
  exact Finset.subset_union_right.trans Finset.subset_union_right

/-- Every marked state lies in the checkpoint hull. -/
theorem forestMarks_subset_hull (H : Finset α) : forestMarks f H ⊆ checkpointHull f H := by
  classical
  exact Finset.union_subset (subset_checkpointHull f H)
    (Finset.union_subset Finset.sdiff_subset (Finset.filter_subset _ _))

/-- Refinement to a compressed forest needs at most twice as many marks. -/
theorem forestMarks_card (H : Finset α) : (forestMarks f H).card ≤ 2 * H.card := by
  classical
  have hcard : (forestMarks f H).card ≤ H.card +
      ((forestRoots f H).card + (forestBranches f H).card) :=
    (Finset.card_union_le ..).trans (Nat.add_le_add_left (Finset.card_union_le ..) H.card)
  have hbound := forestBranches_roots_le_leaves f H
  have hleaves := Finset.card_le_card (forestLeaves_subset f H)
  lia

/-- A hull state of transient depth zero is marked. -/
theorem forestRoot_mem_marks (H : Finset α) {x : α} (hx : x ∈ checkpointHull f H)
    (hd : transientDepth f x = 0) : x ∈ forestMarks f H := by
  classical
  exact Finset.mem_union_right _ (Finset.mem_union_left _ ((mem_forestRoots f H x).mpr ⟨hx, hd⟩))

/-- Between marks, two hull paths cannot merge. -/
theorem forestPredecessor_unique (H : Finset α) {x y z : α}
    (hx : x ∈ forestSources f H) (hy : y ∈ forestSources f H)
    (hfx : f x = z) (hfy : f y = z) (hz : z ∉ forestMarks f H) : x = y := by
  classical
  by_contra hne
  have hzx : x ∈ forestChildren f H z := Finset.mem_filter.mpr ⟨hx, hfx⟩
  have hzy : y ∈ forestChildren f H z := Finset.mem_filter.mpr ⟨hy, hfy⟩
  have hdeg : 2 ≤ (forestChildren f H z).card :=
    Finset.one_lt_card.mpr ⟨x, hzx, y, hzy, hne⟩
  have hxs := (mem_forestSources f H x).mp hx
  have hzS : z ∈ checkpointHull f H := hfx ▸ checkpointHull_step f H hxs.1 hxs.2
  exact hz (Finset.mem_union_right _ (Finset.mem_union_right _
    (Finset.mem_filter.mpr ⟨hzS, hdeg⟩)))

end Cslib.FunctionalGraph
