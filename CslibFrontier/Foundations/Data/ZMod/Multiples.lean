module
-- upstream: candidate (Mathlib, `Mathlib/Data/ZMod/Basic.lean`)

public import CslibFrontier.Init
public import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic
public import Mathlib.Data.ZMod.Basic

/-!
# Multiples of a divisor in `ZMod N`

For `d ∣ N`, the residues `x : ZMod N` whose canonical value `x.val` is divisible by `d` are
exactly the subgroup generated by `d`, and there are `N / d` of them. The additive order of a
residue `y` is `N / gcd(N, y.val)`.

## Main results

* `ZMod.mem_zmultiples_iff_dvd_val`: `x ∈ zmultiples (d : ZMod N) ↔ d ∣ x.val` when `d ∣ N`.
* `ZMod.card_filter_dvd_val`: `#{x : ZMod N | d ∣ x.val} = N / d` when `d ∣ N`.
* `ZMod.filter_dvd_val_nonempty`: that set is nonempty.
* `ZMod.addOrderOf_eq_div_gcd_val`: `addOrderOf y = N / gcd(N, y.val)`.
-/

public section

open Finset

namespace ZMod

variable {N : ℕ} [NeZero N]

/-- For `d ∣ N`, the subgroup of `ZMod N` generated by `d` consists of the residues whose value is
divisible by `d`. -/
theorem mem_zmultiples_iff_dvd_val {d : ℕ} (hd : d ∣ N) (x : ZMod N) :
    x ∈ AddSubgroup.zmultiples (d : ZMod N) ↔ d ∣ x.val := by
  constructor
  · rintro ⟨k, rfl⟩
    have h0 : ZMod.castHom hd (ZMod d) ((k : ℤ) • (d : ZMod N)) = 0 := by
      rw [map_zsmul, map_natCast, ZMod.natCast_self, smul_zero]
    rwa [ZMod.castHom_apply, ZMod.cast_eq_val, ZMod.natCast_eq_zero_iff] at h0
  · rintro ⟨m, hm⟩
    rw [← natCast_zmod_val x, hm, Nat.cast_mul, mul_comm, ← nsmul_eq_mul]
    exact nsmul_mem (AddSubgroup.mem_zmultiples _) m

/-- For `d ∣ N`, exactly `N / d` residues modulo `N` have value divisible by `d`. -/
theorem card_filter_dvd_val {d : ℕ} (hd : d ∣ N) :
    #{x : ZMod N | d ∣ x.val} = N / d := by
  have hd0 : d ≠ 0 := fun h0 => NeZero.ne N (Nat.eq_zero_of_zero_dvd (h0 ▸ hd))
  rw [← card_range (N / d)]
  refine card_nbij' (fun x => x.val / d) (fun k => ((k * d : ℕ) : ZMod N)) ?_ ?_ ?_ ?_
  · intro x _
    simp only [coe_range, Set.mem_Iio]
    exact Nat.div_lt_div_of_lt_of_dvd hd (ZMod.val_lt x)
  · intro k hk
    simp only [coe_range, Set.mem_Iio] at hk
    simp only [coe_filter, mem_univ, true_and, Set.mem_ofPred_eq]
    rw [ZMod.val_cast_of_lt ((Nat.lt_div_iff_mul_lt_of_dvd hd0 hd).mp hk)]
    exact Dvd.intro_left k rfl
  · intro x hx
    simp only [coe_filter, mem_univ, true_and, Set.mem_ofPred_eq] at hx
    simp only [Nat.div_mul_cancel hx, natCast_zmod_val]
  · intro k hk
    simp only [coe_range, Set.mem_Iio] at hk
    dsimp only
    rw [ZMod.val_cast_of_lt ((Nat.lt_div_iff_mul_lt_of_dvd hd0 hd).mp hk),
      Nat.mul_div_cancel _ (Nat.pos_of_ne_zero hd0)]

/-- The residues with value divisible by `d` form a nonempty set: it contains `0`. -/
theorem filter_dvd_val_nonempty (d : ℕ) : ({x : ZMod N | d ∣ x.val} : Finset (ZMod N)).Nonempty :=
  ⟨0, by simp⟩

/-- The additive order of a residue `y : ZMod N` is `N / gcd(N, y.val)`. -/
theorem addOrderOf_eq_div_gcd_val (y : ZMod N) : addOrderOf y = N / Nat.gcd N y.val := by
  rw [← ZMod.addOrderOf_coe y.val (NeZero.ne N), natCast_zmod_val]

end ZMod
