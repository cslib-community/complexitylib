public import CslibFrontier.Init
public import Mathlib.Logic.Function.Iterate
import Mathlib.Data.List.GetD

/-!
# Course-of-values stage tables

A course-of-values table iterates a step function `step : List α → α` that computes the next value
from the list of all earlier values, producing `[val 0, val 1, …, val (n - 1)]`.

## Main definitions

* `List.courseOfValues`: the table of the first `n` values generated by `step`.
* `List.courseOfValuesVal`: the `n`-th value `step (List.courseOfValues step n)`.

## Main results

* `List.courseOfValues_eq_iterate`: `List.courseOfValues step n` is
  `(fun T => T ++ [step T])^[n] []`.
* `List.courseOfValues_eq`:
  `List.courseOfValues step n = (List.range n).map (List.courseOfValuesVal step)`.
* `List.length_courseOfValues`, `List.getD_courseOfValues`, `List.mem_courseOfValues`:
  length, indexed lookup and membership identities.
* `List.take_courseOfValues`, `List.courseOfValues_congr`: prefix preservation and extensionality.
-/

@[expose] public section

namespace List

variable {α : Type*}

/-- The table of the first `n` values defined by course-of-values recursion from `step`:
`[val 0, …, val (n - 1)]`, where `val i = step (courseOfValues step i)`. -/
def courseOfValues (step : List α → α) : ℕ → List α
  | 0 => []
  | n + 1 => courseOfValues step n ++ [step (courseOfValues step n)]

/-- The `n`-th value defined by course-of-values recursion from `step`. -/
def courseOfValuesVal (step : List α → α) (n : ℕ) : α :=
  step (courseOfValues step n)

@[simp]
theorem courseOfValues_zero (step : List α → α) : courseOfValues step 0 = [] :=
  rfl

theorem courseOfValues_succ (step : List α → α) (n : ℕ) :
    courseOfValues step (n + 1) = courseOfValues step n ++ [courseOfValuesVal step n] :=
  rfl

/-- Course-of-values recursion as `n`-fold iteration of appending the next step value. -/
theorem courseOfValues_eq_iterate (step : List α → α) (n : ℕ) :
    courseOfValues step n = (fun T => T ++ [step T])^[n] [] := by
  induction n with
  | zero => rfl
  | succ n ih => rw [courseOfValues, Function.iterate_succ_apply', ih]

/-- **The table entries match `List.courseOfValuesVal` over `0, …, n - 1`.** -/
theorem courseOfValues_eq (step : List α → α) (n : ℕ) :
    courseOfValues step n = (List.range n).map (courseOfValuesVal step) := by
  induction n with
  | zero => rfl
  | succ n ih => rw [courseOfValues_succ, List.range_succ, List.map_append, ← ih]; rfl

@[simp]
theorem length_courseOfValues (step : List α → α) (n : ℕ) :
    (courseOfValues step n).length = n := by
  simp [courseOfValues_eq]

/-- Lookup at any index below `n` in `courseOfValues step n` gives `courseOfValuesVal step m`. -/
theorem getElem?_courseOfValues (step : List α → α) (n m : ℕ) :
    (courseOfValues step n)[m]? = if m < n then some (courseOfValuesVal step m) else none := by
  rw [courseOfValues_eq, List.getElem?_map]
  split_ifs with h
  · rw [List.getElem?_range h]; rfl
  · rw [List.getElem?_eq_none (by simp only [List.length_range]; omega)]; rfl

/-- Defaulted lookup at an index below `n` recovers `courseOfValuesVal step m`. -/
theorem getD_courseOfValues (step : List α → α) (d : α) {n m : ℕ} (h : m < n) :
    (courseOfValues step n).getD m d = courseOfValuesVal step m := by
  simp only [List.getD_eq_getElem?_getD, getElem?_courseOfValues, h, ↓reduceIte]
  rfl

/-- Membership in `courseOfValues step n` witnesses an earlier index `m < n`. -/
theorem mem_courseOfValues {step : List α → α} {n : ℕ} {a : α} :
    a ∈ courseOfValues step n ↔ ∃ m < n, courseOfValuesVal step m = a := by
  simp [courseOfValues_eq]

/-- Taking the first `m ≤ n` entries of a course-of-values table gives the `m`-stage table. -/
theorem take_courseOfValues (step : List α → α) {m n : ℕ} (h : m ≤ n) :
    (courseOfValues step n).take m = courseOfValues step m := by
  refine List.ext_getElem (by simp [Nat.min_eq_left h]) fun i hi₁ hi₂ => ?_
  rw [List.getElem_take]
  simp only [courseOfValues_eq, List.getElem_map, List.getElem_range]

/-- Shorter course-of-values tables are prefixes of longer ones. -/
theorem prefix_courseOfValues (step : List α → α) {m n : ℕ} (h : m ≤ n) :
    courseOfValues step m <+: courseOfValues step n :=
  ⟨(courseOfValues step n).drop m, by rw [← take_courseOfValues step h, List.take_append_drop]⟩

/-- Two step functions that agree on all generated prefixes below `n` produce the same table. -/
theorem courseOfValues_congr {step₁ step₂ : List α → α} {n : ℕ}
    (h : ∀ m < n, step₁ (courseOfValues step₁ m) = step₂ (courseOfValues step₁ m)) :
    courseOfValues step₁ n = courseOfValues step₂ n := by
  induction n with
  | zero => rfl
  | succ n ih =>
    have hprev : courseOfValues step₁ n = courseOfValues step₂ n :=
      ih fun m hm => h m (Nat.lt_succ_of_lt hm)
    rw [courseOfValues, courseOfValues, hprev, ← hprev, h n (Nat.lt_succ_self n)]

end List
