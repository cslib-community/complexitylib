/-!
# ElGamal encryption in a fixed group

Fix an additive commutative group `G` that is a `ZMod q`-module, and an element `g : G`. ElGamal
encryption ([BonehShoup2023], Section 11.5 and Exercise 11.5(a), p. 459) is the public-key scheme
`elGamal q g : PKE G (ZMod q) G (G × G)`: the secret key is a uniform exponent `a`, the public key
is `a • g`, a message `m : G` is encrypted under `u` with a uniform exponent `b` as
`(b • g, b • u + m)`, and decryption subtracts `a • v` from the second component.

The chosen-plaintext experiment of this scheme reduces to the fixed-group DDH experiments of
`CslibFrontier/Crypto/Computational/DiffieHellman/Finite.lean`. The distinguisher `elGamalToDDH`
receives `(u, v, w)`, gives the adversary `u` as its public key, and answers its challenge with
`(v, w + m)`. In the real DDH world this is the chosen-plaintext experiment
(`eval_ddhRealExperiment_elGamalToDDH`). In the random world, when every element of `G` is a
multiple of `g`, the mask `w = c • g` hides the message, so the two challenge bits give the same law
(`eval_ddhRandomExperiment_elGamalToDDH_false`). Hence the chosen-plaintext advantage is at most
the sum of two DDH advantages (`advantage_cpaExperiment_elGamal_le`).

Adversaries receive and return group elements; there are no encodings, security parameter or
setup. The asymptotic statements over a family of prime-order groups are in
`CslibFrontier/Crypto/Computational/ElGamal.lean`.

## Main definitions

* `Cslib.Crypto.elGamal`: ElGamal encryption in the group generated by `g`.
* `Cslib.Crypto.elGamalToDDH`: the DDH distinguisher that runs a chosen-plaintext adversary.

## Main results

* `Cslib.Crypto.elGamal_correct`: ElGamal is perfectly correct.
* `Cslib.Crypto.eval_ddhRealExperiment_elGamalToDDH`: in the real DDH world, the distinguisher runs
  the chosen-plaintext experiment.
* `Cslib.Crypto.eval_ddhRandomExperiment_elGamalToDDH_false`: in the random DDH world, the
  distinguisher's law does not depend on the challenge bit.
* `Cslib.Crypto.advantage_cpaExperiment_elGamal_le`: the chosen-plaintext advantage is at most the
  sum of the DDH advantages of the two distinguishers ([BonehShoup2023], Exercise 11.5(a)).

## References

* [D. Boneh, V. Shoup, *A Graduate Course in Applied Cryptography*][BonehShoup2023],
  Section 11.5 and Exercise 11.5(a), p. 459.
-/

public section

namespace Cslib.Crypto

open Probability
open scoped NNReal

variable {G : Type} [AddCommGroup G] (q : ℕ) [NeZero q] [Module (ZMod q) G] (g : G)

/-- ElGamal encryption in the group generated by `g` ([BonehShoup2023], Section 11.5): the secret
key is a uniform exponent `a` and the public key is `a • g`; a message `m` is encrypted under `u`
with a fresh uniform exponent `b` as `(b • g, b • u + m)`; decryption of `(v, e)` with `a` returns
`e - a • v`. -/
@[expose] noncomputable def elGamal : PKE G (ZMod q) G (G × G) where
  keyGen := do
    let a ← $ᵗ ZMod q
    return (a • g, a)
  encrypt u m := do
    let b ← $ᵗ ZMod q
    return (b • g, b • u + m)
  decrypt a ct := some (ct.2 - a • ct.1)

/-- ElGamal is perfectly correct: `b • (a • g) + m - a • (b • g) = m`. -/
theorem elGamal_correct : (elGamal q g).Correct := by
  intro keys hkeys m ct hct
  simp only [elGamal, ProbComp.eval_bind, ProbComp.eval_pure, ProbComp.eval_uniform,
    PMF.mem_support_bind_iff, PMF.support_pure, Set.mem_singleton_iff] at hkeys hct
  obtain ⟨a, -, rfl⟩ := hkeys
  obtain ⟨b, -, rfl⟩ := hct
  simp only [elGamal, smul_smul, mul_comm b a, add_sub_cancel_left]

/-- The DDH distinguisher that runs the chosen-plaintext adversary `A` against ElGamal
([BonehShoup2023], proof of Exercise 11.5(a)): given `(u, v, w)`, give `A` the public key `u`, and
if `valid u m₀ m₁` holds, answer the challenge with `(v, w + m)` for the message `m` selected by
`b`. -/
@[expose] def elGamalToDDH {σ : Type} (valid : G → G → G → Bool)
    (A : TwoStage G (MessagePair G) (G × G) Bool σ) (b : Bool) (u v w : G) : ProbComp Bool :=
  lrExperiment valid (fun _ m => pure (v, w + m)) A b u

variable {q g}

/-- In the real DDH world, `elGamalToDDH` runs the chosen-plaintext experiment: the public key is
`a • g`, and the challenge `(b • g, (a * b) • g + m)` is an honest encryption. -/
theorem eval_ddhRealExperiment_elGamalToDDH {σ : Type} (valid : G → G → G → Bool)
    (A : TwoStage G (MessagePair G) (G × G) Bool σ) (b : Bool) :
    ProbComp.eval (ddhRealExperiment q g (elGamalToDDH valid A b)) =
      ProbComp.eval ((elGamal q g).cpaExperiment valid A b) := by
  simp only [eval_ddhRealExperiment, PKE.eval_cpaExperiment, elGamalToDDH, elGamal,
    Game.withSetup, eval_lrExperiment, ProbComp.eval_bind, ProbComp.eval_pure,
    ProbComp.eval_uniform, PMF.bind_map, Function.comp_def, PMF.bind_bind, PMF.pure_bind]
  pmf_swap with a p
  split_ifs
  · simp only [smul_smul, mul_comm]
  · exact PMF.bind_const _ _

/-- In the random DDH world, when every element of `G` is a multiple of `g`, the uniform mask
`c • g` hides the challenge message, so `elGamalToDDH` has the same law for both challenge bits. -/
theorem eval_ddhRandomExperiment_elGamalToDDH_false
    (hg : Function.Surjective fun c : ZMod q => c • g) {σ : Type} (valid : G → G → G → Bool)
    (A : TwoStage G (MessagePair G) (G × G) Bool σ) :
    ProbComp.eval (ddhRandomExperiment q g (elGamalToDDH valid A false)) =
      ProbComp.eval (ddhRandomExperiment q g (elGamalToDDH valid A true)) := by
  simp only [eval_ddhRandomExperiment, elGamalToDDH, eval_lrExperiment, ProbComp.eval_pure,
    PMF.pure_bind]
  pmf_swap with a b p
  split_ifs
  · rw [uniformOfFintype_bind_smul_add hg _ fun x => (A.guess p.2 (b • g, x)).eval,
      uniformOfFintype_bind_smul_add hg _ fun x => (A.guess p.2 (b • g, x)).eval]
  · rfl

/-- **ElGamal is IND-CPA secure under DDH, in one group** ([BonehShoup2023], Exercise 11.5(a)):
when every element of `G` is a multiple of `g`, the chosen-plaintext advantage of `A` is at most
the sum of the DDH advantages of `elGamalToDDH valid A false` and `elGamalToDDH valid A true`. -/
theorem advantage_cpaExperiment_elGamal_le (hg : Function.Surjective fun c : ZMod q => c • g)
    {σ : Type} (valid : G → G → G → Bool) (A : TwoStage G (MessagePair G) (G × G) Bool σ) :
    Experiment.advantage ((elGamal q g).cpaExperiment valid A false)
        ((elGamal q g).cpaExperiment valid A true) ≤
      ddhAdvantage q g (elGamalToDDH valid A false) +
        ddhAdvantage q g (elGamalToDDH valid A true) := by
  have hrandom := eval_ddhRandomExperiment_elGamalToDDH_false hg valid A
  refine Game.advantage_le_of_approxEq
    (calc Pr[(elGamal q g).cpaExperiment valid A false]
        _ = Pr[ddhRealExperiment q g (elGamalToDDH valid A false)] := by
          rw [eval_ddhRealExperiment_elGamalToDDH]
        _ ≈[ddhAdvantage q g (elGamalToDDH valid A false)]
            Pr[ddhRandomExperiment q g (elGamalToDDH valid A false)] :=
          Game.approxEq_advantage _ _
        _ = Pr[ddhRandomExperiment q g (elGamalToDDH valid A true)] := by rw [hrandom]
        _ ≈[ddhAdvantage q g (elGamalToDDH valid A true)]
            Pr[ddhRealExperiment q g (elGamalToDDH valid A true)] :=
          (Game.approxEq_advantage _ _).symm
        _ = Pr[(elGamal q g).cpaExperiment valid A true] := by
          rw [eval_ddhRealExperiment_elGamalToDDH])

end Cslib.Crypto
