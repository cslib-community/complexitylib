/-! ### Pohlig–Hellman subgroup reduction -/

/-- **Pohlig–Hellman subgroup reduction** ([KatzLindell2020], Section 10.2.1, Equation (10.2) and
Lemma 10.4, p. 375): if `g` has order `q > 0`, `qi ∣ q`, and `xi` solves the subgroup instance
`(g ^ (q / qi)) ^ xi = (g ^ x) ^ (q / qi)`, then `xi ≡ x [MOD qi]`. -/
@[to_additive pohligHellman_nsmul_subgroup_modEq
/-- **Additive Pohlig–Hellman subgroup reduction**: if `g` has additive order `q > 0`, `qi ∣ q`,
and `xi • ((q / qi) • g) = (q / qi) • (x • g)`, then `xi ≡ x [MOD qi]`. -/]
theorem pohligHellman_subgroup_modEq {M : Type*} [Group M] (g : M) {q qi : ℕ}
    (hg : orderOf g = q) (hq : 0 < q) (hqi : qi ∣ q) (x xi : ℕ)
    (h : (g ^ (q / qi)) ^ xi = (g ^ x) ^ (q / qi)) : xi ≡ x [MOD qi] := by
  have hord : orderOf (g ^ (q / qi)) = qi := by
    have := orderOf_pow_orderOf_div (x := g) (n := qi) (by rw [hg]; omega) (by rw [hg]; exact hqi)
    rwa [hg] at this
  have hswap : (g ^ x) ^ (q / qi) = (g ^ (q / qi)) ^ x := by
    rw [← pow_mul, ← pow_mul, mul_comm]
  rwa [hswap, pow_eq_pow_iff_modEq, hord] at h

/-- **Pohlig–Hellman CRT uniqueness** ([KatzLindell2020], Section 10.2.1, p. 375): let `g` have
order `q = ∏ qs` with pairwise coprime `qs`, let `h = g ^ x`, and let `sol qi` solve each subgroup
instance `(g ^ (q / qi)) ^ sol qi = h ^ (q / qi)`. Then every `y` with `y ≡ sol qi [MOD qi]` for
all `qi ∈ qs` satisfies `y ≡ x [MOD q]`, so the residues determine `x` modulo `q`. -/
@[to_additive pohligHellman_nsmul_crt_modEq
/-- **Additive Pohlig–Hellman CRT uniqueness**: for `g` of additive order `q = ∏ qs` with pairwise
coprime `qs`, `h = x • g`, and `sol qi • ((q / qi) • g) = (q / qi) • h` for all `qi ∈ qs`, every
`y` with `y ≡ sol qi [MOD qi]` for all `qi ∈ qs` satisfies `y ≡ x [MOD q]`. -/]
theorem pohligHellman_crt_modEq {M : Type*} [Group M] (g h : M) {q : ℕ} (hg : orderOf g = q)
    (hq : 0 < q) {qs : List ℕ} (hcop : qs.Pairwise Nat.Coprime) (hprod : qs.prod = q) {x : ℕ}
    (hx : g ^ x = h) (sol : ℕ → ℕ) (hsol : ∀ qi ∈ qs, (g ^ (q / qi)) ^ sol qi = h ^ (q / qi))
    {y : ℕ} (hy : ∀ qi ∈ qs, y ≡ sol qi [MOD qi]) : y ≡ x [MOD q] := by
  subst hx
  have hmem (i : Fin qs.length) : qs.get i ∈ qs := List.get_mem qs i
  have hdvd (i : Fin qs.length) : qs.get i ∣ q := hprod ▸ List.dvd_prod (hmem i)
  rw [← hprod, Nat.modEq_list_prod_iff hcop]
  intro i
  exact (hy _ (hmem i)).trans
    (pohligHellman_subgroup_modEq g hg hq (hdvd i) x _ (hsol _ (hmem i)))

/-! ### Pohlig–Hellman prime-power digit step -/

/-- **Pohlig–Hellman prime-power digit step** (ingredient of [KatzLindell2020],
Exercises 10.4(a)–(b) and 10.5, pp. 382–383): for an element `g` of order `q > 0` in a group `M`,
a divisor `D * p ∣ q`, and a candidate digit `t < p`, the subgroup projection
`(g ^ x * g ^ (q - x % D)) ^ (q / (D * p))` equals `(g ^ (q / p)) ^ t` if and only if
`t = x / D % p`. -/
@[to_additive pohligHellman_nsmul_step
/-- **Additive Pohlig–Hellman prime-power digit step**: for an element `g` of additive order
`q > 0`, a divisor `D * p ∣ q`, and a candidate digit `t < p`,
`(q / (D * p)) • (x • g + (q - x % D) • g) = t • ((q / p) • g)` if and only if
`t = x / D % p`. -/]
theorem pohligHellman_step {M : Type*} [Group M] (g : M) {q : ℕ} (hg : orderOf g = q) (hq : 0 < q)
    {D p : ℕ} (hDp : D * p ∣ q) (x t : ℕ) (ht : t < p) :
    (g ^ x * g ^ (q - x % D)) ^ (q / (D * p)) = (g ^ (q / p)) ^ t ↔ t = x / D % p := by
  obtain ⟨m, hm⟩ := hDp
  have hD : 0 < D := by
    rcases Nat.eq_zero_or_pos D with h | h
    · rw [h] at hm; simp at hm; omega
    · exact h
  have hp : 0 < p := by omega
  have hm0 : 0 < m := by
    rcases Nat.eq_zero_or_pos m with h | h
    · rw [h] at hm; simp at hm; omega
    · exact h
  have hqm : q / (D * p) = m := by rw [hm, Nat.mul_div_cancel_left _ (Nat.mul_pos hD hp)]
  have hqp : q / p = D * m := by
    rw [hm, show D * p * m = p * (D * m) by ring, Nat.mul_div_cancel_left _ hp]
  have hxle : x % D ≤ q :=
    le_trans (Nat.mod_lt _ hD).le (Nat.le_of_dvd hq ⟨p * m, by rw [hm]; ring⟩)
  have e1 : (x + (q - x % D)) * m = D * m * (x / D) + q * m := by
    have h0 := Nat.div_add_mod x D
    have h2 : x + (q - x % D) = D * (x / D) + q := by omega
    rw [h2]; ring
  have e2 : q / p * t = D * m * t := by rw [hqp]
  rw [← pow_add, ← pow_mul, ← pow_mul, hqm, e1, e2, pow_eq_pow_iff_modEq, hg]
  unfold Nat.ModEq
  rw [Nat.add_mul_mod_self_left]
  have hDm : D * m ≠ 0 := Nat.mul_ne_zero hD.ne' hm0.ne'
  have hq' : q = D * m * p := by rw [hm]; ring
  constructor
  · intro h
    have h' : D * m * (x / D) ≡ D * m * t [MOD D * m * p] := by
      unfold Nat.ModEq; rw [← hq']; exact h
    have := Nat.ModEq.mul_left_cancel' hDm h'
    unfold Nat.ModEq at this
    rw [Nat.mod_eq_of_lt ht] at this
    exact this.symm
  · intro h
    have h' : x / D ≡ t [MOD p] := by
      unfold Nat.ModEq; rw [Nat.mod_eq_of_lt ht, h]
    have := Nat.ModEq.mul_left' (D * m) h'
    unfold Nat.ModEq at this
    rw [hq']; exact this

/-! ### Smooth/rough trial-division decomposition (original, not from [KatzLindell2020]) -/

/-- Trial-division divisor schedule: at step `k`, the candidate factor is `k % T + 2`, and the
accumulated divisor grows by `k % T + 2` whenever the product divides `q`. -/
def smoothDivisorSeq (q T : ℕ) : ℕ → ℕ
  | 0 => 1
  | k + 1 =>
    if smoothDivisorSeq q T k * (k % T + 2) ∣ q then
      smoothDivisorSeq q T k * (k % T + 2)
    else
      smoothDivisorSeq q T k

/-- Every term of `smoothDivisorSeq q T` divides `q`. -/
theorem smoothDivisorSeq_dvd (q T : ℕ) : ∀ k, smoothDivisorSeq q T k ∣ q
  | 0 => one_dvd q
  | k + 1 => by
    rw [smoothDivisorSeq]
    split_ifs with h
    · exact h
    · exact smoothDivisorSeq_dvd q T k

/-- When `0 < q`, every term of `smoothDivisorSeq q T` is positive. -/
theorem smoothDivisorSeq_pos {q : ℕ} (hq : 0 < q) (T k : ℕ) : 0 < smoothDivisorSeq q T k :=
  Nat.pos_of_dvd_of_pos (smoothDivisorSeq_dvd q T k) hq

/-- One trial-division step never loses divisibility: `smoothDivisorSeq q T k` divides
`smoothDivisorSeq q T (k + 1)`. -/
theorem smoothDivisorSeq_step_dvd (q T k : ℕ) :
    smoothDivisorSeq q T k ∣ smoothDivisorSeq q T (k + 1) := by
  rw [smoothDivisorSeq]
  split_ifs
  · exact Dvd.intro _ rfl
  · exact dvd_rfl

/-- `smoothDivisorSeq q T` is divisibility-monotone in the step count `k`. -/
theorem smoothDivisorSeq_mono (q T : ℕ) {k k' : ℕ} (h : k ≤ k') :
    smoothDivisorSeq q T k ∣ smoothDivisorSeq q T k' := by
  induction h with
  | refl => exact dvd_rfl
  | step _ ih => exact ih.trans (smoothDivisorSeq_step_dvd q T _)

/-- **$(T + 1)$-smoothness of `smoothDivisorSeq`**: every prime factor `ℓ` of
`smoothDivisorSeq q T k` satisfies `ℓ ≤ T + 1`. -/
theorem smoothDivisorSeq_prime_le {q T : ℕ} (hT : 0 < T) {ℓ : ℕ} (hℓ : ℓ.Prime) (k : ℕ)
    (h : ℓ ∣ smoothDivisorSeq q T k) : ℓ ≤ T + 1 := by
  induction k with
  | zero =>
    simp only [smoothDivisorSeq, Nat.dvd_one] at h
    have := hℓ.one_lt
    omega
  | succ k ih =>
    rw [smoothDivisorSeq] at h
    split_ifs at h
    · rcases (Nat.Prime.dvd_mul hℓ).1 h with h | h
      · exact ih h
      · have h1 := Nat.le_of_dvd (by omega) h
        have h2 := Nat.mod_lt k hT
        omega
    · exact ih h

/-- **Exhaustion of small prime factors**: after `m` passes of length `T` (`q < 2 ^ m`), no prime
`ℓ ≤ T + 1` divides the cofactor `q / smoothDivisorSeq q T (m * T)`. -/
theorem smoothDivisorSeq_not_dvd_div {q T m : ℕ} (hq : 0 < q) (hqm : q < 2 ^ m) {ℓ : ℕ}
    (hℓ : ℓ.Prime) (hℓT : ℓ ≤ T + 1) : ¬ ℓ ∣ q / smoothDivisorSeq q T (m * T) := by
  intro hdiv
  have hN := smoothDivisorSeq_dvd q T (m * T)
  have hℓ2 := hℓ.two_le
  have key : ∀ j ≤ m, ℓ ^ j ∣ smoothDivisorSeq q T (j * T) := by
    intro j
    induction j with
    | zero => intro _; simp [smoothDivisorSeq]
    | succ j ih =>
      intro hj
      have ih' := ih (by omega)
      have hr : ℓ - 2 < T := by omega
      have hkmod : (j * T + (ℓ - 2)) % T = ℓ - 2 := Nat.mul_add_mod_of_lt hr
      have hkN : j * T + (ℓ - 2) + 1 ≤ (j + 1) * T := by rw [Nat.succ_mul]; omega
      have hjm : (j + 1) * T ≤ m * T := Nat.mul_le_mul_right T hj
      have hDk :
          smoothDivisorSeq q T (j * T + (ℓ - 2)) ∣ smoothDivisorSeq q T (m * T) :=
        smoothDivisorSeq_mono q T (by omega)
      have hdiv' : ℓ ∣ q / smoothDivisorSeq q T (j * T + (ℓ - 2)) := by
        obtain ⟨u, hu⟩ := hDk
        obtain ⟨w, hw⟩ := hdiv
        have e1 :
            smoothDivisorSeq q T (m * T) * (q / smoothDivisorSeq q T (m * T)) = q :=
          Nat.mul_div_cancel' hN
        rw [hw, hu] at e1
        have e2 : q / smoothDivisorSeq q T (j * T + (ℓ - 2)) = u * (ℓ * w) := by
          apply Nat.div_eq_of_eq_mul_left (smoothDivisorSeq_pos hq T _)
          rw [show u * (ℓ * w) * smoothDivisorSeq q T (j * T + (ℓ - 2)) =
            smoothDivisorSeq q T (j * T + (ℓ - 2)) * u * (ℓ * w) by ring]
          exact e1.symm
        rw [e2]
        exact ⟨u * w, by ring⟩
      have hstep :
          smoothDivisorSeq q T (j * T + (ℓ - 2) + 1) =
            smoothDivisorSeq q T (j * T + (ℓ - 2)) * ℓ := by
        rw [smoothDivisorSeq, hkmod, show ℓ - 2 + 2 = ℓ by omega,
          ite_eq_left_iff.mpr fun h =>
            absurd (Nat.mul_dvd_of_dvd_div (smoothDivisorSeq_dvd q T _) hdiv') h]
      calc ℓ ^ (j + 1) = ℓ ^ j * ℓ := pow_succ _ _
        _ ∣ smoothDivisorSeq q T (j * T + (ℓ - 2)) * ℓ :=
          Nat.mul_dvd_mul_right (ih'.trans (smoothDivisorSeq_mono q T (by omega))) ℓ
        _ = smoothDivisorSeq q T (j * T + (ℓ - 2) + 1) := hstep.symm
        _ ∣ smoothDivisorSeq q T ((j + 1) * T) := smoothDivisorSeq_mono q T hkN
  have h1 : ℓ ^ m ∣ q := (key m le_rfl).trans hN
  have h2 : ℓ ^ m ≤ q := Nat.le_of_dvd hq h1
  have h3 : 2 ^ m ≤ ℓ ^ m := Nat.pow_le_pow_left hℓ2 m
  omega

/-- **Coprimality of the smooth divisor and its cofactor**: for `0 < q < 2 ^ m` and `0 < T`,
`smoothDivisorSeq q T (m * T)` and `q / smoothDivisorSeq q T (m * T)` are coprime. -/
theorem coprime_smoothDivisorSeq_div {q T m : ℕ} (hq : 0 < q) (hT : 0 < T) (hqm : q < 2 ^ m) :
    Nat.Coprime (smoothDivisorSeq q T (m * T)) (q / smoothDivisorSeq q T (m * T)) :=
  Nat.coprime_of_dvd fun _ hℓ h1 h2 =>
    smoothDivisorSeq_not_dvd_div hq hqm hℓ (smoothDivisorSeq_prime_le hT hℓ _ h1) h2

/-- Every prime factor of the cofactor `q / smoothDivisorSeq q T (m * T)` exceeds `T + 1`. -/
theorem prime_gt_of_dvd_div_smoothDivisorSeq {q T m : ℕ} (hq : 0 < q) (hqm : q < 2 ^ m) {ℓ : ℕ}
    (hℓ : ℓ.Prime) (h : ℓ ∣ q / smoothDivisorSeq q T (m * T)) : T + 1 < ℓ := by
  by_contra hc
  exact smoothDivisorSeq_not_dvd_div hq hqm hℓ (by omega) h

/-! ### CRT combination and composite-order transcript extraction (original) -/

/-- Boolean test for whether two challenges `r₁, r₂` collide modulo some prime factor `p > T` of
the group order `q`. -/
def hasLargePrimeCollision (T q r₁ r₂ : ℕ) : Bool :=
  decide (∃ p ∈ q.primeFactors, T < p ∧ r₁ % p = r₂ % p)

@[simp]
theorem hasLargePrimeCollision_eq_false_iff {T q r₁ r₂ : ℕ} :
    hasLargePrimeCollision T q r₁ r₂ = false ↔
      ∀ p ∈ q.primeFactors, T < p → r₁ % p ≠ r₂ % p := by
  simp [hasLargePrimeCollision]

/-- When no prime factor `p > T` of `q` divides `r₁ - r₂`
(`hasLargePrimeCollision T q r₁ r₂ = false`), the shifted challenge difference
`(r₁ + (q - r₂)) % L` is coprime to any divisor `L ∣ q` whose prime factors all exceed `T`. -/
theorem coprime_challenge_diff {q T L r₁ r₂ : ℕ} (hL : L ∣ q) (hq : 0 < q) (hr₂ : r₂ ≤ q)
    (hbig : ∀ ℓ, ℓ.Prime → ℓ ∣ L → T < ℓ)
    (hcoll : hasLargePrimeCollision T q r₁ r₂ = false) :
    Nat.Coprime ((r₁ + (q - r₂)) % L) L := by
  refine Nat.coprime_of_dvd fun ℓ hℓ h1 h2 => ?_
  have h1' : ℓ ∣ r₁ + (q - r₂) := (Nat.dvd_mod_iff h2).1 h1
  have hℓq : ℓ ∣ q := h2.trans hL
  have hz : ((r₁ + (q - r₂) : ℕ) : ZMod ℓ) = 0 := (ZMod.natCast_eq_zero_iff _ _).2 h1'
  have hq0 : ((q : ℕ) : ZMod ℓ) = 0 := (ZMod.natCast_eq_zero_iff _ _).2 hℓq
  rw [Nat.cast_add, Nat.cast_sub hr₂, hq0, zero_sub, ← sub_eq_add_neg, sub_eq_zero] at hz
  have hmod : r₁ % ℓ = r₂ % ℓ := (ZMod.natCast_eq_natCast_iff' _ _ _).1 hz
  rw [hasLargePrimeCollision_eq_false_iff] at hcoll
  exact hcoll ℓ (Nat.mem_primeFactors.2 ⟨hℓ, hℓq, by omega⟩) (hbig ℓ hℓ h2) hmod

/-- Recover `x % L` from two transcript responses `(s₁, s₂)` and an inverse `inv` of the challenge
difference modulo `L`. -/
def extractModRough (q L s₁ s₂ inv : ℕ) : ℕ :=
  (s₁ + (q - s₂)) % L * inv % L

/-- Given the linear transcript relation `s₁ - s₂ = x * (r₁ - r₂)` in `ZMod q` and an inverse `inv`
of `(r₁ + (q - r₂)) % L` modulo a divisor `L ∣ q`, `extractModRough q L s₁ s₂ inv` equals
`x % L`. -/
theorem extractModRough_eq_mod {q L x r₁ s₁ r₂ s₂ : ℕ} (hL : L ∣ q) (hr₂ : r₂ ≤ q) (hs₂ : s₂ ≤ q)
    (hrel : ((s₁ : ZMod q) - s₂) = (x : ZMod q) * ((r₁ : ZMod q) - r₂)) (inv : ℕ)
    (hinv : (inv : ZMod L) * (((r₁ + (q - r₂)) % L : ℕ) : ZMod L) = 1) :
    extractModRough q L s₁ s₂ inv = x % L := by
  unfold extractModRough
  have hrelL := congrArg (ZMod.castHom hL (ZMod L)) hrel
  simp only [map_sub, map_mul, map_natCast] at hrelL
  have hq0 : ((q : ℕ) : ZMod L) = 0 := (ZMod.natCast_eq_zero_iff _ _).2 hL
  rw [ZMod.natCast_mod, Nat.cast_add, Nat.cast_sub hr₂, hq0, add_sub, add_zero] at hinv
  rw [← ZMod.natCast_eq_natCast_iff']
  push_cast
  rw [ZMod.natCast_mod, Nat.cast_add, Nat.cast_sub hs₂, hq0, add_sub, add_zero, hrelL, mul_assoc,
    mul_comm _ (inv : ZMod L), hinv, mul_one]

/-- Chinese Remainder Theorem combination of `a = x % D` and `xL = x % L` using an inverse `inv` of
`D` modulo `L`; the summand `L - a % L` represents `-a` modulo `L` without ℕ-subtraction
underflow. -/
def crtCombine (D L a xL inv : ℕ) : ℕ :=
  a + D * ((xL + (L - a % L)) * inv % L)

/-- **Chinese Remainder Theorem reconstruction** (the two-modulus case of the CRT used in
[KatzLindell2020], Section 10.2.1, p. 374): for coprime `D` and `L` with `x < D * L`,
`a = x % D`, `xL = x % L`, and `inv * D ≡ 1 (mod L)`, `crtCombine D L a xL inv = x`. -/
theorem crtCombine_eq {D L x a xL : ℕ} (hD : 0 < D) (hL : 0 < L) (hcop : Nat.Coprime D L)
    (hx : x < D * L) (ha : a = x % D) (hxL : xL = x % L) (inv : ℕ)
    (hinv : (inv : ZMod L) * D = 1) :
    crtCombine D L a xL inv = x := by
  unfold crtCombine
  set u := (xL + (L - a % L)) * inv % L with hu
  have hult : u < L := Nat.mod_lt _ hL
  have halt : a < D := by rw [ha]; exact Nat.mod_lt _ hD
  have hmD : a + D * u ≡ x [MOD D] := by
    change (a + D * u) % D = x % D
    rw [Nat.add_mul_mod_self_left, ha, Nat.mod_mod]
  have hmL : a + D * u ≡ x [MOD L] := by
    rw [← ZMod.natCast_eq_natCast_iff]
    have hxL' : (xL : ZMod L) = x := by rw [hxL, ZMod.natCast_mod]
    have haL : ((L - a % L : ℕ) : ZMod L) = -a := by
      rw [Nat.cast_sub (Nat.mod_lt a hL).le, ZMod.natCast_self, ZMod.natCast_mod, zero_sub]
    rw [Nat.cast_add, Nat.cast_mul, hu, ZMod.natCast_mod, Nat.cast_mul, Nat.cast_add, haL, hxL']
    linear_combination (↑x - ↑a) * hinv
  have hlt : a + D * u < D * L := by nlinarith
  have := (Nat.modEq_and_modEq_iff_modEq_mul hcop).1 ⟨hmD, hmL⟩
  unfold Nat.ModEq at this
  rwa [Nat.mod_eq_of_lt hlt, Nat.mod_eq_of_lt hx] at this

/-- **Composite-order discrete-logarithm recovery** (original): combining a residue
`a = x % D` on the smooth divisor `D` with `extractModRough` on the coprime cofactor `L` (where
`D * L = q`) recovers the exact discrete logarithm `x < q`. -/
theorem crtCombine_extractModRough_eq {q D L x r₁ s₁ r₂ s₂ invDiff invD : ℕ}
    (hD : 0 < D) (hL : 0 < L) (hq : D * L = q) (hcop : Nat.Coprime D L)
    (hx : x < q) (hr₂ : r₂ ≤ q) (hs₂ : s₂ ≤ q)
    (hrel : ((s₁ : ZMod q) - s₂) = (x : ZMod q) * ((r₁ : ZMod q) - r₂))
    (hinvDiff : (invDiff : ZMod L) * (((r₁ + (q - r₂)) % L : ℕ) : ZMod L) = 1)
    (hinvD : (invD : ZMod L) * D = 1) :
    crtCombine D L (x % D) (extractModRough q L s₁ s₂ invDiff) invD = x := by
  have hL_dvd : L ∣ q := ⟨D, by rw [← hq, mul_comm]⟩
  have hxL := extractModRough_eq_mod hL_dvd hr₂ hs₂ hrel invDiff hinvDiff
  exact crtCombine_eq hD hL hcop (hq.symm ▸ hx) rfl hxL invD hinvD

/-- **Schnorr transcript congruence in a cyclic group** (original): if `g` has order `q` and two
transcripts `(r₁, s₁)` and `(r₂, s₂)` share the same commitment
`g ^ s₁ * (g ^ x) ^ (-r₁) = g ^ s₂ * (g ^ x) ^ (-r₂)`, then `s₁ - s₂ = x * (r₁ - r₂)` in
`ZMod q`. -/
@[to_additive schnorr_nsmul_transcript_relation
/-- **Additive Schnorr transcript congruence**: if `g` has additive order `q` and two transcripts
`(r₁, s₁)` and `(r₂, s₂)` share the same commitment
`s₁ • g + (-r₁) • (x • g) = s₂ • g + (-r₂) • (x • g)`, then `s₁ - s₂ = x * (r₁ - r₂)` in
`ZMod q`. -/]
theorem schnorr_transcript_relation {M : Type*} [Group M] (g : M) {q : ℕ} (hg : orderOf g = q)
    (x r₁ s₁ r₂ s₂ : ℕ)
    (h : g ^ s₁ * (g ^ x) ^ (-(r₁ : ℤ)) = g ^ s₂ * (g ^ x) ^ (-(r₂ : ℤ))) :
    ((s₁ : ZMod q) - s₂) = (x : ZMod q) * ((r₁ : ZMod q) - r₂) := by
  have key : ∀ s r : ℕ, g ^ s * (g ^ x) ^ (-(r : ℤ)) = g ^ ((s : ℤ) - x * r) := by
    intro s r
    rw [← zpow_natCast, ← zpow_natCast, ← zpow_mul, ← zpow_add]
    congr 1; ring
  rw [key, key, zpow_eq_zpow_iff_modEq, hg, ← ZMod.intCast_eq_intCast_iff] at h
  push_cast at h
  linear_combination h

end Cslib.Crypto
