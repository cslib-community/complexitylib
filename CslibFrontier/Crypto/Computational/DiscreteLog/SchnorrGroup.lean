/-!
# Schnorr groups

A Schnorr group is the subgroup of prime order `q` of `(ZMod p)ˣ`, for a prime `p`, generated by
a residue `g` of multiplicative order `q`. Its public group parameters are the triple `(p, q, g)`
of binary numbers; its elements are encoded by the binary digits of their residues. Multiplication
and exponentiation are computed modulo `p`, by schoolbook multiplication and square-and-multiply.
These groups form a `PrimeOrderGroupFamily`, so the discrete-logarithm assumption and the
security theorems stated for such families apply to them.

A parameter bundle is valid when `p` and `q` are prime, `1 < g < p` and `g ^ q % p = 1`; these
facts imply that `g` has order `q` and that `q` divides `p - 1`. `SchnorrGroup.Desc` contains the
triple together with proofs of these conditions. For example, `(23, 11, 2)` selects the subgroup
of order `11` modulo `23` generated by `2`. The fixed family `schnorrGroups` supplies modular
arithmetic algorithms for every such bundle. `encDesc` encodes just the binary triple, while
validity is part of the Lean input type. Nothing here claims efficient generation of valid
parameter bundles.

## Main definitions

* `Cslib.Crypto.SchnorrGroup.Valid`: validity of public group parameters `(p, q, g)`.
* `Cslib.Crypto.SchnorrGroup.Desc`: parameter bundles carrying their validity proofs.
* `Cslib.Crypto.schnorrGroups`: Schnorr groups as a `PrimeOrderGroupFamily`.

## References

* [D. Boneh, V. Shoup, *A Graduate Course in Applied Cryptography*,
  Version 0.6][BonehShoup2023], Section 10.4.
* [C.-P. Schnorr, *Efficient Signature Generation by Smart Cards*][Schnorr1991]
-/

@[expose] public section

namespace Cslib.Crypto

open Turing.MultiTapeTM

namespace SchnorrGroup

/-- The prime modulus `p` of a raw Schnorr-group description `(p, q, g)`. -/
abbrev rawModulus (d : ℕ × ℕ × ℕ) : ℕ := d.1

/-- The prime subgroup order `q` of a raw Schnorr-group description `(p, q, g)`. -/
abbrev rawOrder (d : ℕ × ℕ × ℕ) : ℕ := d.2.1

/-- The subgroup generator residue `g` of a raw Schnorr-group description `(p, q, g)`. -/
abbrev rawGeneratorResidue (d : ℕ × ℕ × ℕ) : ℕ := d.2.2

/-- Validity of public Schnorr-group parameters `(p, q, g)`: `p` and `q` are prime, and the residue
`g` satisfies `1 < g < p` and `g ^ q ≡ 1 (mod p)`. -/
structure Valid (d : ℕ × ℕ × ℕ) : Prop where
  /-- The modulus is prime. -/
  prime_modulus : (rawModulus d).Prime
  /-- The group order is prime. -/
  prime_order : (rawOrder d).Prime
  /-- The generator is not `0` or `1`. -/
  one_lt_generator : 1 < rawGeneratorResidue d
  /-- The generator is a reduced residue. -/
  generator_lt : rawGeneratorResidue d < rawModulus d
  /-- The generator has order dividing `q`. -/
  generator_pow : rawGeneratorResidue d ^ rawOrder d % rawModulus d = 1

/-- Public Schnorr-group parameters `(p, q, g)` together with validity proofs. A value selects
the subgroup of order `q` modulo `p` generated by `g`; for example, `(23, 11, 2)`. -/
abbrev Desc : Type := {d : ℕ × ℕ × ℕ // Valid d}

/-- The prime modulus `p` of a valid Schnorr-group description `(p, q, g)`. -/
abbrev Desc.modulus (d : Desc) : ℕ := rawModulus d.val

/-- The prime subgroup order `q` of a valid Schnorr-group description `(p, q, g)`. -/
abbrev Desc.order (d : Desc) : ℕ := rawOrder d.val

/-- The subgroup generator residue `g` of a valid Schnorr-group description `(p, q, g)`. -/
abbrev Desc.generatorResidue (d : Desc) : ℕ := rawGeneratorResidue d.val

/-- The generator as a unit modulo `p`. -/
def generatorUnit (d : Desc) : (ZMod d.modulus)ˣ :=
  ZMod.unitOfCoprime d.generatorResidue ((Nat.coprime_comm.mp
    ((d.2.prime_modulus.coprime_iff_not_dvd).mpr
      (Nat.not_dvd_of_pos_of_lt (by have := d.2.one_lt_generator; lia) d.2.generator_lt))))

/-- The Schnorr group of a description, written additively. -/
abbrev Carrier (d : Desc) : Type := Additive (Subgroup.zpowers (generatorUnit d))

instance (d : Desc) : Fact d.order.Prime := ⟨d.2.prime_order⟩

/-- The generator has order dividing `q`. -/
theorem generatorUnit_pow_order (d : Desc) : generatorUnit d ^ d.order = 1 := by
  ext
  rw [Units.val_pow_eq_pow_val, generatorUnit, ZMod.coe_unitOfCoprime, Units.val_one,
    ← Nat.cast_pow, ← ZMod.natCast_mod, d.2.generator_pow, Nat.cast_one]

/-- Every element of the Schnorr group has order dividing `q`. -/
theorem pow_order (d : Desc) (x : Subgroup.zpowers (generatorUnit d)) :
    x ^ d.order = 1 := by
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp x.2
  ext
  rw [Subgroup.coe_pow, ← hk, ← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast,
    generatorUnit_pow_order, one_zpow, Subgroup.coe_one]

instance (d : Desc) : Module (ZMod d.order) (Carrier d) :=
  AddCommMonoid.zmodModule fun x => Additive.toMul.injective (by
    rw [toMul_nsmul, pow_order, toMul_zero])

instance (d : Desc) : NeZero d.modulus := ⟨d.2.prime_modulus.ne_zero⟩

/-- The generator is not the identity. -/
theorem generatorUnit_ne_one (d : Desc) : generatorUnit d ≠ 1 := fun h => by
  have hval := congrArg (fun u : (ZMod d.modulus)ˣ => (u : ZMod d.modulus).val) h
  simp only [generatorUnit, ZMod.coe_unitOfCoprime, ZMod.val_natCast,
    Nat.mod_eq_of_lt d.2.generator_lt, Units.val_one,
    ZMod.val_one_eq_one_mod, Nat.mod_eq_of_lt d.2.prime_modulus.one_lt] at hval
  exact absurd hval (ne_of_gt d.2.one_lt_generator)

/-- The generator of the Schnorr group. -/
def generator (d : Desc) : Carrier d :=
  Additive.ofMul ⟨generatorUnit d, Subgroup.mem_zpowers _⟩

/-- The Schnorr group has `q` elements. -/
theorem card_carrier (d : Desc) : Nat.card (Carrier d) = d.order := by
  change Nat.card (Subgroup.zpowers (generatorUnit d)) = d.1.2.1
  rw [Nat.card_zpowers, orderOf_eq_prime (generatorUnit_pow_order d) (generatorUnit_ne_one d)]

/-- The generator is not the identity of the Schnorr group. -/
theorem generator_ne_zero (d : Desc) : generator d ≠ 0 := fun h =>
  generatorUnit_ne_one d (congrArg (fun x : Carrier d => ((Additive.toMul x :
    Subgroup.zpowers (generatorUnit d)) : (ZMod d.modulus)ˣ)) h)

/-- Elements are encoded by the binary digits of their residues modulo `p`. -/
def encode (d : Desc) (x : Carrier d) : List Bool :=
  ((((Additive.toMul x : Subgroup.zpowers (generatorUnit d)) : (ZMod d.modulus)ˣ) :
    ZMod d.modulus).val).bits

/-- Distinct elements have distinct encodings. -/
theorem encode_injective (d : Desc) : Function.Injective (encode d) := fun _ _ h =>
  Additive.toMul.injective (Subtype.ext (Units.ext (ZMod.val_injective _
    (encNat.injective h))))

/-- Multiplication modulo `p` of encoded residues. -/
def add : Desc × List Bool × List Bool → List Bool
  | (d, x, y) => (ofBits x * ofBits y % d.modulus).bits

/-- `add` multiplies encoded group elements. -/
theorem add_encode (d : Desc) (x y : Carrier d) :
    add (d, encode d x, encode d y) = encode d (x + y) := by
  simp only [add, encode, ofBits_bits, toMul_add, Subgroup.coe_mul, Units.val_mul, ZMod.val_mul]

/-- Exponentiation modulo `p` of an encoded residue. -/
def smul : Desc × ℕ × List Bool → List Bool
  | (d, a, x) => (ofBits x ^ a % d.modulus).bits

/-- `smul` raises encoded group elements to natural powers. -/
theorem smul_encode (d : Desc) (a : ℕ) (x : Carrier d) :
    smul (d, a, encode d x) = encode d ((a : ZMod d.order) • x) := by
  rw [Nat.cast_smul_eq_nsmul]
  simp only [smul, encode, ofBits_bits, toMul_nsmul, Subgroup.coe_pow, Units.val_pow_eq_pow_val]
  rw [← ZMod.val_natCast, Nat.cast_pow, ZMod.natCast_zmod_val]

/-- The encoded generator is the binary digits of `g`. -/
theorem encode_generator (d : Desc) : encode d (generator d) = d.generatorResidue.bits := by
  change (((generatorUnit d : (ZMod d.1.1)ˣ) : ZMod d.1.1).val).bits = _
  rw [generatorUnit, ZMod.coe_unitOfCoprime, ZMod.val_natCast,
    Nat.mod_eq_of_lt d.2.generator_lt]

/-- Encode the public group parameters as the binary triple `(p, q, g)`. The validity proofs in
`Desc` do not contribute bits. -/
def encDesc : Desc ↪ List Bool :=
  (Function.Embedding.subtype _).trans (encPair encNat (encPair encNat encNat))

/-- Forgetting validity does not change the encoding. -/
private theorem computableInPolyTime_val :
    ComputableInPolyTime (Subtype.val : Desc → ℕ × ℕ × ℕ) encDesc
      (encPair encNat (encPair encNat encNat)) :=
  ComputableInPolyTime.of_eq fun _ => rfl

/-- The group order is computable in polynomial time from the description. -/
theorem computableInPolyTime_order :
    ComputableInPolyTime Desc.order encDesc encNat := by
  have := computableInPolyTime_val
  unfold Desc.order rawOrder
  fun_prop

/-- The encoded generator is computable in polynomial time from the description. -/
theorem computableInPolyTime_generator :
    ComputableInPolyTime (fun d => encode d (generator d)) encDesc encBits := by
  have := computableInPolyTime_val
  simp only [encode_generator, Desc.generatorResidue, rawGeneratorResidue]
  fun_prop

/-- Multiplication modulo `p` is computable in polynomial time. -/
theorem computableInPolyTime_add :
    ComputableInPolyTime add (encPair encDesc (encPair encBits encBits)) encBits := by
  have := computableInPolyTime_val
  unfold add Desc.modulus rawModulus
  fun_prop

/-- Exponentiation modulo `p` is computable in polynomial time, by square-and-multiply. -/
theorem computableInPolyTime_smul :
    ComputableInPolyTime smul (encPair encDesc (encPair encNat encBits)) encBits := by
  have hval := computableInPolyTime_val
  have hpow : ComputableInPolyTime
      (fun input : Desc × ℕ × List Bool => ofBits input.2.2 ^ input.2.1 % input.1.1.1)
      (encPair encDesc (encPair encNat encBits)) encNat :=
    ComputableInPolyTime.binary_powMod (by fun_prop) (by fun_prop) (by fun_prop)
      fun input => input.1.2.prime_modulus.pos
  unfold smul Desc.modulus rawModulus
  fun_prop

end SchnorrGroup

open SchnorrGroup in
/-- Schnorr groups with efficient operations. This fixes the modular arithmetic algorithms;
each `d : schnorrGroups.Desc` supplies public parameters `(p, q, g)` and their validity proofs,
selecting the subgroup of order `q` of `(ZMod p)ˣ` generated by `g`. -/
def schnorrGroups : PrimeOrderGroupFamily where
  Desc := SchnorrGroup.Desc
  encDesc := SchnorrGroup.encDesc
  order := Desc.order
  prime_order d := d.2.prime_order
  Carrier := Carrier
  generator := generator
  card_carrier := card_carrier
  generator_ne_zero := generator_ne_zero
  encode := encode
  encode_injective := encode_injective
  add := add
  add_encode := add_encode
  smul := smul
  smul_encode := smul_encode
  computableInPolyTime_order := computableInPolyTime_order
  computableInPolyTime_generator := computableInPolyTime_generator
  computableInPolyTime_add := computableInPolyTime_add
  computableInPolyTime_smul := computableInPolyTime_smul

end Cslib.Crypto
