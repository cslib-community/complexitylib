/-!
# Decodable Schnorr groups

This module instantiates `DecodablePrimeOrderGroupFamily` for `schnorrGroups`
(`schnorrDecodableGroups`). Because `ZMod d.modulus` is a field (`d.2.prime_modulus`) and the
subgroup `Carrier d` already has prime cardinality `d.order`, every residue `u : (ZMod d.modulus)ˣ`
satisfying `u ^ d.order = 1` lies in `Subgroup.zpowers (generatorUnit d)`: `X ^ d.order - 1` has
at most `d.order` roots in `ZMod d.modulus` (`Polynomial.card_roots'`), all `d.order` elements of
`Carrier d` are roots, so they exhaust the roots (`mem_zpowers_of_pow_eq_one`).

Checking canonical binary digits (`encNat (ofBits w) == w`), positive reduced range
(`0 < ofBits w < d.modulus`), and `ofBits w ^ d.order % d.modulus = 1` therefore decides exact
subgroup membership in polynomial time (`SchnorrGroup.isElem`), giving a two-sided canonical
decoder `SchnorrGroup.decode`.

## Main definitions

* `Cslib.Crypto.SchnorrGroup.isElem`: polynomial-time subgroup membership test checking canonical
  binary encoding, positive reduced range modulo `p`, and `a ^ q % p = 1`.
* `Cslib.Crypto.SchnorrGroup.decode`: canonical decoder for Schnorr group elements.
* `Cslib.Crypto.schnorrDecodableGroups`: `schnorrGroups` as a `DecodablePrimeOrderGroupFamily`.

## Main results

* `Cslib.Crypto.SchnorrGroup.mem_zpowers_of_pow_eq_one`: every `u : (ZMod d.modulus)ˣ` with
  `u ^ d.order = 1` belongs to `Subgroup.zpowers (generatorUnit d)`.
* `Cslib.Crypto.SchnorrGroup.computableInPolyTime_isElem`: `SchnorrGroup.isElem` is computable in
  polynomial time.
* `Cslib.Crypto.SchnorrGroup.decode_encode`,
  `Cslib.Crypto.SchnorrGroup.encode_eq_of_decode_eq_some`: canonical round-trip laws for
  `SchnorrGroup.decode`.
-/

public section

namespace Cslib.Crypto

open Turing.MultiTapeTM

namespace SchnorrGroup

/-- Membership test for encoded Schnorr group elements: checks that `w` is a canonical binary
natural `a = ofBits w`, `0 < a < d.modulus`, and `a ^ d.order % d.modulus = 1`. -/
@[expose] def isElem (p : Desc × List Bool) : Bool :=
  (encNat (ofBits p.2) == p.2) &&
    decide (0 < ofBits p.2 ∧ ofBits p.2 < p.1.modulus ∧ ofBits p.2 ^ p.1.order % p.1.modulus = 1)

private theorem isElem_pos {d : Desc} {w : List Bool} (h : isElem (d, w) = true) :
    0 < ofBits w := by
  simp only [isElem, Bool.and_eq_true, decide_eq_true_eq] at h
  exact h.2.1

private theorem isElem_lt {d : Desc} {w : List Bool} (h : isElem (d, w) = true) :
    ofBits w < d.modulus := by
  simp only [isElem, Bool.and_eq_true, decide_eq_true_eq] at h
  exact h.2.2.1

private theorem isElem_pow {d : Desc} {w : List Bool} (h : isElem (d, w) = true) :
    ofBits w ^ d.order % d.modulus = 1 := by
  simp only [isElem, Bool.and_eq_true, decide_eq_true_eq] at h
  exact h.2.2.2

private theorem isElem_bits {d : Desc} {w : List Bool} (h : isElem (d, w) = true) :
    (ofBits w).bits = w := by
  simp only [isElem, Bool.and_eq_true, beq_iff_eq] at h
  exact h.1

/-- Every unit modulo `d.modulus` whose `d.order`-th power is `1` lies in the Schnorr subgroup
generated by `generatorUnit d`, because `X ^ d.order - 1` has at most `d.order` roots over the
field `ZMod d.modulus` and `Carrier d` already supplies `d.order` distinct roots. -/
theorem mem_zpowers_of_pow_eq_one (d : Desc) (u : (ZMod d.modulus)ˣ)
    (hu : u ^ d.order = 1) : u ∈ Subgroup.zpowers (generatorUnit d) := by
  have : Fact d.modulus.Prime := ⟨d.2.prime_modulus⟩
  let S : Finset (ZMod d.modulus) :=
    (Finset.univ : Finset (Subgroup.zpowers (generatorUnit d))).image
      fun (x : Subgroup.zpowers (generatorUnit d)) => ((x : (ZMod d.modulus)ˣ) : ZMod d.modulus)
  let f : Polynomial (ZMod d.modulus) := Polynomial.X ^ d.order - 1
  have hf : f ≠ 0 := by
    intro h0
    have hc := congrArg (fun p : Polynomial (ZMod d.modulus) => p.coeff d.order) h0
    have hq0 : d.order ≠ 0 := d.2.prime_order.ne_zero
    simp only [f, Polynomial.coeff_sub, Polynomial.coeff_X_pow, ↓reduceIte,
      Polynomial.coeff_one, hq0, sub_zero, Polynomial.coeff_zero] at hc
    exact one_ne_zero hc
  have hsub : S ⊆ f.roots.toFinset := by
    intro r hr
    rcases Finset.mem_image.mp hr with ⟨x, _, rfl⟩
    rw [Multiset.mem_toFinset, Polynomial.mem_roots hf, Polynomial.IsRoot.def]
    simp only [f, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
      Polynomial.eval_one, sub_eq_zero]
    have hx := pow_order d x
    have hx' := congrArg (fun z : Subgroup.zpowers (generatorUnit d) =>
      ((z : (ZMod d.modulus)ˣ) : ZMod d.modulus)) hx
    simpa using hx'
  have hcardS : S.card = d.order := by
    rw [Finset.card_image_of_injective _ fun x y hxy =>
      Subtype.ext (Units.ext hxy), Finset.card_univ, ← Nat.card_eq_fintype_card]
    exact card_carrier d
  have hcardR : f.roots.toFinset.card ≤ S.card := by
    rw [hcardS]
    refine (Multiset.toFinset_card_le _).trans ((Polynomial.card_roots' f).trans ?_)
    refine (Polynomial.natDegree_sub_le _ _).trans (max_le ?_ ?_)
    · exact Polynomial.natDegree_X_pow_le d.order
    · simp
  have heq := Finset.eq_of_subset_of_card_le hsub hcardR
  have hur : (u : ZMod d.modulus) ∈ f.roots.toFinset := by
    rw [Multiset.mem_toFinset, Polynomial.mem_roots hf, Polynomial.IsRoot.def]
    simp only [f, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
      Polynomial.eval_one, sub_eq_zero]
    have hu' := congrArg (fun z : (ZMod d.modulus)ˣ => (z : ZMod d.modulus)) hu
    simpa using hu'
  rw [← heq] at hur
  rcases Finset.mem_image.mp hur with ⟨x, _, hx⟩
  have hxu : (x : (ZMod d.modulus)ˣ) = u := by
    ext
    exact hx
  rw [← hxu]
  exact SetLike.coe_mem x

/-- Decode a candidate bit string as an element of `Carrier d` if `isElem (d, w)` holds. -/
def decode (d : Desc) (w : List Bool) : Option (Carrier d) :=
  if h : isElem (d, w) = true then
    let u : (ZMod d.modulus)ˣ :=
      ZMod.unitOfCoprime (ofBits w)
        (Nat.coprime_comm.mp
          (d.2.prime_modulus.coprime_iff_not_dvd.mpr
            (Nat.not_dvd_of_pos_of_lt (isElem_pos h) (isElem_lt h))))
    have hu : u ∈ Subgroup.zpowers (generatorUnit d) := by
      refine mem_zpowers_of_pow_eq_one d u ?_
      ext
      rw [Units.val_pow_eq_pow_val, ZMod.coe_unitOfCoprime, Units.val_one,
        ← Nat.cast_pow, ← ZMod.natCast_mod, isElem_pow h, Nat.cast_one]
    some (Additive.ofMul ⟨u, hu⟩)
  else
    none

/-- `decode` accepts only canonical element encodings. -/
theorem encode_eq_of_decode_eq_some {d : Desc} {w : List Bool} {x : Carrier d}
    (h : decode d w = some x) : w = encode d x := by
  by_cases he : isElem (d, w) = true
  · simp only [decode, he, ↓reduceDIte, Option.some.injEq] at h
    subst h
    unfold encode
    simp only [toMul_ofMul, Subgroup.coe_mk, ZMod.coe_unitOfCoprime, ZMod.val_natCast,
      Nat.mod_eq_of_lt (isElem_lt he), isElem_bits he]
  · simp [decode, he] at h

/-- Every encoded Schnorr group element passes `isElem`. -/
theorem isElem_encode (d : Desc) (x : Carrier d) : isElem (d, encode d x) = true := by
  have hne : NeZero d.modulus := ⟨d.2.prime_modulus.ne_zero⟩
  have h1lt : Fact (1 < d.modulus) := ⟨d.2.prime_modulus.one_lt⟩
  let u : (ZMod d.modulus)ˣ := (Additive.toMul x : Subgroup.zpowers (generatorUnit d))
  have hval_ne : (u : ZMod d.modulus).val ≠ 0 := by
    intro hv0
    have h0 : (u : ZMod d.modulus) = 0 := by
      rw [← ZMod.natCast_zmod_val (u : ZMod d.modulus), hv0, Nat.cast_zero]
    exact Units.ne_zero u h0
  have hpow : (u : ZMod d.modulus).val ^ d.order % d.modulus = 1 := by
    rw [← ZMod.val_natCast, Nat.cast_pow, ZMod.natCast_zmod_val, ← Units.val_pow_eq_pow_val]
    have h1 := pow_order d (Additive.toMul x)
    have h1' := congrArg (fun z : Subgroup.zpowers (generatorUnit d) =>
      (((z : (ZMod d.modulus)ˣ) : ZMod d.modulus)).val) h1
    change (((u ^ d.order : (ZMod d.modulus)ˣ) : ZMod d.modulus)).val =
      (1 : ZMod d.modulus).val at h1'
    rwa [ZMod.val_one_eq_one_mod, Nat.mod_eq_of_lt d.2.prime_modulus.one_lt] at h1'
  change isElem (d, ((u : ZMod d.modulus).val).bits) = true
  simp only [isElem, ofBits_bits, Bool.and_eq_true, decide_eq_true_eq]
  exact ⟨beq_iff_eq.mpr rfl, Nat.pos_of_ne_zero hval_ne, ZMod.val_lt _, hpow⟩

/-- Decoding an encoded Schnorr group element recovers it. -/
theorem decode_encode (d : Desc) (x : Carrier d) : decode d (encode d x) = some x := by
  cases h : decode d (encode d x) with
  | none =>
    simp [decode, isElem_encode d x] at h
  | some y =>
    exact congrArg some ((encode_injective d) (encode_eq_of_decode_eq_some h).symm)

/-- `(decode d w).isSome` agrees with `isElem (d, w)`. -/
theorem isSome_decode_eq_isElem (p : Desc × List Bool) :
    (decode p.1 p.2).isSome = isElem p := by
  by_cases h : isElem p = true <;> simp [decode, h]

/-- `SchnorrGroup.isElem` is computable in polynomial time. -/
theorem computableInPolyTime_isElem :
    ComputableInPolyTime isElem (encPair encDesc encBits) encBool := by
  have hval : ComputableTidilyInPolyTime (Subtype.val : Desc → ℕ × ℕ × ℕ) encDesc
      (encPair encNat (encPair encNat encNat)) :=
    ComputableTidilyInPolyTime.of_eq fun _ => rfl
  have hdesc := hval.comp (ComputableTidilyInPolyTime.fst encDesc encBits)
  have hmod : ComputableTidilyInPolyTime (fun p : Desc × List Bool => p.1.modulus)
      (encPair encDesc encBits) encNat :=
    hdesc.fst'.of_enc_eq fun _ => rfl
  have hord : ComputableTidilyInPolyTime (fun p : Desc × List Bool => p.1.order)
      (encPair encDesc encBits) encNat :=
    hdesc.snd'.fst'.of_enc_eq fun _ => rfl
  have ha : ComputableTidilyInPolyTime (fun p : Desc × List Bool => ofBits p.2)
      (encPair encDesc encBits) encNat :=
    ComputableTidilyInPolyTime.bitsToNat.comp (ComputableTidilyInPolyTime.snd encDesc encBits)
  have hbeq : ComputableTidilyInPolyTime (fun p : Desc × List Bool => encNat (ofBits p.2) == p.2)
      (encPair encDesc encBits) encBool :=
    ComputableTidilyInPolyTime.beq
      ((ComputableTidilyInPolyTime.encode encNat).comp ha)
      (ComputableTidilyInPolyTime.snd encDesc encBits)
  have h0 : ComputableTidilyInPolyTime (fun p : Desc × List Bool => decide (0 < ofBits p.2))
      (encPair encDesc encBits) encBool :=
    ComputableTidilyInPolyTime.binary_lt.comp
      ((ComputableTidilyInPolyTime.const 0).prod ha)
  have hlt : ComputableTidilyInPolyTime
      (fun p : Desc × List Bool => decide (ofBits p.2 < p.1.modulus))
      (encPair encDesc encBits) encBool :=
    ComputableTidilyInPolyTime.binary_lt.comp (ha.prod hmod)
  have hpow : ComputableInPolyTime
      (fun p : Desc × List Bool => ofBits p.2 ^ p.1.order % p.1.modulus)
      (encPair encDesc encBits) encNat :=
    ComputableInPolyTime.binary_powMod ha.computableInPolyTime hord.computableInPolyTime
      hmod.computableInPolyTime fun p => p.1.2.prime_modulus.pos
  have heq1 : ComputableTidilyInPolyTime
      (fun p : Desc × List Bool => decide (ofBits p.2 ^ p.1.order % p.1.modulus = 1))
      (encPair encDesc encBits) encBool :=
    (ComputableTidilyInPolyTime.decide_eq encNat).comp
      (hpow.tidy.prod (ComputableTidilyInPolyTime.const 1))
  exact (hbeq.bool_and' (h0.decide_and (hlt.decide_and heq1))).computableInPolyTime.of_enc_eq
    fun p => by simp only [isElem]

end SchnorrGroup

open SchnorrGroup in
/-- Schnorr groups instantiated as a `DecodablePrimeOrderGroupFamily`. -/
@[expose] def schnorrDecodableGroups : DecodablePrimeOrderGroupFamily where
  toPrimeOrderGroupFamily := schnorrGroups
  decode := decode
  decode_encode := decode_encode
  encode_eq_of_decode_eq_some := encode_eq_of_decode_eq_some
  computableInPolyTime_isElem :=
    computableInPolyTime_isElem.of_enc_eq fun p =>
      congrArg encBool (isSome_decode_eq_isElem p)

end Cslib.Crypto
