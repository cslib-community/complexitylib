public import CslibFrontier.Crypto.Computational.SIS.ModuleEncryption
public import CslibFrontier.Crypto.Computational.LWE.KeyGen
public import CslibFrontier.Computability.Probabilistic.CenteredBinomial
import CslibFrontier.Languages.Probabilistic.Norm

/-!
# Secret laws and centered-binomial Module-LWE sampling

The existing key/encryption laws accept explicit long-term and ephemeral distributions. Their
uniform defaults are unchanged. Conditioning the public-key generator on the sampled secret
retains the correct secret/public-key correlation; forgetting that secret gives exactly the
existing public encryption view.

The concrete small-secret instance reuses the centered-binomial program and modular scalar law.
Nested list sampling has a native strict polynomial-time certificate with unary dimensions and
width, and binary signed output. The finite-vector law and modular casts are semantic identities;
no native certificate for the complete encryption scheme is asserted here. A strict no-wrap
margin identifies each sampled integer with the centered lift of its residue.

## Main results

* `moduleLWEPublicKeyLaw_bind_secret`, `realEncryptionView_bind_secret`: condition on the
  actual sampled secret without changing the public marginal.
* `realEncryptionView_retained_secret_marginal`: forgetting the retained secret recovers the view.
* `isPPTOn_moduleLWECenteredBinomialRows`: the actual nested-list sampler's uniform certificate.
* `eval_moduleLWECenteredBinomialRows`, `eval_moduleLWECenteredBinomial_mod`: exact joint laws.
* `moduleLWECenteredBinomial_inInfNormBound`: centered support bound under the no-wrap margin.

The security reductions in `ModuleEncryption` remain specialized to uniform secrets. These
sampling results add no small-secret security claim or randomized correctness conclusion.
-/

public section

namespace Cslib.Crypto

open Probability ProbComp Turing.MultiTapeTM

/-- Conditioning on the sampled secret preserves the actual public-key law. -/
theorem moduleLWEPublicKeyLaw_bind_secret {k n q : ℕ} [NeZero q]
    (noise : PMF (Fin n → ZMod q)) (secretLaw : PMF (Fin k → Fin n → ZMod q)) :
    moduleLWEPublicKeyLaw k n q noise secretLaw = (do
      let s ← secretLaw
      moduleLWEPublicKeyLaw k n q noise (PMF.pure s)) := by
  simp [moduleLWEPublicKeyLaw]

/-- The public view can be generated by first retaining the secret and using its conditional
public-key law. The ephemeral secret remains an independent draw from the specified law. -/
theorem realEncryptionView_bind_secret {k n q : ℕ} [NeZero q]
    (noise : PMF (Fin n → ZMod q)) (m : Fin n → Bool)
    (secretLaw ephemeralLaw : PMF (Fin k → Fin n → ZMod q)) :
    realEncryptionView k n q noise m secretLaw ephemeralLaw = (do
      let s ← secretLaw
      encryptionViewOfKeyLaw (moduleLWEPublicKeyLaw k n q noise (PMF.pure s))
        noise m ephemeralLaw) := by
  simp [realEncryptionView, encryptionViewOfKeyLaw, moduleLWEPublicKeyLaw]

/-- This retained-secret experiment uses the very secret that generated the public key.
Its public marginal is the generalized existing view, not a separately resampled experiment. -/
theorem realEncryptionView_retained_secret_marginal {k n q : ℕ} [NeZero q]
    (noise : PMF (Fin n → ZMod q)) (m : Fin n → Bool)
    (secretLaw ephemeralLaw : PMF (Fin k → Fin n → ZMod q)) :
    (do
      let s ← secretLaw
      let view ← encryptionViewOfKeyLaw (moduleLWEPublicKeyLaw k n q noise (PMF.pure s))
        noise m ephemeralLaw
      pure (s, view)).map Prod.snd =
      realEncryptionView k n q noise m secretLaw ephemeralLaw := by
  rw [realEncryptionView_bind_secret]
  simp only [pmf_norm]

/-- One native sampler handles every unary row count, degree and centered-binomial width.
The output contains all signed integers in framed rows, with their binary magnitudes charged. -/
theorem isPPTOn_moduleLWECenteredBinomialRows :
    IsPPTOn (encPair (encPair encUnary encUnary) encUnary) (encList (encList encIntBin))
      (fun a : (ℕ × ℕ) × ℕ => OracleComp.replicate a.1.1
        (OracleComp.replicate a.1.2 (sampleCenteredBinomial a.2))) := by
  fun_prop

/-- The native list program represents the same complete joint sample as nested finite vectors. -/
theorem eval_moduleLWECenteredBinomialRows (k n η : ℕ) :
    ProbComp.eval (OracleComp.replicate k (OracleComp.replicate n (sampleCenteredBinomial η))) =
      (ProbComp.eval (OracleComp.replicateFin k
        (OracleComp.replicateFin n (sampleCenteredBinomial η)))).map
          (fun values => List.ofFn fun j => List.ofFn (values j)) := by
  apply ProbComp.eval_replicateFin_map
  rw [← OracleComp.map_ofFn_replicateFin, ProbComp.eval_map]

/-- The modular secret law is the existing scalar centered-binomial law sampled independently
at each module and polynomial coordinate. No separate scalar distribution is introduced. -/
theorem eval_moduleLWECenteredBinomial_mod (k n w η : ℕ) :
    (ProbComp.eval (OracleComp.replicateFin k
      (OracleComp.replicateFin n (sampleCenteredBinomial η)))).map
        (fun values j i => (values j i : ZMod (2 ^ w))) =
      PMF.pi (fun _ : Fin k => PMF.pi (fun _ : Fin n => LWE.noiseLaw w η)) := by
  rw [← ProbComp.eval_replicateFin_map_coords k
    (OracleComp.replicateFin n (sampleCenteredBinomial η))
    (fun values (i : Fin n) => (values i : ZMod (2 ^ w))), ProbComp.eval_replicateFin]
  simp only [ProbComp.eval_map, LWE.eval_errorVector_mod]

/-- Under the strict no-wrap margin, every coefficient of the sampled modular vector has
centered magnitude at most the actual centered-binomial width. -/
theorem moduleLWECenteredBinomial_inInfNormBound {k n w η : ℕ}
    (hwrap : 2 * η < 2 ^ w) {s : Fin k → Fin n → ZMod (2 ^ w)}
    (hs : s ∈ (PMF.pi (fun _ : Fin k =>
      PMF.pi (fun _ : Fin n => LWE.noiseLaw w η))).support) :
    ModuleSIS.inInfNormBound η s := by
  intro j i
  have hi := (PMF.mem_support_pi_iff _ _).mp ((PMF.mem_support_pi_iff _ _).mp hs j) i
  obtain ⟨z, hz, hzi⟩ := (PMF.mem_support_map_iff _ _ _).mp hi
  have hbound := (mem_support_sampleCenteredBinomial_iff η z).mp hz
  have hlift : (z : ZMod (2 ^ w)).valMinAbs = z := by
    rw [ZMod.valMinAbs_spec]
    exact ⟨rfl, by omega, by omega⟩
  rw [← hzi]
  change |(z : ZMod (2 ^ w)).valMinAbs| ≤ (η : ℤ)
  rw [hlift, Int.abs_eq_natAbs]
  exact_mod_cast hbound

end Cslib.Crypto
