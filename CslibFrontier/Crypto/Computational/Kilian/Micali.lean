/-!
# Micali's Computationally Sound Proofs in the Random Oracle Model

Micali's construction ([Micali2000]; [ChiesaYogev2024], Construction 21.1.1) compiles a PCP
verifier `V` into a non-interactive argument in the random oracle model by applying the
Fiat–Shamir transformation to Kilian's interactive argument
(`CslibFrontier/Crypto/Computational/Kilian.lean`). It is built from the oracle-program Merkle
trees `merkleRootProg`, `merklePathProg` and `merkleVerifyProg` over `MerkleHashSpec`
(`CslibFrontier.Crypto.Computational.MerkleTree.Prog`), evaluated against deterministic oracles with
`OracleComp.evalPure` (`CslibFrontier.Languages.Probabilistic.Oracle.EvalPure`):

1. **Micali prover and verifier.** Over the two-channel random oracle interface
   `MicaliSpec α := MerkleHashSpec ⊕ₒ MicaliFSSpec α` (where `Sum.inl` queries the Merkle hash
   `f_MT : List Bool → List Bool` and `Sum.inr` queries the Fiat–Shamir challenge oracle
   `f_FS : α × List Bool → List (List Bool)`), the prover `micaliProve V x table` commits to the
   compact PCP table `kilianTable V x table` under `f_MT`, queries `ρs ← f_FS (x, root)` (including
   the statement `x` in the Fiat–Shamir query for adaptive soundness), and opens the queried
   positions under `f_MT` to produce a `MicaliProof`. The verifier `micaliVerify V x proof`
   re-derives `ρs ← f_FS (x, proof.root)` and checks the Merkle openings and PCP verdicts under
   `f_MT`.
2. **Perfect completeness.** Under any deterministic oracle pair `(hTree, hFS)` whose Fiat–Shamir
   challenges have length `V.coins x`, `micaliVerify` accepts the proof generated by `micaliProve`
   on every table accepted by `V.tableVerifier` (`micaliVerify_micaliProve_eq_true`). Consequently,
   in the lazy random oracle experiment `micaliHonestGame V x table σ m` where `f_MT` samples
   uniform `σ`-bit digests (`BitString.uniformList σ`) and `f_FS (x, rt)` samples
   `kilianChallenges V m x`, the honest prover is accepted with probability one
   (`micaliHonestGame_eq_pure_true`).

As in [ChiesaYogev2024], Construction 21.1.1 with salt lengths `s_MT = s_FS = 0` (which are
zero-knowledge parameters not needed for completeness or soundness), no salts are included.

**Source attribution note:** Construction 21.1.1 is verified against [ChiesaYogev2024], pp.
239–240; bibliographic metadata for [Micali2000] is taken from Chiesa–Yogev's bibliography as the
publisher text is not directly accessible in this environment, and no theorem numbers are cited
from [Micali2000].

## Main definitions

* `Cslib.Crypto.MicaliFSSpec`, `Cslib.Crypto.MicaliSpec`, `Cslib.Crypto.MicaliProof`: oracle
  interfaces and non-interactive proof structure for Micali's construction.
* `Cslib.Crypto.micaliProvePure`, `Cslib.Crypto.micaliVerifyPure`, `Cslib.Crypto.micaliProve`,
  `Cslib.Crypto.micaliVerify`: pure and `OracleComp` Micali prover and verifier.
* `Cslib.Crypto.micaliOracleDist`, `Cslib.Crypto.micaliHonestProg`,
  `Cslib.Crypto.micaliHonestGame`: the lazy random-oracle distribution and honest completeness
  experiment.

## Main results

* `Cslib.Crypto.micaliVerifyPure_micaliProvePure_eq_true`,
  `Cslib.Crypto.micaliVerify_micaliProve_eq_true`,
  `Cslib.Crypto.micaliHonestGame_eq_pure_true`: perfect completeness of Micali's non-interactive
  argument under deterministic oracles and in the random oracle model.

## References

* [S. Micali, *Computationally Sound Proofs*][Micali2000]
* [A. Chiesa, E. Yogev, *Building Cryptographic Proofs from Hash Functions*][ChiesaYogev2024],
  Construction 21.1.1.
* [J. Kilian, *A note on efficient zero-knowledge proofs and arguments*][Kilian1992]
-/

@[expose] public section

namespace Cslib

open Probability

namespace Crypto

open Complexity Probability Turing.MultiTapeTM

variable {α : Type}

/-- Oracle specification for the Fiat–Shamir challenge oracle in Micali's construction:
queries `(x, root)` return a list of PCP random strings `List (List Bool)`. -/
abbrev MicaliFSSpec (α : Type) : OracleSpec (α × List Bool) := fun _ => List (List Bool)

/-- Combined random-oracle specification for Micali's construction: a Merkle hash oracle on the
left (`Sum.inl`) and a Fiat–Shamir challenge oracle on the right (`Sum.inr`). -/
abbrev MicaliSpec (α : Type) : OracleSpec (List Bool ⊕ (α × List Bool)) :=
  MerkleHashSpec ⊕ₒ MicaliFSSpec α

/-- A non-interactive Micali proof consists of the Merkle root `root` of the committed compact PCP
table and the Kilian opening responses `response` for the Fiat–Shamir challenges derived from
`(x, root)`. -/
@[ext]
structure MicaliProof where
  /-- Merkle root of the committed compact PCP table. -/
  root : List Bool
  /-- Opened bits and Merkle authentication paths for each Fiat–Shamir challenge repetition. -/
  response : KilianResponse
  deriving DecidableEq, Repr

/-! #### Oracle-program Kilian commitment, opening and verification -/

/-- Oracle-program computation of the Kilian Merkle commitment root for `table` on `x`. -/
def kilianCommitProg (V : PCPVerifier α) (x : α) (table : List Bool) :
    OracleComp MerkleHashSpec (List Bool) :=
  merkleRootProg (kilianLeaves (kilianTable V x table))

/-- Oracle-program computation of the Kilian openings for a single random string `ρ`. -/
def kilianOpenProg (V : PCPVerifier α) (x : α) (table : List Bool) (ρ : List Bool) :
    OracleComp MerkleHashSpec (List (MerkleOpening Bool)) :=
  let t := kilianTable V x table
  let leaves := kilianLeaves t
  (V.queries (x, ρ)).mapM fun a => do
    let i := kilianPosition V x a
    let path ← merklePathProg leaves i
    return ⟨t.getD i false, path⟩

/-- Oracle-program computation of the Kilian response for a list of random strings `ρs`. -/
def kilianRespondProg (V : PCPVerifier α) (x : α) (table : List Bool) (ρs : List (List Bool)) :
    OracleComp MerkleHashSpec KilianResponse :=
  ρs.mapM (kilianOpenProg V x table)

/-- Oracle-program verification of a single Kilian repetition against `root` on random
string `ρ`. -/
def kilianCheckProg (V : PCPVerifier α) (x : α) (root : List Bool) (ρ : List Bool)
    (answers : List (MerkleOpening Bool)) : OracleComp MerkleHashSpec Bool := do
  let queries := V.queries (x, ρ)
  let depth := kilianDepth V x
  let checks ← (queries.zip answers).mapM fun (a, o) =>
    merkleVerifyProg depth root (kilianPosition V x a) [o.leaf] o.path
  return answers.length == queries.length &&
    checks.all id &&
    V.verdict ((x, ρ), answers.map MerkleOpening.leaf)

/-- Oracle-program verification of all Kilian repetitions against `root` and challenges `ρs`. -/
def kilianVerifyProg (V : PCPVerifier α) (x : α) (root : List Bool) (ρs : List (List Bool))
    (response : KilianResponse) : OracleComp MerkleHashSpec Bool := do
  let checks ← (ρs.zip response).mapM fun (ρ, answers) =>
    kilianCheckProg V x root ρ answers
  return response.length == ρs.length && checks.all id

@[simp]
theorem evalPure_kilianCommitProg (h : List Bool → List Bool) (V : PCPVerifier α) (x : α)
    (table : List Bool) :
    OracleComp.evalPure h (kilianCommitProg V x table) =
      kilianCommit (fun _ => h) V [] x table := by
  simp [kilianCommitProg, kilianCommit]

@[simp]
theorem evalPure_kilianOpenProg (h : List Bool → List Bool) (V : PCPVerifier α) (x : α)
    (table : List Bool) (ρ : List Bool) :
    OracleComp.evalPure h (kilianOpenProg V x table ρ) =
      kilianOpen (fun _ => h) V [] x table ρ := by
  simp [kilianOpenProg, kilianOpen]

@[simp]
theorem evalPure_kilianRespondProg (h : List Bool → List Bool) (V : PCPVerifier α) (x : α)
    (table : List Bool) (ρs : List (List Bool)) :
    OracleComp.evalPure h (kilianRespondProg V x table ρs) =
      kilianRespond (fun _ => h) V [] x table ρs := by
  simp [kilianRespondProg, kilianRespond]

@[simp]
theorem evalPure_kilianCheckProg (h : List Bool → List Bool) (V : PCPVerifier α) (x : α)
    (root : List Bool) (ρ : List Bool) (answers : List (MerkleOpening Bool)) :
    OracleComp.evalPure h (kilianCheckProg V x root ρ answers) =
      kilianCheck (fun _ => h) V [] x root ρ answers := by
  simp only [kilianCheckProg, OracleComp.evalPure_bind, OracleComp.evalPure_mapM,
    OracleComp.evalPure_pure, kilianCheck, List.all_map]
  congr 2
  refine List.all_congr rfl ?_
  rintro ⟨a, o⟩
  simp [MerkleOpening.verify]

@[simp]
theorem evalPure_kilianVerifyProg (h : List Bool → List Bool) (V : PCPVerifier α) (x : α)
    (root : List Bool) (ρs : List (List Bool)) (response : KilianResponse) :
    OracleComp.evalPure h (kilianVerifyProg V x root ρs response) =
      kilianVerify (fun _ => h) V [] x root ρs response := by
  simp only [kilianVerifyProg, OracleComp.evalPure_bind, OracleComp.evalPure_mapM,
    OracleComp.evalPure_pure, kilianVerify, List.all_map]
  congr 1
  refine List.all_congr rfl ?_
  rintro ⟨ρ, answers⟩
  simp

/-! #### Micali prover, verifier and perfect completeness -/

/-- Pure Micali prover given deterministic Merkle-tree (`hTree`) and Fiat–Shamir (`hFS`) hash
functions ([ChiesaYogev2024], Construction 21.1.1). -/
def micaliProvePure (hTree : List Bool → List Bool)
    (hFS : α × List Bool → List (List Bool)) (V : PCPVerifier α) (x : α)
    (table : List Bool) : MicaliProof :=
  let root := kilianCommit (fun _ => hTree) V [] x table
  let ρs := hFS (x, root)
  ⟨root, kilianRespond (fun _ => hTree) V [] x table ρs⟩

/-- Pure Micali verifier given deterministic Merkle-tree (`hTree`) and Fiat–Shamir (`hFS`) hash
functions ([ChiesaYogev2024], Construction 21.1.1). -/
def micaliVerifyPure (hTree : List Bool → List Bool)
    (hFS : α × List Bool → List (List Bool)) (V : PCPVerifier α) (x : α)
    (proof : MicaliProof) : Bool :=
  let ρs := hFS (x, proof.root)
  kilianVerify (fun _ => hTree) V [] x proof.root ρs proof.response

/-- Combine a deterministic Merkle hash `hTree` and a deterministic Fiat–Shamir oracle `hFS` into
a deterministic oracle for `MicaliSpec α`. -/
abbrev micaliOracle (hTree : List Bool → List Bool)
    (hFS : α × List Bool → List (List Bool)) :
    (q : List Bool ⊕ (α × List Bool)) → MicaliSpec α q :=
  OracleComp.sumPure (spec₁ := MerkleHashSpec) (spec₂ := MicaliFSSpec α) hTree hFS

/-- Micali's non-interactive prover as an `OracleComp` program over `MicaliSpec α`: commits to the
compact PCP table under the Merkle hash oracle (`Sum.inl`), queries the Fiat–Shamir oracle
(`Sum.inr`) on `(x, root)` to obtain the challenge strings `ρs`, and opens the queried positions
under the Merkle hash oracle. -/
def micaliProve (V : PCPVerifier α) (x : α) (table : List Bool) :
    OracleComp (MicaliSpec α) MicaliProof := do
  let root ← OracleComp.liftLeft (spec₂ := MicaliFSSpec α) (kilianCommitProg V x table)
  let ρs ← OracleComp.liftRight (spec₁ := MerkleHashSpec)
    (OracleComp.query (spec := MicaliFSSpec α) (x, root))
  let response ← OracleComp.liftLeft (spec₂ := MicaliFSSpec α) (kilianRespondProg V x table ρs)
  return ⟨root, response⟩

/-- Micali's non-interactive verifier as an `OracleComp` program over `MicaliSpec α`: queries the
Fiat–Shamir oracle (`Sum.inr`) on `(x, proof.root)` to re-derive `ρs`, and verifies all openings
and PCP verdicts under the Merkle hash oracle (`Sum.inl`). -/
def micaliVerify (V : PCPVerifier α) (x : α) (proof : MicaliProof) :
    OracleComp (MicaliSpec α) Bool := do
  let ρs ← OracleComp.liftRight (spec₁ := MerkleHashSpec)
    (OracleComp.query (spec := MicaliFSSpec α) (x, proof.root))
  OracleComp.liftLeft (spec₂ := MicaliFSSpec α)
    (kilianVerifyProg V x proof.root ρs proof.response)

@[simp]
theorem evalPure_micaliProve (hTree : List Bool → List Bool)
    (hFS : α × List Bool → List (List Bool)) (V : PCPVerifier α) (x : α)
    (table : List Bool) :
    OracleComp.evalPure (micaliOracle hTree hFS) (micaliProve V x table) =
      micaliProvePure hTree hFS V x table := by
  simp [micaliProve, micaliProvePure]

@[simp]
theorem evalPure_micaliVerify (hTree : List Bool → List Bool)
    (hFS : α × List Bool → List (List Bool)) (V : PCPVerifier α) (x : α)
    (proof : MicaliProof) :
    OracleComp.evalPure (micaliOracle hTree hFS) (micaliVerify V x proof) =
      micaliVerifyPure hTree hFS V x proof := by
  simp [micaliVerify, micaliVerifyPure]

/-- **Perfect completeness of Micali's construction (pure oracle form)**: for any deterministic
Merkle oracle `hTree` and Fiat–Shamir oracle `hFS`, if `V.tableVerifier` accepts `(x, table)` and
every challenge string returned by `hFS` on `(x, root)` has `V.coins x` bits, then
`micaliVerifyPure` accepts the proof produced by `micaliProvePure`. -/
theorem micaliVerifyPure_micaliProvePure_eq_true {hTree : List Bool → List Bool}
    {hFS : α × List Bool → List (List Bool)} {V : PCPVerifier α} {x : α}
    {table : List Bool} (htable : V.tableVerifier (x, table) = true)
    (hρs : ∀ ρ ∈ hFS (x, kilianCommit (fun _ => hTree) V [] x table),
      ρ.length = V.coins x) :
    micaliVerifyPure hTree hFS V x (micaliProvePure hTree hFS V x table) = true := by
  simpa [micaliProvePure, micaliVerifyPure] using
    kilianVerify_kilianRespond (H := fun _ => hTree) htable [] hρs

/-- **Perfect completeness of Micali's construction (`OracleComp` simulation form)**: under any
deterministic oracle `(hTree, hFS)` whose Fiat–Shamir challenges have length `V.coins x`, running
`micaliProve` followed by `micaliVerify` returns `true` on every table accepted by
`V.tableVerifier`. -/
theorem micaliVerify_micaliProve_eq_true {hTree : List Bool → List Bool}
    {hFS : α × List Bool → List (List Bool)} {V : PCPVerifier α} {x : α}
    {table : List Bool} (htable : V.tableVerifier (x, table) = true)
    (hρs : ∀ ρ ∈ hFS (x, kilianCommit (fun _ => hTree) V [] x table),
      ρ.length = V.coins x) :
    OracleComp.evalPure (micaliOracle hTree hFS) (do
      let proof ← micaliProve V x table
      micaliVerify V x proof) = true := by
  simp [micaliVerifyPure_micaliProvePure_eq_true htable hρs]

/-! #### The Micali random-oracle experiment -/

/-- Per-query distribution of the Micali random oracle with `σ`-bit Merkle digests and `m` PCP
repetitions: Merkle queries (`Sum.inl`) draw uniformly from `{0, 1}^σ` (`BitString.uniformList σ`),
and Fiat–Shamir queries (`Sum.inr (x, rt)`) draw `m` independent `V.coins x`-bit challenge strings
(`ProbComp.eval (kilianChallenges V m x)`). -/
noncomputable def micaliOracleDist (V : PCPVerifier α) (σ m : ℕ) :
    (q : List Bool ⊕ (α × List Bool)) → PMF (MicaliSpec α q)
  | .inl _ => BitString.uniformList σ
  | .inr (x, _) => ProbComp.eval (kilianChallenges V m x)

/-- The honest Micali execution as an oracle program: the honest prover generates a proof for
`(x, table)` and the verifier checks it against the same oracle. -/
def micaliHonestProg (V : PCPVerifier α) (x : α) (table : List Bool) :
    OracleComp (MicaliSpec α) Bool := do
  let proof ← micaliProve V x table
  micaliVerify V x proof

/-- The honest Micali ROM experiment with `σ`-bit Merkle digests and `m` PCP repetitions: runs
`micaliHonestProg V x table` against a shared lazy random oracle
`RandomOracle.answer (micaliOracleDist V σ m)` starting from an empty cache. -/
noncomputable def micaliHonestGame [DecidableEq α] (V : PCPVerifier α) (x : α)
    (table : List Bool) (σ m : ℕ) : PMF Bool :=
  (OracleComp.runWith (RandomOracle.answer (micaliOracleDist V σ m))
    (micaliHonestProg V x table) (fun _ => none)).map Prod.fst

/-- **Perfect completeness of Micali's construction in the random oracle model**: if
`V.tableVerifier (x, table) = true`, then for every digest length `σ` and repetition count `m`,
the honest Micali ROM experiment accepts with probability `1`. -/
theorem micaliHonestGame_eq_pure_true [DecidableEq α] (V : PCPVerifier α) {x : α}
    {table : List Bool} (htable : V.tableVerifier (x, table) = true) (σ m : ℕ) :
    micaliHonestGame V x table σ m = PMF.pure true := by
  unfold micaliHonestGame
  refine OracleComp.map_fst_runWith_answer_eq_pure (micaliOracleDist V σ m)
    (micaliHonestProg V x table) true fun h hh => ?_
  have hsplit : h = micaliOracle (fun msg => h (.inl msg))
      (fun xrt => h (.inr xrt)) := by
    ext q
    cases q <;> rfl
  rw [hsplit]
  refine micaliVerify_micaliProve_eq_true htable fun ρ hρ => ?_
  have hmem := hh (.inr (x, kilianCommit (fun _ => fun msg => h (.inl msg)) V [] x table))
  simp only [micaliOracleDist, kilianChallenges, ProbComp.mem_support_replicate_iff] at hmem
  exact BitString.length_of_mem_support_uniformList (by simpa using hmem.2 ρ hρ)

