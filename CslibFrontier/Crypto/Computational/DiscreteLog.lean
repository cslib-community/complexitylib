/-!
# The discrete-logarithm assumption

A `PrimeOrderGroupFamily` is a family of cyclic groups of prime order, indexed by public
descriptions such as `(p, q, g)` for the subgroup of order `q` of `(ZMod p)ˣ` generated by `g`.
Groups are written additively, as `ZMod q`-modules, so the book's `g ^ α` is `α • g`. Algorithms
see a group through its description and the words encoding its elements. The family supplies
exactly the operations that algorithms using it need, as plain polynomial-time functions of the
description and the encoded operands: the order, the encoded generator, addition, and
multiplication by a natural number.

The discrete-logarithm experiment ([BonehShoup2023], Attack Game 10.4) draws a description from a
setup law, a uniform `α : ZMod q` and gives the adversary the description and the encoding of
`α • g`; the adversary wins when the binary number it outputs is `α` modulo `q`. `DiscreteLog`
asserts that every uniform strict PPT adversary wins with negligible probability.

As for `DecisionLWE`, this is a hypothesis, not a theorem. The setup law is arbitrary and is not
claimed to be efficiently sampleable: generating primes with certainty is not a strict PPT task,
since a fair-coin machine with a fixed clock fails with positive probability. Descriptions are
public, and an adversary's running time may depend on their length.

## Main definitions

* `Cslib.Crypto.PrimeOrderGroupFamily`: cyclic groups of prime order with efficient operations.
* `Cslib.Crypto.PrimeOrderGroupFamily.discreteLogGame`: the discrete-logarithm experiment.
* `Cslib.Crypto.PrimeOrderGroupFamily.DiscreteLog`: the discrete-logarithm assumption.

## Main results

* `Cslib.Crypto.PrimeOrderGroupFamily.smul_generator_injective`: a discrete logarithm modulo `q`
  is unique.
* `Cslib.Crypto.PrimeOrderGroupFamily.smul_generator_surjective`,
  `Cslib.Crypto.PrimeOrderGroupFamily.smul_generator_bijective`: the generator map is bijective.
* `Cslib.Crypto.PrimeOrderGroupFamily.uniform_smul_generator_add`: the one-time group mask.

## References

* [D. Boneh, V. Shoup, *A Graduate Course in Applied Cryptography*,
  Version 0.6][BonehShoup2023], Section 10.5.
-/

@[expose] public section

namespace Cslib.Crypto

open Probability Turing.MultiTapeTM

/-- A family of cyclic groups of prime order, indexed by public descriptions, with
polynomial-time operations on encoded elements. -/
structure PrimeOrderGroupFamily where
  /-- Public descriptions of the groups. -/
  Desc : Type
  /-- The encoding of descriptions given to algorithms. -/
  encDesc : Desc ↪ List Bool
  /-- The order of each group. -/
  order : Desc → ℕ
  /-- Every order is prime. -/
  prime_order : ∀ d, (order d).Prime
  /-- The groups, written additively. -/
  Carrier : Desc → Type
  /-- Each group is commutative. -/
  [addCommGroup : ∀ d, AddCommGroup (Carrier d)]
  /-- Each group is a `ZMod q`-module, where `q` is its order. -/
  [module : ∀ d, Module (ZMod (order d)) (Carrier d)]
  /-- The generator of each group. -/
  generator : ∀ d, Carrier d
  /-- Each group has `q` elements. -/
  card_carrier : ∀ d, Nat.card (Carrier d) = order d
  /-- The generator is not the identity, so it generates the group of prime order. -/
  generator_ne_zero : ∀ d, generator d ≠ 0
  /-- Group elements as words. -/
  encode : ∀ d, Carrier d → List Bool
  /-- Distinct elements have distinct encodings. -/
  encode_injective : ∀ d, Function.Injective (encode d)
  /-- Addition of encoded elements. -/
  add : Desc × List Bool × List Bool → List Bool
  /-- `add` adds encoded elements. -/
  add_encode : ∀ d x y, add (d, encode d x, encode d y) = encode d (x + y)
  /-- Multiplication of an encoded element by a natural number. -/
  smul : Desc × ℕ × List Bool → List Bool
  /-- `smul` multiplies encoded elements by natural numbers. -/
  smul_encode : ∀ d (a : ℕ) x, smul (d, a, encode d x) = encode d ((a : ZMod (order d)) • x)
  /-- The order is computable in polynomial time from the description. -/
  computableInPolyTime_order : ComputableInPolyTime order encDesc encNat
  /-- The encoded generator is computable in polynomial time from the description. -/
  computableInPolyTime_generator :
    ComputableInPolyTime (fun d => encode d (generator d)) encDesc encBits
  /-- Addition is computable in polynomial time. -/
  computableInPolyTime_add :
    ComputableInPolyTime add (encPair encDesc (encPair encBits encBits)) encBits
  /-- Multiplication by a binary natural number is computable in polynomial time. -/
  computableInPolyTime_smul :
    ComputableInPolyTime smul (encPair encDesc (encPair encNat encBits)) encBits

namespace PrimeOrderGroupFamily

variable (F : PrimeOrderGroupFamily)

attribute [instance] addCommGroup module

instance (d : F.Desc) : Fact (F.order d).Prime := ⟨F.prime_order d⟩

instance (d : F.Desc) : NeZero (F.order d) := ⟨(F.prime_order d).ne_zero⟩

/-- A discrete logarithm modulo `q` is unique: `α ↦ α • g` is injective. -/
theorem smul_generator_injective (d : F.Desc) :
    Function.Injective fun α : ZMod (F.order d) => α • F.generator d :=
  smul_left_injective (ZMod (F.order d)) (F.generator_ne_zero d)

/-- Every element of `F.Carrier d` is a scalar multiple of the generator: `α ↦ α • g` is
surjective. -/
theorem smul_generator_surjective (d : F.Desc) :
    Function.Surjective fun α : ZMod (F.order d) => α • F.generator d := by
  have : Finite (F.Carrier d) :=
    Nat.finite_of_card_ne_zero (by rw [F.card_carrier d]; exact (F.prime_order d).ne_zero)
  exact ((F.smul_generator_injective d).bijective_of_nat_card_le
    (by rw [F.card_carrier, Nat.card_zmod])).2

/-- The scalar map `α ↦ α • g` is a bijection between `ZMod (F.order d)` and `F.Carrier d`. -/
theorem smul_generator_bijective (d : F.Desc) :
    Function.Bijective fun α : ZMod (F.order d) => α • F.generator d :=
  ⟨F.smul_generator_injective d, F.smul_generator_surjective d⟩

/-- **One-time group mask**: for any group element `m : F.Carrier d`, masking `m` by `γ • g` for a
uniform `γ : ZMod (F.order d)` has the same distribution as `γ • g` itself. -/
theorem uniform_smul_generator_add {α : Type*} (d : F.Desc) (m : F.Carrier d)
    (f : F.Carrier d → PMF α) :
    ((PMF.uniformOfFintype (ZMod (F.order d))).bind fun γ => f (γ • F.generator d + m)) =
      (PMF.uniformOfFintype (ZMod (F.order d))).bind fun γ => f (γ • F.generator d) := by
  obtain ⟨μ, rfl⟩ := F.smul_generator_surjective d m
  simp only [← add_smul]
  change (PMF.uniformOfFintype (ZMod (F.order d))).bind
      ((fun γ => f (γ • F.generator d)) ∘ Equiv.addRight μ) =
    (PMF.uniformOfFintype (ZMod (F.order d))).bind (fun γ => f (γ • F.generator d))
  rw [← PMF.bind_map, PMF.uniformOfFintype_map_equiv]

/-- The discrete-logarithm experiment ([BonehShoup2023], Attack Game 10.4): draw a description
and a uniform `α`, give the adversary the description and the encoding of `α • g`, and accept
when the binary number it outputs is `α` modulo `q`. -/
noncomputable def discreteLogGame (setup : ℕ → PMF F.Desc)
    (adversary : ℕ → F.Desc × List Bool → ProbComp (List Bool)) (n : ℕ) : Game := do
  let d ← setup n
  let α ← PMF.uniformOfFintype (ZMod (F.order d))
  let guess ← ProbComp.eval (adversary n (d, F.encode d (α • F.generator d)))
  return decide ((ofBits guess : ZMod (F.order d)) = α)

/-- The discrete-logarithm assumption for a family and a setup law: every uniform strict PPT
adversary, given the unary security parameter, the description and the encoded instance, finds
the discrete logarithm with negligible probability. This is a hypothesis, not a theorem. -/
def DiscreteLog (setup : ℕ → PMF F.Desc) : Prop :=
  ∀ adversary : ℕ → F.Desc × List Bool → ProbComp (List Bool),
    IsPPTOn (encPair encUnary (encPair F.encDesc encBits)) encBits
      (fun input => adversary input.1 input.2) →
    Negligible fun n => Game.succProbability (F.discreteLogGame setup adversary n)

end PrimeOrderGroupFamily

end Cslib.Crypto
