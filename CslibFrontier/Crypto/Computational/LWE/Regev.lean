/-!
# Regev public-key encryption

Regev's bit encryption scheme [Regev2009, Section 5] in the presentation of
[Peikert2016, Section 5.2.1], at modulus `q = 2 ^ w`. The public key is the decision-LWE matrix
`A = [B * t + e | B]` of `LWE.publicMatrixInt`, generated by the LWE key generator `LWE.keyGen`;
the secret key is `t`. A bit `μ` is encrypted with a uniform binary coin vector `x ∈ {0, 1}^m` as
the row vector `xᵀ A + (μ * 2 ^ (w - 1), 0, …, 0)`, and decrypted by rounding its inner product
with `(1, -t)`, which equals `μ * 2 ^ (w - 1) + ⟨x, e⟩`.

The security statements are concrete and make no efficiency assumption on the adversary.
Under a uniform public matrix, the binary subset sums `xᵀ A` of independent coin vectors are
jointly close to uniform by the leftover hash lemma for `x ↦ xᵀ A`
(`BitString.SubsetSum.dist_bind_mul_le`). This bounds the advantage of every adaptive
left-or-right adversary making `Q` encryption queries by `Q * sqrt(2 ^ ((n + 1) * w) / 2 ^ m)`.
Replacing the generated public key by a uniform matrix costs the advantage of two explicit
decision-LWE distinguishers, one for each challenge bit. Native runtime certificates and the
asymptotic single-challenge theorem are in `LWE.Regev.Security`.

## Main definitions

* `Regev.encryptWithCoins`, `Regev.decrypt`: encryption with explicit binary coins and rounding
  decryption (using `LWE.encodeBit` and `LWE.decode`).
* `Regev.noise`: the integer decryption noise `⟨x, e⟩`.
* `Regev.encrypt`: the encryption program sampling uniform binary coins.
* `Regev.LoRAdversary`, `Regev.lorRun`, `Regev.lorGame`: an adaptive `Q`-query left-or-right
  adversary, its interaction with an encryption oracle, and the experiment for a public-key law.
* `Regev.idealLorGame`: the interaction in which every answer is an independent uniform vector.
* `Regev.challengeGame`: the single-challenge experiment, the left-or-right experiment
  `lrExperiment` of a typed `TwoStage` adversary on a public key drawn from a key law.
* `Regev.ChallengeState`, `Regev.LoRAdversary.ofChallenge`: a single-challenge adversary as a
  one-query left-or-right adversary, whose state records the challenge pair, the saved state and
  the challenge ciphertext.
* `Regev.lorDistinguisher`: the typed decision-LWE distinguisher that runs the `Q`-query
  experiment for one challenge bit on the supplied matrix.

## Main results

* `Regev.encryptWithCoins_dotProduct_secretVector`: the exact decryption residual.
* `Regev.decrypt_encryptWithCoins`, `Regev.keyGen_encrypt_correct`: zero decryption error when
  `4 * (m * η) < 2 ^ w` for errors bounded by `η`.
* `Regev.dist_lorGame_uniform_ideal_le`, `Regev.lorGame_uniform_advantage_le`: the leftover-hash
  bound for adaptive `Q`-query left-or-right security under a uniform public matrix.
* `Regev.challengeGame_uniform_advantage_le`: the single-challenge case `Q = 1`.
* `Regev.lorGame_advantage_le`: the `Q`-query advantage under the actual LWE public-key law is at
  most the two decision-LWE advantages plus the leftover-hash term.

## References

* [O. Regev, *On Lattices, Learning with Errors, Random Linear Codes, and Cryptography*,
  Section 5][Regev2009]
* [C. Peikert, *A Decade of Lattice Cryptography*, Section 5.2.1][Peikert2016]
-/

@[expose] public section

namespace Cslib.Crypto.Regev

open Probability Probability.PMF
open scoped _root_.Matrix NNReal

/-- A ciphertext is one row vector of `n + 1` residues modulo `2 ^ w`. -/
abbrev Ciphertext (n w : ℕ) := Fin (n + 1) → ZMod (2 ^ w)

/-- A public key is an `m × (n + 1)` matrix modulo `2 ^ w`, of the shape `[B * t + e | B]`. -/
abbrev PublicKey (n m w : ℕ) := Matrix (Fin m) (Fin (n + 1)) (ZMod (2 ^ w))

/-- Binary coins viewed as residues. -/
def coinVector {m : ℕ} (w : ℕ) (x : Fin m → Bool) : Fin m → ZMod (2 ^ w) :=
  fun i => ((x i).toNat : ZMod (2 ^ w))

/-- Encrypt `μ` with binary coins `x` as `xᵀ A + (LWE.encodeBit w μ, 0, …, 0)`. -/
def encryptWithCoins {n m w : ℕ} (A : PublicKey n m w) (μ : Bool) (x : Fin m → Bool) :
    Ciphertext n w :=
  coinVector w x ᵥ* A + Pi.single 0 (LWE.encodeBit w μ)

/-- Decrypt by rounding the inner product with the secret vector `(1, -t)`. -/
def decrypt {n w : ℕ} (t : Fin n → ZMod (2 ^ w)) (c : Ciphertext n w) : Bool :=
  LWE.decode w (c ⬝ᵥ LWE.secretVector t)

/-- The integer decryption noise `⟨x, e⟩` selected by the coins. -/
def noise {m : ℕ} (x : Fin m → Bool) (error : Fin m → ℤ) : ℤ :=
  ∑ i, ((x i).toNat : ℤ) * error i

/-- Encrypt with independent uniform binary coins. -/
noncomputable def encrypt {n m w : ℕ} (A : PublicKey n m w) (μ : Bool) :
    ProbComp (Ciphertext n w) := do
  let x ← OracleComp.replicateFin m (ProbComp.uniform Bool)
  return encryptWithCoins A μ x

/-- Encryption draws its coin vector uniformly. -/
@[simp] theorem eval_encrypt {n m w : ℕ} (A : PublicKey n m w) (μ : Bool) :
    ProbComp.eval (encrypt A μ) =
      (PMF.uniformOfFintype (Fin m → Bool)).map (encryptWithCoins A μ) := by
  simp only [encrypt, ProbComp.eval_bind, ProbComp.eval_pure, ProbComp.eval_replicateFin,
    ProbComp.eval_uniform, PMF.pi_uniformOfFintype]
  rfl

/-- The decryption residual: `⟨c, (1, -t)⟩ = μ * 2 ^ (w - 1) + ⟨x, e⟩` modulo `2 ^ w`. -/
theorem encryptWithCoins_dotProduct_secretVector {n m w : ℕ}
    (B : Matrix (Fin m) (Fin n) (ZMod (2 ^ w))) (t : Fin n → ZMod (2 ^ w))
    (error : Fin m → ℤ) (μ : Bool) (x : Fin m → Bool) :
    encryptWithCoins (LWE.publicMatrixInt B t error) μ x ⬝ᵥ
        LWE.secretVector t =
      (((μ.toNat : ℤ) * 2 ^ (w - 1) + noise x error : ℤ) : ZMod (2 ^ w)) := by
  rw [encryptWithCoins, add_dotProduct, ← Matrix.dotProduct_mulVec,
    LWE.publicMatrixInt_mulVec_secretVector, single_dotProduct]
  simp [LWE.encodeBit, noise, coinVector, dotProduct, LWE.secretVector, add_comm]

/-- Errors bounded by `bound` give decryption noise of magnitude at most `m * bound`. -/
theorem natAbs_noise_le {m bound : ℕ} (x : Fin m → Bool) (error : Fin m → ℤ)
    (herror : ∀ i, (error i).natAbs ≤ bound) : (noise x error).natAbs ≤ m * bound := by
  simpa [noise] using LWE.natAbs_binarySum_le x error herror

/-- Zero decryption error: every coin vector decrypts correctly when `4 * (m * bound) < 2 ^ w`. -/
theorem decrypt_encryptWithCoins {n m w bound : ℕ}
    (B : Matrix (Fin m) (Fin n) (ZMod (2 ^ w))) (t : Fin n → ZMod (2 ^ w))
    (error : Fin m → ℤ) (μ : Bool) (x : Fin m → Bool) (hw : 0 < w)
    (herror : ∀ i, (error i).natAbs ≤ bound) (hmargin : 4 * (m * bound) < 2 ^ w) :
    decrypt t (encryptWithCoins (LWE.publicMatrixInt B t error) μ x) = μ := by
  rw [decrypt, encryptWithCoins_dotProduct_secretVector]
  exact LWE.decode_eq_of_error hw μ _
    ((Nat.mul_le_mul_left 4 (natAbs_noise_le x error herror)).trans_lt hmargin)

/-- Every key generated with centered-binomial errors of parameter `η` and every supported
ciphertext decrypt correctly under the strict margin `4 * (m * η) < 2 ^ w`. -/
theorem keyGen_encrypt_correct {n m w η : ℕ} (hw : 0 < w) (hmargin : 4 * (m * η) < 2 ^ w)
    {keys : PublicKey n m w × (Fin n → ZMod (2 ^ w))}
    (hkeys : keys ∈ (ProbComp.eval (LWE.keyGen n m w η)).support)
    (μ : Bool) {c : Ciphertext n w} (hc : c ∈ (ProbComp.eval (encrypt keys.1 μ)).support) :
    decrypt keys.2 c = μ := by
  simp only [LWE.keyGen, ProbComp.eval_bind, ProbComp.eval_pure,
    PMF.mem_support_bind_iff, PMF.mem_support_pure_iff] at hkeys
  obtain ⟨inputs, hinputs, rfl⟩ := hkeys
  simp only [eval_encrypt, PMF.mem_support_map_iff, PMF.mem_support_uniformOfFintype,
    true_and] at hc
  obtain ⟨x, rfl⟩ := hc
  exact decrypt_encryptWithCoins _ _ _ μ x hw
    ((LWE.mem_support_sampleKeyInputs_iff _ _ _ _ _).mp hinputs) hmargin

/-! ### Adaptive left-or-right security -/

/-- An adaptive left-or-right adversary. It receives the public matrix, repeatedly chooses a pair
of bits and absorbs the ciphertext of the selected one, and finally guesses. Absorption is
deterministic without loss of generality: the state may record the full transcript, and later
stages are randomized. -/
structure LoRAdversary (n m w : ℕ) (State : Type) where
  /-- Receive the public matrix. -/
  start : PublicKey n m w → PMF State
  /-- Choose the next pair of challenge bits. -/
  query : State → PMF (MessagePair Bool × State)
  /-- Absorb the answer to the last query. -/
  receive : State → Ciphertext n w → State
  /-- Output the final guess. -/
  guess : State → PMF Bool

variable {n m w : ℕ} {State : Type}

/-- Answer `q` adaptive queries, encrypting the message of each pair selected by `bit` (`msg₀` for
`false`, `msg₁` for `true`) with the oracle `enc`. -/
noncomputable def lorRun (enc : Bool → PMF (Ciphertext n w))
    (adversary : LoRAdversary n m w State) (bit : Bool) : ℕ → State → PMF State
  | 0, state => PMF.pure state
  | q + 1, state => do
    let (pair, state) ← adversary.query state
    let c ← enc (pair.select bit)
    lorRun enc adversary bit q (adversary.receive state c)

/-- The adaptive `Q`-query left-or-right experiment with public keys drawn from `keys`; every
query is answered by a fresh encryption under the drawn key. -/
noncomputable def lorGame (keys : PMF (PublicKey n m w)) (Q : ℕ)
    (adversary : LoRAdversary n m w State) (bit : Bool) : PMF Bool := do
  let A ← keys
  let state ← adversary.start A
  let state ← lorRun (fun μ => ProbComp.eval (encrypt A μ)) adversary bit Q state
  adversary.guess state

/-- The ideal experiment under a uniform public matrix: every answer is an independent uniform
vector, independent of the challenge bit. -/
noncomputable def idealLorGame (Q : ℕ) (adversary : LoRAdversary n m w State) : PMF Bool := do
  let A ← PMF.uniformOfFintype (PublicKey n m w)
  let state ← adversary.start A
  let state ← lorRun (fun _ => PMF.uniformOfFintype (Ciphertext n w)) adversary false Q state
  adversary.guess state

/-- The interaction with all coins drawn in advance, one row per query. -/
private noncomputable def lorRunRows {γ : Type} (answer : Bool → γ → Ciphertext n w)
    (adversary : LoRAdversary n m w State) (bit : Bool) :
    (q : ℕ) → (Fin q → γ) → State → PMF State
  | 0, _, state => PMF.pure state
  | q + 1, rows, state => do
    let (pair, state) ← adversary.query state
    lorRunRows answer adversary bit q (Fin.tail rows)
      (adversary.receive state (answer (pair.select bit) (rows 0)))

/-- Fresh oracle coins may be drawn in advance as independent rows. -/
private theorem lorRun_map_eq {γ : Type} [Finite γ] (D : PMF γ) (answer : Bool → γ → Ciphertext n w)
    (adversary : LoRAdversary n m w State) (bit : Bool) (q : ℕ) (state : State) :
    lorRun (fun μ => D.map (answer μ)) adversary bit q state =
      (pi fun _ : Fin q => D).bind fun rows => lorRunRows answer adversary bit q rows state := by
  induction q generalizing state with
  | zero =>
    have hpi : (pi fun _ : Fin 0 => D) = PMF.pure finZeroElim := by
      ext rows
      have : rows = finZeroElim := Subsingleton.elim _ _
      subst this
      simp
    simp [lorRun, lorRunRows, hpi]
  | succ q ih =>
    rw [pi_fin_succ]
    simp only [lorRun, lorRunRows, PMF.monad_bind_eq_bind, PMF.bind_map, Function.comp_def, ih,
      PMF.bind_bind, Fin.tail_cons, Fin.cons_zero]
    rw [PMF.bind_comm]
    congr 1 with first : 1
    rw [PMF.bind_comm]

/-- Rows can be transformed before or inside the interaction. -/
private theorem lorRunRows_comp {γ δ : Type} (answer : Bool → δ → Ciphertext n w) (f : γ → δ)
    (adversary : LoRAdversary n m w State) (bit : Bool) (q : ℕ) (rows : Fin q → γ)
    (state : State) :
    lorRunRows (fun μ row => answer μ (f row)) adversary bit q rows state =
      lorRunRows answer adversary bit q (f ∘ rows) state := by
  induction q generalizing state with
  | zero => rfl
  | succ q ih =>
    simp only [lorRunRows]
    congr 1 with choice : 1
    exact ih _ _

/-- A message-independent oracle makes the interaction independent of the challenge bit. -/
private theorem lorRun_const (D : PMF (Ciphertext n w)) (adversary : LoRAdversary n m w State)
    (bit : Bool) (q : ℕ) (state : State) :
    lorRun (fun _ => D) adversary bit q state = lorRun (fun _ => D) adversary false q state := by
  induction q generalizing state with
  | zero => rfl
  | succ q ih =>
    simp only [lorRun]
    congr 1 with choice : 1
    congr 1 with c : 1
    exact ih _

/-- Uniform vectors shifted by a fixed message encoding remain uniform. -/
private theorem uniform_map_add (shift : Ciphertext n w) :
    (PMF.uniformOfFintype (Ciphertext n w)).map (fun c => c + shift) =
      PMF.uniformOfFintype (Ciphertext n w) :=
  PMF.uniformOfFintype_map_equiv (Equiv.addRight shift)

/-- The rest of the experiment, given the public matrix and the masks of all queries. -/
private noncomputable def maskedGuess (Q : ℕ) (adversary : LoRAdversary n m w State) (bit : Bool)
    (pair : PublicKey n m w × Matrix (Fin Q) (Fin (n + 1)) (ZMod (2 ^ w))) : PMF Bool := do
  let state ← adversary.start pair.1
  let state ← lorRunRows (fun μ c => c + Pi.single 0 (LWE.encodeBit w μ)) adversary bit Q
    pair.2 state
  adversary.guess state

private theorem lorGame_uniform_eq_bind (Q : ℕ) (adversary : LoRAdversary n m w State)
    (bit : Bool) :
    lorGame (PMF.uniformOfFintype (PublicKey n m w)) Q adversary bit =
      (PMF.uniformOfFintype (PublicKey n m w)).bind fun A =>
        (PMF.uniformOfFintype (Matrix (Fin Q) (Fin m) Bool)).bind fun X =>
          maskedGuess Q adversary bit
            (A, X.map (fun bit => (bit.toNat : ZMod (2 ^ w))) * A) := by
  simp only [lorGame, maskedGuess, eval_encrypt, PMF.monad_bind_eq_bind]
  congr 1 with A : 1
  rw [PMF.bind_comm]
  congr 1 with state : 1
  have hrows : PMF.uniformOfFintype (Matrix (Fin Q) (Fin m) Bool) =
      pi fun _ : Fin Q => PMF.uniformOfFintype (Fin m → Bool) :=
    (PMF.pi_uniformOfFintype).symm
  rw [hrows, lorRun_map_eq, PMF.bind_bind]
  congr 1 with X : 1
  have hmul : _root_.Matrix.map (X : Matrix (Fin Q) (Fin m) Bool)
      (fun bit => (bit.toNat : ZMod (2 ^ w))) * A =
      fun i => coinVector w (X i) ᵥ* A := by
    ext i j
    simp only [Matrix.mul_apply, Matrix.vecMul, dotProduct, coinVector]
    refine Finset.sum_congr rfl fun k _ => ?_
    rfl
  rw [hmul]
  refine congrArg (fun dist : PMF State => dist.bind adversary.guess) ?_
  change lorRunRows (fun μ row => coinVector w row ᵥ* A + Pi.single 0 (LWE.encodeBit w μ))
    adversary bit Q X state = _
  exact lorRunRows_comp (fun μ c => c + Pi.single 0 (LWE.encodeBit w μ))
    (fun x => coinVector w x ᵥ* A) adversary bit Q X state

private theorem idealLorGame_eq_bind (Q : ℕ) (adversary : LoRAdversary n m w State)
    (bit : Bool) :
    idealLorGame Q adversary =
      (PMF.uniformOfFintype (PublicKey n m w)).bind fun A =>
        (PMF.uniformOfFintype (Matrix (Fin Q) (Fin (n + 1)) (ZMod (2 ^ w)))).bind fun U =>
          maskedGuess Q adversary bit (A, U) := by
  simp only [idealLorGame, maskedGuess, PMF.monad_bind_eq_bind]
  congr 1 with A : 1
  rw [PMF.bind_comm]
  congr 1 with state : 1
  have hrows : PMF.uniformOfFintype (Matrix (Fin Q) (Fin (n + 1)) (ZMod (2 ^ w))) =
      pi fun _ : Fin Q => PMF.uniformOfFintype (Ciphertext n w) :=
    (PMF.pi_uniformOfFintype).symm
  rw [hrows]
  have hmap := lorRun_map_eq (PMF.uniformOfFintype (Ciphertext n w))
    (fun μ c => c + Pi.single 0 (LWE.encodeBit w μ)) adversary bit Q state
  simp only [uniform_map_add] at hmap
  rw [← lorRun_const _ adversary bit, hmap, PMF.bind_bind]
  rfl

/-- Under a uniform public matrix, each side of the adaptive `Q`-query experiment is within
`Q * sqrt(2 ^ ((n + 1) * w) / 2 ^ m) / 2` of the ideal experiment. No efficiency or finiteness
assumption is imposed on the adversary. -/
theorem dist_lorGame_uniform_ideal_le (Q : ℕ) (adversary : LoRAdversary n m w State)
    (bit : Bool) :
    dist (lorGame (PMF.uniformOfFintype (PublicKey n m w)) Q adversary bit)
        (idealLorGame Q adversary) ≤
      Q * Real.sqrt ((2 : ℝ) ^ ((n + 1) * w) / (2 : ℝ) ^ m) / 2 := by
  rw [lorGame_uniform_eq_bind Q adversary bit, idealLorGame_eq_bind Q adversary bit]
  simpa only [Fintype.card_fin, Nat.cast_pow, Nat.cast_ofNat, pow_mul'] using
    BitString.SubsetSum.dist_bind_mul_le (q := 2 ^ w) (m := m) (d := n + 1)
      (Rows := Fin Q) (fun A U => maskedGuess Q adversary bit (A, U))

/-- The leftover-hash bound for adaptive left-or-right security with `Q` queries under a
uniform public matrix. -/
theorem lorGame_uniform_advantage_le (Q : ℕ) (adversary : LoRAdversary n m w State) :
    (Game.advantage (lorGame (PMF.uniformOfFintype (PublicKey n m w)) Q adversary false)
        (lorGame (PMF.uniformOfFintype (PublicKey n m w)) Q adversary true) : ℝ) ≤
      Q * Real.sqrt ((2 : ℝ) ^ ((n + 1) * w) / (2 : ℝ) ^ m) := by
  rw [Game.advantage_eq_nndist, coe_nndist]
  have hfalse := dist_lorGame_uniform_ideal_le Q adversary false
  have htrue := dist_lorGame_uniform_ideal_le Q adversary true
  have htriangle := dist_triangle_right
    (lorGame (PMF.uniformOfFintype (PublicKey n m w)) Q adversary false)
    (lorGame (PMF.uniformOfFintype (PublicKey n m w)) Q adversary true)
    (idealLorGame Q adversary)
  linarith

/-- The single-challenge experiment: draw a public matrix from `keys` and run the left-or-right
experiment `lrExperiment` with Regev encryption. Every challenge pair is admissible. The typed
adversary's first stage sees the public matrix and chooses a pair of bits and a state; its second
stage sees that state and the challenge ciphertext. -/
noncomputable def challengeGame (keys : PMF (PublicKey n m w))
    (adversary : TwoStage (PublicKey n m w) (MessagePair Bool) (Ciphertext n w) Bool State)
    (bit : Bool) : Game :=
  Game.withSetup keys (lrExperiment (fun _ _ _ => true) encrypt adversary bit)

/-- The state of `LoRAdversary.ofChallenge`: the challenge pair and saved state chosen by the first
stage, and the challenge ciphertext received (`0` before the query is answered). -/
structure ChallengeState (n w : ℕ) (State : Type) where
  /-- The pair of challenge bits chosen by the first stage. -/
  pair : MessagePair Bool
  /-- The state saved by the first stage. -/
  saved : State
  /-- The challenge ciphertext. -/
  ciphertext : Ciphertext n w

/-- A single-challenge adversary as a one-query left-or-right adversary: the first stage starts the
interaction, the only query is its challenge pair, and the second stage guesses from the saved
state and the answer. -/
noncomputable def LoRAdversary.ofChallenge
    (adversary : TwoStage (PublicKey n m w) (MessagePair Bool) (Ciphertext n w) Bool State) :
    LoRAdversary n m w (ChallengeState n w State) where
  start A := (ProbComp.eval (adversary.choose A)).map fun (pair, saved) => ⟨pair, saved, 0⟩
  query state := PMF.pure (state.pair, state)
  receive state c := { state with ciphertext := c }
  guess state := ProbComp.eval (adversary.guess state.saved state.ciphertext)

/-- The single-challenge experiment is the one-query left-or-right experiment. -/
theorem lorGame_ofChallenge (keys : PMF (PublicKey n m w))
    (adversary : TwoStage (PublicKey n m w) (MessagePair Bool) (Ciphertext n w) Bool State)
    (bit : Bool) :
    lorGame keys 1 (LoRAdversary.ofChallenge adversary) bit =
      challengeGame keys adversary bit := by
  simp only [lorGame, challengeGame, Game.withSetup, lrExperiment, LoRAdversary.ofChallenge,
    lorRun, ↓reduceIte, PMF.monad_bind_eq_bind, PMF.bind_map, PMF.pure_bind, PMF.bind_bind,
    Function.comp_def, ProbComp.eval_bind]

/-- Single-challenge security under a uniform public matrix: advantage at most
`sqrt(2 ^ ((n + 1) * w) / 2 ^ m)`. -/
theorem challengeGame_uniform_advantage_le
    (adversary : TwoStage (PublicKey n m w) (MessagePair Bool) (Ciphertext n w) Bool State) :
    (Game.advantage (challengeGame (PMF.uniformOfFintype (PublicKey n m w)) adversary false)
        (challengeGame (PMF.uniformOfFintype (PublicKey n m w)) adversary true) : ℝ) ≤
      Real.sqrt ((2 : ℝ) ^ ((n + 1) * w) / (2 : ℝ) ^ m) := by
  simpa only [lorGame_ofChallenge, Nat.cast_one, one_mul] using
    lorGame_uniform_advantage_le 1 (LoRAdversary.ofChallenge adversary)

/-- The decision-LWE distinguisher for one challenge bit: run the `Q`-query experiment on the
supplied matrix as public key. -/
noncomputable def lorDistinguisher (Q : ℕ) (adversary : LoRAdversary n m w State) (bit : Bool)
    (A : PublicKey n m w) : PMF Bool :=
  lorGame (PMF.pure A) Q adversary bit

/-- The experiment under a key law averages the per-key distinguisher. -/
theorem lorGame_eq_bind_lorDistinguisher (keys : PMF (PublicKey n m w)) (Q : ℕ)
    (adversary : LoRAdversary n m w State) (bit : Bool) :
    lorGame keys Q adversary bit = keys.bind (lorDistinguisher Q adversary bit) := by
  simp only [lorGame, PMF.monad_bind_eq_bind]
  congr 1 with A : 1
  simp only [lorDistinguisher, lorGame, PMF.monad_bind_eq_bind, PMF.pure_bind]

/-- Concrete adaptive `Q`-query left-or-right security under the actual public-key law: the
advantage is at most the decision-LWE advantages of `lorDistinguisher Q adversary false` and
`lorDistinguisher Q adversary true`, plus the leftover-hash term. The error law `errorLaw` is
arbitrary. -/
theorem lorGame_advantage_le (errorLaw : PMF (ZMod (2 ^ w))) (Q : ℕ)
    (adversary : LoRAdversary n m w State) :
    (Game.advantage (lorGame (LWE.publicMatrixLaw n m w errorLaw) Q adversary false)
        (lorGame (LWE.publicMatrixLaw n m w errorLaw) Q adversary true) : ℝ) ≤
      Game.advantage
          ((LWE.publicMatrixLaw n m w errorLaw).bind (lorDistinguisher Q adversary false))
          ((PMF.uniformOfFintype (PublicKey n m w)).bind (lorDistinguisher Q adversary false)) +
        Game.advantage
          ((LWE.publicMatrixLaw n m w errorLaw).bind (lorDistinguisher Q adversary true))
          ((PMF.uniformOfFintype (PublicKey n m w)).bind (lorDistinguisher Q adversary true)) +
        Q * Real.sqrt ((2 : ℝ) ^ ((n + 1) * w) / (2 : ℝ) ^ m) := by
  have huniform := lorGame_uniform_advantage_le Q adversary
  simp only [Game.advantage_eq_nndist, coe_nndist, lorGame_eq_bind_lorDistinguisher] at huniform ⊢
  have h := dist_triangle4
    ((LWE.publicMatrixLaw n m w errorLaw).bind (lorDistinguisher Q adversary false))
    ((PMF.uniformOfFintype (PublicKey n m w)).bind (lorDistinguisher Q adversary false))
    ((PMF.uniformOfFintype (PublicKey n m w)).bind (lorDistinguisher Q adversary true))
    ((LWE.publicMatrixLaw n m w errorLaw).bind (lorDistinguisher Q adversary true))
  rw [dist_comm ((PMF.uniformOfFintype (PublicKey n m w)).bind (lorDistinguisher Q adversary true))
    ((LWE.publicMatrixLaw n m w errorLaw).bind (lorDistinguisher Q adversary true))] at h
  linarith

end Cslib.Crypto.Regev
