/-!
# Resuming native oracle circuits after a classical query

Two existing native uniform families share one fixed oracle. The first measures its request
prefix without measuring the remaining memory. The classical service returns a fixed-width
reply, and the second family receives the original input, request and reply as classical input
and the entire first active register as quantum input. An arbitrary finite reference is retained.

The semantics sums subnormalized branches. No state is chosen for an impossible outcome.
The circuit descriptions are generated by the existing native algorithms; the explicit width
compatibility is a register-layout condition. The service is an external classical oracle,
not an asserted efficient implementation. Sampling the shared table occurs outside this API.
These are original execution bridges, not a security theorem or polynomial-round QROM model.

## Main definitions

* `Cslib.Quantum.UniformOracleCircuitFamily.resumeRun`: second-stage native execution.
* `Cslib.Quantum.UniformOracleCircuitFamily.resumeDensity`: average over classical replies.
* `Cslib.Quantum.UniformOracleCircuitFamily.runClassicalQuery`: two native stages and one call.
-/

public section

namespace Cslib.Quantum.UniformOracleCircuitFamily

open Matrix Finset Turing.MultiTapeTM
open scoped Kronecker ComplexOrder

variable {a b L : ℕ → ℕ}

-- Equality transport is confined to this adapter: the two native descriptions have fixed
-- dimensions even though their classical words depend on the observed request and reply.
private noncomputable def runAtWidths (F : UniformOracleCircuitFamily) (n ℓ q : ℕ)
    (x : List Bool) (hx : x.length = ℓ)
    (hq : (F.description n ℓ).quantumInputWidth = q)
    (H : (Fin (F.description n ℓ).queryWidth → Bool) →
      Fin (F.description n ℓ).responseWidth → Bool) :
    Qubits q →ₗᵢ[ℂ] Qubits (F.description n ℓ).width := by
  subst ℓ
  subst q
  exact F.run n x H

private theorem runAtWidths_heq (G : UniformOracleCircuitFamily)
    (hG : G.HasOracleSignature a b L) (n ℓ q : ℕ) (x : List Bool)
    (hx : x.length = ℓ) (hq : (G.description n ℓ).quantumInputWidth = q)
    (hlen : ℓ ≤ L n) (H : (Fin (a n) → Bool) → Fin (b n) → Bool) :
    HEq (runAtWidths G n ℓ q x hx hq (hG.oracle n ℓ hlen H))
      (G.run n x (hG.oracle n x.length (hx ▸ hlen) H)) := by
  subst ℓ
  subst q
  rfl

private theorem runAtWidths_apply (F : UniformOracleCircuitFamily) (n ℓ q : ℕ)
    (x : List Bool) (hx : x.length = ℓ)
    (hq : (F.description n ℓ).quantumInputWidth = q)
    (H : (Fin (F.description n ℓ).queryWidth → Bool) →
      Fin (F.description n ℓ).responseWidth → Bool) (ψ : Qubits q) :
    runAtWidths F n ℓ q x hx hq H ψ =
      Circuit.eval (OracleCircuit.toCircuit (F.description n ℓ).width H
        (F.description n ℓ).instructions)
        (embedState (blockEmb (2 * n + 1 + ℓ)
          (by rw [← hq]; exact (F.wellFormed n ℓ).input_le))
          (inputState (F.description n ℓ).width (encPair encUnary encBits (n, x))) ψ) := by
  subst ℓ
  subst q
  rw [runAtWidths, run_apply, initialState_apply]

/-- Resume on the full saved register, with the original word, request and reply as classical
input. The common oracle is transported to this description without a fresh sample. -/
noncomputable def resumeRun (G : UniformOracleCircuitFamily)
    (hG : G.HasOracleSignature a b L) (n : ℕ) (x : List Bool) {q r s : ℕ}
    (hlen : x.length + r + s ≤ L n)
    (hmem : (G.description n (x.length + r + s)).quantumInputWidth = q)
    (H : (Fin (a n) → Bool) → Fin (b n) → Bool)
    (request : Fin r → Bool) (reply : Fin s → Bool) :
    Qubits q →ₗᵢ[ℂ] Qubits (G.description n (x.length + r + s)).width :=
  runAtWidths G n (x.length + r + s) q (x ++ List.ofFn request ++ List.ofFn reply)
    (by simp [Nat.add_assoc]) hmem (hG.oracle n (x.length + r + s) hlen H)

/-- When the dimensions are already those of the transcript, resumption is the original run.
This identifies the adapter with the existing interpreter, rather than a second circuit model. -/
theorem resumeRun_eq_run (G : UniformOracleCircuitFamily)
    (hG : G.HasOracleSignature a b L) (n : ℕ) (x : List Bool) {r s : ℕ}
    (hlen : x.length + r + s ≤ L n)
    (H : (Fin (a n) → Bool) → Fin (b n) → Bool)
    (request : Fin r → Bool) (reply : Fin s → Bool) :
    HEq (G.resumeRun hG n x hlen rfl H request reply)
      (G.run n (x ++ List.ofFn request ++ List.ofFn reply)
        (hG.oracle n _ (by simpa [Nat.add_assoc] using hlen) H)) := by
  exact runAtWidths_heq G hG n _ _ _ _ rfl hlen H

/-- A cast-free execution equation for clients with a concrete register layout. The interpreter
and input embedding are the same ones used by `run`. -/
theorem resumeRun_apply (G : UniformOracleCircuitFamily)
    (hG : G.HasOracleSignature a b L) (n : ℕ) (x : List Bool) {q r s : ℕ}
    (hlen : x.length + r + s ≤ L n)
    (hmem : (G.description n (x.length + r + s)).quantumInputWidth = q)
    (H : (Fin (a n) → Bool) → Fin (b n) → Bool)
    (request : Fin r → Bool) (reply : Fin s → Bool) (ψ : Qubits q) :
    G.resumeRun hG n x hlen hmem H request reply ψ =
      Circuit.eval (OracleCircuit.toCircuit (G.description n (x.length + r + s)).width
        (hG.oracle n (x.length + r + s) hlen H)
        (G.description n (x.length + r + s)).instructions)
        (embedState (blockEmb (2 * n + 1 + (x.length + r + s))
          (by rw [← hmem]; exact (G.wellFormed n _).input_le))
          (inputState (G.description n (x.length + r + s)).width
            (encPair encUnary encBits (n, x ++ List.ofFn request ++ List.ofFn reply))) ψ) :=
  runAtWidths_apply G n _ _ _ _ hmem _ ψ

variable (G : UniformOracleCircuitFamily) (hG : G.HasOracleSignature a b L)
    (n : ℕ) (x : List Bool) {q r s : ℕ}
    (hlen : x.length + r + s ≤ L n)
    (hmem : (G.description n (x.length + r + s)).quantumInputWidth = q)
    (H : (Fin (a n) → Bool) → Fin (b n) → Bool)
    (κ : Type*) [Fintype κ] [DecidableEq κ]

/-- The second stage, averaged over one classical reply, acts linearly on the saved joint
register. Each reply has exactly `s` bits; the outcome dimensions therefore do not depend on it. -/
noncomputable def resumeDensity (request : Fin r → Bool) (service : PMF (Fin s → Bool)) :
    Matrix ((Fin q → Bool) × κ) ((Fin q → Bool) × κ) ℂ →ₗ[ℂ]
    Matrix ((Fin (G.description n (x.length + r + s)).width → Bool) × κ)
      ((Fin (G.description n (x.length + r + s)).width → Bool) × κ) ℂ :=
  ∑ reply, (service reply).toReal •
    densityConj (Matrix.toEuclideanLin.symm
      (G.resumeRun hG n x hlen hmem H request reply).toLinearMap ⊗ₖ (1 : Matrix κ κ ℂ))

/-- Reply averaging is a finite sum of the native second-stage conjugations. -/
theorem resumeDensity_apply (request : Fin r → Bool) (service : PMF (Fin s → Bool)) (ρ) :
    G.resumeDensity hG n x hlen hmem H κ request service ρ =
      ∑ reply, (service reply).toReal •
        densityConj (Matrix.toEuclideanLin.symm
          (G.resumeRun hG n x hlen hmem H request reply).toLinearMap ⊗ₖ
          (1 : Matrix κ κ ℂ)) ρ := by
  simp [resumeDensity, LinearMap.sum_apply, LinearMap.smul_apply]

/-- A deterministic classical service executes exactly its selected continuation. -/
@[simp] theorem resumeDensity_pure (request : Fin r → Bool) (reply : Fin s → Bool) (ρ) :
    G.resumeDensity hG n x hlen hmem H κ request (PMF.pure reply) ρ =
      densityConj (Matrix.toEuclideanLin.symm
        (G.resumeRun hG n x hlen hmem H request reply).toLinearMap ⊗ₖ
        (1 : Matrix κ κ ℂ)) ρ := by
  simp [resumeDensity_apply, PMF.pure_apply, apply_ite ENNReal.toReal]

/-- Each reply's isometric execution and its nonnegative probability preserve positivity. -/
theorem resumeDensity_posSemidef (request : Fin r → Bool) (service : PMF (Fin s → Bool))
    {ρ} (hρ : ρ.PosSemidef) :
    (G.resumeDensity hG n x hlen hmem H κ request service ρ).PosSemidef := by
  rw [resumeDensity_apply]
  apply posSemidef_sum
  intro reply _
  rw [densityConj_apply]
  exact (hρ.mul_mul_conjTranspose_same _).smul ENNReal.toReal_nonneg

/-- Averaging classical replies leaves the reference marginal unchanged, for unnormalized
inputs too. This identity is what allows the second stage to act directly on a branch. -/
theorem partialTraceLeft_resumeDensity (request : Fin r → Bool)
    (service : PMF (Fin s → Bool)) (ρ) :
    partialTraceLeft (G.resumeDensity hG n x hlen hmem H κ request service ρ) =
      partialTraceLeft ρ := by
  rw [resumeDensity_apply, partialTraceLeft_sum]
  have hscalar (c : ℝ) (σ : Matrix ((Fin (G.description n (x.length + r + s)).width → Bool) × κ)
      ((Fin (G.description n (x.length + r + s)).width → Bool) × κ) ℂ) :
      partialTraceLeft (c • σ) = c • partialTraceLeft σ := by
    simpa only [partialTraceLeftLinearMap_apply] using
      (partialTraceLeftLinearMap _ κ).map_smul_of_tower c σ
  simp only [hscalar, partialTraceLeft_densityConj_kronecker (matrix_isometry _)]
  rw [← sum_smul, Probability.PMF.sum_toReal, one_smul]

/-- The second-stage reply average preserves arbitrary input trace. -/
theorem trace_resumeDensity (request : Fin r → Bool) (service : PMF (Fin s → Bool)) (ρ) :
    (G.resumeDensity hG n x hlen hmem H κ request service ρ).trace = ρ.trace := by
  rw [← trace_partialTraceLeft, partialTraceLeft_resumeDensity, trace_partialTraceLeft]

/-- Each supported normalized branch can be resumed as a density matrix. -/
theorem isDensityMatrix_resumeDensity (request : Fin r → Bool) (service : PMF (Fin s → Bool))
    {ρ} (hρ : IsDensityMatrix ρ) :
    IsDensityMatrix (G.resumeDensity hG n x hlen hmem H κ request service ρ) :=
  ⟨G.resumeDensity_posSemidef hG n x hlen hmem H κ request service hρ.posSemidef,
    (G.trace_resumeDensity hG n x hlen hmem H κ request service ρ).trans hρ.trace_eq_one⟩

/-- Reply averaging is exactly one probabilistic service draw followed by the selected native
execution and readout. Together with supported request continuation this is the operational law
for the complete classical-query boundary. -/
theorem measureDensity_resumeDensity_eq {B : Type*} [Fintype B]
    (M : POVM B ((Fin (G.description n (x.length + r + s)).width → Bool) × κ))
    (request : Fin r → Bool) (service : PMF (Fin s → Bool)) (ρ) (hρ : IsDensityMatrix ρ) :
    M.measureDensity (G.resumeDensity hG n x hlen hmem H κ request service ρ)
      (G.isDensityMatrix_resumeDensity hG n x hlen hmem H κ request service hρ) =
      service.bind fun reply =>
        M.measureDensity
          (densityConj (Matrix.toEuclideanLin.symm
            (G.resumeRun hG n x hlen hmem H request reply).toLinearMap ⊗ₖ
            (1 : Matrix κ κ ℂ)) ρ)
          (hρ.densityConj_kronecker (matrix_isometry _)) := by
  have h := M.measureDensity_pmf_sum service
    (fun reply => densityConj (Matrix.toEuclideanLin.symm
      (G.resumeRun hG n x hlen hmem H request reply).toLinearMap ⊗ₖ
      (1 : Matrix κ κ ℂ)) ρ)
    (fun _ => hρ.densityConj_kronecker (matrix_isometry _))
  ext b
  simpa only [POVM.measureDensity_apply, resumeDensity_apply] using
    congrArg (fun p : PMF B => p b) h

section ClassicalQuery

variable (F : UniformOracleCircuitFamily) {L₁ : ℕ → ℕ}
    (hF : F.HasOracleSignature a b L₁) (hx : x.length ≤ L₁ n) (s : ℕ)
    (hnext : x.length + (F.description n x.length).outputWidth + s ≤ L n)
    (hkeep : (G.description n
      (x.length + (F.description n x.length).outputWidth + s)).quantumInputWidth =
      (F.description n x.length).width)
    (service : ((Fin (a n) → Bool) → Fin (b n) → Bool) →
      (Fin (F.description n x.length).outputWidth → Bool) → PMF (Fin s → Bool))

/-- Run one native stage, measure only the request prefix, invoke the classical service once,
and resume a second native stage with all saved quantum memory. Both stages and the service
receive the same `H`; this definition does not sample or reprogram an oracle. -/
noncomputable def runClassicalQuery
    (ρ : Matrix ((Fin (F.description n x.length).quantumInputWidth → Bool) × κ)
      ((Fin (F.description n x.length).quantumInputWidth → Bool) × κ) ℂ) :
    Matrix ((Fin (G.description n
      (x.length + (F.description n x.length).outputWidth + s)).width → Bool) × κ)
      ((Fin (G.description n
      (x.length + (F.description n x.length).outputWidth + s)).width → Bool) × κ) ℂ :=
  ∑ request, G.resumeDensity hG n x hnext hkeep H κ request (service H request)
    (classicalDensityBranch
      (fun z => fun i => z.1 (Fin.castLEEmb (F.wellFormed n x.length).output_le i)) request
      (F.runDensityWithReference n x (hF.oracle n x.length hx H) κ ρ))

/-- The complete execution is a sum of retained request branches followed by reply averaging. -/
theorem runClassicalQuery_apply (ρ) :
    G.runClassicalQuery hG n x H κ F hF hx s hnext hkeep service ρ =
      ∑ request, G.resumeDensity hG n x hnext hkeep H κ request (service H request)
        (classicalDensityBranch
          (fun z => fun i => z.1 (Fin.castLEEmb (F.wellFormed n x.length).output_le i)) request
          (F.runDensityWithReference n x (hF.oracle n x.length hx H) κ ρ)) := by
  rfl

/-- One classical interaction preserves positivity, including on subnormalized inputs. -/
theorem runClassicalQuery_posSemidef {ρ} (hρ : ρ.PosSemidef) :
    (G.runClassicalQuery hG n x H κ F hF hx s hnext hkeep service ρ).PosSemidef := by
  unfold runClassicalQuery
  apply posSemidef_sum
  intro request _
  apply G.resumeDensity_posSemidef
  apply classicalDensityBranch_posSemidef
  rw [runDensityWithReference_apply, densityConj_apply]
  exact hρ.mul_mul_conjTranspose_same _

/-- Only the sum over classical outcomes preserves the inaccessible reference; a conditional
branch may change its reduced state. The identity also holds without normalization. -/
theorem partialTraceLeft_runClassicalQuery (ρ) :
    partialTraceLeft (G.runClassicalQuery hG n x H κ F hF hx s hnext hkeep service ρ) =
      partialTraceLeft ρ := by
  rw [runClassicalQuery, partialTraceLeft_sum]
  simp only [partialTraceLeft_resumeDensity]
  rw [← partialTraceLeft_sum]
  exact (partialTraceLeft_sum_classicalDensityBranch
    (fun z => fun i => z (Fin.castLEEmb (F.wellFormed n x.length).output_le i)) _).trans
      (F.partialTraceLeft_runDensityWithReference n x (hF.oracle n x.length hx H) κ ρ)

/-- The complete interaction preserves the trace, even on a subnormalized input. -/
theorem trace_runClassicalQuery (ρ) :
    (G.runClassicalQuery hG n x H κ F hF hx s hnext hkeep service ρ).trace = ρ.trace := by
  rw [← trace_partialTraceLeft, partialTraceLeft_runClassicalQuery, trace_partialTraceLeft]

/-- A joint input density matrix remains a density matrix after the classical interaction. -/
theorem isDensityMatrix_runClassicalQuery {ρ} (hρ : IsDensityMatrix ρ) :
    IsDensityMatrix (G.runClassicalQuery hG n x H κ F hF hx s hnext hkeep service ρ) :=
  ⟨G.runClassicalQuery_posSemidef hG n x H κ F hF hx s hnext hkeep service hρ.posSemidef,
    (G.trace_runClassicalQuery hG n x H κ F hF hx s hnext hkeep service ρ).trans hρ.trace_eq_one⟩

/-- Reading the final state agrees with operational continuation on supported request
outcomes. Only branches of positive probability are normalized; no null-branch state is used. -/
theorem measureDensity_runClassicalQuery_eq {B : Type*} [Fintype B]
    (M : POVM B ((Fin (G.description n
      (x.length + (F.description n x.length).outputWidth + s)).width → Bool) × κ))
    (ρ) (hρ : IsDensityMatrix ρ) :
    let σ := F.runDensityWithReference n x (hF.oracle n x.length hx H) κ ρ
    let hσ := F.isDensityMatrix_runDensityWithReference n x (hF.oracle n x.length hx H) κ hρ
    let read := fun z => fun i => z.1 (Fin.castLEEmb (F.wellFormed n x.length).output_le i)
    M.measureDensity (G.runClassicalQuery hG n x H κ F hF hx s hnext hkeep service ρ)
      (G.isDensityMatrix_runClassicalQuery hG n x H κ F hF hx s hnext hkeep service hρ) =
      ((POVM.basis.measureDensity σ hσ).map read).bindOnSupport fun request hr =>
        M.measureDensity
          (G.resumeDensity hG n x hnext hkeep H κ request (service H request)
            (normalizeDensity (classicalDensityBranch read request σ)))
          (G.isDensityMatrix_resumeDensity hG n x hnext hkeep H κ request (service H request)
            (isDensityMatrix_normalize_classicalDensityBranch read σ hσ request hr)) := by
  dsimp only
  ext outcome
  symm
  rw [bindOnSupport_classicalDensityBranch_apply
    (hL := fun request σ hσ =>
      G.isDensityMatrix_resumeDensity hG n x hnext hkeep H κ request (service H request) hσ)]
  rw [POVM.measureDensity_apply]
  rw [← ENNReal.ofReal_sum_of_nonneg (fun request _ =>
    M.densityProb_nonneg
      (G.resumeDensity_posSemidef hG n x hnext hkeep H κ request (service H request)
        (classicalDensityBranch_posSemidef _ _
          (F.isDensityMatrix_runDensityWithReference n x
            (hF.oracle n x.length hx H) κ hρ).posSemidef))
      outcome)]
  congr 1
  simp only [runClassicalQuery, POVM.densityProb_sum]

end ClassicalQuery

end Cslib.Quantum.UniformOracleCircuitFamily
