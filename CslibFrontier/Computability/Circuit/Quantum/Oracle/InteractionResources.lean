/-!
# Native resource bounds across a classical query

Both stage descriptions are generated by their existing native algorithms. A polynomial bound
on the original input and classical reply lengths gives one native-computable polynomial bound
for their combined active widths, elementary gates, coherent queries, and transcript length.
The external service is charged as one classical call. Its implementation, the preparation of
the quantum auxiliary state, and generation of an ideal random-oracle table are not included.
The inaccessible reference contributes no active qubits.

The width bound is deliberately an upper bound on the sum of the stage widths, hence also on
their peak. The retained memory is part of stage two's quantum input, not an uncharged register.
These are original consequences of the two native generator certificates.

## Main results

* `Cslib.Quantum.UniformOracleCircuitFamily.exists_classicalQuery_resource_bound`:
  native polynomial budgets for two stages and one classical query.
-/

public section

namespace Cslib.Quantum.UniformOracleCircuitFamily

open Turing.MultiTapeTM

/-- Native generation bounds all stage resources and the complete classical transcript.
The service is called once; the last bound charges that classical oracle call separately. -/
theorem exists_classicalQuery_resource_bound (F G : UniformOracleCircuitFamily)
    {L s : ℕ → ℕ} (hL : PolynomiallyBounded L) (hs : PolynomiallyBounded s) :
    ∃ B : ℕ → ℕ, ComputableInPolyTime B encUnary encUnary ∧ PolynomiallyBounded B ∧
      ∀ n ℓ, ℓ ≤ L n →
        let first := F.description n ℓ
        let next := G.description n (ℓ + first.outputWidth + s n)
        first.width + next.width ≤ B n ∧
        first.instructions.gateCount + next.instructions.gateCount ≤ B n ∧
        first.instructions.queryCount + next.instructions.queryCount ≤ B n ∧
        ℓ + first.outputWidth + s n ≤ B n ∧ 1 ≤ B n := by
  obtain ⟨B₁, hB₁, hp₁, hb₁⟩ := F.exists_computable_resource_bound hL
  have hcap : PolynomiallyBounded (fun n => L n + B₁ n + s n) := (hL.add hp₁).add hs
  obtain ⟨B₂, hB₂, hp₂, hb₂⟩ := G.exists_computable_resource_bound hcap
  have hB : ComputableInPolyTime (fun n => B₁ n + B₂ n + 1) encUnary encUnary := by
    fun_prop
  refine ⟨fun n => B₁ n + B₂ n + 1, hB, hB.polynomiallyBounded, ?_⟩
  intro n ℓ hℓ
  dsimp only
  have hf := hb₁ n ℓ hℓ
  have hr := (F.wellFormed n ℓ).output_le
  have hinput : ℓ + (F.description n ℓ).outputWidth + s n ≤ L n + B₁ n + s n := by
    omega
  have hg := hb₂ n _ hinput
  have hfit := (G.wellFormed n (ℓ + (F.description n ℓ).outputWidth + s n)).input_le
  dsimp only at hfit
  have hc₁ := OracleCircuit.gateCount_add_queryCount (F.description n ℓ).instructions
  have hc₂ := OracleCircuit.gateCount_add_queryCount
    (G.description n (ℓ + (F.description n ℓ).outputWidth + s n)).instructions
  omega

end Cslib.Quantum.UniformOracleCircuitFamily
