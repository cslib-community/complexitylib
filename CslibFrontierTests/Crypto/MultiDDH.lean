module

public import CslibFrontier.Crypto.Computational.DiscreteLog.SchnorrGroup
public import CslibFrontier.Crypto.Computational.DiffieHellman.MultiDDH
import CslibFrontier.Computability.Machines.Turing.MultiTape.Complexity.PolyTime.Plain
import CslibFrontier.Computability.Probabilistic.PPT.Extension
import Mathlib.Tactic.NormNum.Prime

/-!
# Shared fixed-coordinate DDH and Multi-DDH tests

The concrete check is retained from the reviewed Naor–Reingold source of PR #1103,
authored by worker-jetski-cf53d356 (Gemini). It needs no Naor–Reingold consumer import.
-/

public section

namespace CslibFrontierTests.Crypto.MultiDDH

open Cslib Cslib.Crypto Cslib.Crypto.PrimeOrderGroupFamily Turing.MultiTapeTM
open scoped ENNReal NNReal

/-- The Schnorr group of order `11` in `(ZMod 23)ˣ`, generated by `2`. -/
def d23 : schnorrGroups.Desc :=
  ⟨(23, 11, 2), ⟨by norm_num, by norm_num, by norm_num, by norm_num, by norm_num⟩⟩

/-- The original real-DDH fixed-coordinate rerandomization check. -/
example :
    schnorrGroups.ddhFixedUWordRerandomize d23 (Nat.bits 8) (Nat.bits 9) (Nat.bits 16) 2 1 =
      (Nat.bits 13, Nat.bits 12) := by
  decide

/-- Concrete check for `ddhWordShift` (Exercise 10.9). -/
example :
    schnorrGroups.ddhWordShift d23 (Nat.bits 8) (Nat.bits 9) (Nat.bits 16) 2 =
      (Nat.bits 9, Nat.bits 8) := by
  decide

/-- The shared certificate composes with an arbitrary captured input producer. -/
example {α : Type} {enc : α ↪ List Bool}
    {f : α → schnorrGroups.Desc × List Bool × List Bool × List Bool × ℕ × ℕ}
    (hf : ComputableInPolyTime f enc
      (encPair schnorrGroups.encDesc
        (encPair encBits (encPair encBits (encPair encBits (encPair encNat encNat)))))) :
    ComputableInPolyTime
      (fun a => schnorrGroups.ddhFixedUWordRerandomize (f a).1 (f a).2.1 (f a).2.2.1
        (f a).2.2.2.1 (f a).2.2.2.2.1 (f a).2.2.2.2.2) enc
      (encPair encBits encBits) :=
  schnorrGroups.computableInPolyTime_ddhFixedUWordRerandomize.comp hf

/-- Concrete `DDHDistinguisher` checking whether the first and third group elements match. -/
def concreteDDHDistinguisher : schnorrGroups.DDHDistinguisher :=
  fun _ d u _ w => pure (decide (schnorrGroups.encode d u = schnorrGroups.encode d w))

theorem isPPT_concreteDDHDistinguisher : concreteDDHDistinguisher.IsPPT := by
  unfold PrimeOrderGroupFamily.DDHDistinguisher.IsPPT concreteDDHDistinguisher
  fun_prop

/-- `ddhFixedUSelfReduceDistinguisher` preserves `DDHDistinguisher.IsPPT` on a concrete
distinguisher. -/
example :
    (schnorrGroups.ddhFixedUSelfReduceDistinguisher concreteDDHDistinguisher).IsPPT :=
  schnorrGroups.isPPT_ddhFixedUSelfReduceDistinguisher isPPT_concreteDDHDistinguisher

/-- Concrete `SingleSecretMultiDDHDistinguisher` exercising the `enc_structure` projection rules for
`encSingleSecretMultiDDHInput`. -/
def concreteSingleSecretDistinguisher : schnorrGroups.SingleSecretMultiDDHDistinguisher :=
  fun _ d u pairs =>
    pure (decide (schnorrGroups.encode d u =
      encList (schnorrGroups.encCarrierPair d) pairs))

theorem isPPT_concreteSingleSecretDistinguisher :
    concreteSingleSecretDistinguisher.IsPPT := by
  rw [PrimeOrderGroupFamily.SingleSecretMultiDDHDistinguisher.isPPT_iff]
  unfold concreteSingleSecretDistinguisher
  fun_prop

/-- `singleSecretMultiDDHToDDHDistinguisher` produces a PPT `DDHDistinguisher` from the concrete
`SingleSecretMultiDDHDistinguisher`. -/
example :
    (schnorrGroups.singleSecretMultiDDHToDDHDistinguisher id
      concreteSingleSecretDistinguisher).IsPPT :=
  schnorrGroups.isPPT_singleSecretMultiDDHToDDHDistinguisher (by fun_prop)
    isPPT_concreteSingleSecretDistinguisher

/-- Concrete `MultiDDHDistinguisher` exercising the `enc_structure` projection rules for
`encMultiDDHInput`. -/
def concreteMultiDDHDistinguisher : schnorrGroups.MultiDDHDistinguisher :=
  fun _ d blocks =>
    pure (encList (schnorrGroups.encMultiDDHBlock d) blocks).isEmpty

theorem isPPT_concreteMultiDDHDistinguisher :
    concreteMultiDDHDistinguisher.IsPPT := by
  rw [PrimeOrderGroupFamily.MultiDDHDistinguisher.isPPT_iff]
  unfold concreteMultiDDHDistinguisher
  fun_prop

/-- `multiDDHToDDHDistinguisher` produces a PPT `DDHDistinguisher` from the concrete two-parameter
`MultiDDHDistinguisher`. -/
example :
    (schnorrGroups.multiDDHToDDHDistinguisher id id concreteMultiDDHDistinguisher).IsPPT :=
  schnorrGroups.isPPT_multiDDHToDDHDistinguisher (by fun_prop) (by fun_prop)
    isPPT_concreteMultiDDHDistinguisher

/-- `DDH` implies single-secret ($n = 1$) `SingleSecretMultiDDH` for any polynomial-time pair-count
schedule. -/
example {setup : ℕ → PMF schnorrGroups.Desc} {count : ℕ → ℕ}
    (hDDH : schnorrGroups.DDH setup)
    (hcount : ComputableInPolyTime count encUnary encUnary) :
    schnorrGroups.SingleSecretMultiDDH setup count :=
  hDDH.singleSecretMultiDDH hcount

/-- `DDH` implies full two-parameter $(n, m)$ `MultiDDH` for any polynomial-time secret-count and
pair-count schedules. -/
example {setup : ℕ → PMF schnorrGroups.Desc} {secretCount pairCount : ℕ → ℕ}
    (hDDH : schnorrGroups.DDH setup)
    (hsecret : ComputableInPolyTime secretCount encUnary encUnary)
    (hpair : ComputableInPolyTime pairCount encUnary encUnary) :
    schnorrGroups.MultiDDH setup secretCount pairCount :=
  hDDH.multiDDH hsecret hpair

end CslibFrontierTests.Crypto.MultiDDH
