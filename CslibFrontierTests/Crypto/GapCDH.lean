import CslibFrontier.Crypto.Computational.DiffieHellman.GapCDH
import CslibFrontier.Crypto.Computational.DiscreteLog.SchnorrGroup
import Mathlib.Tactic.NormNum.Prime

/-!
# Tests for gap-CDH and the random-oracle Diffie–Hellman KEM

Correctness of Construction 12.19 on the Schnorr group of order `11` in `(ZMod 23)ˣ`, the
answers of the DDH oracle and of the decapsulation oracle, the behaviour of the reduction on
public key `0`, and an instantiation of Theorem 12.22 with uniform `4`-bit keys.
-/

noncomputable section

namespace CslibFrontierTests.Crypto.GapCDH

open Cslib Cslib.Probability Cslib.Crypto Cslib.Crypto.PrimeOrderGroupFamily

/-- The Schnorr group of order `11` in `(ZMod 23)ˣ`, generated by `2`. -/
private def d23 : schnorrGroups.Desc :=
  ⟨(23, 11, 2), ⟨by norm_num, by norm_num, by norm_num, by norm_num, by norm_num⟩⟩

/-- With secret key `3` and encapsulation exponent `5`, decapsulation recovers the key. -/
example (H : schnorrGroups.Carrier d23 → Bool) :
    schnorrGroups.dhKEMDecaps d23 H 3
        (schnorrGroups.dhKEMEncaps d23 H (3 • schnorrGroups.generator d23) 5).1 =
      (schnorrGroups.dhKEMEncaps d23 H (3 • schnorrGroups.generator d23) 5).2 :=
  schnorrGroups.dhKEMDecaps_encaps d23 H 3 5

variable (F : PrimeOrderGroupFamily) (d : F.Desc) [DecidableEq (F.Carrier d)] {K : Type}

/-- The DDH oracle `O_y` accepts a Diffie–Hellman pair `(U, y • U)`. -/
example (y : ZMod (F.order d)) (U : F.Carrier d) :
    F.ddhOracle d y (U, y • U) = PMF.pure true := by
  simp [ddhOracle]

/-- The DDH oracle `O_y` rejects every other pair. -/
example (y : ZMod (F.order d)) (U V : F.Carrier d) (h : V ≠ y • U) :
    F.ddhOracle d y (U, V) = PMF.pure false := by
  simp [ddhOracle, h]

/-- The decapsulation oracle refuses the challenge ciphertext. -/
example (H : F.Carrier d → K) (x : ZMod (F.order d)) (c : F.Carrier d) :
    F.dhKEMAnswer d H x c (.decaps c) = none := by
  simp [dhKEMAnswer]

/-- Other ciphertexts are decapsulated honestly. -/
example (H : F.Carrier d → K) (x : ZMod (F.order d)) (c c' : F.Carrier d) (h : c' ≠ c) :
    F.dhKEMAnswer d H x c (.decaps c') = some (H (x • c')) := by
  simp [dhKEMAnswer, h, dhKEMDecaps]

/-- On public key `0` the reduction outputs `0`, the correct answer, without running the
adversary. -/
example (sampleKey : ProbComp K) (adversary : F.DHKEMAdversary d K) (c : F.Carrier d) :
    F.dhKEMToGapCDH d sampleKey adversary (c, 0) = pure 0 := by
  simp [dhKEMToGapCDH]

/-- Theorem 12.22 for uniform `4`-bit keys and any CCA adversary. -/
example [Fintype (F.Carrier d)] (adversary : F.DHKEMAdversary d (Fin 4 → Bool)) :
    Game.advantage (F.dhKEMCCAGame d (ProbComp.uniform (Fin 4 → Bool)) adversary true)
        (F.dhKEMCCAGame d (ProbComp.uniform (Fin 4 → Bool)) adversary false) ≤
      Game.succProbability
        (F.gapCDHGame d (F.dhKEMToGapCDH d (ProbComp.uniform (Fin 4 → Bool)) adversary)) :=
  F.advantage_dhKEMCCAGame_le d _ adversary

end CslibFrontierTests.Crypto.GapCDH
