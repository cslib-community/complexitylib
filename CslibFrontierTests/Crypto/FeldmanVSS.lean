import CslibFrontier.Crypto.Computational.DiscreteLog.SchnorrGroup
import CslibFrontier.Crypto.Protocols.SecretSharing.Feldman
import CslibFrontier.Crypto.Negligible.Basic
import CslibFrontier.Tactic.PPT
import Mathlib.Tactic.NormNum.Prime

/-!
# Tests for Feldman verifiable secret sharing

Concrete and asymptotic checks on `Cslib.Crypto.Protocols.SecretSharing.Feldman` using the Schnorr
group of order `11` in `(ZMod 23)ˣ` and threshold `t = 2` over `Fin 4` parties:
* Honest commitment evaluation (`feldmanCommit`), verification completeness (`feldmanVerify_share`),
  and encoded verifier soundness (`encodeFeldmanVerify_encode`), rejecting corrupted and
  non-canonical shares.
* Malicious-dealer commitment soundness (`reconstruct_smul_generator_eq_commit_zero`,
  `feldmanVerify_agree_on_authorized`, `reconstruct_eq_of_feldmanVerify_commit_zero`) and share
  uniqueness (`feldmanVerify_unique_share`).
* Exact zero-distance simulation (`feldmanView_eq_feldmanSim`) for coalitions `|I| ≤ t`.
* Strict-PPT `DiscreteLog.feldmanSecrecy` instantiation for uniform secrets alongside the
  `advantage_feldmanChosenSecretDistinguisher_eq_one` chosen-secret vulnerability check.
-/

namespace CslibFrontierTests.Crypto.FeldmanVSS

open Cslib Cslib.Probability Cslib.Crypto Cslib.Crypto.PrimeOrderGroupFamily
open Cslib.Crypto.Protocols.SecretSharing Cslib.Crypto.Protocols.SecretSharing.Feldman
open Turing.MultiTapeTM
open scoped NNReal

/-- The Schnorr group of order `11` in `(ZMod 23)ˣ`, generated by `2`. -/
def d23 : schnorrGroups.Desc :=
  ⟨(23, 11, 2), ⟨by norm_num, by norm_num, by norm_num, by norm_num, by norm_num⟩⟩

local instance : Fact (Nat.Prime (schnorrGroups.order d23)) :=
  ⟨schnorrGroups.prime_order d23⟩
local instance : AddCommGroup (schnorrGroups.Carrier d23) := schnorrGroups.addCommGroup d23
local instance : Module (ZMod (schnorrGroups.order d23)) (schnorrGroups.Carrier d23) :=
  schnorrGroups.module d23
local instance : DecidableEq (schnorrGroups.Carrier d23) :=
  schnorrGroups.instDecidableEqCarrier d23

/-- Concrete `(t = 2, n = 4)` Shamir parameters over `ZMod 11` with points `1, 2, 3, 4`. -/
def params23 : Shamir.Params (ZMod (schnorrGroups.order d23)) (Fin 4) where
  threshold := 2
  threshold_lt_card := by decide
  point i := ((i.1 + 1 : ℕ) : ZMod (schnorrGroups.order d23))
  point_injective := by
    intro a b hab
    revert hab
    decide
  point_nonzero := by
    intro i
    decide

/-! ### 1. Honest commitments, verification, and rejection checks -/

private def sampleTail : Shamir.Randomness params23 := ![5, 7]

private noncomputable def sampleCommit : Fin 3 → schnorrGroups.Carrier d23 :=
  feldmanCommit schnorrGroups d23 params23 3 sampleTail

example : sampleCommit 0 = (3 : ZMod (schnorrGroups.order d23)) • schnorrGroups.generator d23 :=
  feldmanCommit_zero schnorrGroups d23 params23 3 sampleTail

example :
    schnorrGroups.encode d23 (sampleCommit 0) = Nat.bits 8 ∧
      schnorrGroups.encode d23 (sampleCommit 1) = Nat.bits 9 ∧
      schnorrGroups.encode d23 (sampleCommit 2) = Nat.bits 13 := by
  have h0 := feldmanCommit_zero schnorrGroups d23 params23 3 sampleTail
  have h1 := feldmanCommit_succ schnorrGroups d23 params23 3 sampleTail 0
  have h2 := feldmanCommit_succ schnorrGroups d23 params23 3 sampleTail 1
  change schnorrGroups.encode d23 (sampleCommit 0) = Nat.bits 8 ∧
    schnorrGroups.encode d23 (sampleCommit (Fin.succ 0)) = Nat.bits 9 ∧
    schnorrGroups.encode d23 (sampleCommit (Fin.succ 1)) = Nat.bits 13
  rw [h0, h1, h2]
  simp only [sampleTail, Matrix.cons_val_zero, Matrix.cons_val_one]
  decide

example (i : Fin 4) :
    feldmanVerify schnorrGroups d23 params23 sampleCommit i
      (Shamir.share params23 sampleTail 3 i) = true :=
  feldmanVerify_share schnorrGroups d23 params23 3 sampleTail i

-- Encoded verification agrees with group verification and accepts `(i = 0, share = 3 + 5 + 7 = 4)`.
example :
    encodeFeldmanVerify schnorrGroups d23 params23
      (![Nat.bits 8, Nat.bits 9, Nat.bits 13] : Fin 3 → List Bool) 0 4 = true := by
  decide

-- Corrupted share `5 ≠ 4` is rejected.
example :
    encodeFeldmanVerify schnorrGroups d23 params23
      (![Nat.bits 8, Nat.bits 9, Nat.bits 13] : Fin 3 → List Bool) 0 5 = false := by
  decide

-- Non-canonical representative `15 ≡ 4 (mod 11)` is rejected (`shareVal ≥ 11`).
example :
    encodeFeldmanVerify schnorrGroups d23 params23
      (![Nat.bits 8, Nat.bits 9, Nat.bits 13] : Fin 3 → List Bool) 0 15 = false := by
  decide

/-! ### 2. Malicious-dealer soundness and share uniqueness -/

/-- Malicious commitment vector corresponding to polynomial `3 + X + 2 X^2 (mod 11)`. -/
private noncomputable def malCommit : Fin 3 → schnorrGroups.Carrier d23 :=
  ![(3 : ZMod 11) • schnorrGroups.generator d23,
    (1 : ZMod 11) • schnorrGroups.generator d23,
    (2 : ZMod 11) • schnorrGroups.generator d23]

-- Verifying coalitions `{0, 1, 2}` (shares `[6, 2, 2]`) and `{1, 2, 3}` (shares `[2, 2, 6]`)
-- must reconstruct identical secret `3` matching `malCommit 0 = 3 • g`.
private def S₁ : Finset (Fin 4) := {0, 1, 2}
private def S₂ : Finset (Fin 4) := {1, 2, 3}

private def σ₁ : S₁ → ZMod (schnorrGroups.order d23)
  | ⟨0, _⟩ => 6
  | ⟨1, _⟩ => 2
  | ⟨2, _⟩ => 2

private def σ₂ : S₂ → ZMod (schnorrGroups.order d23)
  | ⟨1, _⟩ => 2
  | ⟨2, _⟩ => 2
  | ⟨3, _⟩ => 6

private theorem malCommit_eval_eq (j : ZMod 11) (i : Fin 4)
    (hi : params23.point i = j) :
    (3 + j + 2 * j ^ 2) • schnorrGroups.generator d23 =
      ∑ k : Fin 3, (params23.point i ^ (k : ℕ)) • malCommit k := by
  rw [Fin.sum_univ_three, hi]
  simp only [malCommit, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
    Fin.val_zero, Fin.val_one, Fin.val_two, pow_zero, pow_one, smul_smul]
  rw [← add_smul, ← add_smul]
  congr 1
  ring

private theorem hver₁ :
    ∀ i : S₁, feldmanVerify schnorrGroups d23 params23 malCommit i.1 (σ₁ i) = true := by
  rintro ⟨i, hi⟩
  rw [feldmanVerify_eq_true_iff]
  fin_cases i
  · exact malCommit_eval_eq 1 0 (by decide)
  · exact malCommit_eval_eq 2 1 (by decide)
  · exact malCommit_eval_eq 3 2 (by decide)
  · exact absurd hi (by decide)

private theorem hver₂ :
    ∀ i : S₂, feldmanVerify schnorrGroups d23 params23 malCommit i.1 (σ₂ i) = true := by
  rintro ⟨i, hi⟩
  rw [feldmanVerify_eq_true_iff]
  fin_cases i
  · exact absurd hi (by decide)
  · exact malCommit_eval_eq 2 1 (by decide)
  · exact malCommit_eval_eq 3 2 (by decide)
  · exact malCommit_eval_eq 4 3 (by decide)

example :
    Shamir.reconstruct params23 S₁ σ₁ = Shamir.reconstruct params23 S₂ σ₂ :=
  feldmanVerify_agree_on_authorized schnorrGroups d23 params23 malCommit
    (by decide : Shamir.authorized params23 S₁)
    (by decide : Shamir.authorized params23 S₂)
    hver₁ hver₂

example :
    Shamir.reconstruct params23 S₁ σ₁ = 3 :=
  reconstruct_eq_of_feldmanVerify_commit_zero schnorrGroups d23 params23 malCommit rfl
    S₁ (by decide : Shamir.authorized params23 S₁) σ₁ hver₁

example (s₁ s₂ : ZMod (schnorrGroups.order d23))
    (h₁ : feldmanVerify schnorrGroups d23 params23 malCommit 0 s₁ = true)
    (h₂ : feldmanVerify schnorrGroups d23 params23 malCommit 0 s₂ = true) : s₁ = s₂ :=
  feldmanVerify_unique_share schnorrGroups d23 params23 malCommit 0 h₁ h₂

/-! ### 3. Zero-distance coalition simulation -/

example (secret : ZMod (schnorrGroups.order d23)) :
    feldmanView schnorrGroups d23 params23 {0, 2} secret =
      feldmanSim schnorrGroups d23 params23 {0, 2} (by decide)
        (secret • schnorrGroups.generator d23) :=
  feldmanView_eq_feldmanSim schnorrGroups d23 params23 {0, 2} (by decide) secret

/-! ### 4. Uniform-secret secrecy under `DiscreteLog` and chosen-secret attack -/

/-- Family of `(t = 2, n = 4)` Shamir parameters parameterized by `F.Desc` when `5 ≤ F.order d`. -/
def familyParams (F : PrimeOrderGroupFamily) (hord : ∀ d, 5 ≤ F.order d) (d : F.Desc) :
    Shamir.Params (ZMod (F.order d)) (Fin 4) where
  threshold := 2
  threshold_lt_card := by decide
  point i := ((i.1 + 1 : ℕ) : ZMod (F.order d))
  point_injective := by
    intro a b hab
    have ha : a.1 + 1 < F.order d := lt_of_lt_of_le (by omega) (hord d)
    have hb : b.1 + 1 < F.order d := lt_of_lt_of_le (by omega) (hord d)
    have hval := congrArg ZMod.val hab
    rw [ZMod.val_natCast_of_lt ha, ZMod.val_natCast_of_lt hb] at hval
    exact Fin.ext (by omega)
  point_nonzero := by
    intro i hi
    have hi_lt : i.1 + 1 < F.order d := lt_of_lt_of_le (by omega) (hord d)
    have hval := congrArg ZMod.val hi
    rw [ZMod.val_natCast_of_lt hi_lt, ZMod.val_zero] at hval
    omega

theorem computableInPolyTime_familyPoint (F : PrimeOrderGroupFamily) (hord : ∀ d, 5 ≤ F.order d)
    (i : Fin 4) :
    ComputableInPolyTime (fun d => ((familyParams F hord d).point i).val) F.encDesc encNat := by
  have hfn : (fun d => ((familyParams F hord d).point i).val) = fun _ => i.1 + 1 := by
    ext d
    exact ZMod.val_natCast_of_lt (lt_of_lt_of_le (by omega) (hord d))
  rw [hfn]
  exact ComputableInPolyTime.const (i.1 + 1)

example (F : PrimeOrderGroupFamily) (hord : ∀ d, 5 ≤ F.order d)
    (setup : ℕ → PMF F.Desc) (hDL : F.DiscreteLog setup)
    (adversary : ℕ → F.Desc × (Fin 3 → List Bool) × (({0, 1} : Finset (Fin 4)) → ℕ) →
      ProbComp (List Bool))
    (hadv : IsPPTOn
      (encPair encUnary (encPair F.encDesc (encPair (encPi encBits) (encPi encNat))))
      encBits (fun p => adversary p.1 p.2)) :
    Negligible fun n =>
      Game.succProbability
        (feldmanSecrecyGame F setup (familyParams F hord) (fun _ => rfl)
          {0, 1} adversary n) :=
  hDL.feldmanSecrecy (familyParams F hord) (fun _ => rfl)
    (computableInPolyTime_familyPoint F hord) {0, 1} (by decide) (by decide) adversary hadv

-- Concrete trivial PPT adversary on constant `d23` setup (zero-query simulator reduction compiles
-- cleanly without hitting non-computable traps).
example (F : PrimeOrderGroupFamily) (hord : ∀ d, 5 ≤ F.order d) (setup : ℕ → PMF F.Desc)
    (hDL : F.DiscreteLog setup) :
    Negligible fun n =>
      Game.succProbability
        (feldmanSecrecyGame F setup (familyParams F hord) (fun _ => rfl)
          {0, 1} (fun _ _ => pure []) n) :=
  hDL.feldmanSecrecy (familyParams F hord) (fun _ => rfl)
    (computableInPolyTime_familyPoint F hord) {0, 1} (by decide) (by decide)
    (fun _ _ => pure []) (ComputableInPolyTime.const _).isPPTOn

-- Encoded share verifier is PPT for `familyParams`.
example (F : PrimeOrderGroupFamily) (hord : ∀ d, 5 ≤ F.order d) (i : Fin 4) :
    ComputableInPolyTime
      (fun p : F.Desc × (Fin 3 → List Bool) × ℕ =>
        encodeFeldmanVerify F p.1 (familyParams F hord p.1) p.2.1 i p.2.2)
      (encPair F.encDesc (encPair (encPi encBits) encNat)) encBool :=
  computableInPolyTime_encodeFeldmanVerify F 2 i (familyParams F hord) (fun _ => rfl)
    (computableInPolyTime_familyPoint F hord i)

-- Chosen-secret indistinguishability failure: `C 0 = secret • g` exposes `0` vs `1` with
-- advantage `1` to a strict PPT distinguisher.
example :
    IsPPTOn
      (encPair encUnary (encPair schnorrGroups.encDesc (encPair (encPi encBits) (encPi encNat))))
      encBool
      (fun p => feldmanChosenSecretDistinguisher schnorrGroups (Party := Fin 4) (t := 2)
        (I := {0, 1}) p.1 p.2) ∧
      ∀ n, Game.advantage
        (feldmanChosenSecretGame schnorrGroups (fun _ => PMF.pure d23)
          (fun _ => params23) (fun _ => rfl) {0, 1}
          (feldmanChosenSecretDistinguisher schnorrGroups) (fun _ => 0) (fun _ => 1) false n)
        (feldmanChosenSecretGame schnorrGroups (fun _ => PMF.pure d23)
          (fun _ => params23) (fun _ => rfl) {0, 1}
          (feldmanChosenSecretDistinguisher schnorrGroups) (fun _ => 0) (fun _ => 1) true n) = 1 :=
  ⟨isPPTOn_feldmanChosenSecretDistinguisher schnorrGroups,
    fun n => advantage_feldmanChosenSecretDistinguisher_eq_one schnorrGroups
      (fun _ => PMF.pure d23) (fun _ => params23) (fun _ => rfl) {0, 1} n⟩

end CslibFrontierTests.Crypto.FeldmanVSS
