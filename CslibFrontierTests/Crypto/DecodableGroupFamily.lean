import CslibFrontier.Crypto.Computational.DiffieHellman.Decodable
import CslibFrontier.Crypto.Computational.DiscreteLog.SchnorrGroup.Decodable
import CslibFrontier.Crypto.Computational.ElGamal.Decodable
import CslibFrontier.Crypto.Computational.ElGamal.KDF
import Mathlib.Tactic.NormNum.Prime

/-!
# Tests for decodable prime-order group families and word-level CDH

Checks canonical decoding and membership testing on `schnorrDecodableGroups` (`d23`, order `11`
modulo `23` generated by `2`) and `DecodablePrimeOrderGroupFamily.withSeed`, rejection of invalid
and non-canonical bit strings (`[]`, out-of-subgroup residue `5`, unreduced `24 ≡ 1 mod 23`, and
trailing-`false` encoding `(2 : ℕ).bits ++ [false]`), the `WordCDH ↔ CDH` equivalence
(`cdh_iff_encoded`) and `DDH.wordCDH` corollary, and decodable group-element ElGamal CPA /
`INDCPAOn` without external `valid` stand-ins.
-/

namespace CslibFrontierTests.Crypto.DecodableGroupFamily

open Cslib Cslib.Probability Cslib.Crypto Cslib.Crypto.Encryption Turing.MultiTapeTM
open scoped NNReal

/-- The Schnorr group of order `11` in `(ZMod 23)ˣ`, generated by `2`. -/
def d23 : schnorrDecodableGroups.Desc :=
  ⟨(23, 11, 2), ⟨by norm_num, by norm_num, by norm_num, by norm_num, by norm_num⟩⟩

/-! ### Schnorr canonical decoding and rejection checks -/

-- Valid subgroup elements: `1 = 0 • g`, `2 = 1 • g`, `8 = 3 • g`.
example :
    SchnorrGroup.isElem (d23, (1 : ℕ).bits) = true ∧
    SchnorrGroup.isElem (d23, (2 : ℕ).bits) = true ∧
    SchnorrGroup.isElem (d23, (8 : ℕ).bits) = true := by
  decide

private theorem decode_map_encode_of_isElem (w : List Bool)
    (h : SchnorrGroup.isElem (d23, w) = true) :
    (schnorrDecodableGroups.decode d23 w).map (schnorrDecodableGroups.encode d23) = some w := by
  rw [schnorrDecodableGroups.map_encode_decode]
  have his : schnorrDecodableGroups.isElem (d23, w) = true := by
    change (SchnorrGroup.decode d23 w).isSome = true
    exact (SchnorrGroup.isSome_decode_eq_isElem (d23, w)).trans h
  simp only [his, ↓reduceIte]

private theorem decode_none_of_isElem_false (w : List Bool)
    (h : SchnorrGroup.isElem (d23, w) = false) :
    schnorrDecodableGroups.decode d23 w = none := by
  rw [DecodablePrimeOrderGroupFamily.decode_eq_none_iff,
    ← schnorrDecodableGroups.isElem_eq_false_iff]
  change (SchnorrGroup.decode d23 w).isSome = false
  exact (SchnorrGroup.isSome_decode_eq_isElem (d23, w)).trans h

example :
    (schnorrDecodableGroups.decode d23 (1 : ℕ).bits).map (schnorrDecodableGroups.encode d23) =
      some (1 : ℕ).bits ∧
    (schnorrDecodableGroups.decode d23 (2 : ℕ).bits).map (schnorrDecodableGroups.encode d23) =
      some (2 : ℕ).bits ∧
    (schnorrDecodableGroups.decode d23 (8 : ℕ).bits).map (schnorrDecodableGroups.encode d23) =
      some (8 : ℕ).bits :=
  ⟨decode_map_encode_of_isElem _ (by decide),
   decode_map_encode_of_isElem _ (by decide),
   decode_map_encode_of_isElem _ (by decide)⟩

example :
    schnorrDecodableGroups.decode d23 (schnorrDecodableGroups.encode d23 0) = some 0 ∧
    schnorrDecodableGroups.decode d23
        (schnorrDecodableGroups.encode d23 (schnorrDecodableGroups.generator d23)) =
      some (schnorrDecodableGroups.generator d23) :=
  ⟨schnorrDecodableGroups.decode_encode d23 0,
   schnorrDecodableGroups.decode_encode d23 (schnorrDecodableGroups.generator d23)⟩

-- Exact round-trip at `generator d23`: `decode d23 (2 : ℕ).bits = some (generator d23)`.
example :
    schnorrDecodableGroups.decode d23 (2 : ℕ).bits =
      some (schnorrDecodableGroups.generator d23) := by
  have hgen : schnorrDecodableGroups.encode d23 (schnorrDecodableGroups.generator d23) =
      (2 : ℕ).bits :=
    SchnorrGroup.encode_generator d23
  rw [← hgen, schnorrDecodableGroups.decode_encode]

-- Invalid words: `[]` (residue `0`), non-subgroup residue `5` (`5^11 ≡ 22 mod 23`), unreduced
-- residue `24 ≥ 23` (`24^11 ≡ 1 mod 23`), and non-canonical `(2 : ℕ).bits ++ [false]`.
example :
    SchnorrGroup.isElem (d23, []) = false ∧
    SchnorrGroup.isElem (d23, (5 : ℕ).bits) = false ∧
    SchnorrGroup.isElem (d23, (24 : ℕ).bits) = false ∧
    SchnorrGroup.isElem (d23, (2 : ℕ).bits ++ [false]) = false := by
  decide

example :
    schnorrDecodableGroups.decode d23 [] = none ∧
    schnorrDecodableGroups.decode d23 (5 : ℕ).bits = none ∧
    schnorrDecodableGroups.decode d23 (24 : ℕ).bits = none ∧
    schnorrDecodableGroups.decode d23 ((2 : ℕ).bits ++ [false]) = none :=
  ⟨decode_none_of_isElem_false _ (by decide),
   decode_none_of_isElem_false _ (by decide),
   decode_none_of_isElem_false _ (by decide),
   decode_none_of_isElem_false _ (by decide)⟩

/-! ### Public-seed augmentation `withSeed` -/

example (s : List Bool) (x : schnorrDecodableGroups.withSeed.Carrier (d23, s)) :
    schnorrDecodableGroups.withSeed.decode (d23, s)
        (schnorrDecodableGroups.withSeed.encode (d23, s) x) = some x ∧
    schnorrDecodableGroups.withSeed.isElem ((d23, s), (5 : ℕ).bits) = false := by
  refine ⟨schnorrDecodableGroups.withSeed.decode_encode (d23, s) x, ?_⟩
  rw [DecodablePrimeOrderGroupFamily.isElem_withSeed]
  change (SchnorrGroup.decode d23 (5 : ℕ).bits).isSome = false
  exact (SchnorrGroup.isSome_decode_eq_isElem (d23, (5 : ℕ).bits)).trans (by decide)

/-! ### Word-level CDH equivalence and `DDH.wordCDH` -/

/-- A toy word-level CDH adversary that outputs the second encoded public element `v` verbatim on
even security parameters and outputs the non-group word `[true, false, true]` otherwise. -/
noncomputable def toyWordCDHAdversary :
    ℕ → schnorrDecodableGroups.Desc × List Bool × List Bool → ProbComp (List Bool)
  | 0, (_, _, v) => pure v
  | _ + 1, _ => pure [true, false, true]

/-- `toyWordCDHAdversary` is uniform strict PPT and translates to a PPT typed CDH adversary. -/
theorem isPPT_toyWordCDHAdversary :
    IsPPTOn schnorrDecodableGroups.toPrimeOrderGroupFamily.encWordCDHInput encBits
      (fun x => toyWordCDHAdversary x.1 x.2) ∧
    (schnorrDecodableGroups.wordToTypedCDHAdversary toyWordCDHAdversary).IsPPT := by
  have hp := ComputableInPolyTime.id'
    (encIn := schnorrDecodableGroups.toPrimeOrderGroupFamily.encWordCDHInput)
  have hzero : ComputableInPolyTime
      (fun x : ℕ × schnorrDecodableGroups.Desc × List Bool × List Bool => decide (x.1 = 0))
      schnorrDecodableGroups.toPrimeOrderGroupFamily.encWordCDHInput encBool :=
    (ComputableTidilyInPolyTime.decide_eq encUnary).computableInPolyTime.comp
      (hp.fst'.prod (ComputableInPolyTime.const 0))
  have hv : ComputableInPolyTime
      (fun x : ℕ × schnorrDecodableGroups.Desc × List Bool × List Bool => x.2.2.2)
      schnorrDecodableGroups.toPrimeOrderGroupFamily.encWordCDHInput encBits :=
    hp.snd'.snd'.snd'
  have hfn : ComputableInPolyTime
      (fun x : ℕ × schnorrDecodableGroups.Desc × List Bool × List Bool =>
        if x.1 = 0 then x.2.2.2 else [true, false, true])
      schnorrDecodableGroups.toPrimeOrderGroupFamily.encWordCDHInput encBits :=
    (hzero.ite hv (ComputableInPolyTime.const [true, false, true])).of_enc_eq fun x => by
      by_cases hx : x.1 = 0 <;> simp [hx]
  have hW : IsPPTOn schnorrDecodableGroups.toPrimeOrderGroupFamily.encWordCDHInput encBits
      (fun x => toyWordCDHAdversary x.1 x.2) := by
    refine hfn.isPPTOn.congr fun x => ?_
    rcases x with ⟨n, d, u, v⟩
    cases n <;> rfl
  exact ⟨hW, schnorrDecodableGroups.isPPT_wordToTypedCDHAdversary hW⟩

/-- Under `DDH` (plus negligible inverse group order), `schnorrDecodableGroups` and its seeded
variant `schnorrDecodableGroups.withSeed` enjoy word-level `WordCDH`, equivalent to `CDH`. -/
example {setup : ℕ → PMF schnorrDecodableGroups.Desc}
    (hDDH : schnorrDecodableGroups.toPrimeOrderGroupFamily.DDH setup)
    {seedLen : ℕ → schnorrDecodableGroups.Desc → ℕ}
    (hseed : ComputableInPolyTime (fun p : ℕ × schnorrDecodableGroups.Desc => seedLen p.1 p.2)
      (encPair encUnary schnorrDecodableGroups.encDesc) encUnary)
    {m : ℕ → ℕ} (hm0 : ∀ n, 0 < m n)
    (hm : ∀ n, ∀ d ∈ (setup n).support, m n ≤ schnorrDecodableGroups.order d)
    (hinv : Negligible fun n => (1 / m n : ℝ≥0)) :
    (schnorrDecodableGroups.toPrimeOrderGroupFamily.CDH setup ↔
      schnorrDecodableGroups.toPrimeOrderGroupFamily.WordCDH setup) ∧
    schnorrDecodableGroups.toPrimeOrderGroupFamily.WordCDH setup ∧
    schnorrDecodableGroups.withSeed.toPrimeOrderGroupFamily.WordCDH
      (schnorrDecodableGroups.toPrimeOrderGroupFamily.seededSetup setup seedLen) := by
  have hDDH_seed := hDDH.withSeed hseed
  refine ⟨schnorrDecodableGroups.cdh_iff_encoded setup,
    DecodablePrimeOrderGroupFamily.DDH.wordCDH hDDH hm0 hm hinv, ?_⟩
  refine DecodablePrimeOrderGroupFamily.DDH.wordCDH hDDH_seed hm0 (fun n ds hds => ?_) hinv
  simp only [PrimeOrderGroupFamily.seededSetup, PMF.monad_bind_eq_bind, PMF.monad_pure_eq_pure,
    PMF.support_bind, Set.mem_iUnion, PMF.support_pure, Set.mem_singleton_iff] at hds
  rcases hds with ⟨d, hd, s, _, rfl⟩
  exact hm n d hd

/-! ### Decodable group-element ElGamal CPA and `INDCPAOn` without `valid` stand-ins -/

private theorem elGamalGroupValid_eq (w₁ w₂ : List Bool) :
    schnorrDecodableGroups.elGamalGroupValid (fun _ => d23) 0 [] w₁ w₂ =
      (SchnorrGroup.isElem (d23, w₁) && SchnorrGroup.isElem (d23, w₂)) := by
  simp only [DecodablePrimeOrderGroupFamily.elGamalGroupValid,
    DecodablePrimeOrderGroupFamily.isElem]
  exact congrArg₂ (· && ·)
    (SchnorrGroup.isSome_decode_eq_isElem (d23, w₁))
    (SchnorrGroup.isSome_decode_eq_isElem (d23, w₂))

example :
    schnorrDecodableGroups.elGamalGroupValid (fun _ => d23) 0 [] (1 : ℕ).bits (2 : ℕ).bits =
      true ∧
    schnorrDecodableGroups.elGamalGroupValid (fun _ => d23) 0 [] (5 : ℕ).bits (2 : ℕ).bits =
      false ∧
    schnorrDecodableGroups.elGamalGroupValid (fun _ => d23) 0 []
        ((2 : ℕ).bits ++ [false]) (2 : ℕ).bits =
      false := by
  rw [elGamalGroupValid_eq, elGamalGroupValid_eq, elGamalGroupValid_eq]
  decide

example {setup : ℕ → PMF schnorrDecodableGroups.Desc}
    (hDDH : schnorrDecodableGroups.toPrimeOrderGroupFamily.DDH setup)
    {adversary : Encryption.WordAdversary} (hA : adversary.IsPPT)
    (d : ℕ → schnorrDecodableGroups.Desc)
    (hd : ComputableInPolyTime d encUnary schnorrDecodableGroups.encDesc)
    (hDDH_pure : schnorrDecodableGroups.toPrimeOrderGroupFamily.DDH (fun n => PMF.pure (d n))) :
    (Negligible fun n =>
      Game.advantage
        (schnorrDecodableGroups.elGamalGroupCPAGame setup adversary false n)
        (schnorrDecodableGroups.elGamalGroupCPAGame setup adversary true n)) ∧
    INDCPAOn (schnorrDecodableGroups.elGamalGroupValid d) encBits
      (schnorrDecodableGroups.elGamalKeyGenProb d)
      (schnorrDecodableGroups.elGamalEncryptProb (fun _ m => m) d) :=
  ⟨DecodablePrimeOrderGroupFamily.DDH.negligible_elGamalGroupCPAGame hDDH hA,
   DecodablePrimeOrderGroupFamily.DDH.indcpaOn_elGamalGroupEncryptProb hDDH_pure hd⟩

end CslibFrontierTests.Crypto.DecodableGroupFamily
