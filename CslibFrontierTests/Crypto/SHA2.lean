module
-- upstream: local-only (test)

public import CslibFrontier.Crypto.Primitives.Hash.SHA2
public meta import CslibFrontier.Crypto.Primitives.Hash.SHA2

/-!
# SHA-2 boundary clients

The `abc` and longer-message digests are copied from NIST's official SHA-256 and SHA-512 example
documents. The longer messages occupy two padded blocks, so they exercise state chaining as well as
one-block padding and compression.
-/

-- This module checks the exported SHA-2 API and exports no test fixtures.
set_option linter.privateModule false

public section

namespace SHA2Tests

open Cslib.Crypto Cslib.Crypto.SHA2

set_option linter.hashCommand false

private def abc : List Byte := [0x61, 0x62, 0x63]

private def sha256ABC : List Byte :=
  [0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea,
    0x41, 0x41, 0x40, 0xde, 0x5d, 0xae, 0x22, 0x23,
    0xb0, 0x03, 0x61, 0xa3, 0x96, 0x17, 0x7a, 0x9c,
    0xb4, 0x10, 0xff, 0x61, 0xf2, 0x00, 0x15, 0xad]

private def sha512ABC : List Byte :=
  [0xdd, 0xaf, 0x35, 0xa1, 0x93, 0x61, 0x7a, 0xba,
    0xcc, 0x41, 0x73, 0x49, 0xae, 0x20, 0x41, 0x31,
    0x12, 0xe6, 0xfa, 0x4e, 0x89, 0xa9, 0x7e, 0xa2,
    0x0a, 0x9e, 0xee, 0xe6, 0x4b, 0x55, 0xd3, 0x9a,
    0x21, 0x92, 0x99, 0x2a, 0x27, 0x4f, 0xc1, 0xa8,
