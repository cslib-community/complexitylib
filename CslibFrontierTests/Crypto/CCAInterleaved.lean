import CslibFrontier.Crypto.Computational.Encryption.CCA.Interleaved
import CslibFrontier.Tactic.PolyTime
import CslibFrontierTests.Crypto.CCA

/-!
# Tests for fully adaptive interleaved-query multi-challenge CCA security (`INDCCA2InterleavedOn`)

Two-sided nonvacuity and behavioral regression tests for
`CslibFrontier.Crypto.Computational.Encryption.CCA.Interleaved`:
1. Satisfiable `INDCCA2Interleaved` and `WordINDCCA2Interleaved` instances obtained from `INDCCA2`
   and `WordINDCCA2` via `INDCCA2.indcca2Interleaved` and `WordINDCCA2.wordINDCCA2Interleaved`,
   paired with refutable instances via `INDCCA2Interleaved.indcca2` and
   `INDCCA2InterleavedOf.indcca2Of`.
2. Behavioral tests of the progressive forbidden challenge-ciphertext set `S` in
   `interleavedCcaOracle` and the multi-round loop in `interleavedCca2Game`: a decryption query
   `.decrypt c` submitted *before* `c` is generated by a later `.challenge` query is decrypted
   normally (`S = []`), whereas querying `.decrypt c` *after* `.challenge` produces `c` (`c ∈ S`)
   is rejected.
3. Behavioral test of `OracleComp.limitQueries` enforcing a hard query budget `B`.
-/

namespace ComplexityTests.Crypto.CCAInterleaved

open Cslib Cslib.Probability Cslib.Crypto Cslib.Crypto.Encryption Turing.MultiTapeTM
open ComplexityTests.Crypto.CCA

/-! ### 1. Satisfiable and refutable `INDCCA2Interleaved` and `WordINDCCA2Interleaved` instances -/

/-- By `INDCCA2.indcca2Interleaved` (Theorem 12.1), `constKeyGen`/`constEncrypt`/`constDecrypt`
satisfies fully adaptive interleaved-query multi-challenge `INDCCA2Interleaved`. -/
theorem indcca2Interleaved_const : INDCCA2Interleaved constKeyGen constEncrypt constDecrypt :=
  indcca2_const.indcca2Interleaved
    ((ComputableInPolyTime.const ([], [])).isPPTOn)
    ((ComputableInPolyTime.const []).isPPTOn)
    (ComputableInPolyTime.const none)

/-- By `WordINDCCA2.wordINDCCA2Interleaved`, the equal-length word scheme `lenEncrypt` satisfies
`WordINDCCA2Interleaved`. -/
theorem wordINDCCA2Interleaved_lenEncrypt :
    WordINDCCA2Interleaved constKeyGen lenEncrypt lenDecrypt :=
  wordINDCCA2_lenEncrypt.wordINDCCA2Interleaved
    ((ComputableInPolyTime.const ([], [])).isPPTOn)
    (by
      have h : ComputableInPolyTime
          (fun p : ℕ × List Bool × List Bool => List.replicate p.2.2.length false)
          (encPair encUnary (encPair encBits encBits)) encBits := by polytime
      exact h.isPPTOn)
    (ComputableInPolyTime.const none)

/-- Without the equal-length guard, `lenEncrypt` violates unrestricted
`INDCCA2InterleavedOf encBits encOut` for every decryption function. -/
theorem not_indcca2InterleavedOf_lenEncrypt {Out : Type} (encOut : Out ↪ List Bool)
    (decrypt : ℕ → List Bool → List Bool → Option Out) :
    ¬ INDCCA2InterleavedOf encBits encOut constKeyGen lenEncrypt decrypt :=
  fun hInter => not_indcca2Of_lenEncrypt encOut decrypt hInter.indcca2On

/-- The plaintext-leaking scheme from `CslibFrontierTests.Crypto.Encryption` violates
`INDCCA2Interleaved` for every decryption function. -/
theorem not_indcca2Interleaved_leaking (decrypt : ℕ → List Bool → List Bool → Option Bool) :
    ¬ INDCCA2Interleaved ComplexityTests.Crypto.Encryption.keyGen
        ComplexityTests.Crypto.Encryption.encrypt decrypt :=
  fun hInter => not_indcca2_leaking decrypt hInter.indcca2On

/-! ### 2. Progressive forbidden-set behavior of `interleavedCcaOracle` and `interleavedCca2Game` -/

/-- Deterministic toy encryption mapping bit `b` to `[b]`. -/
def bitEchoEncrypt (_ : ℕ) (_ : List Bool) (b : Bool) : ProbComp (List Bool) :=
  pure [b]

/-- Deterministic toy decryption returning `ct.head?`. -/
def bitEchoDecrypt (_ : ℕ) (_ : List Bool) (ct : List Bool) : Option Bool :=
  ct.head?

/-- Before any `.challenge` query is made (`S = []`), querying `.decrypt [true]` succeeds and
returns `Sum.inr (some true)`, leaving `S = []`. -/
theorem interleavedCcaOracle_decrypt_before_challenge :
    interleavedCcaOracle (fun _ _ _ _ => true) bitEchoEncrypt bitEchoDecrypt 0 [] [] true
      (.decrypt [true]) [] =
      pure (Sum.inr (some true), []) :=
  rfl

/-- Issuing `.challenge false true` when `bit = true` produces ciphertext `[true]` and updates the
forbidden challenge set from `[]` to `[[true]]`. -/
theorem interleavedCcaOracle_challenge_adds_to_S :
    interleavedCcaOracle (fun _ _ _ _ => true) bitEchoEncrypt bitEchoDecrypt 0 [] [] true
      (.challenge false true) [] =
      pure (Sum.inl (some [true]), [[true]]) :=
  rfl

/-- Once `[true]` has been recorded in `S = [[true]]`, querying `.decrypt [true]` is rejected with
`Sum.inr none`, while querying a distinct ciphertext `.decrypt [false]` still succeeds. -/
theorem interleavedCcaOracle_decrypt_after_challenge :
    interleavedCcaOracle (fun _ _ _ _ => true) bitEchoEncrypt bitEchoDecrypt 0 [] [] true
      (.decrypt [true]) [[true]] =
      pure (Sum.inr none, [[true]]) ∧
    interleavedCcaOracle (fun _ _ _ _ => true) bitEchoEncrypt bitEchoDecrypt 0 [] [] true
      (.decrypt [false]) [[true]] =
      pure (Sum.inr (some false), [[true]]) :=
  ⟨rfl, rfl⟩

/-- A 2-round `InterleavedCCA2Adversary` that submits `.challenge false true` in Round 0 (saving the
received challenge ciphertext `ct = [bit]` in Round 1) and queries `.decrypt ct` in Round 1 (which
is rejected with `[]` since `ct ∈ S`), then outputs `lastReply.isEmpty && state.headD false`. -/
def twoRoundInterleavedAdv : InterleavedCCA2Adversary where
  numRounds _ := 2
  step _ _ state lastReply :=
    if state.isEmpty then
      pure (.challenge false true, [true])
    else
      pure (.decrypt lastReply.tail, lastReply.tail)
  finish _ _ state lastReply :=
    pure (lastReply.isEmpty && state.headD false)

/-- End-to-end 2-round behavioral test of `interleavedCca2Game`: Round 0's `.challenge false true`
populates `S = [[bit]]`, Round 1's `.decrypt [bit]` is rejected with `[]`, and `finish` recovers
`bit`. -/
theorem interleavedCca2Game_twoRoundInterleavedAdv (bit : Bool) :
    interleavedCca2Game encBool constKeyGen bitEchoEncrypt bitEchoDecrypt
      twoRoundInterleavedAdv bit 0 = pure bit := by
  cases bit <;> rfl

/-! ### 3. Behavioral test of `OracleComp.limitQueries` -/

/-- With budget `1`, the first oracle query is forwarded and the second oracle query is cut off with
`default = []`. -/
theorem limitQueries_one_cuts_off_second :
    OracleComp.limitQueries (spec := fun _ : Unit => List Bool) (fun _ => []) 1
      (do
        let r₁ ← ProbOracleComp.query ()
        let r₂ ← ProbOracleComp.query ()
        return (r₁, r₂)) =
    (do
      let r₁ ← ProbOracleComp.query ()
      return (r₁, ([] : List Bool))) := by
  simp only [OracleComp.limitQueries, OracleComp.interpret_bind, StateT.run_bind,
    ProbOracleComp.interpret_query, OracleComp.interpret_pure, StateT.run_pure]
  dsimp only [OracleComp.limitQueriesHandler, StateT.run]
  simp

end ComplexityTests.Crypto.CCAInterleaved
