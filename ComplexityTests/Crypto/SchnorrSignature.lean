import Complexity.Crypto.Computational.DiscreteLog.SchnorrGroup
import Complexity.Crypto.Computational.SchnorrSignature
import Complexity.Crypto.Negligible.Basic
import Complexity.Tactic.PolyTime
import Mathlib.Tactic.NormNum.Prime

/-!
# Tests for computational Schnorr signatures under the discrete-logarithm assumption

The order-`11` Schnorr group `d23` in `(ZMod 23)ˣ`, generated by `2`, exercises the bit-encoded
Schnorr signature algorithms (`schnorrSigKeyGen`, `schnorrCommitBits`, `schnorrRespondBits`,
`schnorrSignCoins`, `schnorrSigVerifyBits`, `schnorrRecoverCommitBits`), their strict-PPT and
polynomial-time certificates, the typed Fiat–Shamir random-oracle signature schemes
(`schnorrFamilyROMScheme` and `schnorrScalarROMScheme`) with their Pointcheval–Stern /
Bellare–Neven EUF-CMA bound. Strict-PPT identification is tested separately in
`ComplexityTests/Crypto/SchnorrEavesdrop.lean`; efficient realization of the general ROM
forking reduction remains a separate obligation.
-/

namespace ComplexityTests.Crypto.SchnorrSignature

open Cslib Cslib.Probability Cslib.Crypto Cslib.Crypto.Protocols SigmaProtocol ROMSignature
open Turing.MultiTapeTM
open scoped NNReal

/-- The Schnorr group of order `11` in `(ZMod 23)ˣ`, generated by `2`. -/
def d23 : SchnorrGroup.Desc :=
  ⟨(23, 11, 2), ⟨by norm_num, by norm_num, by norm_num, by norm_num, by norm_num⟩⟩

/-- `d23` has order `11 ≥ 2 ^ 3`, so `3`-bit challenges embed injectively into `ZMod 11`. -/
example : 2 ^ 3 ≤ schnorrGroups.order d23 := by decide

/-- With secret key `sk = 3`, randomness `r = 5`, and challenge bits `[true, false, true]`
(`ofBits = 5`), the commitment is `2 ^ 5 ≡ 9 (mod 23)` and the response is
`5 + 5 · 3 ≡ 9 (mod 11)`. -/
example :
    schnorrGroups.schnorrSignCoins (d23, Nat.bits 3, [true], Nat.bits 5, [true, false, true]) =
      (Nat.bits 9, Nat.bits 9) := by
  decide

/-- The bit-encoded verifier accepts the signature `(Nat.bits 9, Nat.bits 9)` on public key
`2 ^ 3 ≡ 8 (mod 23)` under challenge bits `[true, false, true]`. -/
example : schnorrGroups.schnorrSigVerifyBits
    (d23, Nat.bits 8, [true], (Nat.bits 9, Nat.bits 9), [true, false, true]) = true := by
  decide

/-- The bit-encoded verifier rejects a forged response `(Nat.bits 9, Nat.bits 4)` on public key
`Nat.bits 8` under challenge bits `[true, false, true]`. -/
example : schnorrGroups.schnorrSigVerifyBits
    (d23, Nat.bits 8, [true], (Nat.bits 9, Nat.bits 4), [true, false, true]) = false := by
  decide

/-- The old verification equation reduced an unchecked commitment modulo `23`: the word for
`32 = 9 + 23` passed in place of the canonical commitment `9`. This records that old expression,
not another public verifier. -/
example :
    (schnorrGroups.smul (d23, 9, schnorrGroups.encode d23 (schnorrGroups.generator d23)) ==
      schnorrGroups.add (d23, Nat.bits 32,
        schnorrGroups.smul (d23, 5, Nat.bits 8))) = true := by decide

/-- The bad commitment is outside the actual Schnorr group's encoding range. -/
example : Nat.bits 32 ∉ Set.range (schnorrGroups.encode d23) := by
  rintro ⟨x, hx⟩
  change SchnorrGroup.encode d23 x = Nat.bits 32 at hx
  have h := congrArg ofBits hx
  simp only [SchnorrGroup.encode, ofBits, Nat.foldr_bit_bits] at h
  have hlt := ZMod.val_lt
    (((Additive.toMul x : Subgroup.zpowers (SchnorrGroup.generatorUnit d23)) :
      (ZMod d23.modulus)ˣ) : ZMod d23.modulus)
  change _ < 23 at hlt
  omega

/-- Canonical recovery rejects the same malformed commitment. -/
example : schnorrGroups.schnorrSigVerifyBits
    (d23, Nat.bits 8, [true], (Nat.bits 32, Nat.bits 9), [true, false, true]) = false := by
  decide

/-- A redundant high zero bit also fails exact word equality. -/
example : schnorrGroups.schnorrSigVerifyBits
    (d23, Nat.bits 8, [true], (Nat.bits 9 ++ [false], Nat.bits 9),
      [true, false, true]) = false := by decide

/-- Accepted commitments lie in the group's encoding range for every response/challenge word. -/
example (F : PrimeOrderGroupFamily) (d : F.Desc) (u : F.Carrier d)
    (msg t z roOut : List Bool)
    (h : F.schnorrSigVerifyBits (d, F.encode d u, msg, (t, z), roOut) = true) :
    t ∈ Set.range (F.encode d) :=
  F.schnorrSigVerifyBits_commitment_mem_range d u msg t z roOut h

/-- Public commitment recovery reconstructs `2 ^ 9 · (8 ^ (11 - 5)) ≡ 9 (mod 23)`. -/
example : schnorrGroups.schnorrRecoverCommitBits
    (d23, Nat.bits 8, [true, false, true], Nat.bits 9) = Nat.bits 9 := by
  decide

/-- Completeness of bit-encoded Schnorr signing and verification over any
`PrimeOrderGroupFamily`. -/
example (F : PrimeOrderGroupFamily) (d : F.Desc) (α r : ZMod (F.order d))
    (msg roOut : List Bool) :
    F.schnorrSigVerifyBits
      (d, F.encode d (α • F.generator d), msg,
        F.schnorrSignCoins
          (d, F.encScalar d α, msg, F.encScalar d r, roOut),
        roOut) = true :=
  F.schnorrSigVerifyBits_schnorrSignCoins d α r msg roOut

/-- Key generation is uniform strict PPT on `(1^n, d)`. -/
example : IsPPTOn (encPair encUnary schnorrGroups.encDesc) (encPair encBits encBits)
    (fun input => schnorrGroups.schnorrSigKeyGen input.1 input.2) :=
  schnorrGroups.isPPTOn_schnorrSigKeyGen

/-- Deterministic signing from coins and RO output is computable in polynomial time. -/
example : ComputableInPolyTime schnorrGroups.schnorrSignCoins
    (encPair schnorrGroups.encDesc (encPair encBits (encPair encBits (encPair encBits encBits))))
    (encPair encBits encBits) :=
  schnorrGroups.computableInPolyTime_schnorrSignCoins

/-- Deterministic bit-encoded verification is computable in polynomial time. -/
example : ComputableInPolyTime schnorrGroups.schnorrSigVerifyBits
    (encPair schnorrGroups.encDesc
      (encPair encBits (encPair encBits (encPair (encPair encBits encBits) encBits))))
    encBool :=
  schnorrGroups.computableInPolyTime_schnorrSigVerifyBits

/-- Honest signatures verify in `schnorrFamilyROMScheme` with `3`-bit challenges. -/
example (F : PrimeOrderGroupFamily) (d : F.Desc) (hm : 2 ^ 3 ≤ F.order d) :
    (F.schnorrFamilyROMScheme (M := List Bool) (m := 3) d hm).Correct :=
  F.schnorrFamilyROMScheme_correct (M := List Bool) (m := 3) d hm

/-- A trivial ROM forger that makes no queries and outputs the identity commitment and zero
response. -/
noncomputable def trivialROMForger (F : PrimeOrderGroupFamily) (d : F.Desc) :
    Forger (F.Carrier d) (List Bool)
      (F.Carrier d × ZMod (F.order d))
      (List Bool × F.Carrier d) (BitString 3) where
  Coins := Unit
  coins := PMF.pure ()
  forge _ _ := pure ([], (0, 0))

theorem trivialROMForger_callBounded (F : PrimeOrderGroupFamily) (d : F.Desc) :
    (trivialROMForger F d).CallBounded 0 0 :=
  fun _ _ => ⟨.pure _ 0, .pure _ 0⟩

/-- The Pointcheval–Stern / Bellare–Neven EUF-CMA bound specialized to `3`-bit challenges and
`trivialROMForger`. -/
example (F : PrimeOrderGroupFamily) (d : F.Desc) (hm : 2 ^ 3 ≤ F.order d) :
    (Game.succProbability
      (eufCmaGame (F.schnorrFamilyROMScheme (M := List Bool) (m := 3) d hm)
        (trivialROMForger F d)) : ℝ) ≤
      (1 : ℝ) / 2 ^ 3 +
        √(1 *
          (Game.succProbability
            (oneWayGame (schnorrKeyGen (F.generator d))
              (fun α u => α • F.generator d = u)
              (F.schnorrFamilyROMSchemeReduction (m := 3) d hm
                (trivialROMForger F d) 0 0)) : ℝ)) := by
  have h := F.succProbability_eufCmaGame_schnorrFamilyROMScheme_le
    (m := 3) d hm (trivialROMForger F d) (trivialROMForger_callBounded F d)
  simpa using h

/-- Request a signature and return exactly that signed message. This is a legal adaptive ROM
forger, but its output cannot be a fresh-message forgery. -/
noncomputable def replayROMForger (F : PrimeOrderGroupFamily) (d : F.Desc) :
    Forger (F.Carrier d) (List Bool)
      (F.Carrier d × ZMod (F.order d))
      (List Bool × F.Carrier d) (BitString 3) where
  Coins := Unit
  coins := PMF.pure ()
  forge _ _ := do
    let sig ← OracleComp.query (.inl [])
    return ([], sig)

/-- The actual Schnorr EUF-CMA game rejects replay even though an honest signature verifies. -/
example (F : PrimeOrderGroupFamily) (d : F.Desc) (hm : 2 ^ 3 ≤ F.order d) :
    eufCmaGame (F.schnorrFamilyROMScheme (M := List Bool) (m := 3) d hm)
      (replayROMForger F d) = PMF.pure false := by
  simp only [eufCmaGame, replayROMForger, OracleComp.interpret_bind,
    OracleComp.interpret_query, OracleComp.interpret_pure, StateT.run_bind,
    StateT.run_pure, PMF.monad_bind_eq_bind, PMF.monad_pure_eq_pure, PMF.pure_bind]
  simp [handler, StateT.run, PMF.bind_bind]

end ComplexityTests.Crypto.SchnorrSignature
