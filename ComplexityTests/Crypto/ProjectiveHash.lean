import Complexity.Crypto.Computational.CramerShoup.ProjectiveHash
import Complexity.Crypto.Computational.DiscreteLog.SchnorrGroup
import Mathlib.Tactic.NormNum.Prime

/-!
# Tests for universal and $\text{universal}_2$ projective hash functions

Concrete checks on the Schnorr group of order `11` in `(ZMod 23)ˣ` generated by `2` for universal
and $\text{universal}_2$ projective hash bijections (`projHashEquiv`, `projHashFiberChangeEquiv`,
`projHash2Equiv`, `projHash2FiberChangeEquiv`), concrete projective evaluation on Diffie–Hellman
triples, Lemma 12.5 (`1 / q ^ 2`) and Lemma 12.7 (`1 / q ^ 4`) point-mass formulas, and the
single-tuple (`1 / q`) and finite-list (`Q / q`) union-bound ingredients of Lemma 12.8.
-/

namespace ComplexityTests.Crypto.ProjectiveHash

open Cslib Cslib.Probability Cslib.Crypto Cslib.Crypto.ProjectiveHash
open scoped ENNReal

/-- The Schnorr group of order `11` in `(ZMod 23)ˣ`, generated by `2`. -/
def d23 : schnorrGroups.Desc :=
  ⟨(23, 11, 2), ⟨by norm_num, by norm_num, by norm_num, by norm_num, by norm_num⟩⟩

/-- Concrete `decide` check for `projHashEquiv` and `projHashFiberChangeEquiv` on
`ZMod 11 × ZMod 11` with `α = 2, β = 3, γ = 7` (`7 ≠ 2 * 3 = 6`):
`(4 + 2 * 5, 3 * 4 + 7 * 5) = (14, 47) = (3, 3)` mod `11`. -/
example :
    let hγ : (7 : ZMod (schnorrGroups.order d23)) ≠ 2 * 3 := by decide
    (projHashEquiv schnorrGroups d23 hγ) (4, 5) = (3, 3) ∧
      (projHashEquiv schnorrGroups d23 hγ).symm (3, 3) = (4, 5) ∧
      (projHashFiberChangeEquiv schnorrGroups d23 2) (3, 5) = (4, 5) ∧
      (projHashFiberChangeEquiv schnorrGroups d23 2).symm (4, 5) = (3, 5) := by
  let hγ : (7 : ZMod (schnorrGroups.order d23)) ≠ 2 * 3 := by decide
  have hf : (projHashEquiv schnorrGroups d23 hγ) (4, 5) = (3, 3) := by decide
  have hfc : (projHashFiberChangeEquiv schnorrGroups d23 2) (3, 5) = (4, 5) := by decide
  exact ⟨hf, by rw [← hf, Equiv.symm_apply_apply], hfc, by rw [← hfc, Equiv.symm_apply_apply]⟩

/-- Concrete `decide` check for `projHash2Equiv` and `projHash2FiberChangeEquiv` on `ZMod 11`
4-tuples with `α = 2, β = 3, γ = 7, β' = 4, γ' = 9, ρ = 1, ρ' = 5`. -/
example :
    let hγ : (7 : ZMod (schnorrGroups.order d23)) ≠ 2 * 3 := by decide
    let hγ' : (9 : ZMod (schnorrGroups.order d23)) ≠ 2 * 4 := by decide
    let hρ : (5 : ZMod (schnorrGroups.order d23)) ≠ 1 := by decide
    let e := projHash2Equiv schnorrGroups d23 hγ hγ' hρ
    let ec := projHash2FiberChangeEquiv schnorrGroups d23 2 1
    e ((1, 2), (3, 4)) = ((5, 0), (10, 9)) ∧
      e.symm ((5, 0), (10, 9)) = ((1, 2), (3, 4)) ∧
      ec ((5, 0), (6, 4)) = ((1, 2), (3, 4)) ∧
      ec.symm ((1, 2), (3, 4)) = ((5, 0), (6, 4)) := by
  let hγ : (7 : ZMod (schnorrGroups.order d23)) ≠ 2 * 3 := by decide
  let hγ' : (9 : ZMod (schnorrGroups.order d23)) ≠ 2 * 4 := by decide
  let hρ : (5 : ZMod (schnorrGroups.order d23)) ≠ 1 := by decide
  let e := projHash2Equiv schnorrGroups d23 hγ hγ' hρ
  let ec := projHash2FiberChangeEquiv schnorrGroups d23 2 1
  have hf : e ((1, 2), (3, 4)) = ((5, 0), (10, 9)) := by decide
  have hfc : ec ((5, 0), (6, 4)) = ((1, 2), (3, 4)) := by decide
  exact ⟨hf, by rw [← hf, Equiv.symm_apply_apply], hfc, by rw [← hfc, Equiv.symm_apply_apply]⟩

/-- Concrete check of projective evaluation of `projHash` and `projHash2` on the
Diffie–Hellman pair `(5 • g, 5 • (2 • g))` in `d23` at `σ₁ = 1, τ₁ = 2, σ₂ = 3, τ₂ = 4, ρ = 6`. -/
example :
    let g := schnorrGroups.generator d23
    let u := (2 : ZMod (schnorrGroups.order d23)) • g
    let β : ZMod (schnorrGroups.order d23) := 5
    projHash schnorrGroups d23 1 2 (β • g) (β • u) =
      (3 : ZMod (schnorrGroups.order d23)) • g ∧
    β • projHashAux schnorrGroups d23 1 2 u =
      (3 : ZMod (schnorrGroups.order d23)) • g ∧
    projHash2 schnorrGroups d23 1 2 3 4 6 (β • g) (β • u) =
      (3 : ZMod (schnorrGroups.order d23)) • g ∧
    β • ((projHash2Aux schnorrGroups d23 1 2 3 4 u).1 +
      (6 : ZMod (schnorrGroups.order d23)) • (projHash2Aux schnorrGroups d23 1 2 3 4 u).2) =
      (3 : ZMod (schnorrGroups.order d23)) • g := by
  simp only [projHash_generator_smul, projHashAux_generator_smul, projHash2_generator_smul,
    projHash2Aux, smul_smul, ← add_smul]
  refine ⟨?_, ?_, ?_, ?_⟩ <;> congr 1

/-- Lemma 12.5 on `d23`: for the non-DH triple `(2 • g, 3 • g, 7 • g)` (`7 ≠ 2 * 3`), every joint
pair `(h, z)` has probability `((11 : ℝ≥0∞) ^ 2)⁻¹`. -/
example (h z : schnorrGroups.Carrier d23) :
    ((PMF.uniformOfFintype
      (ZMod (schnorrGroups.order d23) × ZMod (schnorrGroups.order d23))).map (fun p =>
      (projHashAux schnorrGroups d23 p.1 p.2 ((2 : ZMod (schnorrGroups.order d23)) •
        schnorrGroups.generator d23),
        projHash schnorrGroups d23 p.1 p.2 ((3 : ZMod (schnorrGroups.order d23)) •
          schnorrGroups.generator d23)
          ((7 : ZMod (schnorrGroups.order d23)) • schnorrGroups.generator d23)))) (h, z) =
      ((schnorrGroups.order d23 : ℝ≥0∞) ^ 2)⁻¹ := by
  have hγ : (7 : ZMod (schnorrGroups.order d23)) ≠ 2 * 3 := by decide
  exact uniform_projHash_apply_of_ne schnorrGroups d23 hγ h z

/-- Single-tuple ingredient of Lemma 12.8 (via Lemma 12.7) on `d23`: on the `τ₂`-fiber for fixed
`(δ₁, δ₂, ξ)`, the query value `projHash2` on a non-DH triple with tag `ρ' = 5 ≠ 1 = ρ` hits any
target `z'` with probability `(11 : ℝ≥0∞)⁻¹`. -/
example (δ₁ δ₂ ξ : ZMod (schnorrGroups.order d23)) (z' : schnorrGroups.Carrier d23) :
    let α : ZMod (schnorrGroups.order d23) := 2
    let β' : ZMod (schnorrGroups.order d23) := 4
    let γ' : ZMod (schnorrGroups.order d23) := 9
    let ρ : ZMod (schnorrGroups.order d23) := 1
    let ρ' : ZMod (schnorrGroups.order d23) := 5
    ((PMF.uniformOfFintype (ZMod (schnorrGroups.order d23))).map (fun τ₂ =>
      projHash2 schnorrGroups d23 (δ₁ - α * (ξ - ρ * τ₂)) (ξ - ρ * τ₂) (δ₂ - α * τ₂) τ₂ ρ'
        (β' • schnorrGroups.generator d23) (γ' • schnorrGroups.generator d23))) z' =
      (schnorrGroups.order d23 : ℝ≥0∞)⁻¹ := by
  have hγ' : (9 : ZMod (schnorrGroups.order d23)) ≠ 2 * 4 := by decide
  have hρ : (5 : ZMod (schnorrGroups.order d23)) ≠ 1 := by decide
  exact uniform_projHash2_fiber_apply schnorrGroups d23 hγ' hρ δ₁ δ₂ ξ z'

/-- Finite-list union-bound ingredient of Lemma 12.8 on `d23`: for a list of two non-DH queries
`(β' = 4, γ' = 9, ρ' = 5, z₁)` and `(β' = 3, γ' = 7, ρ' = 6, z₂)` against `α = 2, ρ = 1`, the
probability over uniform `τ₂` that either query hits its target is at most `2 / 11`. -/
example [DecidableEq (schnorrGroups.Carrier d23)] (δ₁ δ₂ ξ : ZMod (schnorrGroups.order d23))
    (z₁ z₂ : schnorrGroups.Carrier d23) :
    let α : ZMod (schnorrGroups.order d23) := 2
    let ρ : ZMod (schnorrGroups.order d23) := 1
    let queries :
        List (ZMod (schnorrGroups.order d23) × ZMod (schnorrGroups.order d23) ×
          ZMod (schnorrGroups.order d23) × schnorrGroups.Carrier d23) :=
      [(4, 9, 5, z₁), (3, 7, 6, z₂)]
    ((PMF.uniformOfFintype (ZMod (schnorrGroups.order d23))).map (fun τ₂ =>
      queries.any (fun q =>
        decide (projHash2 schnorrGroups d23 (δ₁ - α * (ξ - ρ * τ₂)) (ξ - ρ * τ₂) (δ₂ - α * τ₂)
          τ₂ q.2.2.1 (q.1 • schnorrGroups.generator d23)
          (q.2.1 • schnorrGroups.generator d23) = q.2.2.2)))) true ≤
      2 / (schnorrGroups.order d23 : ℝ≥0∞) := by
  simpa using uniform_projHash2_fiber_any_le schnorrGroups d23 2 1 δ₁ δ₂ ξ
    [(4, 9, 5, z₁), (3, 7, 6, z₂)] (by
      intro q hq
      rcases List.mem_cons.mp hq with rfl | hq
      · dsimp only; decide
      · rcases List.mem_singleton.mp hq with rfl
        dsimp only; decide)

end ComplexityTests.Crypto.ProjectiveHash
