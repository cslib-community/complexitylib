import Complexity.Crypto.Computational.DiscreteLog.SchnorrGroup
import Complexity.Crypto.Computational.SchnorrEavesdrop
import Complexity.Crypto.Computational.SchnorrIdentification
import Complexity.Crypto.Negligible.Basic
import Complexity.Tactic.PolyTime
import Mathlib.Tactic.NormNum.Prime

/-!
# Tests for Schnorr identification under the discrete-logarithm assumption

The Schnorr group of order `11` in `(ZMod 23)ˣ`, generated by `2`, is a valid description, and
the family's operations compute on its encoded elements. The direct and eavesdropping security
theorems apply to the Schnorr-group family with `n`-bit challenges, for any setup law producing
groups of order at least `2 ^ n`, and their premises are satisfiable: both a silent impersonator
and an eavesdropper that forwards the public key and challenge are uniform strict PPT.
-/

namespace ComplexityTests.Crypto.SchnorrDiscreteLog

open Cslib Cslib.Probability Cslib.Crypto Turing.MultiTapeTM
open scoped NNReal

/-- The Schnorr group of order `11` in `(ZMod 23)ˣ`, generated by `2`. -/
def d23 : SchnorrGroup.Desc :=
  ⟨(23, 11, 2), ⟨by norm_num, by norm_num, by norm_num, by norm_num, by norm_num⟩⟩

example : schnorrGroups.order d23 = 11 := rfl

/-- The encoded generator is the binary digits `[false, true]` of `2`. -/
example : schnorrGroups.encode d23 (schnorrGroups.generator d23) = [false, true] :=
  (SchnorrGroup.encode_generator d23).trans rfl

/-- `2 ^ 7 = 13` in `(ZMod 23)ˣ`, computed on encodings. -/
example : schnorrGroups.smul (d23, 7, Nat.bits 2) = Nat.bits 13 := by decide

/-- `13 · 9 = 2` in `(ZMod 23)ˣ`, computed on encodings. -/
example : schnorrGroups.add (d23, Nat.bits 13, Nat.bits 9) = Nat.bits 2 := by decide

/-- An impersonator that ignores its inputs. -/
noncomputable def silent : schnorrGroups.SchnorrImpersonator where
  commit _ _ := pure ([], [])
  respond _ _ := pure []

/-- The silent impersonator is uniform strict PPT. -/
theorem silent_isPPT : silent.IsPPT :=
  ⟨(ComputableInPolyTime.const _).isPPTOn,
    (ComputableInPolyTime.const _).isPPTOn⟩

/-- `n`-bit challenges have negligible guessing probability `1 / 2 ^ n`. -/
theorem negligible_inv_two_pow : Negligible fun n => (1 : ℝ≥0) / 2 ^ n := by
  simpa only [one_div, inv_pow] using negligible_geometric (ratio := 2⁻¹) (by norm_num)

/-- Under the discrete-logarithm assumption for Schnorr groups of order at least `2 ^ n`,
Schnorr identification with `n`-bit challenges resists the silent impersonator with negligible
success probability. -/
example (setup : ℕ → PMF schnorrGroups.Desc) (hDL : schnorrGroups.DiscreteLog setup)
    (hsize : ∀ n, ∀ d ∈ (setup n).support, 2 ^ n ≤ schnorrGroups.order d) :
    Negligible fun n => Game.succProbability (schnorrGroups.schnorrDirectGame setup id silent n) :=
  PrimeOrderGroupFamily.negligible_schnorrDirectGame hDL (ComputableInPolyTime.of_eq fun _ => rfl)
    hsize negligible_inv_two_pow silent_isPPT

/-- On `d23` with secret exponent `3` (public key `2 ^ 3 = 8` in `(ZMod 23)ˣ`) and `3`-bit
challenges, a strict-PPT honest conversation at security parameter `5` is within statistical
distance `2 / 32` of a strict-PPT simulated conversation on `Nat.bits 8`. -/
example :
    CloseTo
      (ProbComp.eval (schnorrGroups.schnorrRealTranscript 5 d23 (3 : ℕ) 3))
      (ProbComp.eval (schnorrGroups.schnorrSimulatedTranscript 5 d23 (Nat.bits 8) 3))
      (2 / 2 ^ 5 : ℝ≥0) := by
  have h := schnorrGroups.closeTo_schnorrRealTranscript_simulated 5 d23 (3 : ℕ) 3
  have hg : schnorrGroups.encode d23 (schnorrGroups.generator d23) = Nat.bits 2 :=
    (SchnorrGroup.encode_generator d23).trans rfl
  have hpk :
      schnorrGroups.smul (d23, 3, schnorrGroups.encode d23 (schnorrGroups.generator d23)) =
        Nat.bits 8 := by
    rw [hg]
    decide
  rwa [← schnorrGroups.smul_encode d23 3, hpk] at h

/-- Across `10` overheard conversations on `d23` with secret exponent `3` (public key `Nat.bits 8`),
the strict-PPT honest and simulated transcript lists at security parameter `5` are within
statistical distance `20 / 32`. -/
example :
    CloseTo
      (ProbComp.eval (OracleComp.replicate 10
        (schnorrGroups.schnorrRealTranscript 5 d23 (3 : ℕ) 3)))
      (ProbComp.eval (OracleComp.replicate 10
        (schnorrGroups.schnorrSimulatedTranscript 5 d23 (Nat.bits 8) 3)))
      (2 * 10 / 2 ^ 5 : ℝ≥0) := by
  have h := schnorrGroups.closeTo_replicate_schnorrRealTranscript_simulated 5 d23 (3 : ℕ) 3 10
  have hg : schnorrGroups.encode d23 (schnorrGroups.generator d23) = Nat.bits 2 :=
    (SchnorrGroup.encode_generator d23).trans rfl
  have hpk :
      schnorrGroups.smul (d23, 3, schnorrGroups.encode d23 (schnorrGroups.generator d23)) =
        Nat.bits 8 := by
    rw [hg]
    decide
  rwa [← schnorrGroups.smul_encode d23 3, hpk] at h

/-- An eavesdropping adversary that commits to the public key, saves it as state, and echoes the
challenge as its response. -/
noncomputable def forwardEavesdrop : schnorrGroups.SchnorrEavesdropAdversary where
  commit _ p := pure (p.2.1, p.2.1)
  respond _ p := pure p.2

/-- `forwardEavesdrop` is uniform strict PPT. -/
theorem forwardEavesdrop_isPPT : forwardEavesdrop.IsPPT :=
  ⟨(ComputableInPolyTime.prod (by fun_prop) (by fun_prop)).isPPTOn,
    (by fun_prop : ComputableInPolyTime _ _ _).isPPTOn⟩

/-- Converting `forwardEavesdrop` to a direct impersonator that simulates `n` conversations of
`n`-bit challenges preserves uniform strict PPT. -/
example : (forwardEavesdrop.toDirect id id).IsPPT :=
  PrimeOrderGroupFamily.isPPT_toDirect
    (ComputableInPolyTime.of_eq fun _ => rfl)
    (ComputableInPolyTime.of_eq fun _ => rfl)
    forwardEavesdrop_isPPT

/-- Quantitative eavesdropping bound on the constant-`d23` setup with `3`-bit challenges
(`2 ^ 3 ≤ 11`) and `4` overheard conversations. -/
example (n : ℕ) :
    (Game.succProbability
      (schnorrGroups.schnorrEavesdropGame (fun _ => PMF.pure (d23 : schnorrGroups.Desc))
        (fun _ => 3) (fun _ => 4) forwardEavesdrop n) : ℝ) ≤
      2 * (4 : ℕ) / 2 ^ n + 1 / 2 ^ 3 +
        √(Game.succProbability (schnorrGroups.discreteLogGame
          (fun _ => PMF.pure (d23 : schnorrGroups.Desc))
          ((forwardEavesdrop.toDirect (fun _ => 3) (fun _ => 4)).rewind (fun _ => 3)) n)) := by
  refine PrimeOrderGroupFamily.succProbability_schnorrEavesdropGame_le
    (fun _ => PMF.pure (d23 : schnorrGroups.Desc)) (fun _ => 3) (fun _ => 4)
    forwardEavesdrop n ?_
  intro d hd
  obtain rfl : d = d23 := (PMF.mem_support_pure_iff _ _).mp hd
  decide

/-- Under the discrete-logarithm assumption for Schnorr groups of order at least `2 ^ n`,
Schnorr identification with `n`-bit challenges is eavesdropping-secure in the strict-PPT model for
any polynomial-time conversation count `Q`. -/
example (setup : ℕ → PMF schnorrGroups.Desc) (hDL : schnorrGroups.DiscreteLog setup)
    (hsize : ∀ n, ∀ d ∈ (setup n).support, 2 ^ n ≤ schnorrGroups.order d) :
    schnorrGroups.IsEavesdropSecure setup id :=
  PrimeOrderGroupFamily.schnorr_isEavesdropSecure_of_discreteLogHard hDL
    (ComputableInPolyTime.of_eq fun _ => rfl) hsize negligible_inv_two_pow

end ComplexityTests.Crypto.SchnorrDiscreteLog
