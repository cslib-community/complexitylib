import Complexity.Crypto.Computational.DiscreteLog.SchnorrGroup
import Complexity.Crypto.Computational.NaorReingold
import Complexity.Crypto.Computational.NaorReingold.PRF
import Complexity.Crypto.Computational.NaorReingold.Security
import Mathlib.Tactic.NormNum.Prime

/-!
# Tests for the Naor–Reingold PRF and Multi-DDH (I)

Concrete checks on the Schnorr group `d23` of order `11` in `(ZMod 23)ˣ` generated by `2` for
word-level Naor–Reingold evaluation (`naorReingoldWordEval`, `naorReingoldWordSuffix`,
`naorReingoldHashedWordEval`, `naorReingoldSeededPRF`), fixed-$u$ DDH rerandomization
(`ddhFixedUWordRerandomize`), composed `IsPPTOn` / `ComputableInPolyTime` certificates, and
concrete finite quantitative bounds from `NaorReingold.Security`.
-/

namespace ComplexityTests.Crypto.NaorReingold

open Cslib Cslib.Crypto Cslib.Probability Turing.MultiTapeTM
open scoped ENNReal NNReal

/-- The Schnorr group of order `11` in `(ZMod 23)ˣ`, generated by `2`. -/
def d23 : schnorrGroups.Desc :=
  ⟨(23, 11, 2), ⟨by norm_num, by norm_num, by norm_num, by norm_num, by norm_num⟩⟩

/-- On the all-`false` query `[false, false, false]`, `naorReingoldWordEval` with `α₀ = 3` returns
`2 ^ 3 mod 23 = 8`. -/
example :
    schnorrGroups.naorReingoldWordEval d23 3 [2, 5, 7] [false, false, false] = Nat.bits 8 := by
  decide

/-- On query `[true, false, true]` with `α₀ = 3` and `α = [2, 5, 7]`, the selected exponent product
is `3 · 2 · 7 = 42 ≡ 9 (mod 11)`, and `2 ^ 9 = 512 ≡ 6 (mod 23)`. -/
example :
    schnorrGroups.naorReingoldWordEval d23 3 [2, 5, 7] [true, false, true] = Nat.bits 6 := by
  decide

/-- Suffix evaluation starting from `u = 2 ^ 3 = 8` along `αs = [2, 5, 7]` and
`xs = [true, false, true]` yields `8 ^ (2 · 7) = 8 ^ 3 = 512 ≡ 6 (mod 23)`. -/
example :
    schnorrGroups.naorReingoldWordSuffix d23 (Nat.bits 8) [2, 5, 7] [true, false, true] =
      Nat.bits 6 := by
  decide

/-- Fixed-$u$ word rerandomization on the real DDH triple
`(u, v, w) = (2^3, 2^5, 2^{15}) = (8, 9, 16)` with `(σ, τ) = (2, 1)` gives exponent
`σ + τ · β = 2 + 5 = 7`, so `v* = 2 ^ 7 mod 23 = 13` and `w* = 2 ^ 21 ≡ 2 ^ 10 mod 23 = 12`. -/
example :
    schnorrGroups.ddhFixedUWordRerandomize d23 (Nat.bits 8) (Nat.bits 9) (Nat.bits 16) 2 1 =
      (Nat.bits 13, Nat.bits 12) := by
  decide

/-- The plain product certificate composes with the entire captured input. -/
example {α : Type} {input : α ↪ List Bool} {initial : α → ℕ}
    {steps : α → List (ℕ × Bool)}
    (hi : Turing.MultiTapeTM.ComputableInPolyTime initial input Turing.MultiTapeTM.encNat)
    (hs : Turing.MultiTapeTM.ComputableInPolyTime steps input
      (Turing.MultiTapeTM.encList
        (Turing.MultiTapeTM.encPair Turing.MultiTapeTM.encNat Turing.MultiTapeTM.encBool))) :
    Turing.MultiTapeTM.ComputableInPolyTime
      (fun a => PrimeOrderGroupFamily.naorReingoldProdNat (initial a) (steps a)) input
      Turing.MultiTapeTM.encNat := by
  fail_if_success (clear hi; fun_prop)
  fail_if_success (clear hs; fun_prop)
  fun_prop

example : PrimeOrderGroupFamily.naorReingoldProdNat 3 [(2, true), (5, false), (7, true)] = 42 :=
  rfl

example : PrimeOrderGroupFamily.naorReingoldProdNat 0 [] = 0 := rfl

/-! ### Universal-Hash Word Evaluation, Seeded PRF, and Concrete Security Bounds on `d23` -/

/-- Under the all-`true` 52-bit hash matrix (`B = 6`, `outLen = 4`), `Nat.bits 6` on query
`[true, false, true]` hashes to `[true, true, true, true]`, while the all-`false` 52-bit hash
matrix maps the same input to `[false, false, false, false]`. -/
example :
    schnorrGroups.naorReingoldHashedWordEval 4 (fun _ => 6) d23 (List.replicate 52 true)
      3 [2, 5, 7] [true, false, true] = [true, true, true, true] := by
  decide

example :
    schnorrGroups.naorReingoldHashedWordEval 4 (fun _ => 6) d23 (List.replicate 52 false)
      3 [2, 5, 7] [true, false, true] = [false, false, false, false] := by
  decide

/-- Concrete `naorReingoldSeededPRF` evaluation on `d23` with `B = 6`, `expWidth = 4`, and a 2-bit
key `[true, true]`: MSB-first binary exponents `α₀ = 3` (`[false, false, true, true]`), `α₁ = 1`
(`[false, false, false, true]`), `α₂ = 3` (`[false, false, true, true]`), and an all-`true`
26-bit hash seed map query `[true, true]` (`3 · 1 · 3 = 9`, `2 ^ 9 mod 23 = 6`) to
`[true, true]`. -/
def concreteSeededTape : List Bool :=
  [false, false, true, true, false, false, false, true, false, false, true, true] ++
    List.replicate 26 true

example :
    schnorrGroups.naorReingoldSeededPRF (fun _ => d23) (fun _ => 6) (fun _ => 4)
      (fun _ => concreteSeededTape) [true, true] [true, true] = [true, true] := by
  decide

/-- Polynomial-time certificate for `naorReingoldSeededPRF` instantiated on `d23`. -/
example :
    ComputableInPolyTime
      (fun p : List Bool × List Bool =>
        schnorrGroups.naorReingoldSeededPRF (fun _ => d23) (fun _ => 6)
          (fun n => n + 5) id p.1 p.2)
      (encPair encBits encBits) encBits :=
  schnorrGroups.computableInPolyTime_naorReingoldSeededPRF
    (ComputableInPolyTime.const d23)
    (ComputableInPolyTime.const 6)
    (ComputableInPolyTime.id'.unary_add' (ComputableInPolyTime.const 5))
    ComputableInPolyTime.id'

/-- Every element of `schnorrGroups.Carrier d23` has binary encoding length at most `6`. -/
theorem encode_d23_length_le (x : schnorrGroups.Carrier d23) :
    (schnorrGroups.encode d23 x).length ≤ 6 := by
  have : NeZero d23.1.1 := ⟨by decide⟩
  have hfin : ∀ i : Fin 23, i.val.bits.length ≤ 6 := by decide
  exact hfin ⟨((Additive.toMul x).1 : ZMod d23.1.1).val, ZMod.val_lt _⟩

/-- One-query `IsOraclePPT` distinguisher testing whether the oracle reply on `[true, true]` has
head bit `true`. -/
def singleQueryDistinguisher : OracleDistinguisher :=
  fun _ _ =>
    (fun reply => reply.headD false) <$>
      (List.take 1 <$> ProbOracleComp.query ((), [true, true]))

theorem isOraclePPT_singleQueryDistinguisher : IsOraclePPT encBool singleQueryDistinguisher := by
  have hq : IsOraclePPTOn (encPair encUnary encBits) encBits
      (fun _ : ℕ × List Bool => List.take 1 <$> ProbOracleComp.query ((), [true, true])) :=
    IsOraclePPTOn.query_take () (by fun_prop) (by fun_prop)
  unfold singleQueryDistinguisher
  exact (hq.map_with (by fun_prop)).isOraclePPT

theorem isQueryBounded_singleQueryDistinguisher (n : ℕ) (aux : List Bool) :
    (singleQueryDistinguisher n aux).IsQueryBounded 1 := by
  dsimp only [singleQueryDistinguisher]
  rw [Functor.map_map, map_eq_bind_pure_comp]
  simpa only [Nat.add_zero, Function.comp_def] using
    (ProbOracleComp.IsQueryBounded.query ((), [true, true])).bind fun _ =>
      OracleComp.IsCostBounded.pure _ 0

/-- Uniform strict-PPT certificate for the lazy-sampling DDH distinguisher built from
`singleQueryDistinguisher` on `schnorrGroups`. -/
example :
    IsPPTOn
      (encPair encUnary
        (encPair schnorrGroups.encDesc (encPair encBits (encPair encBits encBits))))
      encBool
      (fun input =>
        schnorrGroups.naorReingoldToDDHDistinguisher (fun _ => 2) singleQueryDistinguisher
          input.1 input.2) :=
  schnorrGroups.isPPTOn_naorReingoldToDDHDistinguisher
    (ComputableInPolyTime.const 2) isOraclePPT_singleQueryDistinguisher

/-- Concrete finite quantitative Leftover Hash Lemma bound on `d23` (`order d23 = 11`, `B = 6`,
`Q = 1`, `outLen = 2`) for `singleQueryDistinguisher`. -/
example (n : ℕ) :
    Game.advantage
      (schnorrGroups.naorReingoldHashedGroupIdealGame (fun _ => PMF.pure d23)
        (fun _ => 2) (fun _ => 2) (fun _ => 6) singleQueryDistinguisher n)
      (schnorrGroups.naorReingoldHashedIdealGame (fun _ => PMF.pure d23)
        (fun _ => 2) (fun _ => 2) (fun _ => 6) singleQueryDistinguisher n) ≤
      NNReal.sqrt ((2 : ℝ≥0) ^ 2 / (11 : ℝ≥0)) / 2 := by
  simpa using schnorrGroups.advantage_naorReingoldHashedIdeal_le
    (fun _ => PMF.pure d23) (fun _ => 2) (fun _ => 2) (fun _ => 6)
    singleQueryDistinguisher n 1 11 (by decide)
    (fun d hd x => by
      rw [PMF.mem_support_pure_iff] at hd; subst hd
      exact encode_d23_length_le x)
    (fun d hd => by
      rw [PMF.mem_support_pure_iff] at hd; subst hd
      decide)
    (fun _ _ _ => isQueryBounded_singleQueryDistinguisher n _)

/-- Concrete finite quantitative lazy-sampling DDH reduction bound on `d23` (`Q = 1`, `inLen = 2`)
for `singleQueryDistinguisher`. -/
example (n : ℕ) :
    Game.advantage
      (schnorrGroups.naorReingoldWordRealGame (fun _ => PMF.pure d23) (fun _ => 2)
        singleQueryDistinguisher n)
      (schnorrGroups.naorReingoldWordIdealGame (fun _ => PMF.pure d23) (fun _ => 2)
        singleQueryDistinguisher n) ≤
      (dyadicSize 2 : ℝ≥0) *
        (Game.advantage
          (schnorrGroups.ddhRealGame (fun _ => PMF.pure d23)
            (schnorrGroups.naorReingoldToDDHDistinguisher (fun _ => 2) singleQueryDistinguisher) n)
          (schnorrGroups.ddhIdealGame (fun _ => PMF.pure d23)
            (schnorrGroups.naorReingoldToDDHDistinguisher (fun _ => 2) singleQueryDistinguisher) n)
          + 2 * (4 / (2 : ℝ≥0) ^ n) +
          (∑' d, (PMF.pure d23 : PMF schnorrGroups.Desc) d *
            (schnorrGroups.order d : ℝ≥0∞)⁻¹).toNNReal) :=
  schnorrGroups.advantage_naorReingoldWordGame_le
    (fun _ => PMF.pure d23) (fun _ => 2) singleQueryDistinguisher n (fun _ => 1)
    (fun _ _ => isQueryBounded_singleQueryDistinguisher n _)
    (fun d _ => by
      change (4 : ℝ≥0) / (2 : ℝ≥0) ^ (n + (schnorrGroups.encDesc d).length) ≤ 4 / (2 : ℝ≥0) ^ n
      exact div_le_div_of_nonneg_left (by positivity) (by positivity)
        (pow_le_pow_right₀ (by norm_num) (Nat.le_add_right _ _)))

end ComplexityTests.Crypto.NaorReingold
