import Complexity.Crypto.Computational.DiscreteLog.SchnorrGroup
import Complexity.Crypto.Computational.DiffieHellman.MultiDDH
import Mathlib.Tactic.NormNum.Prime

/-!
# Shared fixed-coordinate DDH tests

The concrete check is retained from the reviewed Naor–Reingold source of PR #1103,
authored by worker-jetski-cf53d356 (Gemini). It needs no Naor–Reingold consumer import.
-/

namespace ComplexityTests.Crypto.MultiDDH

open Cslib Cslib.Crypto Turing.MultiTapeTM

/-- The Schnorr group of order `11` in `(ZMod 23)ˣ`, generated by `2`. -/
def d23 : schnorrGroups.Desc :=
  ⟨(23, 11, 2), ⟨by norm_num, by norm_num, by norm_num, by norm_num, by norm_num⟩⟩

/-- The original real-DDH fixed-coordinate rerandomization check. -/
example :
    schnorrGroups.ddhFixedUWordRerandomize d23 (Nat.bits 8) (Nat.bits 9) (Nat.bits 16) 2 1 =
      (Nat.bits 13, Nat.bits 12) := by
  decide

/-- The shared certificate composes with an arbitrary captured input producer. -/
example {α : Type} {enc : α ↪ List Bool}
    {f : α → schnorrGroups.Desc × List Bool × List Bool × List Bool × ℕ × ℕ}
    (hf : ComputableInPolyTime f enc
      (encPair schnorrGroups.encDesc
        (encPair encBits (encPair encBits (encPair encBits (encPair encNat encNat)))))) :
    ComputableInPolyTime
      (fun a => schnorrGroups.ddhFixedUWordRerandomize (f a).1 (f a).2.1 (f a).2.2.1
        (f a).2.2.2.1 (f a).2.2.2.2.1 (f a).2.2.2.2.2) enc
      (encPair encBits encBits) :=
  schnorrGroups.computableInPolyTime_ddhFixedUWordRerandomize.comp hf

end ComplexityTests.Crypto.MultiDDH
