import Complexity.Crypto.Computational.DiscreteLog.SchnorrGroup
import Complexity.Crypto.Computational.PedersenCommitment
import Complexity.Crypto.Negligible.Basic
import Complexity.Tactic.PPT
import Mathlib.Tactic.NormNum.Prime

/-!
# Tests for Pedersen commitments

Concrete checks on the Schnorr group of order `11` in `(ZMod 23)ˣ` generated by `2` for encoded
Pedersen commitment evaluation, verification `V(m, c, o)`, additive homomorphism,
discrete-logarithm extraction from a verified binding collision, unconditional hiding, and
computational binding under `DiscreteLog`.
-/

namespace ComplexityTests.Crypto.PedersenCommitment

open Cslib Cslib.Probability Cslib.Crypto Cslib.Crypto.PrimeOrderGroupFamily Turing.MultiTapeTM
open scoped NNReal

/-- The Schnorr group of order `11` in `(ZMod 23)ˣ`, generated by `2`. -/
def d23 : schnorrGroups.Desc :=
  ⟨(23, 11, 2), ⟨by norm_num, by norm_num, by norm_num, by norm_num, by norm_num⟩⟩

/-- With generator `g = 2` and commitment key `h = 2 ^ 3 mod 23 = 8`, committing to `m = 4` with
randomness `r = 5` computes `2 ^ 4 · 8 ^ 5 = 2 ^ 19 ≡ 2 ^ 8 = 3 (mod 23)`. -/
example : schnorrGroups.encodePedersenCommit (d23, Nat.bits 8, 4, 5) = Nat.bits 3 := by decide

/-- With the same key `h = 8` (`α = 3`), `(m₀, r₀) = (4, 5)` and `(m₁, r₁) = (2, 2)` both satisfy
`m + 3 · r ≡ 8 (mod 11)`, so they collide at residue `3` (`Nat.bits 3`). -/
example : schnorrGroups.encodePedersenCommit (d23, Nat.bits 8, 2, 2) = Nat.bits 3 := by decide

/-- `pedersenVerify` accepts `(m, c, o) = (4, 3, 5)` under `h = 2 ^ 3 mod 23 = 8` (`α = 3`). -/
example :
    schnorrGroups.pedersenVerify d23
      ((3 : ZMod (schnorrGroups.order d23)) • schnorrGroups.generator d23)
      (Nat.bits 4) (Nat.bits 3) (Nat.bits 5) = true := by decide

/-- `pedersenScheme.isBindingCollision` accepts the concrete verified double opening
`(Nat.bits 3, (Nat.bits 4, Nat.bits 5), (Nat.bits 2, Nat.bits 2))` for `α = 3` in `d23`. -/
example :
    schnorrGroups.pedersenScheme.isBindingCollision
      ⟨d23, (3 : ZMod (schnorrGroups.order d23)) • schnorrGroups.generator d23⟩
      (Nat.bits 3, (Nat.bits 4, Nat.bits 5), (Nat.bits 2, Nat.bits 2)) = true := by decide

/-- `pedersenExtractNat` recovers the secret discrete logarithm `α = 3` from the concrete collision
`((4, 5), (2, 2))` modulo `11`. -/
example : pedersenExtractNat 11 4 5 2 2 = 3 := by decide

/-- Additive homomorphism of Pedersen commitments on `d23`. -/
example (h : schnorrGroups.Carrier d23) :
    schnorrGroups.pedersenCommit d23 h 4 5 + schnorrGroups.pedersenCommit d23 h 2 3 =
      schnorrGroups.pedersenCommit d23 h 6 8 := by
  rw [← schnorrGroups.pedersenCommit_add]
  rfl

/-- Unconditional hiding: for any (even computationally unbounded) `Encryption.WordAdversary` and
any setup law over Schnorr groups of order at least `2 ^ n`, the hiding advantage in
`schnorrGroups.pedersenScheme.hidingGame (schnorrGroups.pedersenKeyDist setup)` is negligible. -/
example (setup : ℕ → PMF schnorrGroups.Desc)
    (adversary : Encryption.WordAdversary)
    (hsize : ∀ n, ∀ d ∈ (setup n).support, 2 ^ n ≤ schnorrGroups.order d) :
    Negligible fun n =>
      Game.advantage
        (schnorrGroups.pedersenScheme.hidingGame
          (schnorrGroups.pedersenKeyDist setup) adversary false n)
        (schnorrGroups.pedersenScheme.hidingGame
          (schnorrGroups.pedersenKeyDist setup) adversary true n) :=
  schnorrGroups.negligible_advantage_pedersenHidingGame setup adversary
    Nat.two_pow_pos hsize
    (by
      simpa only [Nat.cast_pow, Nat.cast_ofNat, one_div, inv_pow] using
        negligible_geometric (ratio := 2⁻¹) (by norm_num))

/-- A trivial Pedersen binding adversary that always outputs the candidate collision
`([], ([], []), ([true], []))`. -/
def trivialBindingAdversary :
    ℕ → List Bool →
      ProbComp (List Bool × (List Bool × List Bool) × (List Bool × List Bool)) :=
  fun _ _ => pure ([], ([], []), ([true], []))

/-- `trivialBindingAdversary` is uniform strict PPT. -/
theorem isPPTOn_trivialBindingAdversary :
    IsPPTOn (encPair encUnary encBits)
      (encPair encBits (encPair (encPair encBits encBits) (encPair encBits encBits)))
      (fun input => trivialBindingAdversary input.1 input.2) :=
  ComputableInPolyTime.isPPTOn (ComputableInPolyTime.const _)

/-- Under the discrete-logarithm assumption for Schnorr groups, `trivialBindingAdversary` succeeds
in `schnorrGroups.pedersenScheme.bindingGame (schnorrGroups.pedersenKeyDist setup)` with negligible
probability. -/
example (setup : ℕ → PMF schnorrGroups.Desc) (hDL : schnorrGroups.DiscreteLog setup) :
    Negligible fun n =>
      Game.succProbability
        (schnorrGroups.pedersenScheme.bindingGame
          (schnorrGroups.pedersenKeyDist setup) trivialBindingAdversary n) :=
  hDL.pedersenBinding trivialBindingAdversary isPPTOn_trivialBindingAdversary

/-- Packaged `CommitmentScheme.StatisticalHiding` and `CommitmentScheme.Binding` for
`schnorrGroups.pedersenScheme`. -/
example (setup : ℕ → PMF schnorrGroups.Desc) (hDL : schnorrGroups.DiscreteLog setup)
    (hsize : ∀ n, ∀ d ∈ (setup n).support, 2 ^ n ≤ schnorrGroups.order d) :
    schnorrGroups.pedersenScheme.StatisticalHiding (schnorrGroups.pedersenKeyDist setup) ∧
      schnorrGroups.pedersenScheme.Binding (schnorrGroups.pedersenKeyDist setup) :=
  ⟨schnorrGroups.pedersenScheme_statisticalHiding setup Nat.two_pow_pos hsize
      (by
        simpa only [Nat.cast_pow, Nat.cast_ofNat, one_div, inv_pow] using
          negligible_geometric (ratio := 2⁻¹) (by norm_num)),
    hDL.pedersenScheme_binding⟩

/-- Regression witness (`openScheme`): a scheme with empty commitment string and opening equal to
the message is perfectly hiding, and is rejected by `CommitmentScheme.Binding`. -/
noncomputable def openScheme : CommitmentScheme Unit where
  encodeKey := ⟨fun _ => [], fun _ _ _ => Subsingleton.elim _ _⟩
  ValidMessage _ _ := True
  commitDist _ m := PMF.pure ([], m)
  verify _ m c o := decide (c = [] ∧ o = m)
  validMessage_of_verify _ _ _ _ _ := trivial
  verify_of_mem_support _ m co _ hco := by
    rw [PMF.support_pure, Set.mem_singleton_iff] at hco
    subst hco
    simp

/-- A constant PPT adversary that breaks `openScheme.Binding` with probability `1`. -/
def cheat : ℕ → List Bool →
    ProbComp (List Bool × (List Bool × List Bool) × (List Bool × List Bool)) :=
  fun _ _ => pure ([], ([], []), ([true], [true]))

/-- `openScheme` is not binding (`¬ openScheme.Binding`). -/
example : ¬ openScheme.Binding (fun _ => PMF.pure ()) := by
  intro h
  have hA : IsPPTOn (encPair encUnary encBits)
      (encPair encBits (encPair (encPair encBits encBits) (encPair encBits encBits)))
      (fun input => cheat input.1 input.2) :=
    ComputableInPolyTime.isPPTOn (ComputableInPolyTime.const _)
  have hs : ∀ n, Game.succProbability
      (openScheme.bindingGame (fun _ => PMF.pure ()) cheat n) = 1 := by
    intro n
    simp [Game.succProbability, CommitmentScheme.bindingGame, CommitmentScheme.isBindingCollision,
      openScheme, cheat]
  exact not_negligible_const (c := 1) one_ne_zero (by simpa [hs] using h cheat hA)

/-- Regression witness (`singletonScheme`): a scheme with singleton message space `{[]}` whose
commitment string equals the message word satisfies `StatisticalHiding` because `hidingForKey`
commits to `m_bit` only when both challenge words satisfy `ValidMessage`. -/
noncomputable def singletonScheme : CommitmentScheme Unit where
  encodeKey := ⟨fun _ => [], fun _ _ _ => Subsingleton.elim _ _⟩
  ValidMessage _ m := m = []
  commitDist _ m := PMF.pure (m, [])
  verify _ m c _ := decide (m = [] ∧ c = [])
  validMessage_of_verify _ _ _ _ h := (of_decide_eq_true h).1
  verify_of_mem_support _ m co hm hco := by
    rw [PMF.support_pure, Set.mem_singleton_iff] at hco
    subst hco
    simp [hm]

/-- `singletonScheme` is statistically hiding. -/
example : singletonScheme.StatisticalHiding (fun _ => PMF.pure ()) := by
  intro adversary _
  have heq : ∀ n,
      singletonScheme.hidingGame (fun _ => PMF.pure ()) adversary false n =
        singletonScheme.hidingGame (fun _ => PMF.pure ()) adversary true n := by
    intro n
    simp only [CommitmentScheme.hidingGame, CommitmentScheme.hidingForKey, singletonScheme,
      PMF.monad_bind_eq_bind, PMF.pure_bind]
    congr 1; funext choice
    by_cases hvalid : choice.1.1 = [] ∧ choice.1.2 = []
    · rcases hvalid with ⟨h1, h2⟩
      simp [h1, h2]
    · simp [hvalid]
  simp [heq, negligible_zero]

end ComplexityTests.Crypto.PedersenCommitment
