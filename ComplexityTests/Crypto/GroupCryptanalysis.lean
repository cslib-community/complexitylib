import Complexity.Crypto.Computational.DiscreteLog.GroupHash
import Complexity.Crypto.Computational.DiscreteLog.PohligHellman
import Complexity.Crypto.Computational.DiscreteLog.SchnorrGroup
import Complexity.Crypto.Computational.Factoring.PollardRho
import Complexity.Crypto.Negligible.Basic
import Mathlib.Tactic.NormNum.Prime

/-!
# Tests for cyclic-group hash families, Pohlig-Hellman, and Pollard's rho factoring

Concrete evaluation and non-vacuity checks for:
1. Discrete-logarithm collision-resistant hashing with encoded outputs (`groupHash`,
   `DiscreteLog.collisionResistantForOn_groupHash`) and the multi-generator hash
   (`multiGeneratorHash`) on the Schnorr group `d23` of order `11` in `(ZMod 23)ˣ` generated by `2`.
2. The Pohlig-Hellman subgroup reduction (`pohligHellman_crt_modEq`) on Katz-Lindell's
   Example 10.5 in `(ZMod 31)ˣ`, the digit step (`pohligHellman_step`), smooth divisor extraction
   (`smoothDivisorSeq`), rough-part residue extraction (`extractModRough`), and CRT recombination
   (`crtCombine`, `crtCombine_extractModRough_eq`).
3. Pollard's rho tortoise-and-hare loop (`rhoFactorLoop`) on `N = 15 = 3 * 5`.
-/

namespace ComplexityTests.Crypto.GroupCryptanalysis

open Cslib Cslib.Probability Cslib.Crypto Cslib.Crypto.PrimeOrderGroupFamily Turing.MultiTapeTM
open scoped NNReal

/-- The Schnorr group of order `11` in `(ZMod 23)ˣ`, generated by `2`. -/
def d23 : schnorrGroups.Desc :=
  ⟨(23, 11, 2), ⟨by norm_num, by norm_num, by norm_num, by norm_num, by norm_num⟩⟩

/-! ### 1. Fixed-length discrete-logarithm hash and multi-generator hash -/

/-- With block length `L = 3` (`2 ^ 3 = 8 ≤ 11`), valid inputs to `schnorrGroups.groupHash` have
length `2 * 3 = 6`. -/
example :
    schnorrGroups.validGroupHashInput (fun _ => 3) 0 (d23, Nat.bits 8)
      (List.replicate 6 true) = true := rfl

example :
    schnorrGroups.validGroupHashInput (fun _ => 3) 0 (d23, Nat.bits 8)
      (List.replicate 5 true) = false := rfl

/-- On `d23` with `h = 2 ^ 3 mod 23 = 8` (`Nat.bits 8`) and `3`-bit blocks
`x₁ = [false, false, true]` (`ofBits x₁ = 4`) and `x₂ = [true, false, true]`
(`ofBits x₂ = 5`), `groupHash` computes `2 ^ 4 · 8 ^ 5 ≡ 3 (mod 23)` (`Nat.bits 3`). -/
example :
    schnorrGroups.groupHash (fun _ => 3) (d23, Nat.bits 8)
      [false, false, true, true, false, true] = Nat.bits 3 := by decide

/-- With the same key `(d23, Nat.bits 8)` (`α = 3`), the distinct `6`-bit message
`[false, true, false, false, true, false]` (`x₁ = 2`, `x₂ = 2`) collides with
`[false, false, true, true, false, true]` (`x₁ = 4`, `x₂ = 5`) at `Nat.bits 3`. -/
example :
    schnorrGroups.groupHash (fun _ => 3) (d23, Nat.bits 8)
      [false, true, false, false, true, false] = Nat.bits 3 := by decide

/-- `isCollisionFor` accepts the concrete `6`-bit collision pair on `(d23, Nat.bits 8)`, and
`pedersenExtractNat` recovers the discrete logarithm `α = 3`. -/
example :
    isCollisionFor (Param := schnorrGroups.Desc × List Bool) (Digest := fun _ => List Bool)
      (schnorrGroups.groupHash (fun _ => 3))
      (schnorrGroups.validGroupHashInput (fun _ => 3))
      0 (d23, Nat.bits 8)
      [false, false, true, true, false, true]
      [false, true, false, false, true, false] = true ∧
    pedersenExtractNat 11
      (ofBits [false, false, true]) (ofBits [true, false, true])
      (ofBits [false, true, false]) (ofBits [false, true, false]) = 3 := by decide

/-- The block length `blockLen d = Nat.log 2 (order d)` satisfies the size hypothesis of
`DiscreteLog.collisionResistantForOn_groupHash` for every Schnorr group, and is non-degenerate on
`d23` (`Nat.log 2 11 = 3`, so inputs have `6` bits). -/
example (d : schnorrGroups.Desc) :
    2 ^ Nat.log 2 (schnorrGroups.order d) ≤ schnorrGroups.order d :=
  Nat.pow_log_le_self 2 (schnorrGroups.prime_order d).ne_zero

example : Nat.log 2 (schnorrGroups.order d23) = 3 := by decide

/-- `DiscreteLog.collisionResistantForOn_groupHash` instantiated on `schnorrGroups` with the
block length `blockLen d = Nat.log 2 (order d)`, whose size hypothesis holds for every setup. -/
example (setup : ℕ → PMF schnorrGroups.Desc) (hDL : schnorrGroups.DiscreteLog setup)
    (hblockLen : ComputableInPolyTime (fun d => Nat.log 2 (schnorrGroups.order d))
      schnorrGroups.encDesc encUnary) :
    CollisionResistantForOn (Param := schnorrGroups.Desc × List Bool)
      (Digest := fun _ => List Bool)
      (encPair schnorrGroups.encDesc encBits)
      (schnorrGroups.groupHashSetup setup)
      (schnorrGroups.groupHash fun d => Nat.log 2 (schnorrGroups.order d))
      (schnorrGroups.validGroupHashInput fun d => Nat.log 2 (schnorrGroups.order d)) :=
  hDL.collisionResistantForOn_groupHash hblockLen
    (Filter.Eventually.of_forall fun _ d _ =>
      Nat.pow_log_le_self 2 (schnorrGroups.prime_order d).ne_zero)

/-- The discrete logarithms `(1, 3)` of the generators `g` and `3 • g` on `d23`. -/
def αs23 : Fin 2 → ZMod (schnorrGroups.order d23) :=
  ![1, 3]

/-- On `d23` with generators `g` and `3 • g`, the vectors `(4, 5)` and `(2, 2)` collide under
`multiGeneratorHash`, since `4 + 5 * 3 ≡ 2 + 2 * 3 (mod 11)`. -/
example :
    schnorrGroups.multiGeneratorHash d23 (fun i => αs23 i • schnorrGroups.generator d23) ![4, 5] =
      schnorrGroups.multiGeneratorHash d23 (fun i => αs23 i • schnorrGroups.generator d23)
        ![2, 2] := by
  rw [multiGeneratorHash_smul_generator_eq_iff]
  decide

/-! ### 2. Pohlig-Hellman reduction and smooth/rough CRT recombination -/

/-- The generator `3` of `(ZMod 31)ˣ`, with inverse `21`. -/
def g31 : (ZMod 31)ˣ :=
  ⟨3, 21, by decide, by decide⟩

/-- The target `26 = 3 ^ 5` in `(ZMod 31)ˣ`, with inverse `6`. -/
def h31 : (ZMod 31)ˣ :=
  ⟨26, 6, by decide, by decide⟩

theorem orderOf_g31 : orderOf g31 = 30 := by
  rw [orderOf_eq_iff (by norm_num)]
  decide

/-- Katz-Lindell Example 10.5: the three subgroup instances for `q = 30 = 5 * 3 * 2` are solved
by `x₁ = 0`, `x₂ = 2`, `x₃ = 1`, and `pohligHellman_crt_modEq` shows that the CRT value `5`
agrees with every discrete logarithm of `26` modulo `30`. -/
example : (g31 ^ (30 / 5)) ^ 0 = h31 ^ (30 / 5) ∧ (g31 ^ (30 / 3)) ^ 2 = h31 ^ (30 / 3) ∧
    (g31 ^ (30 / 2)) ^ 1 = h31 ^ (30 / 2) ∧ g31 ^ 5 = h31 := by decide

example (x : ℕ) (hx : g31 ^ x = h31) : 5 ≡ x [MOD 30] :=
  pohligHellman_crt_modEq g31 h31 orderOf_g31 (by norm_num) (qs := [5, 3, 2]) (by decide) rfl hx
    (fun qi => if qi = 5 then 0 else if qi = 3 then 2 else 1) (by decide) (by decide)

/-- The digit step with `D = 1`, `p = 2` recovers the parity `1` of `x = 5`. -/
example : (g31 ^ 5 * g31 ^ (30 - 5 % 1)) ^ (30 / (1 * 2)) = (g31 ^ (30 / 2)) ^ 1 :=
  (pohligHellman_step g31 orderOf_g31 (by norm_num) (D := 1) (p := 2) (by norm_num) 5 1
    (by norm_num)).2 rfl

/-- `smoothDivisorSeq 12 1 4` extracts the `2`-smooth part `4` of `12 = 4 * 3`, and
`smoothDivisorSeq 12 2 4` extracts all of `12`. -/
example : smoothDivisorSeq 12 1 4 = 4 := rfl

example : smoothDivisorSeq 12 2 4 = 12 := rfl

/-- Concrete CRT recombination for `12 = 4 * 3` (`D = 4`, `L = 3`, `invD = 1` since
`1 * 4 ≡ 1 (mod 3)`): for every `x < 12`, `crtCombine 4 3 (x % 4) (x % 3) 1 = x`. -/
example : crtCombine 4 3 (7 % 4) (7 % 3) 1 = 7 := rfl

example :
    (List.range 12).all (fun x => crtCombine 4 3 (x % 4) (x % 3) 1 == x) = true := by decide

/-- Concrete extraction of the rough residue `7 % 3 = 1` from two transcripts modulo `12` with
`r₁ = 5, r₂ = 1, s₁ = 1, s₂ = 9` (`s₁ - s₂ ≡ 7 * (r₁ - r₂) (mod 12)`), followed by CRT
recombination with `7 % 4 = 3` to recover `x = 7`. -/
example :
    let xModL := extractModRough 12 3 1 9 1
    xModL = 7 % 3 ∧ crtCombine 4 3 (7 % 4) xModL 1 = 7 := by decide

/-- `crtCombine_extractModRough_eq` recovers `x = 7 < 12` from `7 % 4` and a rough-part transcript
collision modulo `12`. -/
example :
    crtCombine 4 3 (7 % 4) (extractModRough 12 3 1 9 1) 1 = 7 :=
  crtCombine_extractModRough_eq (q := 12) (D := 4) (L := 3) (x := 7)
    (r₁ := 5) (s₁ := 1) (r₂ := 1) (s₂ := 9) (invDiff := 1) (invD := 1)
    (by decide) (by decide) rfl (by decide) (by decide) (by decide) (by decide)
    (by decide) rfl rfl

/-! ### 3. Pollard's rho factoring -/

/-- The unit `2` in `(ZMod 15)ˣ` with inverse `8` (`2 * 8 = 16 ≡ 1 (mod 15)`). -/
def unit2Mod15 : (ZMod 15)ˣ :=
  ⟨2, 8, by decide, by decide⟩

/-- A unit-walk on `(ZMod 15)ˣ` that cycles through `1 ↦ 2 ↦ 4 ↦ 8 ↦ 1`, where `1` and `4` collide
modulo `3` while remaining distinct modulo `15`. -/
def walk15 (u : (ZMod 15)ˣ) : (ZMod 15)ˣ :=
  u * unit2Mod15

/-- Starting from `1 : (ZMod 15)ˣ`, `rhoFactorLoop 15 walk15 4 1 1` discovers the nontrivial prime
factor `3` of `15 = 3 * 5` within `2` Floyd tortoise-and-hare steps. -/
example : rhoFactorLoop 15 walk15 4 1 1 = some 3 := rfl

/-- Semiprime soundness applied to the concrete run: the returned factor is `3` or `5`. -/
example : 3 = 3 ∨ 3 = 5 :=
  eq_prime_of_rhoFactorLoop_eq_some (p := 3) (q := 5) (B := 4) (F := walk15) (x := 1) (y := 1)
    (by norm_num) (by norm_num) rfl

end ComplexityTests.Crypto.GroupCryptanalysis
