#guard_msgs in
#print axioms Cslib.Crypto.pohligHellman_step

/-- info: 'Cslib.Crypto.crtCombine_extractModRough_eq' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in
#print axioms Cslib.Crypto.crtCombine_extractModRough_eq

/-- info: 'Cslib.Crypto.pollardRho_spec' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in
#print axioms Cslib.Crypto.pollardRho_spec

end ComplexityTests.Crypto.GroupCryptanalysis
