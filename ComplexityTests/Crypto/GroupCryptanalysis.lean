import Complexity.Crypto.Computational.DiscreteLog.GroupHash
import Complexity.Crypto.Computational.DiscreteLog.PohligHellman
import Complexity.Crypto.Computational.DiscreteLog.PollardRho
import Complexity.Crypto.Computational.DiscreteLog.SchnorrGroup
import Complexity.Crypto.Negligible.Basic
import Mathlib.Tactic.NormNum.Prime

/-!
# Tests for cyclic-group hash families, Pohlig-Hellman reduction, and Pollard's rho factoring

Concrete evaluation and non-vacuity checks on the Schnorr group `d23` of order `11` in `(ZMod 23)ˣ`
generated by `2` for:
1. Fixed-length discrete-logarithm collision-resistant hashing (`groupHash`,
   `DiscreteLog.collisionResistantForOn_groupHash`) and multi-generator vector commitments
   (`multiGeneratorHash`).
2. Pohlig-Hellman prime-power reduction (`pohligHellman_step`), smooth divisor extraction
   (`smoothDivisorSeq`), rough-part residue extraction (`extractModRough`), and explicit CRT
   recombination (`crtCombine`, `crtCombine_extractModRough_eq`).
3. Pollard's rho tortoise-and-hare loop (`rhoFactorLoop`), modulo-`p` GCD extraction
   (`isNontrivialFactor_rhoGcd_of_modEq`), Floyd cycle detection (`floyd_cycle_modEq`), and
   `pollardRho_spec` on `N = 15 = 3 * 5`.
-/

namespace ComplexityTests.Crypto.GroupCryptanalysis

open Cslib Cslib.Probability Cslib.Crypto Cslib.Crypto.PrimeOrderGroupFamily Turing.MultiTapeTM
open scoped NNReal

/-- The Schnorr group of order `11` in `(ZMod 23)ˣ`, generated by `2`. -/
def d23 : schnorrGroups.Desc :=
  ⟨(23, 11, 2), ⟨by norm_num, by norm_num, by norm_num, by norm_num, by norm_num⟩⟩

/-! ### 1. Fixed-length discrete-logarithm hash and multi-generator hash -/

/-- With block length `L = 3` (`2 ^ 3 = 8 ≤ 11`), valid inputs to `schnorrGroups.groupHash` have
length `2 * 3 = 6`. -/
example :
    schnorrGroups.validGroupHashInput (fun _ => 3) 0 (d23, Nat.bits 8)
      (List.replicate 6 true) = true := rfl

example :
    schnorrGroups.validGroupHashInput (fun _ => 3) 0 (d23, Nat.bits 8)
      (List.replicate 5 true) = false := rfl

/-- On `d23` with `h = 2 ^ 3 mod 23 = 8` (`Nat.bits 8`) and `3`-bit blocks
`x₁ = [false, false, true]` (`ofBits x₁ = 4`) and `x₂ = [true, false, true]`
(`ofBits x₂ = 5`), `groupHash` computes `2 ^ 4 · 8 ^ 5 ≡ 3 (mod 23)` (`Nat.bits 3`). -/
example :
    schnorrGroups.groupHash (fun _ => 3) (d23, Nat.bits 8)
      [false, false, true, true, false, true] = Nat.bits 3 := by decide

/-- With the same key `(d23, Nat.bits 8)` (`α = 3`), the distinct `6`-bit message
`[false, true, false, false, true, false]` (`x₁ = 2`, `x₂ = 2`) collides with
`[false, false, true, true, false, true]` (`x₁ = 4`, `x₂ = 5`) at `Nat.bits 3`. -/
example :
    schnorrGroups.groupHash (fun _ => 3) (d23, Nat.bits 8)
      [false, true, false, false, true, false] = Nat.bits 3 := by decide

/-- `isCollisionFor` accepts the concrete `6`-bit collision pair on `(d23, Nat.bits 8)`, and
`pedersenExtractNat` recovers the discrete logarithm `α = 3`. -/
example :
    isCollisionFor (Param := schnorrGroups.Desc × List Bool) (Digest := fun _ => List Bool)
      (schnorrGroups.groupHash (fun _ => 3))
      (schnorrGroups.validGroupHashInput (fun _ => 3))
      0 (d23, Nat.bits 8)
      [false, false, true, true, false, true]
      [false, true, false, false, true, false] = true ∧
    pedersenExtractNat 11
      (ofBits [false, false, true]) (ofBits [true, false, true])
      (ofBits [false, true, false]) (ofBits [false, true, false]) = 3 := by decide

/-- Non-vacuity of `DiscreteLog.collisionResistantForOn_groupHash` on `schnorrGroups` with
polynomial-time block length `blockLen`. -/
example (setup : ℕ → PMF schnorrGroups.Desc) (hDL : schnorrGroups.DiscreteLog setup)
    (blockLen : schnorrGroups.Desc → ℕ)
    (hblockLen : ComputableInPolyTime blockLen schnorrGroups.encDesc encUnary)
    (hbound : ∀ᶠ n in Filter.atTop,
      ∀ d ∈ (setup n).support, 2 ^ blockLen d ≤ schnorrGroups.order d) :
    CollisionResistantForOn (Param := schnorrGroups.Desc × List Bool)
      (Digest := fun _ => List Bool)
      (encPair schnorrGroups.encDesc encBits)
      (schnorrGroups.groupHashSetup setup)
      (schnorrGroups.groupHash blockLen)
      (schnorrGroups.validGroupHashInput blockLen) :=
  hDL.collisionResistantForOn_groupHash hblockLen hbound

/-- Multi-generator hash homomorphic properties on `d23`. -/
example (hs : Fin 2 → schnorrGroups.Carrier d23)
    (xs ys : Fin 2 → ZMod (schnorrGroups.order d23)) :
    schnorrGroups.multiGeneratorHash d23 hs (xs + ys) =
      schnorrGroups.multiGeneratorHash d23 hs xs +
        schnorrGroups.multiGeneratorHash d23 hs ys :=
  schnorrGroups.multiGeneratorHash_add d23 hs xs ys

/-! ### 2. Pohlig-Hellman reduction and smooth/rough CRT recombination -/

/-- `smoothDivisorSeq 12 1 4` extracts the `2`-smooth part `4` of `12 = 4 * 3`, and
`smoothDivisorSeq 12 2 4` extracts all of `12`. -/
example : smoothDivisorSeq 12 1 4 = 4 := rfl

example : smoothDivisorSeq 12 2 4 = 12 := rfl

/-- Concrete CRT recombination for `q = 12 = 4 * 3` (`D = 4`, `L = 3`, `invD = 1` since
`1 * 4 ≡ 1 (mod 3)`): for every `x < 12`, `crtCombine 4 3 12 (x % 4) (x % 3) 1 = x`. -/
example : crtCombine 4 3 12 (7 % 4) (7 % 3) 1 = 7 := rfl

example :
    (List.range 12).all (fun x => crtCombine 4 3 12 (x % 4) (x % 3) 1 == x) = true := by decide

/-- Concrete extraction of the rough residue `7 % 3 = 1` from two transcripts modulo `12` with
`r₁ = 5, r₂ = 1, s₁ = 1, s₂ = 9` (`s₁ - s₂ ≡ 7 * (r₁ - r₂) (mod 12)`), followed by CRT
recombination with `7 % 4 = 3` to recover `x = 7`. -/
example :
    let xModL := extractModRough 12 3 1 9 1
    xModL = 7 % 3 ∧ crtCombine 4 3 12 (7 % 4) xModL 1 = 7 := by decide

/-- `crtCombine_extractModRough_eq` recovers `x = 7 < 12` from `7 % 4` and a rough-part transcript
collision modulo `12`. -/
example :
    crtCombine 4 3 12 (7 % 4) (extractModRough 12 3 1 9 1) 1 = 7 :=
  crtCombine_extractModRough_eq (q := 12) (D := 4) (L := 3) (x := 7)
    (r₁ := 5) (s₁ := 1) (r₂ := 1) (s₂ := 9) (invDiff := 1) (invD := 1)
    (by decide) (by decide) rfl (by decide) (by decide) (by decide) (by decide)
    (by decide) rfl rfl

/-! ### 3. Pollard's rho factoring and Floyd cycle detection -/

/-- The unit `2` in `(ZMod 15)ˣ` with inverse `8` (`2 * 8 = 16 ≡ 1 (mod 15)`). -/
def unit2Mod15 : (ZMod 15)ˣ :=
  ⟨2, 8, by decide, by decide⟩

/-- A unit-walk on `(ZMod 15)ˣ` that cycles through `1 ↦ 2 ↦ 4 ↦ 8 ↦ 1`, where `1` and `4` collide
modulo `3` while remaining distinct modulo `15`. -/
def walk15 (u : (ZMod 15)ˣ) : (ZMod 15)ˣ :=
  u * unit2Mod15

/-- Starting from `1 : (ZMod 15)ˣ`, `rhoFactorLoop 15 walk15 4 1 1` discovers the nontrivial prime
factor `3` of `15 = 3 * 5` within `2` Floyd tortoise-and-hare steps. -/
example : rhoFactorLoop 15 walk15 4 1 1 = some 3 := rfl

/-- The factor `3` returned by `rhoFactorLoop 15 walk15 4 1 1` satisfies `IsNontrivialFactor 15 3`
and equals one of the prime factors `3` or `5`. -/
example : IsNontrivialFactor 15 3 ∧ (3 = 3 ∨ 3 = 5) :=
  (pollardRho_spec (N := 15) (p := 3) (q := 5) (by norm_num) (by norm_num) rfl walk15 4).1
    1 3 rfl

/-! ### 4. Axiom hygiene verification -/

