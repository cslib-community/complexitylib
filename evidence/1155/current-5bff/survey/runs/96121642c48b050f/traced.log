[aesop] ✅️ ✅️ (G0) [100.0000%] ⋯ ⊢ ComputableTidilyInPolyTime
      (fun n => size (saved.length n) (densityBound n) * common n + 1 - common n) encUnary encUnary
  [aesop] Initial goal:
        pair : SamplablePair
        gap : ℕ → ℝ
        hpair : pair.HasGap gap
        saved : pair.SeedRealization
        observationBound densityBound common : ℕ → ℕ
        hgap : ∀ᶠ (n : ℕ) in atTop, 4 / ↑(dyadicSize (densityBound n)) ≤ gap n
        choose : ℕ → ℕ
        hchoose : ∀ᶠ (n : ℕ) in atTop, choose n < size (saved.length n) (densityBound n)
        hsecure :
          ∀ (test : ℕ → ℕ → List Bool → ProbComp Bool),
            (IsPPTOn (encPair (encPair encUnary encUnary) encBits) encBool fun input =>
                test input.1.1 input.1.2 input.2) →
              Negligible fun n =>
                Game.advantage
                  ((PMF.map
                        (paddedGenerate n (saved.length n) (observationBound n) (densityBound n) (common n) (choose n)
                          (saved.evaluate n))
                        (uniformList (common n))).bind
                    fun word => (test n (choose n) word).eval)
                  ((uniformList (common n + 1)).bind fun word => (test n (choose n) word).eval)
        hobservationPlain : ComputableInPolyTime observationBound encUnary encUnary
        hdensityPlain : ComputableInPolyTime densityBound encUnary encUnary
        hcommonPlain : ComputableInPolyTime common encUnary encUnary
        observation_fits✝ :
          ∀ (n : ℕ),
            ∀ observation ∈ (PMF.map Prod.fst (pair.joint n)).support,
              ((pair.encode n) observation).length ≤ observationBound n
        seed_fits✝ :
          ∀ (n index : ℕ),
