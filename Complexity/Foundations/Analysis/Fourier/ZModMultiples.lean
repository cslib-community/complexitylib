module
-- upstream: candidate (Mathlib, `Mathlib/Analysis/Fourier/ZMod.lean`)

public import Complexity.Foundations.Data.ZMod.Multiples
public import Mathlib.Analysis.Fourier.ZMod

/-!
# Character sums over a subgroup of `ZMod N`

For `d ∣ N`, the standard additive character `ZMod.stdAddChar` summed over the subgroup of
multiples of `d` is the indicator of its annihilator, the multiples of `N / d`, scaled by the
subgroup's size `N / d`. This is the orthogonality relation behind exact quantum period finding.

## Main results

* `ZMod.stdAddChar_natCast_mul_eq_one_iff`: `stdAddChar (d * y) = 1 ↔ N / d ∣ y.val`.
* `ZMod.sum_dvd_val_stdAddChar_mul`: `∑_{d ∣ h.val} stdAddChar (h * y)` is `N / d` when
  `N / d ∣ y.val`, and `0` otherwise.
-/

public section

open Finset

namespace ZMod

variable {N : ℕ} [NeZero N]

/-- For `d ∣ N`, `stdAddChar (d * y) = 1` exactly when `N / d` divides `y.val`. -/
theorem stdAddChar_natCast_mul_eq_one_iff {d : ℕ} (hd : d ∣ N) (y : ZMod N) :
    stdAddChar ((d : ZMod N) * y) = 1 ↔ N / d ∣ y.val := by
  have hd0 : 0 < d :=
    Nat.pos_of_ne_zero fun h0 => NeZero.ne N (Nat.eq_zero_of_zero_dvd (h0 ▸ hd))
  rw [← AddChar.map_zero_eq_one (stdAddChar (N := N)), injective_stdAddChar.eq_iff,
    ← natCast_zmod_val y, ← Nat.cast_mul, ZMod.natCast_eq_zero_iff _ N, ZMod.val_natCast,
    Nat.mod_eq_of_lt (ZMod.val_lt y), Nat.div_dvd_iff_dvd_mul hd hd0]

/-- **Orthogonality over a subgroup.** For `d ∣ N`, the sum of `stdAddChar (h * y)` over the
residues `h` with `d ∣ h.val` (the subgroup generated by `d`) is `N / d` when `N / d ∣ y.val` (that
is, `y` annihilates the subgroup) and `0` otherwise. -/
theorem sum_dvd_val_stdAddChar_mul {d : ℕ} (hd : d ∣ N) (y : ZMod N) :
    ∑ h : ZMod N, (if d ∣ h.val then stdAddChar (h * y) else 0) =
      if N / d ∣ y.val then ((N / d : ℕ) : ℂ) else 0 := by
  have hmem : ∀ h : ZMod N, d ∣ h.val ↔ h ∈ AddSubgroup.zmultiples (d : ZMod N) :=
    fun h => (mem_zmultiples_iff_dvd_val hd h).symm
  split_ifs with hy
  · have h1 : ∀ h : ZMod N, d ∣ h.val → stdAddChar (h * y) = 1 := by
      intro h hh
      obtain ⟨k, rfl⟩ := (hmem h).mp hh
      rw [smul_mul_assoc, AddChar.map_zsmul_eq_zpow,
        (stdAddChar_natCast_mul_eq_one_iff hd y).mpr hy, one_zpow]
    rw [sum_congr rfl fun h _ => ite_congr rfl (h1 h) fun _ => rfl, sum_boole,
      card_filter_dvd_val hd]
  · -- Translating by `d` permutes the subgroup and multiplies the sum by
    -- `stdAddChar (d * y) ≠ 1`, so the sum vanishes.
    have hne : stdAddChar ((d : ZMod N) * y) ≠ 1 :=
      fun h => hy ((stdAddChar_natCast_mul_eq_one_iff hd y).mp h)
    refine eq_zero_of_mul_eq_self_left hne ?_
    rw [mul_sum]
    refine Fintype.sum_equiv (Equiv.addRight (d : ZMod N)) _ _ fun h => ?_
    have hiff : d ∣ (h + d).val ↔ d ∣ h.val := by
      rw [hmem, hmem]
      exact AddSubgroup.add_mem_cancel_right _ (AddSubgroup.mem_zmultiples _)
    rw [Equiv.coe_addRight, if_congr hiff rfl rfl]
    split_ifs
    · rw [← AddChar.map_add_eq_mul]; ring_nf
    · rw [mul_zero]

end ZMod
