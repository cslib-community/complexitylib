/-!
# The encrypted-link reduction algorithms

The reduction embeds the challenge public key immediately after a freshly generated predecessor
key. It saves only keys it generated itself, the challenge public key, and the selected bit
index. Its guessing stage replaces the unknown target secret by a zero word of the predecessor
secret's length and runs the actual boundary-link splicing sampler.

The target key's outgoing link is already zeroed. Fixed supported secret-key length will justify
the substitution in the separate game proof; neither that hypothesis nor a security conclusion
is built into these algorithms. Random link selection runs from the end of the chain towards
its beginning. Dyadic padding coordinates reject, and decoding is total on every saved word.

## Main definitions

* `Cslib.Crypto.Homomorphic.Scheme.LinkState`: the explicitly encoded simulation context.
* `Cslib.Crypto.Homomorphic.Scheme.chooseLinkAt`: generate the known keys and challenge messages.
* `Cslib.Crypto.Homomorphic.Scheme.guessLink`: splice the challenge into the public artifact.
* `Cslib.Crypto.Homomorphic.Scheme.linkAdversaryAt`: the reduction at supplied index families.
* `Cslib.Crypto.Homomorphic.Scheme.linkAdversary`: select link and bit indices uniformly.

## Main results

* `Cslib.Crypto.Homomorphic.Scheme.guessLink_active`: the exact response to an encoded context.
* `Cslib.Crypto.Homomorphic.Scheme.guessLink_reject`: a rejected coordinate always returns false.

## References

* [C. Gentry, *Fully homomorphic encryption using ideal lattices*, Section 2][Gentry2009]
* [D. Boneh, V. Shoup, *A Graduate Course in Applied Cryptography*, Section 11.2][BonehShoup2023]
-/

@[expose] public section

namespace Cslib.Crypto.Homomorphic.Scheme

open ProbComp Probability Turing.MultiTapeTM

/-- Active flag, earlier keys, predecessor, challenge public key, later keys, and unary bit index.
Every saved secret belongs to a key generated by the reduction itself. -/
abbrev LinkState := Bool × List (List Bool × List Bool) × (List Bool × List Bool) ×
  List Bool × List (List Bool × List Bool) × ℕ

/-- Frame every saved component, including all simulator-generated secret keys. -/
def encLinkState : LinkState ↪ List Bool :=
  encPair encBool (encPair (encList (encPair encBits encBits))
    (encPair (encPair encBits encBits)
      (encPair encBits (encPair (encList (encPair encBits encBits)) encUnary))))

/-- Total saved-state parsing, reusing the standard component decoders. -/
def linkStateDecoder : Decoder encLinkState :=
  Decoder.bool.pair ((Decoder.bits.pair Decoder.bits).list.pair
    ((Decoder.bits.pair Decoder.bits).pair
      (Decoder.bits.pair ((Decoder.bits.pair Decoder.bits).list.pair Decoder.unary))))

/-- Serialize an active simulation context. -/
def activeLinkState (before : List (List Bool × List Bool))
    (predecessor : List Bool × List Bool) (challengePk : List Bool)
    (after : List (List Bool × List Bool)) (bitIndex : ℕ) : List Bool :=
  encLinkState (true, before, predecessor, challengePk, after, bitIndex)

/-- A fixed inactive saved state. -/
def rejectLinkState : List Bool := encLinkState (false, [], ([], []), [], [], 0)

/-- Both challenge messages are equal when the coordinate is rejected. -/
def rejectLinkChoice : (Bool × Bool) × List Bool := ((false, false), rejectLinkState)

@[simp] theorem linkStateDecoder_decode_active (before : List (List Bool × List Bool))
    (predecessor : List Bool × List Bool) (challengePk : List Bool)
    (after : List (List Bool × List Bool)) (bitIndex : ℕ) :
    linkStateDecoder.decode (activeLinkState before predecessor challengePk after bitIndex) =
      (true, before, predecessor, challengePk, after, bitIndex) :=
  linkStateDecoder.decode_enc _

@[simp] theorem linkStateDecoder_decode_reject :
    linkStateDecoder.decode rejectLinkState = (false, [], ([], []), [], [], 0) :=
  linkStateDecoder.decode_enc _

variable (E : Scheme)

/-- Sample every known key before choosing the predecessor's selected bit against zero.
Out-of-range bit indices return the fixed reject state. -/
def chooseLinkAt (n beforeCount afterCount bitIndex : ℕ) (challengePk : List Bool) :
    ProbComp ((Bool × Bool) × List Bool) := do
  let before ← OracleComp.replicate beforeCount (E.keyGen n)
  let predecessor ← E.keyGen n
  let after ← OracleComp.replicate afterCount (E.keyGen n)
  if bitIndex < predecessor.2.length then
    pure ((predecessor.2.getD bitIndex false, false),
      activeLinkState before predecessor challengePk after bitIndex)
  else pure rejectLinkChoice

/-- Decode the saved state and run the actual public-artifact test. The replacement secret is
used only to supply the already-zeroed outgoing link's length. -/
def guessLink
    (test : ℕ → (List (List Bool) × List (List (List Bool))) → ProbComp Bool)
    (n : ℕ) (state challengeCiphertext : List Bool) : ProbComp Bool := do
  let context := linkStateDecoder.decode state
  if context.1 then
    let (before, predecessor, targetKey, after, bitIndex) := context.2
    let target := (targetKey, List.replicate predecessor.2.length false)
    let links ← E.spliceEncryptedKeyLink n before predecessor target after bitIndex
      challengeCiphertext
    test n ((before ++ predecessor :: target :: after).map Prod.fst, links)
  else pure false

/-- An encoded active context executes the concrete splicing sampler and exposes only public
keys and encrypted links to the test. -/
@[simp] theorem guessLink_active
    (test : ℕ → (List (List Bool) × List (List (List Bool))) → ProbComp Bool)
    (n : ℕ) (before : List (List Bool × List Bool)) (predecessor : List Bool × List Bool)
    (challengePk : List Bool) (after : List (List Bool × List Bool))
    (bitIndex : ℕ) (challengeCiphertext : List Bool) :
    E.guessLink test n (activeLinkState before predecessor challengePk after bitIndex)
      challengeCiphertext = (do
        let target := (challengePk, List.replicate predecessor.2.length false)
        let links ← E.spliceEncryptedKeyLink n before predecessor target after bitIndex
          challengeCiphertext
        test n ((before ++ predecessor :: target :: after).map Prod.fst, links)) := by
  simp only [guessLink, linkStateDecoder_decode_active, ↓reduceIte]

/-- Rejecting a coordinate discards the ciphertext and never invokes the test. -/
@[simp] theorem guessLink_reject
    (test : ℕ → (List (List Bool) × List (List (List Bool))) → ProbComp Bool)
    (n : ℕ) (challengeCiphertext : List Bool) :
    E.guessLink test n rejectLinkState challengeCiphertext = pure false := by
  simp only [guessLink, linkStateDecoder_decode_reject, Bool.false_eq_true, ↓reduceIte]

/-- The complete two-stage reduction at parameter-dependent link and bit positions. -/
def linkAdversaryAt (beforeCount afterCount bitIndex : ℕ → ℕ)
    (test : ℕ → (List (List Bool) × List (List (List Bool))) → ProbComp Bool) :
    Encryption.Adversary where
  choose n pk := E.chooseLinkAt n (beforeCount n) (afterCount n) (bitIndex n) pk
  guess := E.guessLink test

/-- Select a reverse link index and a bit index with exact dyadic samplers. Padding link
indices reject immediately; padding bit indices are rejected by `chooseLinkAt`. -/
noncomputable def linkAdversary (depth capacity : ℕ → ℕ)
    (test : ℕ → (List (List Bool) × List (List (List Bool))) → ProbComp Bool) :
    Encryption.Adversary where
  choose n pk := do
    let reverseIndex ← sampleDyadicIndex (depth n)
    let bitIndex ← sampleDyadicIndex (capacity n)
    if reverseIndex < depth n then
      E.chooseLinkAt n (depth n - reverseIndex - 1) reverseIndex bitIndex pk
    else pure rejectLinkChoice
  guess := E.guessLink test

end Cslib.Crypto.Homomorphic.Scheme
