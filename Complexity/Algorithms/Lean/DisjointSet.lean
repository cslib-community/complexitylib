/-!
# Representation-independent disjoint-set specification

This module specifies a dynamic partition (disjoint-set / union-find abstract state machine) over
a finite universe `Fin n` in the `Cslib.Stateful` framework.

Mathematical states are equivalence relations `Partition n` with decidable Boolean membership,
starting from the discrete partition `Partition.discrete n` of `n` singleton classes. The
interface (`Op`, `spec`) exposes:

* `Op.same x y`: test whether `x` and `y` belong to the same equivalence class;
* `Op.union x y`: merge the classes of `x` and `y`, returning `true` iff two distinct classes
  merged;
* `Op.numComponents`: return the current number of equivalence classes.

Unlike concrete union-find forests, `spec` intentionally does not expose raw tree-root indices:
under union by rank, two histories reaching the same mathematical partition can choose different
canonical roots, so exposing root indices would leak internal forest history rather than abstract
partition state. Returning the effective-merge Boolean from `Op.union` gives single-pass edge
filters such as `spanningForestEdges` (the unweighted Kruskal / cycle-filtering loop, whose
returned edge list depends on observed answers while its issued operation sequence is fixed at one
`Op.union` per input edge), while clients such as `connectIfNew` branch on `same` so that the
issued operation sequence itself adapts to the current partition.

## Main definitions

* `Cslib.Algorithms.Lean.DisjointSet.Partition`: decidable equivalence relations on `Fin n`.
* `Partition.toSetoid`, `Partition.discrete`, `Partition.classOf`, `Partition.components`,
  `Partition.numComponents`, `Partition.merge`: setoid view, singleton partition, equivalence
  classes, quotient component set, component count, and binary class merge.
* `Cslib.Algorithms.Lean.DisjointSet.Op`, `Cslib.Algorithms.Lean.DisjointSet.spec`: typed
  disjoint-set operations and `Cslib.Stateful.Spec`.
* `same`, `union`, `getNumComponents`, `connectIfNew`, `spanningForestEdges`: primitive client
  operations, history-adaptive conditional union, and the single-pass spanning-forest edge filter.

## Main results

* `Partition.rel_merge_iff_eqvGen`: `p.merge x y` is the exact equivalence closure `Relation.EqvGen`
  generated by `p` and the pair `(x, y)`.
* `Partition.numComponents_discrete`, `Partition.numComponents_merge_of_rel`,
  `Partition.numComponents_merge_of_not_rel`: exact component counts initially and across redundant
  versus effective merges.
* `runClient_connectIfNew`, `runClient_spanningForestEdges_history`: exact operation histories for
  history-adaptive conditional union and single-pass spanning-forest filtering.
* `spanningForestEdges_sublist`, `spanningForestEdges_rel_iff_eqvGen`,
  `spanningForestEdges_numComponents_add_length`, `spanningForestEdges_idempotent_partition`:
  correctness, connectivity preservation, and component-count conservation for
  `spanningForestEdges`.

## References

* [T. H. Cormen, C. E. Leiserson, R. L. Rivest and C. Stein, *Introduction to Algorithms*,
  Chapter 21][CLRS2009]
-/

public section

namespace Cslib.Algorithms.Lean.DisjointSet

open Cslib.Stateful

/-- A decidable partition (equivalence relation) on `Fin n`. -/
structure Partition (n : ℕ) where
  /-- Boolean equivalence test between elements of `Fin n`. -/
  rel : Fin n → Fin n → Bool
  /-- Reflexivity of `rel`. -/
  refl : ∀ x, rel x x = true
  /-- Symmetry of `rel`. -/
  symm : ∀ {x y}, rel x y = true → rel y x = true
  /-- Transitivity of `rel`. -/
  trans : ∀ {x y z}, rel x y = true → rel y z = true → rel x z = true

namespace Partition

variable {n : ℕ}

@[ext]
theorem ext {p q : Partition n} (h : ∀ x y, p.rel x y = q.rel x y) : p = q := by
  cases p
  cases q
  simp only [mk.injEq]
  funext x y
  exact h x y

instance instDecidableEq (n : ℕ) : DecidableEq (Partition n) := fun p q =>
  if h : ∀ x y : Fin n, p.rel x y = q.rel x y then
    isTrue (ext h)
  else
    isFalse fun hpq => h fun x y => by rw [hpq]

@[simp]
theorem rel_refl (p : Partition n) (x : Fin n) : p.rel x x = true :=
  p.refl x

/-- Boolean symmetry of `p.rel`. -/
theorem rel_comm (p : Partition n) (x y : Fin n) : p.rel x y = p.rel y x := by
  cases hxy : p.rel x y <;> cases hyx : p.rel y x
  · rfl
  · exact absurd (p.symm hyx) (by simp [hxy])
  · exact absurd (p.symm hxy) (by simp [hyx])
  · rfl

/-- View a `Partition n` as a `Setoid (Fin n)`. -/
@[expose] def toSetoid (p : Partition n) : Setoid (Fin n) where
  r x y := p.rel x y = true
  iseqv := ⟨p.refl, p.symm, p.trans⟩

@[simp]
theorem toSetoid_r_iff (p : Partition n) (x y : Fin n) :
    p.toSetoid.r x y ↔ p.rel x y = true := Iff.rfl

/-- The discrete partition of `Fin n` into `n` singleton classes. -/
@[expose] def discrete (n : ℕ) : Partition n where
  rel x y := x == y
  refl x := by simp
  symm h := by
    rw [beq_iff_eq] at h ⊢
    exact h.symm
  trans h₁ h₂ := by
    rw [beq_iff_eq] at h₁ h₂ ⊢
    exact h₁.trans h₂

@[simp]
theorem rel_discrete (x y : Fin n) : (discrete n).rel x y = (x == y) := rfl

theorem rel_discrete_eq_true {x y : Fin n} : (discrete n).rel x y = true ↔ x = y :=
  beq_iff_eq

/-- The equivalence class of `x` in `p`. -/
@[expose] def classOf (p : Partition n) (x : Fin n) : Finset (Fin n) :=
  Finset.univ.filter fun y => p.rel x y

@[simp]
theorem mem_classOf {p : Partition n} {x y : Fin n} :
    y ∈ p.classOf x ↔ p.rel x y = true := by
  simp [classOf]

theorem self_mem_classOf (p : Partition n) (x : Fin n) : x ∈ p.classOf x :=
  mem_classOf.mpr (p.refl x)

theorem classOf_nonempty (p : Partition n) (x : Fin n) : (p.classOf x).Nonempty :=
  ⟨x, p.self_mem_classOf x⟩

/-- Two elements have the same equivalence class iff they are related in `p`. -/
theorem classOf_eq_iff {p : Partition n} {x y : Fin n} :
    p.classOf x = p.classOf y ↔ p.rel x y = true := by
  constructor
  · intro h
    have hy : y ∈ p.classOf x := h ▸ p.self_mem_classOf y
    exact mem_classOf.mp hy
  · intro hxy
    ext z
    simp only [mem_classOf]
    exact ⟨fun hxz => p.trans (p.symm hxy) hxz, fun hyz => p.trans hxy hyz⟩

/-- Unrelated elements have disjoint equivalence classes. -/
theorem disjoint_classOf_of_rel_eq_false {p : Partition n} {x y : Fin n}
    (h : p.rel x y = false) : Disjoint (p.classOf x) (p.classOf y) := by
  refine Finset.disjoint_left.mpr fun z hzx hzy => ?_
  have hxy : p.rel x y = true := p.trans (mem_classOf.mp hzx) (p.symm (mem_classOf.mp hzy))
  rw [h] at hxy
  cases hxy

/-- The finite set of equivalence classes (connected components) of `p`. -/
@[expose] def components (p : Partition n) : Finset (Finset (Fin n)) :=
  Finset.univ.image p.classOf

@[simp]
theorem mem_components {p : Partition n} {c : Finset (Fin n)} :
    c ∈ p.components ↔ ∃ x, p.classOf x = c := by
  simp [components]

theorem classOf_mem_components (p : Partition n) (x : Fin n) :
    p.classOf x ∈ p.components :=
  mem_components.mpr ⟨x, rfl⟩

/-- The number of equivalence classes of `p`. -/
@[expose] def numComponents (p : Partition n) : ℕ :=
  p.components.card

@[simp]
theorem numComponents_zero (p : Partition 0) : p.numComponents = 0 := by
  simp [numComponents, components]

/-- Every partition of `Fin n` has at most `n` components. -/
theorem numComponents_le (p : Partition n) : p.numComponents ≤ n :=
  Finset.card_image_le.trans (by simp)

/-- Every partition of a nonempty `Fin n` has at least one component. -/
theorem numComponents_pos (hn : 0 < n) (p : Partition n) : 0 < p.numComponents :=
  Finset.Nonempty.card_pos ⟨p.classOf ⟨0, hn⟩, p.classOf_mem_components ⟨0, hn⟩⟩

/-- The discrete partition on `Fin n` has `n` components. -/
@[simp]
theorem numComponents_discrete (n : ℕ) : (discrete n).numComponents = n := by
  unfold numComponents components
  rw [Finset.card_image_of_injective]
  · exact Finset.card_fin n
  · intro x y h
    exact rel_discrete_eq_true.mp (classOf_eq_iff.mp h)

/-- Merge the equivalence classes of `x` and `y` in `p`. -/
@[expose] def merge (p : Partition n) (x y : Fin n) : Partition n where
  rel a b := p.rel a b || (p.rel a x && p.rel y b) || (p.rel a y && p.rel x b)
  refl a := by simp
  symm {a b} h := by
    simp only [Bool.or_eq_true, Bool.and_eq_true] at h ⊢
    rcases h with (hab | ⟨hax, hyb⟩) | ⟨hay, hxb⟩
    · exact .inl (.inl (p.symm hab))
    · exact .inr ⟨p.symm hyb, p.symm hax⟩
    · exact .inl (.inr ⟨p.symm hxb, p.symm hay⟩)
  trans {a b c} h₁ h₂ := by
    simp only [Bool.or_eq_true, Bool.and_eq_true] at h₁ h₂ ⊢
    rcases h₁ with (hab | ⟨hax, hyb⟩) | ⟨hay, hxb⟩ <;>
      rcases h₂ with (hbc | ⟨hbx, hyc⟩) | ⟨hby, hxc⟩
    · exact .inl (.inl (p.trans hab hbc))
    · exact .inl (.inr ⟨p.trans hab hbx, hyc⟩)
    · exact .inr ⟨p.trans hab hby, hxc⟩
    · exact .inl (.inr ⟨hax, p.trans hyb hbc⟩)
    · exact .inl (.inr ⟨hax, hyc⟩)
    · exact .inl (.inl (p.trans hax hxc))
    · exact .inr ⟨hay, p.trans hxb hbc⟩
    · exact .inl (.inl (p.trans hay hyc))
    · exact .inr ⟨hay, hxc⟩

@[simp]
theorem rel_merge (p : Partition n) (x y a b : Fin n) :
    (p.merge x y).rel a b =
      (p.rel a b || (p.rel a x && p.rel y b) || (p.rel a y && p.rel x b)) := rfl

theorem rel_merge_eq_true {p : Partition n} {x y a b : Fin n} :
    (p.merge x y).rel a b = true ↔
      p.rel a b = true ∨
        (p.rel a x = true ∧ p.rel y b = true) ∨
        (p.rel a y = true ∧ p.rel x b = true) := by
  simp only [rel_merge, Bool.or_eq_true, Bool.and_eq_true, or_assoc]

/-- `p.merge x y` is the exact equivalence closure `Relation.EqvGen` of `p` together with
`(x, y)`. -/
theorem rel_merge_iff_eqvGen {p : Partition n} {x y a b : Fin n} :
    (p.merge x y).rel a b = true ↔
      Relation.EqvGen (fun u v => p.rel u v = true ∨ (u = x ∧ v = y)) a b := by
  constructor
  · intro h
    rcases rel_merge_eq_true.mp h with hab | ⟨hax, hyb⟩ | ⟨hay, hxb⟩
    · exact .rel _ _ (.inl hab)
    · exact .trans _ x _ (.rel _ _ (.inl hax))
        (.trans _ y _ (.rel _ _ (.inr ⟨rfl, rfl⟩)) (.rel _ _ (.inl hyb)))
    · exact .trans _ y _ (.rel _ _ (.inl hay))
        (.trans _ x _ (.symm _ _ (.rel _ _ (.inr ⟨rfl, rfl⟩))) (.rel _ _ (.inl hxb)))
  · intro h
    induction h with
    | rel u v huv =>
      rcases huv with huv | ⟨rfl, rfl⟩
      · exact rel_merge_eq_true.mpr (.inl huv)
      · exact rel_merge_eq_true.mpr (.inr (.inl ⟨p.refl u, p.refl v⟩))
    | refl u => exact (p.merge x y).refl u
    | symm u v _ ih => exact (p.merge x y).symm ih
    | trans u v w _ _ ih₁ ih₂ => exact (p.merge x y).trans ih₁ ih₂

@[simp]
theorem merge_self (p : Partition n) (x : Fin n) : p.merge x x = p := by
  ext a b
  cases h : p.rel a b
  · simp only [rel_merge, h, Bool.false_or, Bool.or_self, Bool.and_eq_false_imp]
    intro hax
    cases hxb : p.rel x b
    · rfl
    · exact absurd (p.trans hax hxb) (by simp [h])
  · simp [rel_merge, h]

theorem merge_comm (p : Partition n) (x y : Fin n) : p.merge x y = p.merge y x := by
  ext a b
  simp only [rel_merge]
  cases p.rel a b <;> cases p.rel a x <;> cases p.rel y b <;>
    cases p.rel a y <;> cases p.rel x b <;> rfl

/-- Merging two already-equivalent elements leaves the partition unchanged. -/
theorem merge_of_rel {p : Partition n} {x y : Fin n} (h : p.rel x y = true) :
    p.merge x y = p := by
  ext a b
  cases hab : p.rel a b
  · simp only [rel_merge, hab, Bool.false_or, Bool.or_eq_false_iff, Bool.and_eq_false_imp]
    refine ⟨fun hax => ?_, fun hay => ?_⟩
    · cases hyb : p.rel y b
      · rfl
      · exact absurd (p.trans (p.trans hax h) hyb) (by simp [hab])
    · cases hxb : p.rel x b
      · rfl
      · exact absurd (p.trans (p.trans hay (p.symm h)) hxb) (by simp [hab])
  · simp [rel_merge, hab]

/-- Redundant merges preserve the number of components. -/
theorem numComponents_merge_of_rel {p : Partition n} {x y : Fin n} (h : p.rel x y = true) :
    (p.merge x y).numComponents = p.numComponents := by
  rw [merge_of_rel h]

private theorem classOf_merge_eq_union {p : Partition n} {x y z : Fin n}
    (hz : p.rel z x = true ∨ p.rel z y = true) :
    (p.merge x y).classOf z = p.classOf x ∪ p.classOf y := by
  ext w
  simp only [mem_classOf, Finset.mem_union, rel_merge_eq_true]
  rcases hz with hzx | hzy
  · constructor
    · rintro (hzw | ⟨_, hyw⟩ | ⟨_, hxw⟩)
      · exact .inl (p.trans (p.symm hzx) hzw)
      · exact .inr hyw
      · exact .inl hxw
    · rintro (hxw | hyw)
      · exact .inl (p.trans hzx hxw)
      · exact .inr (.inl ⟨hzx, hyw⟩)
  · constructor
    · rintro (hzw | ⟨_, hyw⟩ | ⟨_, hxw⟩)
      · exact .inr (p.trans (p.symm hzy) hzw)
      · exact .inr hyw
      · exact .inl hxw
    · rintro (hxw | hyw)
      · exact .inr (.inr ⟨hzy, hxw⟩)
      · exact .inl (p.trans hzy hyw)

private theorem classOf_merge_of_not_rel {p : Partition n} {x y z : Fin n}
    (hzx : p.rel z x = false) (hzy : p.rel z y = false) :
    (p.merge x y).classOf z = p.classOf z := by
  ext w
  simp only [mem_classOf, rel_merge, hzx, hzy, Bool.false_and, Bool.or_false]

private theorem components_merge (p : Partition n) (x y : Fin n) :
    (p.merge x y).components =
      Insert.insert (p.classOf x ∪ p.classOf y)
        ((p.components.erase (p.classOf x)).erase (p.classOf y)) := by
  ext c
  simp only [mem_components, Finset.mem_insert, Finset.mem_erase]
  constructor
  · rintro ⟨z, rfl⟩
    cases hzx : p.rel z x
    · cases hzy : p.rel z y
      · right
        rw [classOf_merge_of_not_rel hzx hzy]
        refine ⟨?_, ?_, z, rfl⟩
        · intro heq
          have h := classOf_eq_iff.mp heq
          rw [hzy] at h
          cases h
        · intro heq
          have h := classOf_eq_iff.mp heq
          rw [hzx] at h
          cases h
      · left
        exact classOf_merge_eq_union (.inr hzy)
    · left
      exact classOf_merge_eq_union (.inl hzx)
  · rintro (rfl | ⟨hcy, hcx, z, rfl⟩)
    · exact ⟨x, classOf_merge_eq_union (.inl (p.refl x))⟩
    · have hzx : p.rel z x = false := by
        cases h : p.rel z x
        · rfl
        · exact absurd (classOf_eq_iff.mpr h) hcx
      have hzy : p.rel z y = false := by
        cases h : p.rel z y
        · rfl
        · exact absurd (classOf_eq_iff.mpr h) hcy
      exact ⟨z, classOf_merge_of_not_rel hzx hzy⟩

/-- Merging two distinct equivalence classes decreases the number of components by exactly `1`. -/
theorem numComponents_merge_of_not_rel {p : Partition n} {x y : Fin n}
    (h : p.rel x y = false) :
    (p.merge x y).numComponents + 1 = p.numComponents := by
  unfold numComponents
  rw [components_merge]
  have hne : p.classOf y ≠ p.classOf x := fun heq => by
    have hyx := classOf_eq_iff.mp heq
    rw [p.symm hyx] at h
    cases h
  have hunion_not_mem : p.classOf x ∪ p.classOf y ∉ p.components := by
    intro hm
    obtain ⟨z, hz⟩ := mem_components.mp hm
    have hzx : p.rel z x = true := by
      have hx : x ∈ p.classOf z := hz ▸ Finset.mem_union_left _ (p.self_mem_classOf x)
      exact mem_classOf.mp hx
    have hzy : p.rel z y = true := by
      have hy : y ∈ p.classOf z := hz ▸ Finset.mem_union_right _ (p.self_mem_classOf y)
      exact mem_classOf.mp hy
    have hxy := p.trans (p.symm hzx) hzy
    rw [h] at hxy
    cases hxy
  have hunion_not_erase :
      p.classOf x ∪ p.classOf y ∉ (p.components.erase (p.classOf x)).erase (p.classOf y) :=
    fun hm => hunion_not_mem (Finset.erase_subset _ _ (Finset.erase_subset _ _ hm))
  rw [Finset.card_insert_of_notMem hunion_not_erase]
  have hy_mem : p.classOf y ∈ p.components.erase (p.classOf x) :=
    Finset.mem_erase.mpr ⟨hne, p.classOf_mem_components y⟩
  have hx_mem : p.classOf x ∈ p.components := p.classOf_mem_components x
  have hcard₁ := Finset.card_erase_add_one hy_mem
  have hcard₂ := Finset.card_erase_add_one hx_mem
  omega

end Partition

/-- Typed operations on a disjoint-set partition over `Fin n`. -/
inductive Op (n : ℕ) where
  /-- Test whether `x` and `y` belong to the same equivalence class. -/
  | same (x y : Fin n)
  /-- Merge the classes of `x` and `y`, returning `true` iff two distinct classes merged. -/
  | union (x y : Fin n)
  /-- Query the current number of equivalence classes. -/
  | numComponents
  deriving DecidableEq, Repr

/-- Total stateful specification of a disjoint-set structure on `Fin n`. -/
abbrev spec (n : ℕ) : Spec where
  State := Partition n
  Op := Op n
  Result
    | .same _ _ => Bool
    | .union _ _ => Bool
    | .numComponents => ℕ
  step p
    | .same x y => (p, p.rel x y)
    | .union x y => (p.merge x y, !p.rel x y)
    | .numComponents => (p, p.numComponents)

/-- Client helper: query whether `x` and `y` are in the same equivalence class. -/
@[expose] def same {n : ℕ} (x y : Fin n) : (spec n).Client Bool :=
  PFunctor.FreeM.lift (P := (spec n).signature) (.same x y)

/-- Client helper: merge the classes of `x` and `y`, returning `true` iff two distinct classes
merged. -/
@[expose] def union {n : ℕ} (x y : Fin n) : (spec n).Client Bool :=
  PFunctor.FreeM.lift (P := (spec n).signature) (.union x y)

/-- Client helper: query the current number of equivalence classes. -/
@[expose] def getNumComponents {n : ℕ} : (spec n).Client ℕ :=
  PFunctor.FreeM.lift (P := (spec n).signature) .numComponents

/-- History-adaptive connection client: query `same x y` first, issuing `union x y` only when `x`
and `y` belong to distinct equivalence classes. Its operation history has length `1` when `x` and
`y` are already connected and `2` when they merge. -/
@[expose] def connectIfNew {n : ℕ} (x y : Fin n) : (spec n).Client Bool := do
  let connected ← same x y
  if connected then
    pure false
  else
    union x y

/-- Exact semantics and state-dependent operation history of `connectIfNew`. -/
theorem runClient_connectIfNew {n : ℕ} (x y : Fin n) (p : Partition n) :
    (spec n).runClient p (connectIfNew x y) =
      if p.rel x y then
        (false, p, [.same x y])
      else
        (true, p.merge x y, [.same x y, .union x y]) := by
  unfold connectIfNew same union
  cases h : p.rel x y
  · simp [Spec.runClient_lift_bind', Spec.runClient_lift, spec, h]
  · simp [Spec.runClient_lift_bind', spec, h]

/-- Single-pass spanning-forest client (the unweighted Kruskal / cycle-filtering loop): scan edges
in order, retaining an edge iff `union` reports that its endpoints lay in distinct components. -/
@[expose] def spanningForestEdges {n : ℕ} :
    List (Fin n × Fin n) → (spec n).Client (List (Fin n × Fin n))
  | [] => pure []
  | e :: es => do
      let merged ← union e.1 e.2
      let rest ← spanningForestEdges es
      pure (if merged then e :: rest else rest)

@[simp]
theorem eval_spanningForestEdges_nil {n : ℕ} (p : Partition n) :
    eval (spec n) (spanningForestEdges []) p = ([], p) := rfl

@[simp]
theorem eval_spanningForestEdges_cons {n : ℕ} (e : Fin n × Fin n) (es : List (Fin n × Fin n))
    (p : Partition n) :
    eval (spec n) (spanningForestEdges (e :: es)) p =
      let rest := eval (spec n) (spanningForestEdges es) (p.merge e.1 e.2)
      (if !p.rel e.1 e.2 then e :: rest.1 else rest.1, rest.2) := by
  simp only [spanningForestEdges, union, eval_lift_bind', spec]
  change eval (spec n)
      ((spanningForestEdges es).bind fun rest =>
        pure (if !p.rel e.1 e.2 then e :: rest else rest))
      (p.merge e.1 e.2) = _
  rw [eval_bind, eval_pure']

/-- Exact operation history issued by `spanningForestEdges es`: one `Op.union` call per input edge
in order. -/
theorem runClient_spanningForestEdges_history {n : ℕ} (es : List (Fin n × Fin n))
    (p : Partition n) :
    ((spec n).runClient p (spanningForestEdges es)).2.2 = es.map fun e => Op.union e.1 e.2 := by
  induction es generalizing p with
  | nil => rfl
  | cons e es ih =>
    simp only [spanningForestEdges, union, Spec.runClient_lift_bind', spec, List.map_cons]
    change Op.union e.1 e.2 ::
        ((spec n).runClient (p.merge e.1 e.2)
          ((spanningForestEdges es).bind fun rest =>
            pure (if !p.rel e.1 e.2 then e :: rest else rest))).2.2 =
      Op.union e.1 e.2 :: List.map (fun e => Op.union e.1 e.2) es
    rw [Spec.runClient_bind]
    simp [ih (p.merge e.1 e.2)]

/-- `spanningForestEdges es` issues `es.length` operations. -/
theorem runClient_spanningForestEdges_length {n : ℕ} (es : List (Fin n × Fin n))
    (p : Partition n) :
    ((spec n).runClient p (spanningForestEdges es)).2.2.length = es.length := by
  rw [runClient_spanningForestEdges_history, List.length_map]

/-- Every retained edge belongs to the input edge list in order. -/
theorem spanningForestEdges_sublist {n : ℕ} (es : List (Fin n × Fin n)) (p : Partition n) :
    (eval (spec n) (spanningForestEdges es) p).1.Sublist es := by
  induction es generalizing p with
  | nil => simp
  | cons e es ih =>
    rw [eval_spanningForestEdges_cons]
    dsimp only
    split
    · exact List.Sublist.cons_cons e (ih (p.merge e.1 e.2))
    · exact List.Sublist.cons e (ih (p.merge e.1 e.2))

/-- Exact conservation law: the final component count plus the number of accepted forest edges
equals the initial component count. -/
theorem spanningForestEdges_numComponents_add_length {n : ℕ} (es : List (Fin n × Fin n))
    (p : Partition n) :
    (eval (spec n) (spanningForestEdges es) p).2.numComponents +
      (eval (spec n) (spanningForestEdges es) p).1.length = p.numComponents := by
  induction es generalizing p with
  | nil => simp
  | cons e es ih =>
    rw [eval_spanningForestEdges_cons]
    dsimp only
    have hrec := ih (p.merge e.1 e.2)
    cases hrel : p.rel e.1 e.2
    · simp only [Bool.not_false, ↓reduceIte, List.length_cons]
      have hmerge := Partition.numComponents_merge_of_not_rel hrel
      omega
    · simp only [Bool.not_true, Bool.false_eq_true, ↓reduceIte]
      have hmerge := Partition.numComponents_merge_of_rel hrel
      omega

/-- The final partition after `spanningForestEdges es` is the exact equivalence closure of `p`
together with all edges in `es`. -/
theorem spanningForestEdges_rel_iff_eqvGen {n : ℕ} (es : List (Fin n × Fin n))
    (p : Partition n) (a b : Fin n) :
    (eval (spec n) (spanningForestEdges es) p).2.rel a b = true ↔
      Relation.EqvGen (fun u v => p.rel u v = true ∨ (u, v) ∈ es) a b := by
  induction es generalizing p with
  | nil =>
    simp only [eval_spanningForestEdges_nil, List.not_mem_nil, or_false]
    constructor
    · exact fun h => .rel _ _ h
    · intro h
      induction h with
      | rel _ _ huv => exact huv
      | refl u => exact p.refl u
      | symm _ _ _ ih => exact p.symm ih
      | trans _ _ _ _ _ ih₁ ih₂ => exact p.trans ih₁ ih₂
  | cons e es ih =>
    rw [eval_spanningForestEdges_cons, ih (p.merge e.1 e.2)]
    clear ih
    constructor
    · intro h
      induction h with
      | rel u v huv =>
        rcases huv with huv | huv
        · exact (Partition.rel_merge_iff_eqvGen.mp huv).mono fun w z hwz =>
            hwz.elim .inl fun ⟨hw, hz⟩ => .inr (List.mem_cons.mpr (.inl (Prod.ext hw hz)))
        · exact .rel _ _ (.inr (List.mem_cons_of_mem e huv))
      | refl u => exact .refl u
      | symm _ _ _ ih' => exact .symm _ _ ih'
      | trans _ _ _ _ _ ih₁ ih₂ => exact .trans _ _ _ ih₁ ih₂
    · intro h
      induction h with
      | rel u v huv =>
        rcases huv with huv | huv
        · exact .rel _ _ (.inl (Partition.rel_merge_eq_true.mpr (.inl huv)))
        · rcases List.mem_cons.mp huv with rfl | hmem
          · exact .rel _ _ (.inl (Partition.rel_merge_eq_true.mpr
              (.inr (.inl ⟨p.refl u, p.refl v⟩))))
          · exact .rel _ _ (.inr hmem)
      | refl u => exact .refl u
      | symm _ _ _ ih' => exact .symm _ _ ih'
      | trans _ _ _ _ _ ih₁ ih₂ => exact .trans _ _ _ ih₁ ih₂

/-- Discarding cycle edges preserves connectivity: running `spanningForestEdges` on the retained
forest edges reaches the exact same partition as running it on `es`. -/
theorem spanningForestEdges_idempotent_partition {n : ℕ} (es : List (Fin n × Fin n))
    (p : Partition n) :
    (eval (spec n) (spanningForestEdges (eval (spec n) (spanningForestEdges es) p).1) p).2 =
      (eval (spec n) (spanningForestEdges es) p).2 := by
  induction es generalizing p with
  | nil => rfl
  | cons e es ih =>
    rw [eval_spanningForestEdges_cons]
    dsimp only
    cases hrel : p.rel e.1 e.2
    · simp only [Bool.not_false, ↓reduceIte, eval_spanningForestEdges_cons]
      exact ih (p.merge e.1 e.2)
    · simp only [Bool.not_true, Bool.false_eq_true, ↓reduceIte]
      rw [Partition.merge_of_rel hrel]
      exact ih p

end Cslib.Algorithms.Lean.DisjointSet
