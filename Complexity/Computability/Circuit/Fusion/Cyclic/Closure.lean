module
-- upstream: candidate

public import Complexity.Computability.Circuit.Fusion.Semifilter

/-!
# Closure generated by semifilter pairs

At a reference point, force the full target complement and the restricted inputs containing
that point, close upward, and apply the intersection rule of each listed pair. These are exactly
the facts forced in every semifilter above the point that preserves the pairs. If the empty set
is not derivable, the derivable sets themselves form such a semifilter.

For a cover of all semifilters, the empty set is derivable exactly at the target points. The
generated closure, viewed as a monotone map from complement subsets to ambient subsets, therefore
recovers the target at the empty set. This is the semantic closure argument for the converse to
the cyclic lower bound; no finite circuit compiler or execution bound is supplied here.
The carrier may be infinite, inputs need not cover it, and the pair list may be empty.
Restriction to an arbitrary admissible class of semifilters does not supply the converse.

## Main definitions

* `Cslib.Circuits.Fusion.PairDerivation`: the four closure rules at a reference point.
* `Cslib.Circuits.Fusion.pairClosure`: the generated state as an order homomorphism.

## Main results

* `Cslib.Circuits.Fusion.PairDerivation.le`: leastness among predicates closed under the rules.
* `Cslib.Circuits.Fusion.PairCover.derives_empty_iff`: derivability characterizes the target.
* `Cslib.Circuits.Fusion.PairCover.ofDerivesEmpty`: recover a cover from target-point derivations.
* `Cslib.Circuits.Fusion.PairCover.pairClosure_empty`: the generated empty-index state is
  the target.

## References

* Adapted from LowerBound/Fusion/Cyclic/Closure.lean in
  [S. Schlesinger, *Algebraic circuit formalizations in Complexitylib*][Schlesinger2026Algebraic].
-/

@[expose] public section

namespace Cslib.Circuits.Fusion

universe u

variable {U : Type u} {n : ℕ}

/-- Sets forced by the inputs true at a point, upward closure, and the listed intersection rules. -/
inductive PairDerivation (target : Set U) (input : Fin n → Set U)
    (pairs : List (Set ↥(targetᶜ) × Set ↥(targetᶜ))) (point : U) : Set ↥(targetᶜ) → Prop
  /-- Every semifilter accepts the full set. -/
  | univ : PairDerivation target input pairs point Set.univ
  /-- A true input forces its restriction to the complement. -/
  | input (i : Fin n) (h : point ∈ input i) :
      PairDerivation target input pairs point (Subtype.val ⁻¹' input i)
  /-- Accepted sets propagate upward. -/
  | mono {s t : Set ↥(targetᶜ)} (h : PairDerivation target input pairs point s) (hst : s ⊆ t) :
      PairDerivation target input pairs point t
  /-- A listed pair forces the intersection of its accepted arguments. -/
  | inter (p : Set ↥(targetᶜ) × Set ↥(targetᶜ)) (hp : p ∈ pairs)
      (hleft : PairDerivation target input pairs point p.1)
      (hright : PairDerivation target input pairs point p.2) :
      PairDerivation target input pairs point (p.1 ∩ p.2)

variable {target : Set U} {input : Fin n → Set U}
  {pairs : List (Set ↥(targetᶜ) × Set ↥(targetᶜ))} {point : U} {s : Set ↥(targetᶜ)}

/-- The derivable sets form the least predicate closed under the four rules. -/
theorem PairDerivation.le {P : Set ↥(targetᶜ) → Prop} (huniv : P Set.univ)
    (hinput : ∀ i, point ∈ input i → P (Subtype.val ⁻¹' input i)) (hmono : Monotone P)
    (hpairs : ∀ p ∈ pairs, P p.1 → P p.2 → P (p.1 ∩ p.2)) :
    PairDerivation target input pairs point ≤ P := by
  intro s hs
  induction hs with
  | univ => exact huniv
  | input i h => exact hinput i h
  | mono _ h ih => exact hmono h ih
  | inter p hp _ _ ihleft ihright => exact hpairs p hp ihleft ihright

/-- A closure that avoids the empty set is a semifilter preserving every listed pair. -/
def PairDerivation.semifilter (h : ¬ PairDerivation target input pairs point ∅) :
    Semifilter ↥(targetᶜ) where
  toFun := PairDerivation target input pairs point
  monotone' _ _ hst hs := hs.mono hst
  map_top' := propext ⟨fun _ => trivial, fun _ => .univ⟩
  map_bot' := propext ⟨h, False.elim⟩

/-- The canonical semifilter accepts precisely the derivable sets. -/
@[simp] theorem PairDerivation.apply_semifilter
    (h : ¬ PairDerivation target input pairs point ∅) (s : Set ↥(targetᶜ)) :
    PairDerivation.semifilter h s ↔ PairDerivation target input pairs point s := Iff.rfl

/-- An outside point belongs to every set derivable at its ambient value. -/
theorem PairDerivation.mem_of_outside (x : ↥(targetᶜ))
    (h : PairDerivation target input pairs x.val s) : x ∈ s :=
  PairDerivation.le (P := fun s => x ∈ s) (Set.mem_univ x) (fun _ hx => hx)
    (fun _ _ hst hx => hst hx) (fun _ _ hx hy => ⟨hx, hy⟩) s h

/-- An unrestricted cover forces the empty set at each target point. -/
private theorem PairCover.derives_empty (c : PairCover target input) (hpoint : point ∈ target) :
    PairDerivation target input c.pairs point ∅ := by
  by_contra h
  apply c.isCover ⟨⟨point, hpoint⟩, PairDerivation.semifilter h, trivial, .input⟩
  exact fun p hp hx hy => .inter p hp hx hy

/-- Deriving the empty set characterizes the target for covers of all semifilters. -/
theorem PairCover.derives_empty_iff (c : PairCover target input) (point : U) :
    PairDerivation target input c.pairs point ∅ ↔ point ∈ target := by
  refine ⟨fun h => ?_, c.derives_empty⟩
  by_contra hx
  exact h.mem_of_outside ⟨point, hx⟩

/-- Target-point derivations suffice to defeat every semifilter witness. -/
def PairCover.ofDerivesEmpty (pairs : List (Set ↥(targetᶜ) × Set ↥(targetᶜ)))
    (h : ∀ point ∈ target, PairDerivation target input pairs point ∅) :
    PairCover target input where
  pairs := pairs
  isCover w hp := w.filter.not_apply_empty
    (PairDerivation.le w.filter.apply_univ w.above w.filter.monotone hp ∅
      (h w.point.val w.point.property))

/-- Constructing a cover from derivations leaves the pair list unchanged. -/
@[simp] theorem PairCover.pairs_ofDerivesEmpty
    (pairs : List (Set ↥(targetᶜ) × Set ↥(targetᶜ)))
    (h : ∀ point ∈ target, PairDerivation target input pairs point ∅) :
    (PairCover.ofDerivesEmpty pairs h).pairs = pairs := rfl

/-- The points deriving each complement subset, ordered monotonically by that subset. -/
def pairClosure (target : Set U) (input : Fin n → Set U)
    (pairs : List (Set ↥(targetᶜ) × Set ↥(targetᶜ))) : Set ↥(targetᶜ) →o Set U where
  toFun s := {point | PairDerivation target input pairs point s}
  monotone' _ _ h _ hs := hs.mono h

/-- The generated state lies below every monotone state containing the seeds and pair rules. -/
theorem pairClosure_le (state : Set ↥(targetᶜ) →o Set U) (huniv : Set.univ ⊆ state Set.univ)
    (hinput : ∀ i, input i ⊆ state (Subtype.val ⁻¹' input i))
    (hpairs : ∀ p ∈ pairs, state p.1 ∩ state p.2 ⊆ state (p.1 ∩ p.2)) :
    pairClosure target input pairs ≤ state :=
  fun s point h => PairDerivation.le (P := fun s => point ∈ state s)
    (huniv (Set.mem_univ point)) (fun i hx => hinput i hx)
    (fun _ _ hst hx => state.monotone hst hx) (fun p hp hx hy => hpairs p hp ⟨hx, hy⟩) s h

/-- The empty-index state of an unrestricted cover is exactly its target. -/
@[simp] theorem PairCover.pairClosure_empty (c : PairCover target input) :
    pairClosure target input c.pairs ∅ = target :=
  Set.ext c.derives_empty_iff

end Cslib.Circuits.Fusion
