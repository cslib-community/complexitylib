/-!
# Cyclotomic fields and a common evaluation grid

The rational cyclotomic field `ℚ[X] / (X ^ (2 ^ e) + 1)` of `2 ^ (e + 1)`-th roots of unity,
with its power basis, its primitive additive character on `ZMod (2 ^ (e + 1))` and its regular
representation by `2 ^ e × 2 ^ e` rational matrices. Over any field, a Schwartz–Zippel argument
shows that one fixed grid `S ^ k` simultaneously avoids the zeros of a whole list of nonzero
polynomials of bounded total degree, provided `S` is large enough.

## Main definitions

* `Rational.CyclotomicRing.degree`, `Rational.CyclotomicRing.dimension`,
  `Rational.CyclotomicRing.modulus`: the degree `2 ^ e`, the root order `2 ^ (e + 1)`, and the
  cyclotomic polynomial `X ^ (2 ^ e) + 1`.
* `Rational.CyclotomicRing.R`: the cyclotomic quotient `AdjoinRoot (X ^ (2 ^ e) + 1)` over `ℚ`.
* `Rational.CyclotomicRing.powerBasis`, `Rational.CyclotomicRing.basis`: its power basis and the
  version indexed by `Fin (2 ^ e)`.
* `Rational.CyclotomicRing.intoComplex`: an embedding of the quotient into `ℂ`.
* `Rational.CyclotomicRing.character`: the additive character of the adjoined root.
* `Rational.CyclotomicRing.rho`: the regular representation by rational matrices.

## Main results

* `Rational.CyclotomicRing.root_primitive`: the adjoined root is a primitive root of unity of
  order `2 ^ (e + 1)`.
* `Rational.FiniteGrid.det_totalDegree_le`: total degree of a polynomial determinant.
* `Rational.FiniteGrid.simultaneous`: a grid avoiding all zeros of a list of polynomials.

## References

* Adapted from OpenAI's formalization [OpenAI2026RationalHitting] at revision
  adc7f1241b42e322a6451854ab7e4b4c146bf78a (file
  lean/OAI/Computability/RationalHitting/CyclotomicGrid.lean), via the complexitylib port
  [Schlesinger2026RationalHitting] at revision add0aca8ee0d71e68969f2cb45cf91554a50f787.
-/

@[expose] public section

namespace Cslib.Circuits

namespace Rational.CyclotomicRing
open Polynomial Matrix Module

/-- Degree of the chosen cyclotomic modulus. -/
def degree (e : ℕ) : ℕ := 2 ^ e

/-- Order of the chosen root of unity. -/
def dimension (e : ℕ) : ℕ := 2 ^ (e + 1)

/-- The cyclotomic degree `2 ^ e` is positive. -/
lemma degree_pos (e : ℕ) : 0 < degree e := by unfold degree; positivity

/-- The root order `2 ^ (e + 1)` is positive. -/
lemma dimension_pos (e : ℕ) : 0 < dimension e := by unfold dimension; positivity

/-- The order of the root of unity is nonzero. -/
instance dimension_neZero (e : ℕ) : NeZero (dimension e) := ⟨(dimension_pos e).ne'⟩

noncomputable section

/-- The cyclotomic modulus for roots of unity of power-of-two order. -/
def modulus (e : ℕ) : ℚ[X] := X ^ (2 ^ e) + 1

private lemma modulus_eq_cyclotomic (e : ℕ) : modulus e = cyclotomic (dimension e) ℚ := by
  rw [dimension, cyclotomic_prime_pow_eq_geom_sum Nat.prime_two]
  simp [modulus, Finset.sum_range_succ, add_comm]

/-- The modulus `X ^ (2 ^ e) + 1` is the `2 ^ (e + 1)`-th cyclotomic polynomial, hence
irreducible over `ℚ`. -/
instance modulus_irreducible (e : ℕ) : Fact (Irreducible (modulus e)) :=
  ⟨by
    rw [modulus_eq_cyclotomic]
    exact cyclotomic.irreducible_rat (by unfold dimension; positivity)⟩

/-- The rational cyclotomic quotient used for the matrix construction. -/
abbrev R (e : ℕ) := AdjoinRoot (modulus e)

/-- The cyclotomic modulus `X ^ (2 ^ e) + 1` is monic. -/
lemma modulus_monic (e : ℕ) : (modulus e).Monic := by
  simpa [modulus] using monic_X_pow_add_C (1 : ℚ) (pow_ne_zero e (by norm_num : (2 : ℕ) ≠ 0))

/-- The degree of the cyclotomic modulus is `degree e`. -/
lemma modulus_natDegree (e : ℕ) : (modulus e).natDegree = degree e := by
  simp [modulus, degree]

/-- The quotient's power basis generated by the adjoined root. -/
def powerBasis (e : ℕ) : PowerBasis ℚ (R e) := AdjoinRoot.powerBasis' (modulus_monic e)

/-- Reindex the power basis by the explicit cyclotomic degree. -/
def basis (e : ℕ) : Basis (Fin (degree e)) ℚ (R e) :=
  (powerBasis e).basis.reindex (finCongr (modulus_natDegree e))

/-- The `i`-th basis element of `R e` is the `i`-th power of the adjoined root. -/
lemma basis_apply (e : ℕ) (i : Fin (degree e)) :
    basis e i = AdjoinRoot.root (modulus e) ^ i.val := by
  rw [basis, Basis.reindex_apply]
  exact (powerBasis e).basis_eq_pow _

/-- The cyclotomic quotient contains `ℚ`, so it has characteristic zero. -/
instance charZero (e : ℕ) : CharZero (R e) := algebraRat.charZero (R e)

/-- The cyclotomic quotient is finite-dimensional over `ℚ`. -/
instance finite (e : ℕ) : Module.Finite ℚ (R e) :=
  (modulus_monic e).finite_adjoinRoot

/-- An embedding of the cyclotomic quotient into the complex numbers. -/
def intoComplex (e : ℕ) : R e →ₐ[ℚ] ℂ := IsAlgClosed.lift

/-- The adjoined root is a primitive root of unity of order `2 ^ (e + 1)`. Since the modulus
is irreducible, the quotient is a field, so invertibility in the regular representation can be
tested at this single primitive root. -/
lemma root_primitive (e : ℕ) : IsPrimitiveRoot (AdjoinRoot.root (modulus e)) (dimension e) := by
  apply (Polynomial.isRoot_cyclotomic_iff).mp
  have hh := AdjoinRoot.isRoot_root (modulus e)
  rw [← Polynomial.map_cyclotomic (dimension e) (algebraMap ℚ (R e)),
    ← modulus_eq_cyclotomic e]
  exact hh

/-- The additive character generated by the primitive cyclotomic root. -/
def character (e : ℕ) : AddChar (ZMod (dimension e)) (R e) :=
  AddChar.zmodChar (dimension e) (root_primitive e).pow_eq_one

/-- The additive character generated by the adjoined root is primitive. -/
lemma character_primitive (e : ℕ) : (character e).IsPrimitive :=
  AddChar.zmodChar_primitive_of_primitive_root _ (root_primitive e)

/-- The regular rational matrix representation of the cyclotomic field. -/
def rho (e : ℕ) : R e →ₐ[ℚ] Matrix (Fin (degree e)) (Fin (degree e)) ℚ :=
  Algebra.leftMulMatrix (basis e)

end
end Rational.CyclotomicRing

namespace Rational.FiniteGrid
open MvPolynomial Matrix
open scoped BigOperators
noncomputable section

variable {K : Type*} [Field K] {k : ℕ}

/-- The fixed grid, independent of the coefficients, finds a nonzero value. -/
theorem exists_eval_ne_zero (p : MvPolynomial (Fin k) K) (hp : p ≠ 0)
    (S : Finset K) (hS : p.totalDegree < S.card) :
    ∃ x : Fin k → K, (∀ i, x i ∈ S) ∧ eval x p ≠ 0 := by
  classical
  by_contra! hz
  have hh := schwartz_zippel_totalDegree hp S
  have he : (Fintype.piFinset (fun _ : Fin k => S)).filter (fun x => eval x p = 0) =
      Fintype.piFinset (fun _ : Fin k => S) := by
    apply Finset.filter_eq_self.mpr
    intro x hx
    exact hz x (Fintype.mem_piFinset.mp hx)
  rw [he] at hh
  have hpos : 0 < S.card := lt_of_le_of_lt (Nat.zero_le _) hS
  have hpos' : (0 : ℚ≥0) < S.card := by exact_mod_cast hpos
  have hpow : (S.card : ℚ≥0) ^ k ≠ 0 := pow_ne_zero _ (ne_of_gt hpos')
  have hcard : (Fintype.piFinset (fun _ : Fin k => S)).card = S.card ^ k := by simp
  rw [hcard, Nat.cast_pow, div_self hpow] at hh
  have hlt : (p.totalDegree : ℚ≥0) / S.card < 1 :=
    (div_lt_one hpos').mpr (by exact_mod_cast hS)
  exact (not_lt_of_ge hh) hlt

/-- A determinant of polynomials of total degree at most `d` has total degree at most
`|ι| * d`. -/
lemma det_totalDegree_le {ι : Type*} [Fintype ι] [DecidableEq ι]
    (A : Matrix ι ι (MvPolynomial (Fin k) K)) (d : ℕ)
    (hA : ∀ i j, (A i j).totalDegree ≤ d) :
    A.det.totalDegree ≤ Fintype.card ι * d := by
  rw [Matrix.det_apply]
  apply totalDegree_finsetSum_le
  intro σ _
  apply (totalDegree_smul_le _ _).trans
  apply (totalDegree_finsetProd _ _).trans
  calc
    ∑ i : ι, (A (σ i) i).totalDegree ≤ ∑ _i : ι, d := Finset.sum_le_sum (fun i _ => hA _ _)
    _ = Fintype.card ι * d := by simp

/-- The common grid specializes a list of determinant conditions
simultaneously, rather than one formula gate at a time. -/
theorem simultaneous (P : List (MvPolynomial (Fin k) K))
    (hP : ∀ p ∈ P, p ≠ 0) (d : ℕ) (hd : ∀ p ∈ P, p.totalDegree ≤ d)
    (S : Finset K) (hS : P.length * d < S.card) :
    ∃ x : Fin k → K, (∀ i, x i ∈ S) ∧ ∀ p ∈ P, eval x p ≠ 0 := by
  have hprod : P.prod ≠ 0 := List.prod_ne_zero (by intro hz; exact hP 0 hz rfl)
  have hdeg : P.prod.totalDegree ≤ P.length * d := by
    refine (totalDegree_list_prod P).trans ?_
    simpa using List.sum_le_length_nsmul (P.map totalDegree) d (by simpa using hd)
  obtain ⟨x, hx, hxp⟩ := exists_eval_ne_zero P.prod hprod S (hdeg.trans_lt hS)
  refine ⟨x, hx, ?_⟩
  intro p hp hz
  apply hxp
  change eval₂Hom (RingHom.id K) x P.prod = 0
  rw [map_list_prod]
  apply List.prod_eq_zero
  exact List.mem_map.mpr ⟨p, hp, hz⟩

end
end Rational.FiniteGrid

end Cslib.Circuits
