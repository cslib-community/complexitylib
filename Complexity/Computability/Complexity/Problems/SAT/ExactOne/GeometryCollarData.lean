/-!
# Finite collars for every ordered three-port assignment

An inner square of side 180000 is centered inside a square of side 540000. Three disjoint
orthogonal routes connect the inner north/west/east accesses to any three distinct outer side
midpoints. A reflection of the inner layout selects the appropriate cyclic orientation.
The tables use only multiples of 10000 and have at most seven segments per route.

## Main definitions

* `PortAssignment`: three ordered sides, using left/right/bottom/top as 0/1/2/3.
* `collarReflected`, `collarRoutes`: the finite orientation and connector tables.
* `collarOuterPort`, `collarInnerPort`: prescribed exterior and interior endpoints.

## References

These finite annular routing tables are original.
-/

@[expose] public section

namespace Cslib.Complexity.SAT.ExactOne

open Orthogonal

/-- Three ordered outer sides; the geometry certificate assumes they are distinct. -/
abbrev PortAssignment := Fin 4 × Fin 4 × Fin 4

/-- The three designated sides are distinct. -/
def PortAssignment.Distinct (s : PortAssignment) : Prop :=
  s.1 ≠ s.2.1 ∧ s.1 ≠ s.2.2 ∧ s.2.1 ≠ s.2.2

instance (s : PortAssignment) : Decidable s.Distinct :=
  inferInstanceAs (Decidable (_ ∧ _))

/-- Side assigned to an indexed terminal. -/
def PortAssignment.side (s : PortAssignment) (i : Fin 3) : Fin 4 :=
  if i = 0 then s.1 else if i = 1 then s.2.1 else s.2.2

/-- All 24 ordered injections into the four outer sides. -/
def collarAssignments : List PortAssignment :=
  [(0, 1, 2), (0, 1, 3), (0, 2, 1), (0, 2, 3), (0, 3, 1), (0, 3, 2),
    (1, 0, 2), (1, 0, 3), (1, 2, 0), (1, 2, 3), (1, 3, 0), (1, 3, 2),
    (2, 0, 1), (2, 0, 3), (2, 1, 0), (2, 1, 3), (2, 3, 0), (2, 3, 1),
    (3, 0, 1), (3, 0, 2), (3, 1, 0), (3, 1, 2), (3, 2, 0), (3, 2, 1)]

/-- Finite reflection choices, in `collarAssignments` order. -/
def collarReflections : List Bool :=
  [false, true, true, true, false, false, true, false, false, false, true, true,
    false, false, true, true, true, false, true, true, false, false, false, true]

