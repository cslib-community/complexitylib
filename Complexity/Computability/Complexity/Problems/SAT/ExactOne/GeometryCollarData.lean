/-- The reflection required for the selected ordered assignment. -/
def collarReflected (s : PortAssignment) : Bool :=
  collarReflections.getD (collarAssignments.idxOf s) false

/-- Three outer-to-inner collar routes. Invalid repeated-side assignments use an empty default.
-/
def collarRoutes (s : PortAssignment) : List Route :=
  collarRouteTable.getD (collarAssignments.idxOf s) []

/-- Exterior midpoint in left/right/bottom/top order. -/
def collarOuterPort (s : Fin 4) : Point :=
  if s = 0 then (0, 270000) else if s = 1 then (540000, 270000)
    else if s = 2 then (270000, 0) else (270000, 540000)

/-- The translated inner port, including the selected horizontal reflection. -/
def collarInnerPort (reflected : Bool) (i : Fin 3) : Point :=
  if i = 0 then (270000, 180000)
  else if (i = 1) != reflected then (180000, 270000) else (360000, 270000)

