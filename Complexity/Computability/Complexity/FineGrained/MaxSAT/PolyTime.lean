import Complexity.Computability.Machines.Turing.MultiTape.Complexity.PolyTime.Plain

/-!
# Native exact MAX-SAT threshold counting

The full threshold circuit is generated by native polynomial-time operations on its complete
encoding. Tensor contraction then counts its accepted assignments in
`2 ^ O((N+1)/sqrt(log(N+2)))` times a polynomial in the input encoding length, using polynomial
space, where `N` is literal occurrences plus clauses. The theorem is uniform over all clause
widths and cutoffs. In particular, sparse fixed-width instances have the stated rate in their
number of variables.

The runtime certificate includes clause generation, the linear-size population counter,
binary comparison, circuit serialization, and the count-preserving frontier compilation.
-/

public section

namespace Cslib.Complexity.MaxSAT

open Cslib.Logic.PL Cslib.Circuits Cslib.Circuits.Boolean Cslib.Circuits.Frontier
  Turing.MultiTapeTM ComputableInPolyTime

private abbrev literalEncoding := encPair encNat encBool
private abbrev clauseEncoding := encList literalEncoding

private def literalCode (n : ℕ) (l : Literal ℕ) : List (Op × List ℕ) × List ℕ :=
  if l.1 < n then
    if l.2 then ([], [l.1]) else ([(.not, [l.1])], [n])
  else ([(.const (!l.2), [])], [n])

private theorem literalCode_eq (n : ℕ) (l : Literal ℕ) :
    literalCode n l = (literalCircuit n l).code := by
  unfold literalCode literalCircuit
  split_ifs <;> rfl

private theorem literalCode_polyTime {α : Type} {enc : α ↪ List Bool}
    {n : α → ℕ} {l : α → Literal ℕ} (hn : ComputableInPolyTime n enc encNat)
    (hl : ComputableInPolyTime l enc literalEncoding) :
    ComputableInPolyTime (fun a => literalCode (n a) (l a)) enc encCode := by
  have hv := hl.fst'
  have hs := hl.snd'
  have hop : ComputableInPolyTime (fun b : Bool => Op.const (!b)) encBool encOp :=
    .of_tidy (ComputableTidilyInPolyTime.of_finite _)
  have htag := hop.comp hs
  unfold literalCode
  fun_prop

private def clauseCode (n : ℕ) (c : Clause ℕ) : List (Op × List ℕ) × List ℕ :=
  balancedCode n clauseJoin.code ([(.const false, [])], [n]) (c.map (literalCode n))

private theorem clauseCode_eq (n : ℕ) (c : Clause ℕ) :
    clauseCode n c = (clauseCircuit n c).code := by
  have he : c.map (literalCode n) = (c.map (literalCircuit n)).map Circuit.code := by
    simp only [List.map_map, Function.comp_def]
    exact List.map_congr_left (fun l _ => literalCode_eq n l)
  rw [clauseCode, he]
  exact balancedCode_eq_code clauseJoin (Circuit.oneGate (.const false) Fin.elim0)
    (c.map (literalCircuit n))

private theorem clauseCode_polyTime :
    ComputableInPolyTime (fun p : ℕ × Clause ℕ => clauseCode p.1 p.2)
      (encPair encUnary clauseEncoding) encCode := by
  have hn := unary_to_binary.comp (fst encUnary clauseEncoding)
  have hl := literalCode_polyTime
    (hn.comp (fst (encPair encUnary clauseEncoding) literalEncoding))
    (snd (encPair encUnary clauseEncoding) literalEncoding)
  have hs := mapWithInput (f := fun p l => literalCode p.1 l)
    (snd encUnary clauseEncoding) hl
  have hz : ComputableInPolyTime
      (fun p : ℕ × Clause ℕ => ([(Op.const false, [])], [p.1]))
      (encPair encUnary clauseEncoding) encCode := by fun_prop
  exact computableInPolyTime_balancedCode hn (const clauseJoin.code) hz hs

private theorem scoreCircuit_code (F : Instance) :
    (scoreCircuit F).code = appendCodes F.1 (F.2.map (clauseCode F.1)) := by
  rw [scoreCircuit, ← appendCodes_code]
  congr 1
  apply List.ext_getElem (by simp)
  intro i hi hj
  simp [clauseCode_eq]

/-- The complete code of the clause-value circuit is generated in native polynomial time. -/
theorem computableInPolyTime_scoreCircuit :
    ComputableInPolyTime (fun F => (scoreCircuit F).code) encInstance encCode := by
  have hn : ComputableInPolyTime (fun F : Instance => F.1) encInstance encUnary :=
    fst encUnary encCNF
  have hc : ComputableInPolyTime (fun F : Instance => F.2) encInstance encCNF :=
    snd encUnary encCNF
  have hb : ComputableInPolyTime
      (fun p : Instance × Clause ℕ => clauseCode p.1.1 p.2)
      (encPair encInstance clauseEncoding) encCode :=
    clauseCode_polyTime.comp
      ((hn.comp (fst encInstance clauseEncoding)).prod (snd encInstance clauseEncoding))
  have h := computableInPolyTime_appendCodes (unary_to_binary.comp hn)
    (mapWithInput (f := fun F c => clauseCode F.1 c) hc hb)
  simpa only [scoreCircuit_code, Function.comp_def] using h

/-- Native compilation of a threshold query to the complete typed circuit encoding. -/
theorem computableInPolyTime_thresholdCircuit :
    ComputableInPolyTime
      (fun ((numVars, clauses), cutoff) =>
        (⟨numVars, thresholdCircuit (numVars, clauses) cutoff⟩ : Σ n, Circuit signature n 1))
      encQuery (Boolean.encCircuit 1) := by
  have hF : ComputableInPolyTime (fun p : Query => p.1) encQuery encInstance :=
    fst encInstance encUnary
  have hn := hF.fst'
  have hm := (length_list clauseEncoding).comp hF.snd'
  have hq : ComputableInPolyTime (fun p : Query => p.2) encQuery encUnary :=
    snd encInstance encUnary
  have hcode := computableInPolyTime_compCode (unary_to_binary.comp hn)
    (computableInPolyTime_linearThresholdCircuit.comp (hm.prod hq))
    (computableInPolyTime_scoreCircuit.comp hF)
  have h := hn.prod hcode
  apply h.of_enc_eq
  intro p
  rw [Boolean.encCircuit_apply]
  congr 1
  simp only [Function.comp_apply, compCode_code, thresholdCircuit]

private def compiledFormula (p : Query) : CNF ℕ :=
  Compiler.toCNF (thresholdCircuit p.1 p.2) interpretation (fun _ b => b)

private def countShift (p : Query) : ℕ :=
  Compiler.freeShift (thresholdCircuit p.1 p.2) interpretation (fun _ b => b)

private theorem compiledFormula_polyTime :
    ComputableInPolyTime compiledFormula encQuery encCNF :=
  (CircuitCounting.computableInPolyTime_toCNF (σ := Boolean.signature) Boolean.encOp interpretation
    (fun (_ : Fin 1) b => b)).comp computableInPolyTime_thresholdCircuit

private theorem countShift_polyTime :
    ComputableInPolyTime countShift encQuery encUnary := by
  have h := (CircuitCounting.computableInPolyTime_freeShift (σ := Boolean.signature)
    Boolean.encOp interpretation (fun (_ : Fin 1) b => b)).comp
      computableInPolyTime_thresholdCircuit
  apply h.of_enc_eq
  intro p
  rfl

private theorem thresholdCircuit_fanIn (p : Query) :
    (thresholdCircuit p.1 p.2).FanInAtMost 2 :=
  Circuit.fanInAtMost_of_arity_le Boolean.arity_le_two _

private theorem compiledFormula_width (p : Query) (cl : Clause ℕ)
    (hcl : cl ∈ compiledFormula p) : cl.length ≤ 3 :=
  Compiler.length_le_of_mem_toCNF interpretation (fun _ b => b)
    (thresholdCircuit_fanIn p) hcl

private theorem compiledFormula_density (p : Query) :
    (compiledFormula p).length ≤ 8 * ((compiledFormula p).numVars + 1) :=
  Compiler.length_toCNF_le_numVars interpretation (fun _ b => b) (thresholdCircuit_fanIn p)

private theorem compiledFormula_vars (p : Query) :
    (compiledFormula p).numVars ≤ 957 * workSize p.1 + 957 := by
  apply (Compiler.numVars_toCNF_le interpretation (fun _ b => b)
    (thresholdCircuit_fanIn p)).trans
  have hs := size_thresholdCircuit_le p.1 p.2
  omega

/-- One native machine computes the exact threshold count in the contraction rate, with an
explicit structural parameter and polynomial space. Its constants are independent of clause
width, density, cutoff, and declared unused variables. -/
theorem exists_thresholdCounter :
    ∃ (count : Query → ℕ) (A e b : ℕ),
      (∀ p, count p = thresholdCount p.1 p.2) ∧
      ComputableInO count encQuery encNat
        (fun p => 2 ^ (A * (workSize p.1 + 1) / Nat.sqrt (Nat.log 2 (workSize p.1 + 2))) *
          ((encQuery p).length + 1) ^ e)
        (fun p => ((encQuery p).length + 1) ^ b) := by
  obtain ⟨count, A, e, b, hspec, hinO⟩ :=
    ContractionCounting.exists_shiftedCounter_of_polyTime_toCNF 3 8 957
      compiledFormula_polyTime countShift_polyTime (fun p => workSize p.1)
      compiledFormula_width compiledFormula_density compiledFormula_vars
  refine ⟨count, A, e, b, fun p => ?_, hinO⟩
  rw [hspec]
  change 2 ^ Compiler.freeShift (thresholdCircuit p.1 p.2) interpretation (fun _ b => b) *
    (Compiler.toCNF (thresholdCircuit p.1 p.2) interpretation (fun _ b => b)).modelCount = _
  rw [← Compiler.acceptCount_eq_two_pow_freeShift_mul_modelCount,
    ← Circuit.satCount_eq_acceptCount, satCount_thresholdCircuit]

end Cslib.Complexity.MaxSAT
