/-!
# Restarted bounded class batches without per-pair dictionary/buffer state

The retained dictionary is supplied only to a completed batch matcher. Each batch
regenerates projected quarters and emits a bounded row-aligned window, evaluating
only its selected full-state records. Pair callbacks carry original operands and
scalar ranks, never the dictionary or a growing buffer. Capacity includes quarter
volume, so actual repeated quarter/retained input volume is amortized over batches.
The fixed uniform machine includes output, callback and control temporaries; sharp
global bit-resource normalization remains separate from the derived record charges.
This is an original implementation refinement of [WangLvShenZhang2027],
Lemma 8/Theorem 7, PDF pp. 21–22, under the
deterministic multitape bit convention on p. 6.

## Main definitions

* `quarterVolume`, `capacity`, `batchCount`, `labels`: computed restart parameters.
* `batch`, `run`: bounded full-state production and retained matching/release.

## Main results

* `batch_sound`, `batch_cover`, `run_none`, `run_sound`: actual occurrence/witness completeness.
* `batch_length`, `copyAllowance`: derived batch storage and repeated-input charges.
* `groups_length`, `batchCount_le_quarter`, `labels_wire`: actual quarter and label data bounds.
* `batchCertificate`, `runCertificate`: uniform executable bounded-batch composition.
-/

public section
namespace Cslib.Cryptanalysis.AddXNOR.ClassBatches
open Turing.MultiTapeTM Cslib.GenericRAM

/-- The two quarter populations actually regenerated by the produced orientation. -/
def quarterVolume (context : JoinedProbe.Context) : ℕ :=
  let ((input, right), _) := context
  let (_, (first, second)) := ClassBalance.halfInput input right
  2 ^ first.length + 2 ^ second.length

/-- Include quarter volume in the computed retained-side allowance to pay for each restart. -/
def capacity (context : JoinedProbe.Context) : ℕ :=
  let (_, (_, allowance)) := context
  allowance + quarterVolume context

/-- Actual produced population, computed without generating its full record list. -/
def population (context : JoinedProbe.Context) (g : ℕ) : ℕ :=
  let ((input, right), _) := context
  ClassBalance.count input right g

/-- All nonempty row-rank windows have labels below this computed ceiling. -/
def batchCount (context : JoinedProbe.Context) (g : ℕ) : ℕ :=
  population context g ⌈/⌉ capacity context

/-- Uniform power-of-two label data; extra labels are guarded before quarter generation. -/
def labels (context : JoinedProbe.Context) (g : ℕ) : List ℕ :=
  SortedQuarterMachine.indices (batchCount context g).size

/-- One directly emitted row-aligned window, then full-width original-state reconstruction. -/
def batch (context : JoinedProbe.Context) (g i : ℕ) : List (ℕ × ℕ) :=
  let ((input, right), _) := context
  (KeyJoinBatch.window (i*capacity context, capacity context) (JoinedProbe.groups context g)).map
    (ClassBalance.record input right)

/-- A completed batch supplies the dictionary to the matcher once. Padded labels do no work. -/
def matchLabel (context : JoinedProbe.Context) (g i : ℕ) : Option (ℕ × ℕ) :=
  let (_, (parameter, _)) := context
  if i < batchCount context g then BatchedAccess.matchBatch parameter (batch context g i) else none

/-- Release each materialized batch before the next label, retaining only the first witness. -/
def run (context : JoinedProbe.Context) (g : ℕ) : Option (ℕ × ℕ) :=
  let (_, ((_, (_, kept)), _)) := context
  if kept.isEmpty then none else (labels context g).findSome? (matchLabel context g)

theorem capacity_pos (context : JoinedProbe.Context) : 0 < capacity context := by
  rcases context with ⟨⟨input, right⟩, parameter, allowance⟩
  have h : 0 < 2 ^ (ClassBalance.halfInput input right).2.1.length := Nat.two_pow_pos _
  change 0 < allowance + (2 ^ (ClassBalance.halfInput input right).2.1.length +
    2 ^ (ClassBalance.halfInput input right).2.2.length)
  exact h.trans_le ((Nat.le_add_right _ _).trans (Nat.le_add_left _ _))

private theorem groups_count (context : JoinedProbe.Context) (g : ℕ) :
    KeyJoin.count (JoinedProbe.groups context g) = population context g := by
  rcases context with ⟨⟨input, right⟩, parameter, allowance⟩
  rfl

/-- Quarter storage follows from the actual generated arrays, not a supplied capacity oracle. -/
theorem groups_length (context : JoinedProbe.Context) (g : ℕ) :
    (JoinedProbe.groups context g).flatten.length = quarterVolume context := by
  rcases context with ⟨⟨input, right⟩, parameter, allowance⟩
  have h := ClassJoin.groups_input_length (ClassBalance.queryInput input right g)
  simpa only [JoinedProbe.groups, ClassBalance.queryInput, quarterVolume, List.length_map] using h

/-- A batch's reconstructed records all belong to the actual original produced class. -/
theorem batch_sound (context : JoinedProbe.Context) (g i : ℕ) (r : ℕ × ℕ)
    (h : r ∈ batch context g i) :
    let ((input, right), _) := context
    r ∈ ClassBalance.records input right g := by
  rcases context with ⟨⟨input, right⟩, parameter, allowance⟩
  obtain ⟨pair, hp, rfl⟩ := List.mem_map.mp h
  exact List.mem_map.mpr ⟨pair, KeyJoinBatch.window_mem_join _ _ _ hp, rfl⟩

/-- Every actual full-state occurrence enters one of the computed batches. -/
theorem batch_cover (context : JoinedProbe.Context) (g : ℕ) (r : ℕ × ℕ)
    (h : let ((input, right), _) := context; r ∈ ClassBalance.records input right g) :
    ∃ i < batchCount context g, r ∈ batch context g i := by
  rcases context with ⟨⟨input, right⟩, parameter, allowance⟩
  obtain ⟨pair, hp, rfl⟩ := List.mem_map.mp h
  obtain ⟨i, hi, hm⟩ := KeyJoinBatch.window_cover _ (capacity_pos _) _ pair hp
  refine ⟨i, ?_, List.mem_map.mpr ⟨pair, hm, rfl⟩⟩
  exact hi

/-- All direct batch outputs fit a capacity plus one quarter input, including every residue. -/
theorem batch_length (context : JoinedProbe.Context) (g i : ℕ) :
    (batch context g i).length ≤ capacity context + quarterVolume context := by
  rw [batch, List.length_map]
  exact (KeyJoinBatch.window_length _ _).trans_eq (by rw [groups_length])

private theorem label_mem (context : JoinedProbe.Context) (g i : ℕ)
    (hi : i < batchCount context g) : i ∈ labels context g := by
  rw [labels, SortedQuarterMachine.indices_eq_range, List.mem_range]
  exact hi.trans (Nat.lt_size_self _)

/-- Every miss is exhaustive for the actual original class, with physical full-state fit only. -/
theorem run_none (context : JoinedProbe.Context) (g : ℕ)
    (fits : let ((input, right), ((w, (_, kept)), _)) := context
      ∀ r ∈ kept ++ ClassBalance.records input right g, r.1 < 2 ^ w) :
    run context g = none ↔
      let ((input, right), ((_, (_, kept)), _)) := context
      ¬ BatchedAccess.Meets kept (ClassBalance.records input right g) := by
  rcases context with ⟨⟨input, right⟩, ⟨w, orientation, kept⟩, allowance⟩
  let context : JoinedProbe.Context := ((input, right), ((w, (orientation, kept)), allowance))
  by_cases empty : kept.isEmpty = true
  · have hk : kept = [] := List.isEmpty_iff.mp empty
    simp [run, hk, BatchedAccess.Meets]
  · rw [run, ite_eq_right empty, List.findSome?_eq_none_iff]
    constructor
    · intro allBatch ⟨a, ha, b, hb, he⟩
      obtain ⟨i, hi, hm⟩ := batch_cover context g b hb
      have hnone := allBatch i (label_mem context g i hi)
      rw [matchLabel, ite_eq_left hi] at hnone
      have noMeet := (BatchedAccess.match_none _ _ (fun r hr => fits r (by
        rcases List.mem_append.mp hr with h | h
        · exact List.mem_append_left _ h
        · exact List.mem_append_right _ (batch_sound context g i r h)))).mp hnone
      exact noMeet ⟨a, ha, b, hm, he⟩
    · intro noMeet i _
      dsimp only [matchLabel]
      split
      · apply (BatchedAccess.match_none _ _ (fun r hr => fits r (by
          rcases List.mem_append.mp hr with h | h
          · exact List.mem_append_left _ h
          · exact List.mem_append_right _ (batch_sound context g i r h)))).mpr
        rintro ⟨a, ha, b, hb, he⟩
        exact noMeet ⟨a, ha, b, batch_sound context g i b hb, he⟩
      · rfl

/-- Returned packed witnesses come from the actual dictionary and reconstructed produced class. -/
theorem run_sound (context : JoinedProbe.Context) (g : ℕ) (out : ℕ × ℕ)
    (hit : run context g = some out) :
    let ((input, right), ((_, (orientation, kept)), _)) := context
    ∃ a ∈ kept, ∃ b ∈ ClassBalance.records input right g, a.1 = b.1 ∧
      out = if orientation then (b.2, a.2) else (a.2, b.2) := by
  rcases context with ⟨⟨input, right⟩, ⟨w, orientation, kept⟩, allowance⟩
  let context : JoinedProbe.Context := ((input, right), ((w, (orientation, kept)), allowance))
  dsimp only [run] at hit
  split at hit
  · simp at hit
  · obtain ⟨i, _, hi⟩ := List.exists_of_findSome?_eq_some hit
    dsimp only [matchLabel] at hi
    split at hi
    · obtain ⟨a, ha, b, hb, he, ho⟩ := BatchedAccess.match_sound _ _ out hi
      exact ⟨a, ha, b, batch_sound context g i b hb, he, ho⟩
    · simp at hi

/-- Computed labels themselves stay quarter scale; the population bound comes from the
actual join and capacity already includes its full quarter input. -/
theorem batchCount_le_quarter (context : JoinedProbe.Context) (g : ℕ) :
    batchCount context g ≤ quarterVolume context := by
  rw [batchCount, ceilDiv_le_iff_le_mul (capacity_pos context)]
  have h := KeyJoin.count_le_square (JoinedProbe.groups context g)
  rw [groups_count, groups_length] at h
  have hc : quarterVolume context ≤ capacity context := Nat.le_add_left _ _
  exact h.trans (by simpa only [pow_two, Nat.mul_comm] using
    Nat.mul_le_mul_left (quarterVolume context) hc)

private theorem pow_size (n : ℕ) : 2 ^ n.size ≤ 2 * (n+1) := by
  cases h : n.size with
  | zero => simp only [pow_zero]; omega
  | succ k =>
    have low : 2 ^ k ≤ n := Nat.lt_size.mp (by omega)
    rw [pow_succ]
    omega

/-- Every generated label is actually stored in quarter-scale binary data. -/
theorem labels_wire (context : JoinedProbe.Context) (g : ℕ) :
    (encList encNat (labels context g)).length ≤
      2 * (quarterVolume context+1) * (2 * (quarterVolume context).size+1) := by
  have hk := batchCount_le_quarter context g
  have power : 2 ^ (batchCount context g).size ≤ 2 * (quarterVolume context+1) :=
    (pow_size _).trans (Nat.mul_le_mul_left 2 (Nat.add_le_add_right hk 1))
  have size := Nat.size_le_size hk
  exact (SortedQuarterMachine.indices_wire _).2.2.trans
    (Nat.mul_le_mul power (by omega))

/-- Actual repeated quarter/retained-capacity volume over the generated labels is linear
in the class population plus capacity; padding and the final partial batch are charged. -/
theorem copyAllowance (context : JoinedProbe.Context) (g : ℕ) :
    (labels context g).length * capacity context ≤
      2 * population context g + 4 * capacity context := by
  have h := KeyJoinBatch.batch_allowance (population context g) (capacity context)
  have k := pow_size (batchCount context g)
  have hm := Nat.mul_le_mul_right (capacity context) k
  rw [labels, (SortedQuarterMachine.indices_wire _).1]
  change batchCount context g * capacity context ≤ population context g + capacity context at h
  nlinarith

private abbrev ec := JoinedProbe.encoding
private abbrev er := encPair encNat encNat
private abbrev ei := encPair ec encNat

private noncomputable def quarterCertificate : NativeCertificate
    (fun side : ClassBalance.Input × Bool =>
      let (_, (first, second)) := ClassBalance.halfInput side.1 side.2
      2 ^ first.length + 2 ^ second.length)
    (encPair ClassBalance.encoding encBool) encNat := by
  have first : ComputableInPolyTime (fun q : SortedMeet.Input => q.2.1.length)
      SortedMeet.encoding encUnary := by dsimp only [SortedMeet.encoding]; fun_prop
  have second : ComputableInPolyTime (fun q : SortedMeet.Input => q.2.2.length)
      SortedMeet.encoding encUnary := by dsimp only [SortedMeet.encoding]; fun_prop
  have a := ComputableInPolyTime.binary_pow' (ComputableInPolyTime.const 2) first
  have b := ComputableInPolyTime.binary_pow' (ComputableInPolyTime.const 2) second
  have sum := ComputableInPolyTime.of_tidy (a.tidy.binary_add' b.tidy)
  exact .ofPolyTime ((sum.comp ClassBalance.halfInput_polyTime).of_enc_eq (fun _ => rfl))

private noncomputable def capacityCertificate : NativeCertificate capacity ec encNat := by
  let original : NativeCertificate (id : JoinedProbe.Context → _) ec ec :=
    .linear (.of_eq (fun _ => rfl))
  have add : ComputableInPolyTime (fun q : ℕ × ℕ => q.1+q.2) er encNat := by fun_prop
  exact NativeCertificate.congr ((NativeCertificate.ofPolyTime add).comp
    (original.snd.snd.prod (quarterCertificate.comp original.fst))) (fun _ => rfl)

private noncomputable def populationCertificate : NativeCertificate
    (fun q : JoinedProbe.Context × ℕ => population q.1 q.2) ei encNat := by
  let original : NativeCertificate (id : JoinedProbe.Context × ℕ → _) ei ei :=
    .linear (.of_eq (fun _ => rfl))
  exact NativeCertificate.congr (ClassBalance.countCertificate.comp
    (original.fst.fst.prod original.snd)) (fun _ => rfl)

private noncomputable def countCertificate : NativeCertificate
    (fun q : JoinedProbe.Context × ℕ => batchCount q.1 q.2) ei encNat := by
  let original : NativeCertificate (id : JoinedProbe.Context × ℕ → _) ei ei :=
    .linear (.of_eq (fun _ => rfl))
  have ceil : ComputableInPolyTime (fun q : ℕ × ℕ => q.1 ⌈/⌉ q.2) er encNat := by
    have a := ComputableTidilyInPolyTime.fst encNat encNat
    have b := ComputableTidilyInPolyTime.snd encNat encNat
    have h := ComputableTidilyInPolyTime.binary_div'
      (ComputableTidilyInPolyTime.binary_sub' (a.binary_add' b) (.const 1)) b
    exact .of_tidy (h.of_enc_eq (fun _ => rfl))
  exact NativeCertificate.congr ((NativeCertificate.ofPolyTime ceil).comp
    (populationCertificate.prod (capacityCertificate.comp original.fst))) (fun _ => rfl)

/-- Generate only this batch's quarter matches and reconstructed full states. The retained
parameter is projected out before quarter/window/full-state callbacks are invoked. -/
noncomputable def batchCertificate : NativeCertificate
    (fun q : (JoinedProbe.Context × ℕ) × ℕ => batch q.1.1 q.1.2 q.2)
    (encPair (encPair JoinedProbe.encoding encNat) encNat) (encList (encPair encNat encNat)) := by
  let e := encPair ei encNat
  let original : NativeCertificate (id : (JoinedProbe.Context × ℕ) × ℕ → _) e e :=
    .linear (.of_eq (fun _ => rfl))
  let context := original.fst.fst
  let capacity := capacityCertificate.comp context
  have mul : ComputableInPolyTime (fun q : ℕ × ℕ => q.1*q.2) er encNat := by fun_prop
  let start := (NativeCertificate.ofPolyTime mul).comp (original.snd.prod capacity)
  let bounds := start.prod capacity
  let query := (NativeCertificate.ofPolyTime ClassBalance.queryInput_polyTime).comp
    (context.fst.prod original.fst.snd)
  let groups := ClassJoin.groupsCertificate.comp query
  let selected := KeyJoinBatch.windowCertificate.comp (bounds.prod groups)
  exact NativeCertificate.congr (ClassBalance.emitCertificate.comp
    (context.fst.prod selected)) (fun _ => rfl)

private noncomputable def matchCertificate : NativeCertificate
    (fun q : (JoinedProbe.Context × ℕ) × ℕ => matchLabel q.1.1 q.1.2 q.2)
    (encPair ei encNat) (encOption er) := by
  let e := encPair ei encNat
  let original : NativeCertificate (id : (JoinedProbe.Context × ℕ) × ℕ → _) e e :=
    .linear (.of_eq (fun _ => rfl))
  have lt : ComputableInPolyTime (fun q : ℕ × ℕ => decide (q.1 < q.2)) er encBool := by
    fun_prop
  let selected := (NativeCertificate.ofPolyTime lt).comp
    (original.snd.prod (countCertificate.comp original.fst))
  let matched := BatchedAccess.matchCertificate.comp
    (original.fst.fst.snd.fst.prod batchCertificate)
  let missing : NativeCertificate (fun _ : (JoinedProbe.Context × ℕ) × ℕ =>
      (none : Option (ℕ × ℕ))) e (encOption er) := .const _
  exact NativeCertificate.congr (NativeCertificate.branch selected matched missing) (fun q => by
    simp [matchLabel])

/-- A fixed uniform outer stream consumes actually generated batch labels, reuses its
retained parameter once per batch and releases batch outputs. All callback/state/control
and producer/matcher temporaries are charged in the composed time/prefix-space profiles. -/
noncomputable def runCertificate : NativeCertificate
    (fun q : JoinedProbe.Context × ℕ => run q.1 q.2)
    (encPair JoinedProbe.encoding encNat) (encOption (encPair encNat encNat)) := by
  let original : NativeCertificate (id : JoinedProbe.Context × ℕ → _) ei ei :=
    .linear (.of_eq (fun _ => rfl))
  let power := (NativeCertificate.ofPolyTime ComputableInPolyTime.binary_size).comp countCertificate
  let generation := (Classical.choose_spec SortedQuarterMachine.indices_computable).2.2
  let generated : NativeCertificate SortedQuarterMachine.indices encUnary (encList encNat) :=
    ⟨_, _, generation⟩
  let indices := generated.comp power
  let e := encPair (encPair ei (encOption er)) encNat
  let arg : NativeCertificate (id : ((JoinedProbe.Context × ℕ) × Option (ℕ × ℕ)) × ℕ → _) e e :=
    .linear (.of_eq (fun _ => rfl))
  let fresh := matchCertificate.comp (arg.fst.fst.prod arg.snd)
  let found := arg.fst.snd
  let parked : NativeCertificate
      (fun q : (((JoinedProbe.Context × ℕ) × Option (ℕ × ℕ)) × ℕ) × (ℕ × ℕ) => some q.2)
      (encPair e er) (encOption er) :=
    ((NativeCertificate.linear (.of_eq (fun _ => rfl))).snd).some
  let step : NativeCertificate
      (fun q : ((JoinedProbe.Context × ℕ) × Option (ℕ × ℕ)) × ℕ =>
        q.1.2.orElse (fun _ => matchLabel q.1.1.1 q.1.1.2 q.2)) e (encOption er) :=
    NativeCertificate.congr (found.option fresh parked) (fun q => by
      rcases q with ⟨⟨input, found⟩, i⟩
      cases found <;> rfl)
  let loop := NativeCertificate.foldlStream ei (encOption er) encNat
    (fun q found i => found.orElse (fun _ => matchLabel q.1 q.2 i)) step
  let initial : NativeCertificate (fun _ : JoinedProbe.Context × ℕ =>
      (none : Option (ℕ × ℕ))) ei (encOption er) := .const _
  let searched := loop.comp (original.prod (initial.prod indices))
  have foldEq (q : JoinedProbe.Context × ℕ) (xs : List ℕ) (found : Option (ℕ × ℕ)) :
      xs.foldl (fun found i => found.orElse (fun _ => matchLabel q.1 q.2 i)) found =
        found.orElse (fun _ => xs.findSome? (matchLabel q.1 q.2)) := by
    induction xs generalizing found with
    | nil => cases found <;> rfl
    | cons i xs ih =>
      cases found with
      | some out => simpa only [List.foldl_cons, Option.orElse_some] using ih (some out)
      | none =>
        rw [List.foldl_cons, Option.orElse_none, ih, List.findSome?_cons]
        cases matchLabel q.1 q.2 i <;> rfl
  let empty := original.fst.snd.fst.snd.snd.post
    ((ComputableInDegree.listIsEmpty er).inO_one)
  let missing : NativeCertificate (fun _ : JoinedProbe.Context × ℕ =>
      (none : Option (ℕ × ℕ))) ei (encOption er) := .const _
  exact NativeCertificate.congr (NativeCertificate.branch empty missing searched) (fun q => by
    rcases q with ⟨context, g⟩
    simp only [run, labels, Function.comp_def, id_eq]
    split
    · rfl
    · exact foldEq (context, g) _ none)

end Cslib.Cryptanalysis.AddXNOR.ClassBatches
