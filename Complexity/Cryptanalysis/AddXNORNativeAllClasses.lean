module
-- upstream: candidate

public import Complexity.Cryptanalysis.AddXNORNativeSelectedClass
import all Complexity.Cryptanalysis.AddXNORNativeSelectedClass

/-!
# Native outer composition of every low-bit class

A finite structured-code family visits increasing class keys, skips the remainder
only after an actual valid hit, and releases the dictionary even for the final
successful class. The code is generated by unrolling the class interval; its size
is linear in the number of classes. This is not a fixed-size outer while program
or a source bit-space certificate. Class consumers themselves are native loops.
-/

public section

namespace Cslib.Cryptanalysis.AddXNOR.Native.Driver

open Cslib.WordRAM Quarter

/-- Native composition of a finite interval, with witness-preserving early exit. -/
@[expose] def searchClasses {W m p a b c d : ℕ} (L : SearchLayout W m p a b c d)
    (s t : BitVec m) (j : ℕ) : ℕ → Code .standard 40
  | 0 => ram[ tag ← #0 ]
  | n + 1 => .seq (selectedClass L s t (BitVec.ofNat p j))
      (.branch (.lt zero tag) (ram[ tag ← tag ]) (searchClasses L s t (j + 1) n))

/-- Charged full-interval budget; successful prefixes use at most this budget. -/
def allTime {m p : ℕ} (as bs cs ds : List (BitVec m)) (s t : BitVec m) (j : ℕ) : ℕ → ℕ
  | 0 => 1
  | n + 1 => selectedTime as bs cs ds s t (BitVec.ofNat p j) +
      (2 + allTime (p := p) as bs cs ds s t (j + 1) n)

/-- The full charged outer budget is the sum of the actual per-class budgets
plus two native control instructions per class and the final empty-interval write. -/
theorem allTime_eq_sum {m p : ℕ} (as bs cs ds : List (BitVec m))
    (s t : BitVec m) (j n : ℕ) :
    allTime (p := p) as bs cs ds s t j n =
      ((List.range' j n).map fun k => selectedTime as bs cs ds s t (BitVec.ofNat p k)).sum +
        2 * n + 1 := by
  induction n generalizing j with
  | zero => simp [allTime]
  | succ n ih =>
    simp only [allTime, List.range'_succ, List.map_cons, List.sum_cons, ih]
    omega

/-- Indexed selected-class solution in an interval of class values. -/
def RangeSolution {m p : ℕ} (as bs cs ds : List (BitVec m)) (s t : BitVec m) (j n : ℕ) : Prop :=
  ∃ k, j ≤ k ∧ k < j + n ∧ PackedClassSolution as bs cs ds s t (BitVec.ofNat p k)

private theorem range_succ {m p : ℕ} (as bs cs ds : List (BitVec m))
    (s t : BitVec m) (j n : ℕ) :
    RangeSolution (p := p) as bs cs ds s t j (n + 1) ↔
      PackedClassSolution as bs cs ds s t (BitVec.ofNat p j) ∨
        RangeSolution (p := p) as bs cs ds s t (j + 1) n := by
  constructor
  · rintro ⟨k, hk, hn, hs⟩
    by_cases he : k = j
    · subst k; exact Or.inl hs
    · exact Or.inr ⟨k, by omega, by omega, hs⟩
  · rintro (h | ⟨k, hk, hn, hs⟩)
    · exact ⟨j, le_rfl, by omega, h⟩
    · exact ⟨k, by omega, by omega, hs⟩

/-- General finite outer composition derives exhaustive absence and sound hits.
The intermediate table contract is supplied by `Driver.prepare_exec`; no class
traversal, termination or dictionary validity conclusion is a premise. -/
theorem searchClasses_exec {W m p : ℕ} (hp : p ≤ m)
    (as bs cs ds : List (BitVec m)) (s t : BitVec m)
    (L : SearchLayout W m p as.length bs.length cs.length ds.length) (j n : ℕ)
    (x : Data 40) (hx : L.Raw as bs cs ds (x.comap bank)) (hr : Ready as bs cs ds s t L x)
    (hfit : Fits W (L.D + 4 * 2 ^ m + 8))
    (hload : Fits W (2 * L.q₂ + 2 * 2 ^ p + 4)) :
    ∃ y, ExecWithin W (searchClasses L s t j n) x y (allTime (p := p) as bs cs ds s t j n) ∧
      (y.regs tag ≠ 0 ↔ RangeSolution (p := p) as bs cs ds s t j n) ∧
      (y.regs tag ≠ 0 → eval (witness as bs cs ds y) s = t) ∧
      (∀ a, a < L.q₂ → y.mem a = x.mem a) ∧
      L.Raw as bs cs ds (y.comap bank) ∧ Ready as bs cs ds s t L y ∧
      y.regs balance = x.regs balance := by
  induction n generalizing j x with
  | zero =>
    let y := x.set tag 0
    have he : ExecWithin (B := .standard) W (ram[ tag ← #0 ]) x y 1 := .const (fits_zero W)
    refine ⟨y, he, ?_, ?_, fun _ _ => rfl, hx, ?_, ?_⟩
    · simp [y, RangeSolution]; omega
    · simp [y]
    · simpa +decide [Ready, y, tag, bank, Quarter.operand, forwardPointer, backwardPointer, zero]
        using hr
    · simp +decide [y, tag, bank, Quarter.operand, balance]
  | succ n ih =>
    obtain ⟨u, hu, _, hit, sound, _, frame, raw, ready, ub⟩ :=
      selectedClass_exec hp as bs cs ds s t (BitVec.ofNat p j) L x hx hr hfit hload
    by_cases hh : u.regs tag ≠ 0
    · have keep : ExecWithin (B := .standard) W (ram[ tag ← tag ]) u u 1 := by
        simpa [Data.set] using (ExecWithin.copy (B := .standard) (w := W)
          (d := tag) (s := tag) (x := u))
      have test : (Cond.lt zero tag).Holds u := by
        simp only [Cond.holds_lt, ready.2.2.2.2]
        omega
      refine ⟨u, (hu.seq (ExecWithin.branch_pos test keep)).mono ?_, ?_, sound,
        frame, raw, ready, ub⟩
      · simp only [allTime]; omega
      · rw [range_succ]
        exact ⟨fun _ => Or.inl (hit.mp hh), fun _ => hh⟩
    · obtain ⟨y, hy, yh, yw, yf, yr, yt, yb⟩ := ih (j + 1) u raw ready
      have test : ¬(Cond.lt zero tag).Holds u := by
        simp only [Cond.holds_lt, ready.2.2.2.2]
        omega
      refine ⟨y, ?_, ?_, yw, ?_, yr, yt, yb.trans ub⟩
      · simpa only [searchClasses, allTime, Nat.add_comm 2] using
          hu.seq (ExecWithin.branch_neg (pos := ram[ tag ← tag ]) test hy)
      · rw [range_succ]
        have hn : ¬PackedClassSolution as bs cs ds s t (BitVec.ofNat p j) :=
          fun h => hh (hit.mpr h)
        simpa only [hn, false_or] using yh
      · intro a ha; rw [yf a ha, frame a ha]

/-- Visiting every low-bit key finds exactly the union of all selected classes. -/
theorem range_all_iff {m p : ℕ} (as bs cs ds : List (BitVec m)) (s t : BitVec m) :
    RangeSolution (p := p) as bs cs ds s t 0 (2 ^ p) ↔
      ∃ g : BitVec p, PackedClassSolution as bs cs ds s t g := by
  constructor
  · rintro ⟨k, _, _, hs⟩; exact ⟨BitVec.ofNat p k, hs⟩
  · rintro ⟨g, hg⟩
    exact ⟨g.toNat, Nat.zero_le _, by simpa only [Nat.zero_add] using g.isLt, by simpa using hg⟩

end Cslib.Cryptanalysis.AddXNOR.Native.Driver
