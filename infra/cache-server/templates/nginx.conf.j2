# Managed by Complexitylib infra/cache-server. Applied revision {{ cache_server_revision }}.
server {
    listen {{ cache_server_http_port }};
    listen [::]:{{ cache_server_http_port }};
    server_name {{ cache_server_domain }};
    access_log off;
    error_log /var/log/nginx/complexitylib-cache-error.log warn;
    log_not_found off;

    location ^~ /.well-known/acme-challenge/ {
        root {{ cache_server_acme_root }};
        default_type text/plain;
        try_files $uri =404;
    }

    location = /healthz {
        default_type text/plain;
        add_header Cache-Control "no-store";
        return 200 "{{ cache_server_revision }}\n";
    }

    location / {
{% if cache_server_https %}
        return 301 https://{{ cache_server_domain }}$request_uri;
{% else %}
        return 503;
{% endif %}
    }
}
{% if cache_server_https %}

server {
    listen {{ cache_server_https_port }} ssl;
    listen [::]:{{ cache_server_https_port }} ssl;
    server_name {{ cache_server_domain }};
    ssl_certificate {{ cache_server_certificate_directory }}/fullchain.pem;
    ssl_certificate_key {{ cache_server_certificate_directory }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:ComplexitylibCacheTLS:1m;
    ssl_session_timeout 1d;
    access_log off;
    error_log /var/log/nginx/complexitylib-cache-error.log warn;
    log_not_found off;

    root {{ cache_server_data_root }};
    autoindex off;
    disable_symlinks on;
    sendfile on;
    tcp_nopush on;
    gzip off;
    client_max_body_size 1k;

    location = /healthz {
        default_type text/plain;
        add_header Cache-Control "no-store";
        return 200 "{{ cache_server_revision }}\n";
    }

    location ~ "^/a0/cslib-community/complexitylib/[0-9a-f]{16}\.art$" {
        limit_except GET { deny all; }
        default_type application/vnd.reservoir.artifact;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location ~ "^/r0/cslib-community/complexitylib/tc/[A-Za-z0-9_.+-]+/[0-9a-f]{40}\.jsonl$" {
        limit_except GET { deny all; }
        default_type application/vnd.reservoir.outputs+json-lines;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Do not expose directories, other repositories, dotfiles or rsync's incomplete temp files.
    location / { return 404; }
}
{% endif %}
