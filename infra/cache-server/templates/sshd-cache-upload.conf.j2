# Managed by Complexitylib infra/cache-server. Do not grant this account another SSH path.
Match User {{ cache_server_upload_user }}
    AuthenticationMethods publickey
    PubkeyAuthentication yes
    PubkeyAcceptedAlgorithms {{ cache_server_upload_pubkey_algorithms }}
    AuthorizedKeysFile {{ cache_server_upload_home }}/.ssh/authorized_keys
    AuthorizedKeysCommand none
    AuthorizedPrincipalsFile /dev/null
    TrustedUserCAKeys none
    HostbasedAuthentication no
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    ForceCommand {{ cache_server_upload_command }}
    DisableForwarding yes
    PermitTTY no
    PermitUserRC no

# End the account-specific block before any configuration included after this file.
Match all
