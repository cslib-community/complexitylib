[Unit]
Description=Bound cache host egress
Wants=network-online.target
After=network-online.target
Before=nginx.service
OnFailure=cache-origin-alert@%n.service

[Service]
Type=oneshot
RemainAfterExit=true
# Set this explicitly after inspecting the host's default route and qdiscs.
# This replaces the interface's root qdisc; never enable over an unrelated shaper.
Environment=CACHE_INTERFACE=REPLACE_WITH_PRIMARY_INTERFACE
ExecStart=/usr/sbin/tc qdisc replace dev ${CACHE_INTERFACE} root handle 1: tbf rate 128mbit burst 256kb latency 400ms
# Leave the cap in place on stop. Rollback must inspect the current qdisc and
# restore the saved configuration explicitly, never delete another operator's cap.
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
